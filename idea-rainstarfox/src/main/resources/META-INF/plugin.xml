<idea-plugin>
    <id>org.rainstarfox.idea</id>
    <name>rainStarfox</name>
    <vendor>rainStarfox</vendor>

    <!-- 描述、版本、兼容区间由 build.gradle.kts 的 pluginConfiguration 注入，
         不写在这里：校验器对描述有硬性规则（必须拉丁字母开头、至少 40 字符），
         放在构建脚本里一份来源，避免两边不一致。 -->

    <depends>com.intellij.modules.platform</depends>

    <!-- Java 支持是**可选**的：装了就跟 Java 一样能 Ctrl+点跳进 JDK / 第三方类。
         没有 Java 插件的 IDE（CLion / GoLand / PyCharm）照样能装，只是少了这段跳转。 -->
    <depends optional="true" config-file="rainStarfox-java.xml">com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 文件类型与语言 -->
        <fileType name="rainStarfox File"
                  implementationClass="org.rainstarfox.idea.RsfFileType"
                  fieldName="INSTANCE"
                  language="rainStarfox"
                  extensions="rsf"/>

        <!-- 词法 / 语法（扁平树） -->
        <lang.parserDefinition language="rainStarfox"
                               implementationClass="org.rainstarfox.idea.RsfParserDefinition"/>

        <!-- 高亮 -->
        <lang.syntaxHighlighterFactory language="rainStarfox"
                                       implementationClass="org.rainstarfox.idea.RsfSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="org.rainstarfox.idea.RsfColorSettingsPage"/>

        <!-- 编辑体验 -->
        <lang.commenter language="rainStarfox"
                        implementationClass="org.rainstarfox.idea.RsfCommenter"/>
        <lang.braceMatcher language="rainStarfox"
                           implementationClass="org.rainstarfox.idea.RsfBraceMatcher"/>

        <!-- 报错波浪线：外部注解器，在后台线程跑编译器 -->
        <externalAnnotator language="rainStarfox"
                           implementationClass="org.rainstarfox.idea.RsfExternalAnnotator"/>

        <!-- 补全 -->
        <completion.contributor language="rainStarfox"
                                implementationClass="org.rainstarfox.idea.RsfCompletionContributor"/>

        <!-- Ctrl+点跳转：问语言服务器要声明位置 -->
        <gotoDeclarationHandler implementation="org.rainstarfox.idea.RsfGotoDeclarationHandler"/>

        <!-- 重命名（Shift+F6）：改哪些地方由语言服务器算（textDocument/rename） -->
        <renameHandler implementation="org.rainstarfox.idea.RsfRenameHandler"/>

        <!-- Alt+F7（Find Usages）：接管 processElementUsages，结果进标准 Find 工具窗 -->
        <findUsagesHandlerFactory implementation="org.rainstarfox.idea.RsfFindUsagesHandlerFactory"/>
        <lang.findUsagesProvider language="rainStarfox"
                                 implementation="org.rainstarfox.idea.RsfFindUsagesProvider"/>

        <!-- 悬停文档（RDoc）：声明上方的 /// 行 -->
        <lang.documentationProvider language="rainStarfox"
                                    implementation="org.rainstarfox.idea.RsfDocumentationProvider"/>

        <!-- 样板（live templates）：fn / lam / class / ... 按 Tab 展开 -->
        <defaultLiveTemplatesProvider implementation="org.rainstarfox.idea.RsfLiveTemplates"/>

        <!-- 把 <项目>/out 挂进模块类路径：Java 侧引用 rsf 编译出的类才不飘红 -->
        <postStartupActivity implementation="org.rainstarfox.idea.RsfOutputActivity"/>

        <!-- 设置 -->
        <applicationService serviceImplementation="org.rainstarfox.idea.RsfSettings"/>
        <applicationConfigurable parentId="tools"
                                 id="org.rainstarfox.idea.settings"
                                 displayName="rainStarfox"
                                 instance="org.rainstarfox.idea.RsfConfigurable"/>

        <notificationGroup id="rainStarfox" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="Rsf.RunFile"
                class="org.rainstarfox.idea.RsfRunAction"
                text="运行 rainStarfox 文件"
                description="用解释器执行当前 .rsf 文件（rsf run）">
            <add-to-group group-id="RunMenu" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="Rsf.BuildFile"
                class="org.rainstarfox.idea.RsfBuildAction"
                text="编译 rainStarfox 文件"
                description="把当前 .rsf 文件编译成 .class（rsf build）">
            <add-to-group group-id="BuildMenu" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
