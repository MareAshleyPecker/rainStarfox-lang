<templateSet group="rainStarfox">
    <!-- 样板：输入缩写后按 Tab 展开。占位符全都可以 Tab 跳过去改。 -->
    <template name="fn" value="pub fn $name$($x$ : int) -&gt; int {&#10;    $END$&#10;}" description="顶层函数" toReformat="true" toShortenFQNames="true">
        <variable name="name" expression="" defaultValue="name" alwaysStopAt="true"/>
        <variable name="x" expression="" defaultValue="x" alwaysStopAt="true"/>
    </template>

    <template name="lam" value="lam($x$ : int) -&gt; int {&#10;    $END$&#10;}" description="lambda 字面量" toReformat="true" toShortenFQNames="true">
        <variable name="x" expression="" defaultValue="x" alwaysStopAt="true"/>
    </template>

    <template name="class" value="pub class $Name$ {&#10;    $END$&#10;}" description="类声明" toReformat="true" toShortenFQNames="true">
        <variable name="Name" expression="" defaultValue="Name" alwaysStopAt="true"/>
    </template>

    <template name="itf" value="pub interface $Name$ {&#10;    $END$&#10;}" description="接口声明" toReformat="true" toShortenFQNames="true">
        <variable name="Name" expression="" defaultValue="Name" alwaysStopAt="true"/>
    </template>

    <template name="enum" value="pub enum $Name$ {&#10;    $END$&#10;}" description="枚举声明" toReformat="true" toShortenFQNames="true">
        <variable name="Name" expression="" defaultValue="Name" alwaysStopAt="true"/>
    </template>

    <template name="main" value="fn main() -&gt; void {&#10;    $END$&#10;}" description="程序入口" toReformat="true" toShortenFQNames="true"/>

    <template name="for" value="for (var $i$ = 0; $i$ &lt; $n$; $i$ = $i$ + 1) {&#10;    $END$&#10;}" description="计数循环" toReformat="true" toShortenFQNames="true">
        <variable name="i" expression="" defaultValue="i" alwaysStopAt="true"/>
        <variable name="n" expression="" defaultValue="n" alwaysStopAt="true"/>
    </template>

    <template name="while" value="while ($cond$) {&#10;    $END$&#10;}" description="while 循环" toReformat="true" toShortenFQNames="true">
        <variable name="cond" expression="" defaultValue="cond" alwaysStopAt="true"/>
    </template>

    <template name="switch" value="switch ($value$) {&#10;    $CASE$ :&#10;        $END$&#10;    else :&#10;        rtn&#10;}" description="枚举分支" toReformat="true" toShortenFQNames="true">
        <variable name="value" expression="" defaultValue="value" alwaysStopAt="true"/>
        <variable name="CASE" expression="" defaultValue="CASE" alwaysStopAt="true"/>
    </template>

    <template name="try" value="try {&#10;    $END$&#10;} catch ($e$ : string) {&#10;    println($e$)&#10;}" description="错误处理" toReformat="true" toShortenFQNames="true">
        <variable name="e" expression="" defaultValue="e" alwaysStopAt="true"/>
    </template>
</templateSet>
