{
  "函数声明": {
    "prefix": "fun",
    "body": [
      "${1:public }fun ${2:name}() ${3|->,::,:|} ${4:void} {",
      "    $0",
      "}"
    ],
    "description": "声明一个函数（ControlType 在最左，MainType 在 fun 之后）"
  },
  "入口 main": {
    "prefix": "main",
    "body": [
      "fun main() -> void {",
      "    $0",
      "    rtn",
      "}"
    ],
    "description": "程序的入口函数"
  },
  "可变变量": {
    "prefix": "var",
    "body": ["var ${1:name} = ${2:0}"],
    "description": "声明可变变量"
  },
  "不可变变量": {
    "prefix": "imutvar",
    "body": ["imutvar ${1:name} = ${2:0}"],
    "description": "声明不可变变量"
  },
  "if / else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "if / else"
  },
  "if 单行": {
    "prefix": "if1",
    "body": ["if ${1:condition} : ${2:rtn}"],
    "description": "冒号形式的 if（后面跟单条语句）"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "while 循环"
  },
  "for-in": {
    "prefix": "forin",
    "body": [
      "for (${1:i} in ${2:0}..${3:9}) {",
      "    $0",
      "}"
    ],
    "description": "Kotlin 式 for（区间两端都含）"
  },
  "for-in 带步长": {
    "prefix": "forstep",
    "body": [
      "for (${1:i} in ${2:0}..${3:10} step ${4:2}) {",
      "    $0",
      "}"
    ],
    "description": "带步长的 for-in"
  },
  "for 经典三段": {
    "prefix": "for",
    "body": [
      "for (var ${1:i} = 0; ${1:i} < ${2:10}; ${1:i} = ${1:i} + 1) {",
      "    $0",
      "}"
    ],
    "description": "Java 式 for"
  },
  "无限循环": {
    "prefix": "forloop",
    "body": [
      "for (;;) {",
      "    $0",
      "    break",
      "}"
    ],
    "description": "for (;;) 加 break"
  },
  "三目": {
    "prefix": "ternary",
    "body": ["if ${1:condition} ? ${2:a} : ${3:b}"],
    "description": "三目运算符（是表达式）"
  },
  "返回": {
    "prefix": "rtn",
    "body": ["rtn ${1}"],
    "description": "返回（rtn 与 return 等价）"
  },
  "打印": {
    "prefix": "println",
    "body": ["println(\"${1}\" + ${2})"],
    "description": "输出一行"
  },
  "goto 标签": {
    "prefix": "goto",
    "body": ["goto ${1:label}"],
    "description": "跳转到标签"
  }
}
