{
  "name": "rainstarfox",
  "displayName": "rainStarfox",
  "description": "rainStarfox (.rsf) 的语法高亮、报错诊断与代码补全",
  "version": "0.2.0",
  "publisher": "rainStarfox",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "rainStarfox",
    "rsf",
    "rain"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:rainstarfox"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --target=node18",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "check-grammar": "node tools/tokenize-check.js",
    "package": "npm run build && npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "rainstarfox",
        "aliases": [
          "rainStarfox",
          "rsf"
        ],
        "extensions": [
          ".rsf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rainstarfox",
        "scopeName": "source.rsf",
        "path": "./syntaxes/rainstarfox.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rainstarfox",
        "path": "./snippets/rainstarfox.json"
      }
    ],
    "configuration": {
      "title": "rainStarfox",
      "properties": {
        "rainstarfox.launcher": {
          "type": "string",
          "default": "",
          "markdownDescription": "rsf 启动器路径（`rainStarfox-x.y.z.jar` 或 `rainStarfox.exe`）。留空则自动在工作区里找 `build/libs/rainStarfox-*.jar`，找不到再找 `build/native/rainStarfox/rainStarfox.exe`。"
        },
        "rainstarfox.javaCommand": {
          "type": "string",
          "default": "java",
          "description": "启动器是 jar 时用哪个 java 命令。"
        },
        "rainstarfox.diagnosticsDelay": {
          "type": "number",
          "default": 500,
          "description": "停止输入后多少毫秒跑一次检查（每次都要起一次 JVM，所以别调太小）。"
        }
      }
    }
  }
}
