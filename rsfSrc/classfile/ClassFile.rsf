import "../core/HashMap.rsf"

// 阶段 64d：自己写 class 文件（不依赖 ASM）
//
// 目标：给自举后端（Backend.rsf）一套与 ASM 同名同形的发射 API，
// 让它编到 C 之后也能产出 .class。最小实现：
//   * 常量池按「首次使用」顺序追加（与 ASM 默认行为一致）
//   * 方法体 = 字节缓冲 + 标签回填（只做 16 位跳转，超范围显式失败）
//   * 类文件版本 49（Java 5）：不需要 StackMapTable，校验器走类型推导
//
// 语言没有位运算，拼字节全用除法/取模。

// 十进制字符串转整数（供常量池回填用；不依赖 parseInt 的错误返回）
pub fn decInt(s : String) -> Int {
    var neg = false
    var i = 0
    if (s.length() > 0 && s.charAt(0) == 45) {
        neg = true
        i = 1
    }
    var v = 0
    while (i < s.length()) {
        v = v * 10 + (charToInt(s.charAt(i)) - 48)
        i = i + 1
    }
    if (neg) { v = 0 - v }
    rtn v
}

// 向下取整的整数除法（负数也按数学 floor）
fn longOfDigit(d : Int) -> Long {
    if (d == 48) { rtn 0L }
    if (d == 49) { rtn 1L }
    if (d == 50) { rtn 2L }
    if (d == 51) { rtn 3L }
    if (d == 52) { rtn 4L }
    if (d == 53) { rtn 5L }
    if (d == 54) { rtn 6L }
    if (d == 55) { rtn 7L }
    if (d == 56) { rtn 8L }
    rtn 9L
}

pub fn decLong(s : String) -> Long {
    var i = 0
    var neg = false
    if (s.length() > 0 && charToInt(s.charAt(0)) == 45) {
        neg = true
        i = 1
    }
    var v = 0L
    while (i < s.length()) {
        v = v * 10L + longOfDigit(charToInt(s.charAt(i)))
        i = i + 1
    }
    if (neg) { v = 0L - v }
    rtn v
}

pub fn floorDiv(a : Int, b : Int) -> Int {
    var q = a / b
    if (a % b != 0 && ((a < 0) != (b < 0))) { q = q - 1 }
    rtn q
}

fn pow2I(p : Int) -> Int {
    var r = 1
    var i = 0
    while (i < p) {
        r = r * 2
        i = i + 1
    }
    rtn r
}

fn pow2Long(p : Int) -> Long {
    var r = 1L
    var i = 0
    while (i < p) {
        r = r * 2L
        i = i + 1
    }
    rtn r
}

// long 的某 32 位（按二进制补码取，结果按 Int 的补码回绕）
fn longToIntWrap(v : Long) -> Int {
    var x = v
    while (x < 0L) { x = x + 4294967296L }
    while (x >= 4294967296L) { x = x - 4294967296L }
    var out = 0
    var i = 0
    while (i < 32) {
        if ((x / pow2Long(i)) % 2L == 1L) { out = out + pow2I(i) }
        i = i + 1
    }
    rtn out
}

fn longHi(v : Long) -> Int { rtn longToIntWrap(floorDivLong(v, 4294967296L)) }
fn longLo(v : Long) -> Int { rtn longToIntWrap(v - floorDivLong(v, 4294967296L) * 4294967296L) }

// Long 没有 floorDiv：除法向零截断，这里按「向下取整」修正
fn floorDivLong(a : Long, b : Long) -> Long {
    var q = a / b
    if ((q * b != a) && ((a < 0L) != (b < 0L))) { q = q - 1L }
    rtn q
}

// 常量池里 long 常量的去重键（用十进制字符串；Long.toString 三端都可用）
fn longKeyOf(v : Long) -> String { rtn Long.toString(v) }

pub class Buf {
    var data : Int[] = new Int[256]
    var n : Int = 0

    pub fn size() -> Int { rtn n }

    prv fn grow(k : Int) -> void {
        var cap = data.length
        while (cap < n + k) { cap = cap * 2 }
        var a : Int[] = new Int[cap]
        for (var i = 0; i < n; i = i + 1) { a[i] = data[i] }
        data = a
    }

    pub fn u1(v : Int) -> void {
        if (n + 1 > data.length) { grow(1) }
        var x = v % 256
        if (x < 0) { x = x + 256 }
        data[n] = x
        n = n + 1
    }

    pub fn u2(v : Int) -> void {
        u1(floorDiv(v, 256) % 256)
        u1(v % 256)
    }

    pub fn u4(v : Int) -> void {
        u1(floorDiv(v, 16777216) % 256)
        u1(floorDiv(v, 65536) % 256)
        u1(floorDiv(v, 256) % 256)
        u1(v % 256)
    }

    pub fn raw(src : Int[], count : Int) -> void {
        if (n + count > data.length) { grow(count) }
        for (var i = 0; i < count; i = i + 1) {
            var x = src[i] % 256
            if (x < 0) { x = x + 256 }
            data[n] = x
            n = n + 1
        }
    }

    pub fn patchU2(at : Int, v : Int) -> void {
        var hi = floorDiv(v, 256) % 256
        var lo = v % 256
        if (hi < 0) { hi = hi + 256 }
        if (lo < 0) { lo = lo + 256 }
        data[at] = hi
        data[at + 1] = lo
    }
}

// JVM 类文件里的字符串用「修改版 UTF-8」：0 写成 C0 80，代理对每个码元各 3 字节。
fn mutfLen(s : String) -> Int {
    // 常量池里的 UTF-8 是「modified UTF-8」：BMP 上与普通 UTF-8 逐字节相同，
    // 只有 U+0000 例外——必须写成 C0 80（两个字节），否则 JVM 报
    // `ClassFormatError: Illegal UTF8 string in constant pool`。
    var bs = stringBytes(s)
    var i = 0
    var n = 0
    while (i < bs.length) {
        if ((bs[i] + 0) == 0) { n = n + 2 } else { n = n + 1 }
        i = i + 1
    }
    rtn n
}

fn mutfWrite(b : Buf, s : String) -> void {
    var bs = stringBytes(s)
    var i = 0
    while (i < bs.length) {
        if ((bs[i] + 0) == 0) {
            b.u1(192)
            b.u1(128)
        } else {
            b.u1(bs[i] + 0)
        }
        i = i + 1
    }
}

pub class Cp {
    var b : Buf = new Buf()
    var count : Int = 1
    var map : HashMap&<Int> = new HashMap&<Int>()

    pub fn utf8(s : String) -> Int {
        var key = "u:" + s
        if (map.containsKey(key)) { rtn map.get(key) ?: 0 }
        var idx = count
        map.put(key, idx)
        count = count + 1
        b.u1(1)
        b.u2(mutfLen(s))
        mutfWrite(b, s)
        rtn idx
    }

    // 依赖别的常量时先占位（tag + u2 0），拿到下标再回填；下标先占住，保证「下标 = 字节顺序」
    pub fn cls(name : String) -> Int {
        var key = "c:" + name
        if (map.containsKey(key)) { rtn map.get(key) ?: 0 }
        var idx = count
        map.put(key, idx)
        count = count + 1
        b.u1(7)
        var at = b.size()
        b.u2(0)
        var u = utf8(name)
        b.patchU2(at, u)
        rtn idx
    }

    pub fn stringConst(s : String) -> Int {
        var key = "s:" + s
        if (map.containsKey(key)) { rtn map.get(key) ?: 0 }
        var idx = count
        map.put(key, idx)
        count = count + 1
        b.u1(8)
        var at = b.size()
        b.u2(0)
        var u = utf8(s)
        b.patchU2(at, u)
        rtn idx
    }

    pub fn intConst(v : Int) -> Int {
        var key = "i:" + intToString(v)
        if (map.containsKey(key)) { rtn map.get(key) ?: 0 }
        var idx = count
        map.put(key, idx)
        count = count + 1
        b.u1(3)
        b.u4(v)
        rtn idx
    }

    pub fn nameType(name : String, desc : String) -> Int {
        var key = "n:" + name + "|" + desc
        if (map.containsKey(key)) { rtn map.get(key) ?: 0 }
        var idx = count
        map.put(key, idx)
        count = count + 1
        b.u1(12)
        var a1 = b.size()
        b.u2(0)
        var a2 = b.size()
        b.u2(0)
        var n = utf8(name)
        var d = utf8(desc)
        b.patchU2(a1, n)
        b.patchU2(a2, d)
        rtn idx
    }

    pub fn floatConst(v : Float) -> Int {
        var key = "f:" + Float.toString(v)
        if (map.containsKey(key)) { rtn map.get(key) ?: 0 }
        var idx = count
        map.put(key, idx)
        count = count + 1
        b.u1(4)
        b.u4(Float.floatToIntBits(v))
        rtn idx
    }

    pub fn doubleConst(v : Double) -> Int {
        var key = "d:" + Double.toString(v)
        if (map.containsKey(key)) { rtn map.get(key) ?: 0 }
        var idx = count
        map.put(key, idx)
        count = count + 2
        b.u1(6)
        var bits = Double.doubleToLongBits(v)
        b.u4(longHi(bits))
        b.u4(longLo(bits))
        rtn idx
    }

    // long / double 常量各占两个槽（tag 5 / 6）
    pub fn longConst(v : Long) -> Int {
        var key = "j:" + longKeyOf(v)
        if (map.containsKey(key)) { rtn map.get(key) ?: 0 }
        var idx = count
        map.put(key, idx)
        count = count + 2
        b.u1(5)
        b.u4(longHi(v))
        b.u4(longLo(v))
        rtn idx
    }

    prv fn refOf(tag : Int, owner : String, name : String, desc : String) -> Int {
        var key = "r:" + intToString(tag) + ":" + owner + "." + name + ":" + desc
        if (map.containsKey(key)) { rtn map.get(key) ?: 0 }
        var idx = count
        map.put(key, idx)
        count = count + 1
        b.u1(tag)
        var a1 = b.size()
        b.u2(0)
        var a2 = b.size()
        b.u2(0)
        var o = cls(owner)
        var nt = nameType(name, desc)
        b.patchU2(a1, o)
        b.patchU2(a2, nt)
        rtn idx
    }

    pub fn fieldRef(owner : String, name : String, desc : String) -> Int {
        rtn refOf(9, owner, name, desc)
    }

    pub fn methodRef(owner : String, name : String, desc : String) -> Int {
        rtn refOf(10, owner, name, desc)
    }

    pub fn imethodRef(owner : String, name : String, desc : String) -> Int {
        rtn refOf(11, owner, name, desc)
    }
}

pub class FieldInfo {
    var access : Int = 0
    var name : String = ""
    var desc : String = ""
}

pub class Method {
    var cp : Cp = new Cp()
    var access : Int = 0
    var name : String = ""
    var desc : String = ""
    var b : Buf = new Buf()
    var labels : HashMap&<Int> = new HashMap&<Int>()
    var fixAt : Int[] = new Int[16]
    var fixLabel : Int[] = new Int[16]
    var fixCount : Int = 0
    var tryStart : Int[] = new Int[8]
    var tryEnd : Int[] = new Int[8]
    var tryHandler : Int[] = new Int[8]
    var tryType : String[] = new String[8]
    var tryCount : Int = 0
    // 待解析的常量池引用：发出时先占位，finish 时统一按下标回填
    var refAt : Int[] = new Int[16]
    var refKind : String[] = new String[16]
    var refA : String[] = new String[16]
    var refB : String[] = new String[16]
    var refC : String[] = new String[16]
    var refCount : Int = 0
    var maxStack : Int = 0
    var maxLocals : Int = 0
    var maxLocalSeen : Int = 0
    var isStatic : Bool = false
    var failed : Bool = false

    // 阶段 67：调试信息。自举后端早已在每条指令前调 `visitLineNumber`、在方法尾部调
    // `visitLocalVariable`（与 Kotlin 侧 `emitBody` / `endLvt` 同构），但这里的门面一直
    // 是空实现，所以原生产物没有 LINENUMBER / LVT / SourceFile 属性。反编译要靠它们
    // 把字节码偏移映射回源码行，故在此真正落盘。
    var lineLbl : Int[] = new Int[16]
    var lineNo : Int[] = new Int[16]
    var lineCount : Int = 0
    var lvName : String[] = new String[8]
    var lvDesc : String[] = new String[8]
    var lvStart : Int[] = new Int[8]
    var lvEnd : Int[] = new Int[8]
    var lvSlot : Int[] = new Int[8]
    var lvCount : Int = 0


    prv fn growFix() -> void {
        var a : Int[] = new Int[fixAt.length * 2]
        var l : Int[] = new Int[fixAt.length * 2]
        for (var i = 0; i < fixCount; i = i + 1) {
            a[i] = fixAt[i]
            l[i] = fixLabel[i]
        }
        fixAt = a
        fixLabel = l
    }

    fn addFix(at : Int, label : Int) -> void {
        if (fixCount >= fixAt.length) { growFix() }
        fixAt[fixCount] = at
        fixLabel[fixCount] = label
        fixCount = fixCount + 1
    }

    prv fn growRefs() -> void {
        var n = refAt.length * 2
        var p1 : Int[] = new Int[n]
        var p2 : String[] = new String[n]
        var p3 : String[] = new String[n]
        var p4 : String[] = new String[n]
        var p5 : String[] = new String[n]
        for (var i = 0; i < refCount; i = i + 1) {
            p1[i] = refAt[i]
            p2[i] = refKind[i]
            p3[i] = refA[i]
            p4[i] = refB[i]
            p5[i] = refC[i]
        }
        refAt = p1
        refKind = p2
        refA = p3
        refB = p4
        refC = p5
    }

    fn addRef(at : Int, kind : String, a : String, b : String, c : String) -> void {
        if (refCount >= refAt.length) { growRefs() }
        refAt[refCount] = at
        refKind[refCount] = kind
        refA[refCount] = a
        refB[refCount] = b
        refC[refCount] = c
        refCount = refCount + 1
    }

    prv fn growLines() -> void {
        var a : Int[] = new Int[lineLbl.length * 2]
        var n : Int[] = new Int[lineLbl.length * 2]
        for (var i = 0; i < lineCount; i = i + 1) {
            a[i] = lineLbl[i]
            n[i] = lineNo[i]
        }
        lineLbl = a
        lineNo = n
    }

    prv fn growLocalVars() -> void {
        var cap = lvStart.length * 2
        var n : String[] = new String[cap]
        var d : String[] = new String[cap]
        var s : Int[] = new Int[cap]
        var e : Int[] = new Int[cap]
        var k : Int[] = new Int[cap]
        for (var i = 0; i < lvCount; i = i + 1) {
            n[i] = lvName[i]
            d[i] = lvDesc[i]
            s[i] = lvStart[i]
            e[i] = lvEnd[i]
            k[i] = lvSlot[i]
        }
        lvName = n
        lvDesc = d
        lvStart = s
        lvEnd = e
        lvSlot = k
    }

    // 行号表条目：`line` 在标签 `lid` 之后生效（ASM 的 (line, Label) 语义）
    pub fn visitLineNumber(line : Int, lid : Int) -> void {
        if (lineCount >= lineLbl.length) { growLines() }
        lineLbl[lineCount] = lid
        lineNo[lineCount] = line
        lineCount = lineCount + 1
    }

    pub fn visitLocalVariable(nm : String, dsc : String, sig : ?String, start : Int, end : Int, slot : Int) -> void {
        if (lvCount >= lvStart.length) { growLocalVars() }
        lvName[lvCount] = nm
        lvDesc[lvCount] = dsc
        lvStart[lvCount] = start
        lvEnd[lvCount] = end
        lvSlot[lvCount] = slot
        lvCount = lvCount + 1
    }

    // 落盘前先数一遍能解析的条目：标签可能从未 visit（ASM 会抛，这里选择丢弃该条），
    // 而 Code 属性长度必须提前写，所以要先知道条目数。
    pub fn lineTableCount() -> Int {
        var n = 0
        var i = 0
        while (i < lineCount) {
            if (labelAt(lineLbl[i]) >= 0) { n = n + 1 }
            i = i + 1
        }
        rtn n
    }

    pub fn localVarTableCount() -> Int {
        var n = 0
        var i = 0
        while (i < lvCount) {
            var st = labelAt(lvStart[i])
            var en = labelAt(lvEnd[i])
            if (st >= 0 && en > st) { n = n + 1 }
            i = i + 1
        }
        rtn n
    }

    pub fn label(id : Int) -> void {
        labels.put(intToString(id), b.size())
    }

    pub fn visitCode() -> void { }

    pub fn visitEnd() -> void { }

    pub fn insn(op : Int) -> void { b.u1(op) }

    pub fn varInsn(op : Int, slot : Int) -> void {
        // 与 ASM 一致：0..3 号槽用紧凑形式（aload_0 之类），字节更短
        if (slot <= 3) {
            var d = 0
            if (op == 21 || op == 54) { d = 5 }
            if (op == 22 || op == 55) { d = 8 }
            if (op == 23 || op == 56) { d = 11 }
            if (op == 24 || op == 57) { d = 14 }
            if (op == 25 || op == 58) { d = 17 }
            if (d > 0) {
                b.u1(op + d + slot)
                if (slot + 1 > maxLocalSeen) { maxLocalSeen = slot + 1 }
                rtn
            }
        }
        var wide = op == 22 || op == 23 || op == 24 || op == 55 || op == 56 || op == 57
        var top = slot + 1
        if (wide) { top = slot + 2 }
        if (top > maxLocalSeen) { maxLocalSeen = top }
        if (slot > 255) {
            b.u1(196)
            b.u1(op)
            b.u2(slot)
        } else {
            b.u1(op)
            b.u1(slot)
        }
    }

    pub fn typeInsn(op : Int, t : String) -> void {
        b.u1(op)
        var at = b.size()
        b.u2(0)
        addRef(at, "class", t, "", "")
    }

    pub fn fieldInsn(op : Int, owner : String, name : String, desc : String) -> void {
        b.u1(op)
        var at = b.size()
        b.u2(0)
        addRef(at, "field", owner, name, desc)
    }

    pub fn methodInsn(op : Int, owner : String, name : String, desc : String) -> void {
        b.u1(op)
        var at = b.size()
        b.u2(0)
        addRef(at, "method", owner, name, desc)
    }

    pub fn ifaceMethodInsn(op : Int, owner : String, name : String, desc : String) -> void {
        b.u1(op)
        var at = b.size()
        b.u2(0)
        addRef(at, "iface", owner, name, desc)
    }

    // 16 位跳转：操作数在 addFix 记录的位置回填
    pub fn jump(op : Int, labelId : Int) -> void {
        b.u1(op)
        addFix(b.size(), labelId)
        b.u2(0)
    }

    // ldc / ldc_w 与 ASM 同一套选择：下标 <= 255 用 2 字节 ldc，否则 ldc_w
    pub fn ldcInt(v : Int) -> void {
        var idx = cp.intConst(v)
        if (idx <= 255) {
            b.u1(18)
            b.u1(idx)
        } else {
            b.u1(19)
            b.u2(idx)
        }
    }

    pub fn ldcString(s : String) -> void {
        var idx = cp.stringConst(s)
        if (idx <= 255) {
            b.u1(18)
            b.u1(idx)
        } else {
            b.u1(19)
            b.u2(idx)
        }
    }

    pub fn iinc(slot : Int, delta : Int) -> void {
        b.u1(132)
        b.u1(slot)
        b.u1(delta)
    }

    // 带 isInterface 的方法调用（ASM 风格 5 参）
    pub fn methodInsn5(op : Int, owner : String, name : String, desc : String, isIface : Bool) -> void {
        if (isIface) {
            ifaceMethodInsn(op, owner, name, desc)
            rtn
        }
        methodInsn(op, owner, name, desc)
    }

    // bipush(16) / sipush(17) / newarray(188)
    pub fn intInsn(op : Int, operand : Int) -> void {
        b.u1(op)
        if (op == 17) {
            b.u2(operand)
        } else {
            b.u1(operand)
        }
    }

    pub fn ldcLong(v : Long) -> void {
        b.u1(20)
        b.u2(cp.longConst(v))
    }

    // float / double 常量：暂不支持（要用 IEEE 位模式，三种执行后端都得有 bit-cast）
    pub fn ldcFloat(v : Float) -> void {
        var idx = cp.floatConst(v)
        if (idx <= 255) {
            b.u1(18)
            b.u1(idx)
        } else {
            b.u1(19)
            b.u2(idx)
        }
    }

    pub fn ldcDouble(v : Double) -> void {
        b.u1(20)
        b.u2(cp.doubleConst(v))
    }

    // 类常量（`Type` 那种）：CONSTANT_Class
    pub fn ldcClass(n : String) -> void {
        var idx = cp.cls(n)
        if (idx <= 255) {
            b.u1(18)
            b.u1(idx)
        } else {
            b.u1(19)
            b.u2(idx)
        }
    }

    // multianewarray：类引用 + 维度
    pub fn multiANewArray(d : String, dims : Int) -> void {
        b.u1(197)
        var at = b.size()
        b.u2(0)
        b.u1(dims)
        addRef(at, "class", d, "", "")
    }

    // 描述符里的参数占用槽数（long/double 各两个）
    pub fn argSlots() -> Int {
        var n = 0
        var i = 0
        var stop = false
        while (i < desc.length() && !stop) {
            var c = desc.charAt(i)
            if (c == ')') { stop = true }
            if (c == 'J' || c == 'D') { n = n + 2 } else {
                if (c != '(' && c != ')') { n = n + 1 }
            }
            i = i + 1
        }
        if (!isStatic) { n = n + 1 }
        rtn n
    }

    pub fn maxs(stack : Int, locals : Int) -> void {
        if (stack > 0) { maxStack = stack }
        if (locals > 0) { maxLocals = locals }
    }

    pub fn tryCatch(start : Int, end : Int, handler : Int, t : String) -> void {
        if (tryCount >= tryStart.length) {
            var a : Int[] = new Int[tryStart.length * 2]
            var e : Int[] = new Int[tryStart.length * 2]
            var h : Int[] = new Int[tryStart.length * 2]
            var s : String[] = new String[tryStart.length * 2]
            for (var i = 0; i < tryCount; i = i + 1) {
                a[i] = tryStart[i]
                e[i] = tryEnd[i]
                h[i] = tryHandler[i]
                s[i] = tryType[i]
            }
            tryStart = a
            tryEnd = e
            tryHandler = h
            tryType = s
        }
        tryStart[tryCount] = start
        tryEnd[tryCount] = end
        tryHandler[tryCount] = handler
        tryType[tryCount] = t
        tryCount = tryCount + 1
    }

    pub fn labelAt(id : Int) -> Int {
        if (!labels.containsKey(intToString(id))) { rtn -1 }
        rtn labels.get(intToString(id)) ?: -1
    }

    prv fn resolveRefs() -> void {
        for (var i = 0; i < refCount; i = i + 1) {
            var k = refKind[i]
            var idx = 0
            if (k == "class") {
                idx = cp.cls(refA[i])
            } else if (k == "field") {
                idx = cp.fieldRef(refA[i], refB[i], refC[i])
            } else if (k == "method") {
                idx = cp.methodRef(refA[i], refB[i], refC[i])
            } else if (k == "iface") {
                idx = cp.imethodRef(refA[i], refB[i], refC[i])
            } else if (k == "int") {
                idx = cp.intConst(decInt(refA[i]))
            } else if (k == "long") {
                idx = cp.longConst(decLong(refA[i]))
            } else {
                idx = cp.stringConst(refA[i])
            }
            b.patchU2(refAt[i], idx)
        }
    }

    pub fn finish() -> void {
        resolveRefs()
        for (var i = 0; i < fixCount; i = i + 1) {
            var target = labelAt(fixLabel[i])
            var opAt = fixAt[i] - 1
            if (target < 0) {
                failed = true
                rtn
            }
            var delta = target - opAt
            if (delta < -32768 || delta > 32767) {
                failed = true
                rtn
            }
            b.patchU2(fixAt[i], delta)
        }
    }
}

pub class ClassWriter {
    var access : Int = 1
    var name : String = ""
    var superName : String = "java/lang/Object"
    // 阶段 67：SourceFile 属性。Kotlin 侧 `cw.visitSource(sourceName, null)` 一直有，
    // 这里此前是空实现，产物因此丢掉「这个类来自哪个 .rsf 文件」。
    var sourceFile : String = ""
    // 阶段 72：Signature 属性（泛型签名）。枚举的父类要写成
    // `Ljava/lang/Enum<Lpkg/Color;>;`，Java 侧才认得出 `Enum<Color>`；Kotlin 侧走
    // ASM 的 `cw.visit(..., signature, ...)`，这里以前也是空实现。
    var signature : String = ""
    var cp : Cp = new Cp()
    var methods : Method[] = new Method[8]
    var methodCount : Int = 0
    var fields : FieldInfo[] = new FieldInfo[8]
    var fieldCount : Int = 0
    var interfaces : String[] = new String[8]
    var interfaceCount : Int = 0

    constructor(n : String, s : String) {
        name = n
        superName = s
    }

    pub fn visitSource(s : String, d : ?String) -> void { sourceFile = s }

    pub fn visitMethod(a : Int, mn : String, md : String) -> Method {
        var m = new Method()
        m.cp = cp
        m.access = a
        m.name = mn
        m.desc = md
        m.isStatic = (a / 8) % 2 == 1
        if (methodCount >= methods.length) {
            var arr : Method[] = new Method[methods.length * 2]
            for (var i = 0; i < methodCount; i = i + 1) { arr[i] = methods[i] }
            methods = arr
        }
        methods[methodCount] = m
        methodCount = methodCount + 1
        rtn m
    }

    pub fn addInterface(n : String) -> void {
        if (interfaceCount >= interfaces.length) {
            var arr : String[] = new String[interfaces.length * 2]
            for (var i = 0; i < interfaceCount; i = i + 1) { arr[i] = interfaces[i] }
            interfaces = arr
        }
        interfaces[interfaceCount] = n
        interfaceCount = interfaceCount + 1
    }

    pub fn visitField(a : Int, fname : String, fdesc : String) -> void {
        var f = new FieldInfo()
        f.access = a
        f.name = fname
        f.desc = fdesc
        if (fieldCount >= fields.length) {
            var arr : FieldInfo[] = new FieldInfo[fields.length * 2]
            for (var i = 0; i < fieldCount; i = i + 1) { arr[i] = fields[i] }
            fields = arr
        }
        fields[fieldCount] = f
        fieldCount = fieldCount + 1
    }

    // 产出 class 文件字节；跳转没落点/超范围时返回 null
    pub fn toBytes() -> Buf {
        cp.cls(name)
        cp.cls(superName)
        if (sourceFile != "") {
            cp.utf8("SourceFile")
            cp.utf8(sourceFile)
        }
        if (signature != "") {
            cp.utf8("Signature")
            cp.utf8(signature)
        }
        for (var fi = 0; fi < fieldCount; fi = fi + 1) {
            cp.utf8(fields[fi].name)
            cp.utf8(fields[fi].desc)
        }
        for (var mi = 0; mi < methodCount; mi = mi + 1) {
            var m = methods[mi]
            cp.utf8(m.name)
            cp.utf8(m.desc)
            cp.utf8("Code")
            for (var ti = 0; ti < m.tryCount; ti = ti + 1) {
                if (m.tryType[ti] != "") { cp.cls(m.tryType[ti]) }
            }
            // Code 属性里的子属性名 / LVT 的变量名与描述符都必须在 `cp.count` 写出前登记
            if (m.lineTableCount() > 0) { cp.utf8("LineNumberTable") }
            if (m.localVarTableCount() > 0) {
                cp.utf8("LocalVariableTable")
                for (var li = 0; li < m.lvCount; li = li + 1) {
                    cp.utf8(m.lvName[li])
                    cp.utf8(m.lvDesc[li])
                }
            }
            m.finish()
            if (m.failed) { rtn new Buf() }
        }

        var out = new Buf()
        out.u4(0 - 889275714)
        out.u2(0)
        out.u2(49)
        out.u2(cp.count)
        out.raw(cp.b.data, cp.b.size())
        out.u2(access)
        out.u2(cp.cls(name))
        out.u2(cp.cls(superName))
        out.u2(interfaceCount)
        for (var ii = 0; ii < interfaceCount; ii = ii + 1) {
            out.u2(cp.cls(interfaces[ii]))
        }
        out.u2(fieldCount)
        for (var fi = 0; fi < fieldCount; fi = fi + 1) {
            var f = fields[fi]
            out.u2(f.access)
            out.u2(cp.utf8(f.name))
            out.u2(cp.utf8(f.desc))
            out.u2(0)
        }
        out.u2(methodCount)
        for (var mi = 0; mi < methodCount; mi = mi + 1) {
            var m = methods[mi]
            out.u2(m.access)
            out.u2(cp.utf8(m.name))
            out.u2(cp.utf8(m.desc))
            out.u2(1)
            out.u2(cp.utf8("Code"))
            var codeLen = m.b.size()
            var lnCnt = m.lineTableCount()
            var lvCnt = m.localVarTableCount()
            var attrBytes = 0
            if (lnCnt > 0) { attrBytes = attrBytes + 8 + 4 * lnCnt }
            if (lvCnt > 0) { attrBytes = attrBytes + 8 + 10 * lvCnt }
            out.u4(12 + codeLen + 8 * m.tryCount + attrBytes)
            var wantLocals = m.maxLocalSeen
            var argn = m.argSlots()
            if (argn > wantLocals) { wantLocals = argn }
            if (m.maxLocals > wantLocals) { wantLocals = m.maxLocals }
            var wantStack = m.maxStack
            if (wantStack <= 0) { wantStack = 128 }
            out.u2(wantStack)
            out.u2(wantLocals)
            out.u4(codeLen)
            out.raw(m.b.data, codeLen)
            out.u2(m.tryCount)
            for (var ti = 0; ti < m.tryCount; ti = ti + 1) {
                out.u2(m.labelAt(m.tryStart[ti]))
                out.u2(m.labelAt(m.tryEnd[ti]))
                out.u2(m.labelAt(m.tryHandler[ti]))
                if (m.tryType[ti] == "") {
                    out.u2(0)
                } else {
                    out.u2(cp.cls(m.tryType[ti]))
                }
            }
            // Code 属性自己的 attributes_count：先 LineNumberTable，再 LocalVariableTable
            // （与 ASM 的输出顺序一致）
            var codeAttrs = 0
            if (lnCnt > 0) { codeAttrs = codeAttrs + 1 }
            if (lvCnt > 0) { codeAttrs = codeAttrs + 1 }
            out.u2(codeAttrs)
            if (lnCnt > 0) {
                out.u2(cp.utf8("LineNumberTable"))
                out.u4(2 + 4 * lnCnt)
                out.u2(lnCnt)
                var lx = 0
                while (lx < m.lineCount) {
                    var pc = m.labelAt(m.lineLbl[lx])
                    if (pc >= 0) {
                        out.u2(pc)
                        out.u2(m.lineNo[lx])
                    }
                    lx = lx + 1
                }
            }
            if (lvCnt > 0) {
                out.u2(cp.utf8("LocalVariableTable"))
                out.u4(2 + 10 * lvCnt)
                out.u2(lvCnt)
                var vx = 0
                while (vx < m.lvCount) {
                    var st = m.labelAt(m.lvStart[vx])
                    var en = m.labelAt(m.lvEnd[vx])
                    if (st >= 0 && en > st) {
                        out.u2(st)
                        out.u2(en - st)
                        out.u2(cp.utf8(m.lvName[vx]))
                        out.u2(cp.utf8(m.lvDesc[vx]))
                        out.u2(m.lvSlot[vx])
                    }
                    vx = vx + 1
                }
            }
        }
        // 类属性：Signature 在前、SourceFile 在后（与 ASM 的写出顺序一致，
        // 这样 stage1 与 Kotlin 侧的类在 javap -v 里也是同一个顺序）。
        var attrCount = 0
        if (signature != "") { attrCount = attrCount + 1 }
        if (sourceFile != "") { attrCount = attrCount + 1 }
        out.u2(attrCount)
        if (signature != "") {
            out.u2(cp.utf8("Signature"))
            out.u4(2)
            out.u2(cp.utf8(signature))
        }
        if (sourceFile != "") {
            out.u2(cp.utf8("SourceFile"))
            out.u4(2)
            out.u2(cp.utf8(sourceFile))
        }
        rtn out
    }
}

// ============================================================ ASM 风格门面
//
// 自举后端（`rsfSrc/bootstrap/Backend.rsf`）的源码里全是 `cw.visitMethod(...)`、
// `mv.visitVarInsn(...)` 这类 ASM 调用。要让「C 后端编它自己」成立，就得把这些对象
// 换成 rsf 自己实现的版本。门面**类名改短**（Cw/Mv/Lb/Fv/Av）避免与 Java ASM 撞名，
// 方法名与实参个数保持与 ASM 一致，这样 Backend.rsf 只需要改类型名和少数调用点。

pub class Lb {
    var id : Int = 0
    constructor() {}
}

pub class Av {
    constructor() {}
    // 注解属性暂不落盘（64e-3 的已知缺口），这里只要让调用点能编过、链式能走通
    pub fn visit(k : ?String, v : String) -> void { }
    pub fn visitStr(k : ?String, v : String) -> void { }
    pub fn visitInt(k : ?String, v : Int) -> void { }
    pub fn visitLong(k : ?String, v : Long) -> void { }
    pub fn visitFloat(k : ?String, v : Float) -> void { }
    pub fn visitDouble(k : ?String, v : Double) -> void { }
    pub fn visitBool(k : ?String, v : Bool) -> void { }
    pub fn visitByte(k : ?String, v : Byte) -> void { }
    pub fn visitChar(k : ?String, v : Char) -> void { }
    pub fn visitEnum(k : ?String, d : String, v : String) -> void { }
    pub fn visitArray(k : ?String) -> Av { rtn new Av() }
    pub fn visitEnd() -> void { }
}

pub class Fv {
    constructor() {}
    pub fn visitEnd() -> void { }
    pub fn visitAnnotation(d : String, visible : Bool) -> Av { rtn new Av() }
}

pub class Mv {
    var m : Method = new Method()
    var nextLabel : Int = 1

    constructor(mm : Method) { m = mm }

    fn labelId(l : Lb) -> Int {
        if (l.id == 0) {
            l.id = nextLabel
            nextLabel = nextLabel + 1
        }
        rtn l.id
    }

    pub fn visitCode() -> void { }
    pub fn visitEnd() -> void { }
    pub fn visitInsn(op : Int) -> void { m.insn(op) }
    pub fn visitIntInsn(op : Int, operand : Int) -> void { m.intInsn(op, operand) }
    pub fn visitVarInsn(op : Int, slot : Int) -> void { m.varInsn(op, slot) }
    pub fn visitTypeInsn(op : Int, t : String) -> void { m.typeInsn(op, t) }
    pub fn visitFieldInsn(op : Int, o : String, n : String, d : String) -> void { m.fieldInsn(op, o, n, d) }
    pub fn visitMethodInsn(op : Int, o : String, n : String, d : String, iface : Bool) -> void {
        m.methodInsn5(op, o, n, d, iface)
    }
    pub fn visitJumpInsn(op : Int, l : Lb) -> void { m.jump(op, labelId(l)) }
    pub fn visitLabel(l : Lb) -> void { m.label(labelId(l)) }
    pub fn visitLdcInt(v : Int) -> void { m.ldcInt(v) }
    pub fn visitLdcLong(v : Long) -> void { m.ldcLong(v) }
    pub fn visitLdcFloat(v : Float) -> void { m.ldcFloat(v) }
    pub fn visitLdcDouble(v : Double) -> void { m.ldcDouble(v) }
    pub fn visitLdcString(s : String) -> void { m.ldcString(s) }
    pub fn visitLdcClass(n : String) -> void { m.ldcClass(n) }
    pub fn visitMaxs(a : Int, b : Int) -> void { m.maxs(a, b) }
    pub fn visitTryCatchBlock(a : Lb, b : Lb, c : Lb, t : ?String) -> void {
        if (t == null) {
            m.tryCatch(labelId(a), labelId(b), labelId(c), "")
        } else {
            m.tryCatch(labelId(a), labelId(b), labelId(c), t!!)
        }
    }
    // 行号表 / 局部变量表（阶段 67 起真正落盘，见 Method.visitLineNumber / visitLocalVariable）
    pub fn visitLineNumber(line : Int, l : Lb) -> void { m.visitLineNumber(line, labelId(l)) }
    pub fn visitLocalVariable(a : String, b : String, c : ?String, d : Lb, e : Lb, f : Int) -> void {
        m.visitLocalVariable(a, b, c, labelId(d), labelId(e), f)
    }
    pub fn visitMultiANewArrayInsn(d : String, dims : Int) -> void { m.multiANewArray(d, dims) }
    pub fn visitAnnotation(d : String, visible : Bool) -> Av { rtn new Av() }
    pub fn visitAnnotationDefault() -> Av { rtn new Av() }
}

fn byteOf(v : Int) -> Byte {
    var x = v % 256
    if (x < 0) { x = x + 256 }
    if (x > 127) { x = x - 256 }
    rtn toByte(x)
}

fn bytesOf(b : Buf) -> Byte[] {
    var out : Byte[] = new Byte[b.size()]
    var i = 0
    while (i < b.size()) {
        out[i] = byteOf(b.data[i])
        i = i + 1
    }
    rtn out
}

pub class Cw {
    var w : ClassWriter = new ClassWriter("", "java/lang/Object")

    constructor(flags : Int) { }

    pub fn visit(ver : Int, acc : Int, nm : String, sig : ?String, sup : String, ifaces : String[]) -> void {
        w.name = nm
        w.access = acc
        w.superName = sup
        if (sig != null) { w.signature = sig!! }
        var i = 0
        while (i < ifaces.length) {
            w.addInterface(ifaces[i])
            i = i + 1
        }
    }

    pub fn visitMethod(a : Int, nm : String, d : String, sig : ?String, ex : ?String) -> Mv {
        rtn new Mv(w.visitMethod(a, nm, d))
    }

    pub fn visitField(a : Int, nm : String, d : String, sig : ?String, value : ?String) -> Fv {
        w.visitField(a, nm, d)
        rtn new Fv()
    }

    pub fn visitSource(s : String, d : ?String) -> void { w.visitSource(s, d) }
    pub fn visitAnnotation(d : String, visible : Bool) -> Av { rtn new Av() }
    pub fn visitEnd() -> void { }
    pub fn toByteArray() -> Byte[] { rtn bytesOf(w.toBytes()) }
}
