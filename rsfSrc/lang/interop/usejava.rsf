// rsf 调用 Java —— 三种来源的 import 里，点分路径那种就是干这个的
//
//   import java.lang.Math     // 显式导入
//   Math.max(...)             // 静态方法
//   Math.PI                   // 静态字段
//   System.out.println(...)   // 静态字段 + 实例方法（链式）
//   s.length()                // 实例方法
//
// java.lang 下的类（Math / Integer / String / System）和 Java 一样可以省掉 import。

import java.lang.Math
import java.lang.Integer

fun main() -> void {
    // ---- 静态方法：按实参类型选重载 ----
    println("Math.max(3, 7) = " + Math.max(3, 7))
    println("Math.max(1.5, 2.5) = " + Math.max(1.5, 2.5))
    println("Math.abs(-5) = " + Math.abs(-5))
    println("Math.sqrt(2.0) = " + Math.sqrt(2.0))

    // ---- 静态字段 ----
    println("Math.PI = " + Math.PI)

    // ---- 静态字段 + 实例方法链 ----
    System.out.println("这条是 Java 的 System.out 打的")

    // ---- 字符串上的实例方法（String.length / substring / contains 都是 JVM 方法）----
    var s = "rainStarfox"
    println("s.length() = " + s.length())
    println("s.toUpperCase() = " + s.toUpperCase())
    println("s.substring(0, 4) = " + s.substring(0, 4))
    println("s.contains(\"Star\") = " + s.contains("Star"))

    // ---- 静态工厂 + 实例方法 ----
    var n = Integer.parseInt("42")
    println("Integer.parseInt(\"42\") = " + n)
    println("Integer.toHexString(255) = " + Integer.toHexString(255))
    println("String.valueOf(3.5) = " + String.valueOf(3.5))

    rtn
}
