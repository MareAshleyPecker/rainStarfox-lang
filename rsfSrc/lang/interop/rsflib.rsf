// 反向：让 Java 调用 rsf。
//
// rsf 的顶层函数（不写访问控制就是 public）会被编译成普通的 public static 方法，所以 Java 侧
// 只要类名对得上就能直接调——不需要任何胶水代码。
//
//   rsf build lang/interop/rsflib.rsf -o out
//   javac -d out -cp out lang/interop/UseRsf.java
//   java -cp out UseRsf

fn greet(who : string) -> string {
    rtn "hello from rsf, " + who
}

fn fact(n : int) -> int {
    if (n <= 1) { rtn 1 }
    rtn n * fact(n - 1)
}

// 可空返回类型在 Java 侧就是一个可能为 null 的引用
fn maybe(n : int) : ?string {
    if (n > 0) { rtn "positive" }
    rtn null
}

fn main() -> void { rtn }
