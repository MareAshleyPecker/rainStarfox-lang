// rainStarfox 阶段 16b 示例：文件读写（readText / writeText / readBytes / writeBytes）
//
// 这四个函数都是 `!T`（可能失败），调用方**必须**显式处理错误。四种写法这个示例都演示了：
//   (a) f(...) ?: 兜底值                        失败就取右边的值
//   (b) f(...) ?: 兜底()                       只要「出错时做点什么」——兜底写成 -> void 的函数，
//                                              消息从 lastErrorMessage() 取，值丢掉
//   (c) try f(...)                             在 !T 函数里原样往上抛（返回 void 的用它）
//   (d) f(...)!!                               往上抛（返回值的用它；本函数也得写成 !T）
//
// 跑：rsf run   rsfSrc/lang/files.rsf      （解释器）
//     rsf build rsfSrc/lang/files.rsf      （字节码：生成 files.class + TempFile.class）
//     java -cp out files
// 查：rsf check rsfSrc/lang/files.rsf
//
// **这个示例只在系统临时目录里读写，跑完把文件删掉**——不给仓库留任何垃圾文件。
// 路径由 `java.io.File(临时目录, 名字)` 拼出来，所以 Windows / Linux 都不用管分隔符。

import java.io.File

// ---------------------------------------------------------------- 临时文件

// 一个临时文件对象：负责拼路径、以及跑完把它删掉。
// （rsf 没有内置的「删文件」，删除走 java.io.File 的实例方法，和读写一样是 JVM 互操作）
class TempFile(name : String) {
    var file : File = new File(System.getProperty("java.io.tmpdir"), "rsf-16b-" + name)

    fn path() -> String {
        rtn file.getAbsolutePath()
    }

    fn label() -> String {
        rtn file.getName()
    }

    // 删除是**尽力而为**：删不掉不报错（临时目录本来就由系统回收）
    fn cleanup() -> void {
        if (file.delete()) {
            println("  （临时文件已删除: " + label() + "）")
        } else {
            println("  （临时文件没能删掉，留给系统回收: " + label() + "）")
        }
    }
}

// ---------------------------------------------------------------- 包一层 !T

// 四个文件函数自己是 !T，这里再包一层是为了演示「!T 函数自己内部也要处理错误」。
// 有返回值的用 `!!` 往上抛；返回 void 的没有值可以断言，用 `try` 原样往上抛
// （`!void` 上不能写 `!!`——没有值可以取）。

fn saveText(path : String, text : String) -> !void {
    try writeText(path, text)
}

fn loadText(path : String) -> !String {
    rtn readText(path)!!
}

fn saveBytes(path : String, data : Byte[]) -> !void {
    try writeBytes(path, data)
}

fn loadBytes(path : String) -> !Byte[] {
    rtn readBytes(path)!!
}

// ---------------------------------------------------------------- 小工具

// Byte -> 两位十六进制（Byte 是**有符号**的，负的要先加回 256）
fn hexDigit(n : Int) -> String {
    if (n < 10) { rtn intToString(n) }
    rtn "abcdef".substring(n - 10, n - 9)
}

fn byteHex(b : Byte) -> String {
    var n : Int = b                 // Byte 隐式加宽成 Int
    if (n < 0) { n = n + 256 }
    rtn hexDigit(n / 16) + hexDigit(n % 16)
}

fn bytesToHex(data : Byte[]) -> String {
    var out = ""
    for (i in 0..data.length - 1) {
        out = out + byteHex(data[i])
    }
    rtn out
}

// ---------------------------------------------------------------- 兜底函数

// 多语句块抽出来的 !T 函数：文本读写一来一回
fn textRoundTrip(path : String, label : String) -> !void {
    var content = "hello, rainStarfox!\n第二行（UTF-8）\n"
    try saveText(path, content)
    println("写进 " + label + " 的字符数 = " + content.length())

    var back = loadText(path)!!
    println("读回来的字符数 = " + back.length())
    println("第一行 = " + back.substring(0, 19))
    println("和写进去的一模一样 = " + (back == content))
}

fn binRoundTrip(path : String) -> !void {
    var raw : Byte[] = new Byte[6]
    raw[0] = toByte(82)      // 'R'
    raw[1] = toByte(115)     // 's'
    raw[2] = toByte(102)     // 'f'
    raw[3] = toByte(0)
    raw[4] = toByte(200)     // 有符号 Byte 的负数：读回来是 -56
    raw[5] = toByte(255)     // 截断成 -1
    println("要写的字节 = " + bytesToHex(raw))

    try saveBytes(path, raw)
    var back : Byte[] = loadBytes(path)!!
    println("读回来的字节数 = " + back.length)
    println("读回来的字节 = " + bytesToHex(back))
    println("第 5 个字节（有符号）= " + back[4])
}

// 出错时打印一句话就够的兜底（-> void）：成功路径的值被丢掉
fn reportIo(prefix : String) -> void {
    println(prefix + lastErrorMessage())
}

fn reportWriteFailure() -> void {
    var e = lastErrorMessage()
    println("接住了写失败：消息以 '" + e.substring(0, 9) + "' 开头，长度 " + e.length())
}

// ---------------------------------------------------------------- 入口

fn main() -> void {
    var text = new TempFile("demo.txt")
    var bin = new TempFile("demo.bin")
    var missing = new TempFile("no-such-file.txt")

    // ---- (a) 写文本 + 读回来：多语句的「出错就整段跳过」抽成一个 !T 函数 ----
    println("== 文本：writeText / readText ==")
    textRoundTrip(text.path(), text.label()) ?: reportIo("文本读写失败: ")
    text.cleanup()

    // ---- 写二进制 + 读回来 ----
    println()
    println("== 二进制：writeBytes / readBytes ==")
    binRoundTrip(bin.path()) ?: reportIo("二进制读写失败: ")
    bin.cleanup()

    // ---- (b) 读一个不存在的文件：?: 给兜底值 ----
    println()
    println("== 失败处理之一：?: 兜底 ==")
    var fallback = loadText(missing.path()) ?: "(读不到，用了兜底值)"
    println("loadText(不存在的文件) ?: -> " + fallback)

    // ---- (c) 同一次失败：?: 取到错误消息本身 ----
    // 左边失败时右边就求值成「刚才那条消息」，于是不需要 catch 绑定也能用消息。
    println()
    println("== 失败处理之二：?: 取错误消息 ==")
    var msg = loadText(missing.path()) ?: lastErrorMessage()
    // 消息形如： readText: 文件操作失败 '<绝对路径>'：<绝对路径>
    // 绝对路径每次跑都不一样（里面有临时目录），所以这里只打印固定那几段，
    // 免得示例的输出随机器变。
    println("接住了：消息以 '" + msg.substring(0, 8) + "' 开头，长度 " + msg.length())
    println("消息里有 '文件操作失败' 吗 = " + msg.contains("文件操作失败"))

    // ---- 写到一个不可能成功的路径：`!void` 的 ?: 兜底 ----
    println()
    println("== 失败处理之三：!void 的 ?: 兜底 ==")
    var dir : String = System.getProperty("java.io.tmpdir")
    saveText(dir + "/rsf-16b-不存在的目录/x.txt", "x") ?: reportWriteFailure()

    rtn
}
