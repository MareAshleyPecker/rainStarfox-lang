// rainStarfox 阶段 14 示例：错误返回 `!T` 与它的四种处理方式
//
// 跑：rsf run   rsfSrc/lang/errors.rsf          （解释器，不落地任何 .class）
//     rsf build rsfSrc/lang/errors.rsf          （字节码：生成 errors.class）
//     java -cp out errors
// 查：rsf check rsfSrc/lang/errors.rsf
//
// 约定（三个后端的可观察行为完全一致，有测试守着）：
//   * 返回子句前面加 `!`：`fn f(...) -> !Int` 表示「可能失败」。正常路径返回的
//     就是 Int，出错时走**异常**这条路（JVM 上就是 RuntimeException）——所以
//     `!T` 在字节码里和 `T` 是同一个描述符，不新造类型、也不装箱。
//   * 调用 `!T` 函数必须显式处理错误，四种写法任选：
//       (a) f(...) ?: 兜底值        出错就取右边的值
//       (b) f(...) ?: 兜底()        只要「出错时做点什么」：兜底写成 -> void 的函数，
//                                  值丢掉，消息从 lastErrorMessage() 取
//       (c) f(...)!!                往上抛：本函数也得是 !T（有返回值的用它）
//       (d) try f(...)              在 !T 函数里原样往上抛（!void 只能这么抛）
//   * `fail "消息"` 只能写在 !T 函数里，或者 `?:` 的兜底里。
//   * `lastErrorMessage()` 是「最近一条错误消息」：被 `?:` 接住之后仍然保留，
//     所以兜底函数里读到的就是刚才那条。
//
// 旧表面 `try { ... } catch (e : String) { ... }` 正在退休（阶段 84 拍板）：
// 错误处理用上面四种写法就够了，不再需要 catch 绑定。它现在只剩**自举编译器自己的源码**
// 还在用（那些 try 兼着 catch 控制流信号，得先重构）；示例与标准库已经全迁完了。
// **运行期故障**（数组越界、`!!` 打到 null、除零）不是 `!T` 调用、接不住——
// 三端一律中止程序并打一条清晰的错误消息，消息格式见 `rsfSrc/lang/arrays.rsf` 开头。

// ---------------------------------------------------------------- 可能失败的函数

// 注意名字：阶段 16 起 `parseInt` 已经是内置函数了（`parseInt(String) -> !Int`），
// 内置函数名不允许被用户函数占用，所以这里用另一个名字自己写一个 !T 函数。
fn readNumber(s : String) -> !Int {
    if (s.length() == 0) {
        fail "空字符串没法转数字"
    }
    rtn 42
}

fn lookup(id : Int) -> !String {
    if (id < 0) {
        fail "编号不能是负数：" + id      // 消息可以拼出来，不限于字面量
    }
    rtn "第 " + id + " 号"
}

// (c) 用 `!!` 把 lookup 的错误往上抛 —— 所以 describe 自己也必须是 !T
fn describe(id : Int) -> !String {
    rtn "查询结果：" + lookup(id)!!
}

// `!void`：不带值的 rtn 也只允许出现在这里
fn check(n : Int) -> !void {
    if (n < 0) {
        fail "check 只接受非负数，实际是 " + n
    }
    println("check 通过：" + n)
    rtn
}

// ---------------------------------------------------------------- 兜底函数
//
// 兜底函数有两个常见形状，看你要不要成功路径上的值：
//   * -> void：只想「出错时干点什么」，值丢掉（(b) 写法）
//   * 与左边同类型：既要值、又要出错时干点什么，成功路径照常返回那个值

// 只打印、不要值的兜底
fn reportText(prefix : String) -> void {
    println(prefix + lastErrorMessage())
}

// 要有值的兜底：不需要值时用它自己的返回值当结果
fn valueOrMessage(prefix : String) -> String {
    rtn prefix + lastErrorMessage()
}

// ---------------------------------------------------------------- 入口

fn main() -> void {
    // (a) 想接住消息：?: 的兜底读 lastErrorMessage()
    println("== (a) 出错时读到消息 ==")
    println("正常路径：" + (readNumber("12") ?: 0))
    readNumber("") ?: reportText("出错了：")

    // (b) 兜底是 -> void 的函数：值被丢掉，只保留「出错时做点什么」
    println()
    println("== (b) ?: 的 void 兜底 ==")
    failInside() ?: reportText("接住了：")

    // (c) `?:` 给兜底值：出错就取右边，结果类型是非 ! 的正常类型
    println()
    println("== (c) ?: 兜底值 ==")
    println("出错的：" + (readNumber("") ?: -1))
    println("正常的：" + (readNumber("12") ?: -1))
    // 要值的兜底：兜底函数自己返回和左边同类型的值（这里顺便演示 String 的兜底）
    println(lookup(-1) ?: valueOrMessage("查询失败："))

    // (d) `!!` 往上抛 + 错误跨层函数传播：
    //     main → describeBoth → describe → lookup（lookup 里 fail），最后由 ?: 接住
    println()
    println("== (d) !! 往上抛，跨层传播 ==")
    describeBoth() ?: reportText("跨层接住：")

    // `!void` 函数：处理方式和其他 !T 一样（`!void` 不能写 `!!`，用 try 传播）
    println()
    println("== !void ==")
    checkBoth() ?: reportText("check 失败：")

    // 循环 / 分支里同样能用：兜底函数可以带参数（这里要把下标拼进消息）
    println()
    println("== 循环里逐条处理 ==")
    var i = 0
    while (i < 3) {
        println(lookup(i - 1) ?: indexFailure(i))
        i = i + 1
    }

    rtn
}

// 多语句的「出错就整段跳过」：抽成一个 !T 函数，调用点再用 `?:` 兜底
// （旧写法是 `try { 一堆语句 } catch (e) { ... }`）
fn failInside() -> !void {
    fail "这是 ?: 兜底接住的 fail"
}

fn describeBoth() -> !void {
    println(describe(7)!!)
    println(describe(-1)!!)     // 这里 fail，下面那句不会执行
    println("这一行不会执行")
}

fn checkBoth() -> !void {
    try check(3)
    try check(-3)               // 这里 fail，下面那句不会执行
    println("这一行不会执行")
}

// 兜底也可以带参数：把「第几次」和错误消息拼成一句话返回
fn indexFailure(i : Int) -> String {
    rtn "第 " + i + " 次失败：" + lastErrorMessage()
}
