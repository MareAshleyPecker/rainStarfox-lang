// 阶段 58c：块套块的盒模型（HTML 那套：padding / margin / border / 宽度 / 高度 / 权重）
//
// 调用方每帧写一棵树：`box()` 是块容器（默认竖排），`row()` 是横排容器，
// `label/button/toggle/field/spacer` 是叶子。每个控件都有：
//   padding  —— 内容与边框之间
//   margin   —— 与兄弟/父边界之间
//   width/height —— 固定尺寸（-1 = 自动）
//   flex     —— 在容器里分剩余空间的权重（0 = 按内容大小）
//   align    —— 内容水平对齐：0 左、1 中、2 右
// 渲染器先 measure（算内容尺寸）再 place（按约束摆放），最后按 depth 画区域。

pub class Kids {
    var items : Widget[] = new Widget[4]
    var n : Int = 0

    pub fn add(w : Widget) -> Kids {
        if (n == items.length) {
            var bigger = new Widget[items.length * 2]
            var i = 0
            while (i < n) {
                bigger[i] = items[i]
                i = i + 1
            }
            items = bigger
        }
        items[n] = w
        n = n + 1
        rtn this
    }

    pub fn size() -> Int { rtn n }

    pub fn at(i : Int) -> Widget { rtn items[i] }

    pub fn toArray() -> Widget[] {
        var out = new Widget[n]
        var i = 0
        while (i < n) {
            out[i] = items[i]
            i = i + 1
        }
        rtn out
    }
}

/// 测量结果：内容需要的宽高（含 padding，不含 margin）。
pub class Size(w0 : Int, h0 : Int) {
    var w : Int = w0
    var h : Int = h0
}

pub class Widget {
    var kind : String = "label"
    var key : String = ""
    var text : String = ""
    var action : Int = 0
    var checked : Bool = false
    var padL : Int = 0
    var padT : Int = 0
    var padR : Int = 0
    var padB : Int = 0
    var marginL : Int = 0
    var marginT : Int = 0
    var marginR : Int = 0
    var marginB : Int = 0
    var border : Int = -1
    var bg : Int = -1
    var fg : Int = 15658734
    var accent : Int = 4621004
    var fixedW : Int = -1
    var fixedH : Int = -1
    var weight : Int = 0
    var align : Int = 0
    var kids : Widget[] = new Widget[0]

    // ---------------------------------------------------------------- 盒子样式

    pub fn withKey(k : String) -> Widget {
        key = k
        rtn this
    }

    pub fn withColors(bgColor : Int, fgColor : Int) -> Widget {
        bg = bgColor
        fg = fgColor
        rtn this
    }

    pub fn withAccent(c : Int) -> Widget {
        accent = c
        rtn this
    }

    pub fn pad(p : Int) -> Widget {
        padL = p
        padT = p
        padR = p
        padB = p
        rtn this
    }

    pub fn padX(x : Int) -> Widget {
        padL = x
        padR = x
        rtn this
    }

    pub fn padY(y : Int) -> Widget {
        padT = y
        padB = y
        rtn this
    }

    pub fn padding(l : Int, t : Int, r : Int, b : Int) -> Widget {
        padL = l
        padT = t
        padR = r
        padB = b
        rtn this
    }

    pub fn margin(m : Int) -> Widget {
        marginL = m
        marginT = m
        marginR = m
        marginB = m
        rtn this
    }

    pub fn marginX(x : Int) -> Widget {
        marginL = x
        marginR = x
        rtn this
    }

    pub fn marginY(y : Int) -> Widget {
        marginT = y
        marginB = y
        rtn this
    }

    pub fn width(w : Int) -> Widget {
        fixedW = w
        rtn this
    }

    pub fn height(h : Int) -> Widget {
        fixedH = h
        rtn this
    }

    pub fn flex(weight0 : Int) -> Widget {
        weight = weight0
        rtn this
    }

    pub fn align(a : Int) -> Widget {
        align = a
        rtn this
    }

    pub fn frame(c : Int) -> Widget {
        border = c
        rtn this
    }

    pub fn add(w : Widget) -> Widget {
        var box = Kids()
        var i = 0
        while (i < kids.length) {
            box.add(kids[i])
            i = i + 1
        }
        box.add(w)
        kids = box.toArray()
        rtn this
    }

    pub fn hasKids() -> Bool { rtn kids.length > 0 }

    /// 这块区域的内容宽高（含 padding）；叶子按文字长度估。
    pub fn contentW(textWidth : Int) -> Int {
        if (kind == "label") { rtn textWidth + padL + padR }
        if (kind == "button") { rtn textWidth + 10 + padL + padR }
        if (kind == "check") { rtn 16 + textWidth + padL + padR }
        if (kind == "field") { rtn 60 + padL + padR }
        if (kind == "spacer") { rtn padL + padR }
        rtn padL + padR
    }
}

// ------------------------------------------------------------------ 构造器

pub fn label(text0 : String) -> Widget {
    var w = Widget()
    w.kind = "label"
    w.text = text0
    w.padL = 2
    w.padR = 2
    rtn w
}

pub fn title(text0 : String) -> Widget {
    var w = label(text0)
    w.padT = 2
    w.padB = 2
    rtn w
}

pub fn button(text0 : String, actionId : Int) -> Widget {
    var w = Widget()
    w.kind = "button"
    w.text = text0
    w.action = actionId
    w.padL = 6
    w.padR = 6
    rtn w
}

pub fn toggle(text0 : String, actionId : Int, checked : Bool) -> Widget {
    var w = Widget()
    w.kind = "check"
    w.text = text0
    w.action = actionId
    w.checked = checked
    w.padL = 2
    w.padR = 2
    rtn w
}

pub fn field(text0 : String) -> Widget {
    var w = Widget()
    w.kind = "field"
    w.text = text0
    w.padL = 4
    w.padR = 4
    rtn w
}

pub fn spacer(h : Int) -> Widget {
    var w = Widget()
    w.kind = "spacer"
    w.padT = h
    rtn w
}

/// 块容器：默认竖排，可以画底/边框（HTML 的 `<div>`）。
pub fn box() -> Widget {
    var w = Widget()
    w.kind = "box"
    rtn w
}

/// 横排容器（HTML 的 flex row）。
pub fn row() -> Widget {
    var w = Widget()
    w.kind = "row"
    rtn w
}

/// 兼容旧名：`column()` == `box()`、`panel()` == 带边框的 `box()`。
pub fn column() -> Widget { rtn box() }

pub fn panel() -> Widget {
    var w = box()
    w.border = 15658734
    rtn w
}
