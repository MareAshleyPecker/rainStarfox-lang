// 阶段 58：UI 库 · 软件画布
//
// 一块 `width * height` 的像素缓冲（Int，0xRRGGBB，不含 alpha）。所有绘制都是
// **纯整数运算**：解释器与 C 后端都能跑，画面逐字节一致（判据台 verify52 对拍）。
//
// 颜色不带 alpha：Int 是 32 位的，0xFF000000 会溢出成负数，通道拆解时 `%`
// 符号随被除数走，亮暗就全乱了。半透明留给上层自己调色。
import "Font.rsf"
import "Geometry.rsf"

pub fn rgb(r : Int, g : Int, b : Int) -> Int {
    rtn (r % 256) * 65536 + (g % 256) * 256 + (b % 256)
}

/// 拆通道（0..255）。
pub fn redOf(c : Int) -> Int { rtn (c / 65536) % 256 }

pub fn greenOf(c : Int) -> Int { rtn (c / 256) % 256 }

pub fn blueOf(c : Int) -> Int { rtn c % 256 }

pub class Canvas(w : Int, h : Int) {
    var width : Int = w
    var height : Int = h
    var pixels : Int[] = new Int[w * h]

    pub fn clear(c : Int) -> void {
        var i = 0
        while (i < pixels.length) {
            pixels[i] = c
            i = i + 1
        }
    }

    pub fn get(x : Int, y : Int) -> Int {
        if (x < 0 || y < 0 || x >= width || y >= height) { rtn 0 }
        rtn pixels[y * width + x]
    }

    /// 写一个像素（越界丢弃）。
    pub fn set(x : Int, y : Int, c : Int) -> void {
        if (x < 0 || y < 0 || x >= width || y >= height) { rtn }
        pixels[y * width + x] = c
    }

    pub fn fill(r : Rect, c : Int) -> void {
        var x0 = r.x
        var y0 = r.y
        var x1 = r.x + r.w
        var y1 = r.y + r.h
        if (x0 < 0) { x0 = 0 }
        if (y0 < 0) { y0 = 0 }
        if (x1 > width) { x1 = width }
        if (y1 > height) { y1 = height }
        var y = y0
        while (y < y1) {
            var x = x0
            while (x < x1) {
                pixels[y * width + x] = c
                x = x + 1
            }
            y = y + 1
        }
    }

    /// 只画边框（`thickness` 像素，往里长）。
    pub fn stroke(r : Rect, c : Int, thickness : Int) -> void {
        if (thickness <= 0) { rtn }
        fill(Rect(r.x, r.y, r.w, thickness), c)
        fill(Rect(r.x, r.y + r.h - thickness, r.w, thickness), c)
        fill(Rect(r.x, r.y, thickness, r.h), c)
        fill(Rect(r.x + r.w - thickness, r.y, thickness, r.h), c)
    }

    /// Bresenham 直线。
    pub fn line(x0 : Int, y0 : Int, x1 : Int, y1 : Int, c : Int) -> void {
        var dx = x1 - x0
        var dy = y1 - y0
        var sx = 1
        var sy = 1
        if (dx < 0) { sx = -1; dx = -dx }
        if (dy < 0) { sy = -1; dy = -dy }
        var err = dx - dy
        var x = x0
        var y = y0
        while (true) {
            set(x, y, c)
            if (x == x1 && y == y1) { rtn }
            var e2 = err * 2
            if (e2 > -dy) { err = err - dy; x = x + sx }
            if (e2 < dx) { err = err + dx; y = y + sy }
        }
    }

    /// 实心圆（按半宽逐行取整，不做抗锯齿——整数像素，三端零分叉）。
    pub fn circle(cx : Int, cy : Int, radius : Int, c : Int) -> void {
        if (radius < 0) { rtn }
        var dy = -radius
        while (dy <= radius) {
            var limit = radius * radius - dy * dy
            var dx = 0
            while (dx * dx <= limit) { dx = dx + 1 }
            dx = dx - 1
            fill(Rect(cx - dx, cy + dy, dx * 2 + 1, 1), c)
            dy = dy + 1
        }
    }

    /// 一个 5x7 字形（`code` 是 ASCII 码；不认识的字符按空白走）。
    pub fn glyph(code : Int, x : Int, y : Int, c : Int) -> void {
        var row = 0
        while (row < 7) {
            var bits = glyphRow(code, row)
            // 字形码第 4 位是最左列（MSB 优先），别按低位先画，否则整行镜像
            var mask = 16
            var col = 0
            while (col < 5) {
                if (bits >= mask) {
                    set(x + col, y + row, c)
                    bits = bits - mask
                }
                mask = mask / 2
                col = col + 1
            }
            row = row + 1
        }
    }

    /// 文字（小写按大写画，字距 6 像素）。返回画完之后的 x。
    pub fn text(s : String, x : Int, y : Int, c : Int) -> Int {
        var i = 0
        var cur = x
        while (i < s.length()) {
            var code = charToInt(s.charAt(i))
            if (code >= 97 && code <= 122) { code = code - 32 }
            glyph(code, cur, y, c)
            cur = cur + 6
            i = i + 1
        }
        rtn cur
    }

    pub fn textWidth(s : String) -> Int { rtn s.length() * 6 }

    /// 块状「回读」：每 `step` 像素取一格，亮暗映射成字符，方便当判据看。
    pub fn ascii(step : Int) -> String {
        var out = ""
        var y = 0
        while (y < height) {
            var x = 0
            while (x < width) {
                var c = get(x, y)
                var r = redOf(c)
                var g = greenOf(c)
                var b = blueOf(c)
                var luma = (r * 30 + g * 59 + b * 11) / 100
                if (luma >= 200) {
                    out = out + "#"
                } else {
                    if (luma >= 120) {
                        out = out + "+"
                    } else {
                        if (luma >= 40) { out = out + "." } else { out = out + " " }
                    }
                }
                x = x + step
            }
            out = out + "\n"
            y = y + step
        }
        rtn out
    }
}
