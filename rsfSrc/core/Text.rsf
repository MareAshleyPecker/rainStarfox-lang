// 阶段 40：核心标准库 · 文本工具 Text
//
// 只用内置的字符串基本操作（length / charAt / substring / indexOf / startsWith /
// endsWith / trim / toUpperCase / toLowerCase / replace），不引 JDK 正则、不做格式化。
pub class Text {
    pub stc fn repeat(s : string, times : int) -> string {
        if (times <= 0) { rtn "" }
        var out = ""
        var i = 0
        while (i < times) {
            out = out + s
            i = i + 1
        }
        rtn out
    }

    pub stc fn padLeft(s : string, width : int, pad : char) -> string {
        if (s.length() >= width) { rtn s }
        var need = width - s.length()
        var out = ""
        var i = 0
        while (i < need) {
            out = out + pad
            i = i + 1
        }
        rtn out + s
    }

    pub stc fn padRight(s : string, width : int, pad : char) -> string {
        if (s.length() >= width) { rtn s }
        var need = width - s.length()
        var out = s
        var i = 0
        while (i < need) {
            out = out + pad
            i = i + 1
        }
        rtn out
    }

    pub stc fn isBlank(s : string) -> bool
        { rtn s.trim().length() == 0 }

    // 把 s 按 sep 切开（简单的顺序扫描；连续分隔符会产生空段，与 JDK split 不同）
    pub stc fn split(s : string, sep : char) -> string[] {
        var out : string[] = new string[8]
        var n = 0
        var start = 0
        var i = 0
        while (i < s.length()) {
            if (s.charAt(i) == sep) {
                var piece = s.substring(start, i)
                if (n == out.length) {
                    var bigger : string[] = new string[out.length * 2]
                    var k = 0
                    while (k < n) { bigger[k] = out[k]; k = k + 1 }
                    out = bigger
                }
                out[n] = piece
                n = n + 1
                start = i + 1
            }
            i = i + 1
        }
        var tail = s.substring(start, s.length())
        if (n == out.length) {
            var bigger2 : string[] = new string[out.length * 2]
            var k2 = 0
            while (k2 < n) { bigger2[k2] = out[k2]; k2 = k2 + 1 }
            out = bigger2
        }
        out[n] = tail
        n = n + 1
        var exact : string[] = new string[n]
        var j = 0
        while (j < n) { exact[j] = out[j]; j = j + 1 }
        rtn exact
    }

    pub stc fn join(parts : string[], sep : string) -> string {
        var out = ""
        var i = 0
        while (i < parts.length) {
            if (i > 0) { out = out + sep }
            out = out + parts[i]
            i = i + 1
        }
        rtn out
    }

    // 从左往右数第 n 次出现的下标；找不到给 -1
    pub stc fn nthIndexOf(s : string, ch : char, n : int) -> int {
        var seen = 0
        var i = 0
        while (i < s.length()) {
            if (s.charAt(i) == ch) {
                seen = seen + 1
                if (seen == n) { rtn i }
            }
            i = i + 1
        }
        rtn -1
    }

    pub stc fn countOf(s : string, ch : char) -> int {
        var c = 0
        var i = 0
        while (i < s.length()) {
            if (s.charAt(i) == ch) { c = c + 1 }
            i = i + 1
        }
        rtn c
    }

    // 前缀/后缀剥离（不匹配就原样返回）
    pub stc fn stripPrefix(s : string, prefix : string) -> string {
        if (s.startsWith(prefix)) { rtn s.substring(prefix.length(), s.length()) }
        rtn s
    }

    pub stc fn stripSuffix(s : string, suffix : string) -> string {
        if (suffix.length() > 0 && s.endsWith(suffix)) {
            rtn s.substring(0, s.length() - suffix.length())
        }
        rtn s
    }

    // 按字符串分隔符切（sep 为空时整串算一段；连续分隔符会产生空段）
    pub stc fn splitBy(s : string, sep : string) -> string[] {
        if (sep.length() == 0) {
            var one : string[] = new string[1]
            one[0] = s
            rtn one
        }
        var out : string[] = new string[8]
        var n = 0
        var start = 0
        var i = 0
        while (i + sep.length() <= s.length()) {
            if (s.substring(i, i + sep.length()) == sep) {
                var piece = s.substring(start, i)
                if (n == out.length) {
                    var bigger : string[] = new string[out.length * 2]
                    var k = 0
                    while (k < n) { bigger[k] = out[k]; k = k + 1 }
                    out = bigger
                }
                out[n] = piece
                n = n + 1
                i = i + sep.length()
                start = i
            } else {
                i = i + 1
            }
        }
        var tail = s.substring(start, s.length())
        if (n == out.length) {
            var bigger2 : string[] = new string[out.length * 2]
            var k2 = 0
            while (k2 < n) { bigger2[k2] = out[k2]; k2 = k2 + 1 }
            out = bigger2
        }
        out[n] = tail
        n = n + 1
        var exact : string[] = new string[n]
        var j = 0
        while (j < n) { exact[j] = out[j]; j = j + 1 }
        rtn exact
    }

    // 子串第一次出现的下标；没有给 -1（不用 JDK 的 indexOf，自举侧没登记这个成员）
    pub stc fn indexOf(s : string, sub : string) -> int {
        if (sub.length() == 0) { rtn 0 }
        var i = 0
        while (i + sub.length() <= s.length()) {
            if (s.substring(i, i + sub.length()) == sub) { rtn i }
            i = i + 1
        }
        rtn -1
    }

    // 子串最后一次出现的下标；没有给 -1
    pub stc fn lastIndexOf(s : string, sub : string) -> int {
        if (sub.length() == 0) { rtn s.length() }
        var i = s.length() - sub.length()
        while (i >= 0) {
            if (s.substring(i, i + sub.length()) == sub) { rtn i }
            i = i - 1
        }
        rtn -1
    }
}
