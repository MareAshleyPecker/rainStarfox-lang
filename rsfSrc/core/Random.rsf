// 阶段 50：核心标准库 · 确定性随机数 Random
//
// Lehmer（乘同余）发生器：state = state * 16807 mod 2147483647。
// 用 Schrage 拆成 16807 * (state % 127773) - 2836 * (state / 127773)，
// 中间结果最大约 2.147e9，正好压在 int 范围内——没有 long、没有位运算也能算。
// 同一个种子序列固定，所以探针可以拿它当金标。
pub class Random {
    var state : int = 1

    pub fn seed(s : int) -> void {
        var v = s % 2147483647
        if (v < 0) { v = -v }
        if (v == 0) { v = 1 }
        state = v
    }

    // 1 .. 2147483646
    pub fn nextInt() -> int {
        var hi = state / 127773
        var lo = state % 127773
        var t = 16807 * lo - 2836 * hi
        if (t < 0) { t = t + 2147483647 }
        state = t
        rtn t
    }

    // [0, bound)；bound <= 0 时给 0
    pub fn nextBelow(bound : int) -> int {
        if (bound <= 0) { rtn 0 }
        rtn nextInt() % bound
    }

    // [lo, hi] 闭区间
    pub fn nextRange(lo : int, hi : int) -> int {
        if (hi <= lo) { rtn lo }
        rtn lo + nextBelow(hi - lo + 1)
    }

    pub fn nextBool() -> bool { rtn nextInt() % 2 == 0 }

    // 原地洗牌（Fisher-Yates，从后往前）
    pub fn shuffle(a : int[]) -> void {
        var i = a.length - 1
        while (i > 0) {
            var j = nextBelow(i + 1)
            var t = a[i]
            a[i] = a[j]
            a[j] = t
            i = i - 1
        }
    }
}
