// 阶段 40：核心标准库 · 字符串键哈希表 HashMap<T>
//
// 开放寻址（线性探测）+ 2 倍扩容；键只支持 string（自举链与编译器前端用不到别的键）。
// 哈希：djb2（h = 5381; h = h * 33 + c），与 SymTable 同一套。
public class HashMap&<T> {
    var keys : string[] = new string[8]
    var vals : T[] = new T[8]
    var used : bool[] = new bool[8]
    var n : int = 0

    public fn size() -> int { rtn n }

    public fn isEmpty() -> bool { rtn n == 0 }

    public fn hashOf(s : string) -> int {
        var h = 5381
        var i = 0
        while (i < s.length()) {
            h = h * 33 + charToInt(s.charAt(i))
            i = i + 1
        }
        if (h < 0) { h = -h }
        rtn h
    }

    public fn slotOf(s : string) -> int {
        var cap = keys.length
        var i = hashOf(s) % cap
        while (used[i]) {
            if (keys[i] == s) { rtn i }
            i = (i + 1) % cap
        }
        rtn i
    }

    public fn put(k : string, v : T) -> void {
        if ((n + 1) * 4 > keys.length * 3) { rehash() }
        var i = slotOf(k)
        if (!used[i]) {
            used[i] = true
            keys[i] = k
            n = n + 1
        }
        vals[i] = v
    }

    public fn get(k : string) -> ?T {
        var cap = keys.length
        var i = hashOf(k) % cap
        while (used[i]) {
            if (keys[i] == k) { rtn vals[i] }
            i = (i + 1) % cap
        }
        rtn null
    }

    public fn containsKey(k : string) -> bool {
        var cap = keys.length
        var i = hashOf(k) % cap
        while (used[i]) {
            if (keys[i] == k) { rtn true }
            i = (i + 1) % cap
        }
        rtn false
    }

    // 删除：先清槽，再把后面同一簇的元素重新 put 回去（保持线性探测的查找不变量）
    public fn remove(k : string) -> bool {
        var cap = keys.length
        var i = hashOf(k) % cap
        while (used[i]) {
            if (keys[i] == k) {
                used[i] = false
                n = n - 1
                var j = (i + 1) % cap
                while (used[j]) {
                    var kk = keys[j]
                    var vv = vals[j]
                    used[j] = false
                    n = n - 1
                    put(kk, vv)
                    j = (j + 1) % cap
                }
                rtn true
            }
            i = (i + 1) % cap
        }
        rtn false
    }

    public fn rehash() -> void {
        var oldKeys = keys
        var oldVals = vals
        var oldUsed = used
        var cap = oldKeys.length * 2
        keys = new string[cap]
        vals = new T[cap]
        used = new bool[cap]
        n = 0
        var i = 0
        while (i < oldKeys.length) {
            if (oldUsed[i]) { put(oldKeys[i], oldVals[i]) }
            i = i + 1
        }
    }
}
