// 阶段 40：核心标准库 · 32 位整数位运算 Bits
//
// rsf 语言没有 `&`/`|`/`^`/`<<`/`>>` 运算符（`&` 只用于泛型实参），
// 所以这里全部用算术实现：除以 2^n 取位、乘 2^n 左移。
// 口径：Int 是 32 位二补数，与 JVM 一致；负数按位模式处理。
pub class Bits {
    // 2 的 n 次方；n 超出 0..30 时返回 0/-2147483648 这类回绕值，调用方自己保证范围
    pub stc fn pow2(n : Int) -> Int {
        var p = 1
        var i = 0
        while (i < n) {
            p = p * 2
            i = i + 1
        }
        rtn p
    }

    // 第 i 位（0 是最低位）；unsigned 口径，负数的高位也算 1
    pub stc fn bitAt(x : Int, i : Int) -> Int {
        if (i == 31) {
            if (x < 0) { rtn 1 }
            rtn 0
        }
        var d = pow2(i)
        var q = x / d
        if (x < 0 && q * d != x) { q = q - 1 }
        var b = q % 2
        if (b < 0) { b = b + 2 }
        rtn b
    }

    pub stc fn shl(x : Int, n : Int) -> Int {
        if (n <= 0) { rtn x }
        if (n >= 32) { rtn 0 }
        if (n == 31) {
            if (x % 2 == 0) { rtn 0 }
            rtn -2147483647 - 1
        }
        rtn x * pow2(n)
    }

    // 算术右移（负数补 1）
    pub stc fn shr(x : Int, n : Int) -> Int {
        if (n <= 0) { rtn x }
        if (n >= 31) {
            if (x < 0) { rtn -1 }
            rtn 0
        }
        var d = pow2(n)
        var q = x / d
        if (x < 0 && q * d != x) { q = q - 1 }
        rtn q
    }

    // 逻辑右移（负数当无符号数看）
    pub stc fn ushr(x : Int, n : Int) -> Int {
        if (n <= 0) { rtn x }
        if (n == 31) {
            if (x < 0) { rtn 1 }
            rtn 0
        }
        if (n >= 32) { rtn 0 }
        var d = pow2(n)
        var q = x / d
        if (x < 0 && q * d != x) { q = q - 1 }
        if (x < 0) { q = q + pow2(32 - n) }
        rtn q
    }

    pub stc fn and(a : Int, b : Int) -> Int {
        var out = 0
        var i = 0
        while (i < 32) {
            if (bitAt(a, i) == 1 && bitAt(b, i) == 1) {
                out = out + pow2(i)
            }
            i = i + 1
        }
        rtn out
    }

    pub stc fn or(a : Int, b : Int) -> Int {
        var out = 0
        var i = 0
        while (i < 32) {
            if (bitAt(a, i) == 1 || bitAt(b, i) == 1) {
                out = out + pow2(i)
            }
            i = i + 1
        }
        rtn out
    }

    pub stc fn xor(a : Int, b : Int) -> Int {
        var out = 0
        var i = 0
        while (i < 32) {
            if (bitAt(a, i) != bitAt(b, i)) {
                out = out + pow2(i)
            }
            i = i + 1
        }
        rtn out
    }

    // 按位取反：~x == -1 - x
    pub stc fn not(x : Int) -> Int { rtn -1 - x }

    pub stc fn popCount(x : Int) -> Int {
        var c = 0
        var i = 0
        while (i < 32) {
            c = c + bitAt(x, i)
            i = i + 1
        }
        rtn c
    }

    pub stc fn isPow2(x : Int) -> Bool {
        if (x <= 0) { rtn false }
        rtn and(x, x - 1) == 0
    }

    // 最低位的 1（x 为 0 时返回 0）
    pub stc fn lowestBit(x : Int) -> Int {
        if (x == 0) { rtn 0 }
        rtn and(x, -x)
    }

    // 最高位的 1（x 为 0 时返回 0）
    pub stc fn highestBit(x : Int) -> Int {
        var i = 31
        while (i >= 0) {
            if (bitAt(x, i) == 1) { rtn pow2(i) }
            i = i - 1
        }
        rtn 0
    }

    // 固定 32 位二进制串
    pub stc fn toBinary(x : Int) -> String {
        var out = ""
        var i = 31
        while (i >= 0) {
            if (bitAt(x, i) == 1) { out = out + '1' } else { out = out + '0' }
            i = i - 1
        }
        rtn out
    }

    // 去掉前导 0 的二进制串（0 仍给 "0"）
    pub stc fn toBinaryShort(x : Int) -> String {
        var out = ""
        var started = false
        var i = 31
        while (i >= 0) {
            if (bitAt(x, i) == 1) {
                out = out + '1'
                started = true
            } else {
                if (started) { out = out + '0' }
            }
            i = i - 1
        }
        if (!started) { rtn "0" }
        rtn out
    }

    // 固定 8 位十六进制串（小写）
    pub stc fn toHex(x : Int) -> String {
        var out = ""
        var i = 7
        while (i >= 0) {
            var v = bitAt(x, i * 4) + bitAt(x, i * 4 + 1) * 2 + bitAt(x, i * 4 + 2) * 4 + bitAt(x, i * 4 + 3) * 8
            if (v < 10) { out = out + toChar(48 + v) } else { out = out + toChar(97 + v - 10) }
            i = i - 1
        }
        rtn out
    }

    // ---------------------------------------------------------------- 64 位

    // 2 的 n 次方（Long）；n >= 63 时回绕成负数，调用方自己保证 0..62
    pub stc fn pow2Long(n : Int) -> Long {
        var p : Long = 1L
        var i = 0
        while (i < n) {
            p = p * 2L
            i = i + 1
        }
        rtn p
    }

    // 第 i 位（0 是最低位）；unsigned 口径，负数高位算 1
    pub stc fn bitAtLong(x : Long, i : Int) -> Int {
        if (i >= 63) {
            if (x < 0L) { rtn 1 }
            rtn 0
        }
        if (i < 0) { rtn 0 }
        var d : Long = pow2Long(i)
        var q : Long = x / d
        if (x < 0L && q * d != x) { q = q - 1L }
        var r : Long = q % 2L
        if (r < 0L) { r = r + 2L }
        if (r == 0L) { rtn 0 }
        rtn 1
    }

    pub stc fn shlLong(x : Long, n : Int) -> Long {
        if (n <= 0) { rtn x }
        if (n >= 64) { rtn 0L }
        if (n == 63) {
            if (x % 2L == 0L) { rtn 0L }
            rtn -9223372036854775807L - 1L
        }
        rtn x * pow2Long(n)
    }

    // 算术右移（负数补 1）
    pub stc fn shrLong(x : Long, n : Int) -> Long {
        if (n <= 0) { rtn x }
        if (n >= 63) {
            if (x < 0L) { rtn -1L }
            rtn 0L
        }
        var d : Long = pow2Long(n)
        var q : Long = x / d
        if (x < 0L && q * d != x) { q = q - 1L }
        rtn q
    }

    // 逻辑右移（负数当无符号数看）
    pub stc fn ushrLong(x : Long, n : Int) -> Long {
        if (n <= 0) { rtn x }
        if (n >= 64) { rtn 0L }
        if (n == 63) {
            if (x < 0L) { rtn 1L }
            rtn 0L
        }
        var d : Long = pow2Long(n)
        var q : Long = x / d
        if (x < 0L && q * d != x) { q = q - 1L }
        if (x < 0L) { q = q + pow2Long(64 - n) }
        rtn q
    }

    pub stc fn andLong(a : Long, b : Long) -> Long {
        var out : Long = 0L
        var p : Long = 1L
        var i = 0
        while (i < 64) {
            if (bitAtLong(a, i) == 1 && bitAtLong(b, i) == 1) { out = out + p }
            p = p * 2L
            i = i + 1
        }
        rtn out
    }

    pub stc fn orLong(a : Long, b : Long) -> Long {
        var out : Long = 0L
        var p : Long = 1L
        var i = 0
        while (i < 64) {
            if (bitAtLong(a, i) == 1 || bitAtLong(b, i) == 1) { out = out + p }
            p = p * 2L
            i = i + 1
        }
        rtn out
    }

    pub stc fn xorLong(a : Long, b : Long) -> Long {
        var out : Long = 0L
        var p : Long = 1L
        var i = 0
        while (i < 64) {
            var ba = bitAtLong(a, i)
            var bb = bitAtLong(b, i)
            if (ba != bb) { out = out + p }
            p = p * 2L
            i = i + 1
        }
        rtn out
    }

    // ~x == -1L - x
    pub stc fn notLong(x : Long) -> Long { rtn -1L - x }

    pub stc fn popCountLong(x : Long) -> Int {
        var c = 0
        var i = 0
        while (i < 64) {
            c = c + bitAtLong(x, i)
            i = i + 1
        }
        rtn c
    }

    pub stc fn isPow2Long(x : Long) -> Bool {
        if (x <= 0L) { rtn false }
        rtn andLong(x, x - 1L) == 0L
    }

    pub stc fn lowestBitLong(x : Long) -> Long {
        if (x == 0L) { rtn 0L }
        rtn andLong(x, -x)
    }

    pub stc fn highestBitLong(x : Long) -> Long {
        var i = 63
        while (i >= 0) {
            if (bitAtLong(x, i) == 1) { rtn pow2Long(i) }
            i = i - 1
        }
        rtn 0L
    }

    // 固定 64 位二进制串
    pub stc fn toBinaryLong(x : Long) -> String {
        var out = ""
        var i = 63
        while (i >= 0) {
            if (bitAtLong(x, i) == 1) { out = out + '1' } else { out = out + '0' }
            i = i - 1
        }
        rtn out
    }

    // 固定 16 位十六进制串（小写）
    pub stc fn toHexLong(x : Long) -> String {
        var out = ""
        var i = 15
        while (i >= 0) {
            var v = bitAtLong(x, i * 4) + bitAtLong(x, i * 4 + 1) * 2 + bitAtLong(x, i * 4 + 2) * 4 + bitAtLong(x, i * 4 + 3) * 8
            if (v < 10) { out = out + toChar(48 + v) } else { out = out + toChar(97 + v - 10) }
            i = i - 1
        }
        rtn out
    }
}
