// 阶段 40：核心标准库 · 字符串工具 Strings
//
// 只用内置的 length / charAt / substring / toUpperCase / toLowerCase / trim，
// 不做正则、不做格式化（Text.rsf 里已有 repeat / pad / split / join）。
pub class Strings {
    // 子串出现次数（不重叠）；target 为空返回 0
    pub stc fn count(s : string, target : string) -> int {
        if (target.length() == 0) { rtn 0 }
        var c = 0
        var i = 0
        while (i + target.length() <= s.length()) {
            if (s.substring(i, i + target.length()) == target) {
                c = c + 1
                i = i + target.length()
            } else {
                i = i + 1
            }
        }
        rtn c
    }

    // 把所有 target 换成 repl（从左到右；target 为空原样返回）
    pub stc fn replace(s : string, target : string, repl : string) -> string {
        if (target.length() == 0) { rtn s }
        var out = ""
        var i = 0
        while (i < s.length()) {
            if (i + target.length() <= s.length() && s.substring(i, i + target.length()) == target) {
                out = out + repl
                i = i + target.length()
            } else {
                out = out + s.charAt(i)
                i = i + 1
            }
        }
        rtn out
    }

    pub stc fn equalsIgnoreCase(a : string, b : string) -> bool {
        rtn a.toLowerCase() == b.toLowerCase()
    }

    pub stc fn startsWithIgnoreCase(s : string, prefix : string) -> bool {
        if (prefix.length() > s.length()) { rtn false }
        rtn s.substring(0, prefix.length()).toLowerCase() == prefix.toLowerCase()
    }

    pub stc fn capitalize(s : string) -> string {
        if (s.length() == 0) { rtn s }
        rtn s.substring(0, 1).toUpperCase() + s.substring(1)
    }

    pub stc fn uncapitalize(s : string) -> string {
        if (s.length() == 0) { rtn s }
        rtn s.substring(0, 1).toLowerCase() + s.substring(1)
    }

    pub stc fn reverse(s : string) -> string {
        var out = ""
        var i = s.length() - 1
        while (i >= 0) {
            out = out + s.charAt(i)
            i = i - 1
        }
        rtn out
    }

    // 截到 width 个字符；超长时末尾补 "..."
    pub stc fn ellipsis(s : string, width : int) -> string {
        if (width <= 0) { rtn "" }
        if (s.length() <= width) { rtn s }
        if (width <= 3) { rtn s.substring(0, width) }
        rtn s.substring(0, width - 3) + "..."
    }

    // 左右用 pad 填到 width（已经够宽就原样返回）
    pub stc fn center(s : string, width : int, pad : char) -> string {
        if (s.length() >= width) { rtn s }
        var need = width - s.length()
        var left = need / 2
        var right = need - left
        var out = ""
        var i = 0
        while (i < left) {
            out = out + pad
            i = i + 1
        }
        out = out + s
        var j = 0
        while (j < right) {
            out = out + pad
            j = j + 1
        }
        rtn out
    }

    stc fn isSpace(ch : char) -> bool {
        var c = charToInt(ch)
        rtn c == 32 || c == 9 || c == 10 || c == 13
    }

    pub stc fn trimStart(s : string) -> string {
        var i = 0
        while (i < s.length() && isSpace(s.charAt(i))) { i = i + 1 }
        rtn s.substring(i, s.length())
    }

    pub stc fn trimEnd(s : string) -> string {
        var i = s.length() - 1
        while (i >= 0 && isSpace(s.charAt(i))) { i = i - 1 }
        rtn s.substring(0, i + 1)
    }

    // 全是 ASCII 数字且非空
    pub stc fn isDigits(s : string) -> bool {
        if (s.length() == 0) { rtn false }
        var i = 0
        while (i < s.length()) {
            var c = charToInt(s.charAt(i))
            if (c < 48 || c > 57) { rtn false }
            i = i + 1
        }
        rtn true
    }

    // 按空白段切词（连续空白只算一个分隔符，首尾空白不产生空词）
    pub stc fn words(s : string) -> string[] {
        var out : string[] = new string[8]
        var n = 0
        var i = 0
        while (i < s.length()) {
            while (i < s.length() && isSpace(s.charAt(i))) { i = i + 1 }
            if (i >= s.length()) { break }
            var start = i
            while (i < s.length() && !isSpace(s.charAt(i))) { i = i + 1 }
            var piece = s.substring(start, i)
            if (n == out.length) {
                var bigger : string[] = new string[out.length * 2]
                var k = 0
                while (k < n) { bigger[k] = out[k]; k = k + 1 }
                out = bigger
            }
            out[n] = piece
            n = n + 1
        }
        var exact : string[] = new string[n]
        var j = 0
        while (j < n) { exact[j] = out[j]; j = j + 1 }
        rtn exact
    }
}
