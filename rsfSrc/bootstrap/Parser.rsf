// rainStarfox 阶段 17b：**用 rsf 自己写的语法分析器**（自举的第二步）
//
// 基准是 Kotlin 版 `src/main/kotlin/org/example/complie/parsing/Parser.kt`：
// 同一份 `.rsf` 输入，这里建出来的语法树必须与它**结构完全相同**——对拍时两边各自
// 打成同一份规范化文本（见下面的「dump 格式」），逐行比。对拍命令见 BOOTSTRAP.md 的 17b 段。
//
// 这个文件是**纯库**（没有 main）：`import "Parser.rsf"` 就能用
// `parseSource(source)` 与 `dumpAst(node)`。要跑起来看输出用旁边的 `ParserCli.rsf`：
//
//     rsf build rsfSrc/bootstrap/ParserCli.rsf -o out
//     java -Drsf.ast.file=rsfSrc/lang/enums.rsf -cp out ParserCli
//
// 查：rsf check rsfSrc/bootstrap/ParserCli.rsf（Parser.rsf 自己没有 main，check 也过）
//
// ================================================================ AST 怎么表示
//
// **rsf 现在没有继承/接口**（阶段 20 才有），所以写不出「Expr / Stmt / Decl 多态
// 节点层次」那种设计——那需要「一个数组装不同子类」。这里用的是**胖节点**：
//
//     public class Node(kind : NodeKind, text : string)
//         kind      —— NodeKind 枚举，说明这是哪一种节点
//         text      —— 这一层的**属性串**，形如 "name=foo mutable=true"，字段之间正好一个空格
//         children  —— 子节点数组（用 add 追加，内部满 8 个翻倍）
//
// 于是「一棵树」就是 `Node` 对象的数组套数组，遍历一律 `switch (node.kind)`——
// 这正是阶段 19c 加 `switch` 的原因。**没有继承带来的三个直接后果**：
//
//   1. **属性只能塞进字符串**。Kotlin 版每个节点类有自己的字段（`FuncDecl.control`、
//      `ForStmt.condition`…），rsf 版没有字段可声明，只能把「这一层需要的字面量」
//      拼成一个 `k=v` 串。好处是它**恰好就是对拍用的 dump 文本**；坏处是拼错了
//      （把 `ret` 写成 `retType`）编译器一句话都不说，只有对拍测试会报「第 N 行不一样」。
//      —— 这就是为什么对拍测试在这个阶段不是「锦上添花」，而是唯一的正确性防线。
//   2. **可选的子节点没法用 null 表示**：rsf 的**数组元素不可空**（`Node[]` 里放不进
//      null），所以「可能没有的孩子」不能留空位。这里的做法是**按需 add**：
//      `if (...) { node.add(child) }`，节点自己不存在就不占位置。Kotlin 版那边是
//      `List`，天然可以为空，两边因此都能表达同一件事。
//   3. **没有方法重载**：`match(LT, GT, LE, GE)` 那种 Kotlin 写法在这里得拆成
//      `matchAny4(a, b, c, d)` 这种定参数个数的函数（见下面「工具」段）。
//
// ================================================================ dump 格式
//
// 与测试源集里的 `src/test/kotlin/org/example/AstDump.kt` **逐字节一致**：
//
//     缩进 = 2 空格 × 深度；一行一个节点；
//     行 = <缩进><KIND NAME>[" " + text]；text 为空就只有一个 KIND NAME；
//     列表节点自己带 count=N（孩子个数），孩子就是它的 childCount 个 child。
//
// 两份实现必须同步改：`AstDump.kt` 的 `esc` 与这里的 `escapeValue` 是同一张转义表，
// 字段顺序也必须一样（Kotlin 那边在 dump 函数里按固定顺序写字段，这边在解析时按同一顺序 put）。
//
// ================================================================ 解糖：做，而且照着 Kotlin 版做
//
// `for (i in a..b step n)` 在 Kotlin 版里是**解析期解糖**成
//
//     { imutvar __rsf_forEnd<k> = b; imutvar __rsf_forStep<k> = n; imutvar i = a;
//       for (步长 >= 0 ? i <= 终点 : i >= 终点 ; i = i + 步长) 循环体 }
//
// rsf 版**照做**，连合成名字的计数器 `__rsf_forEnd<k>` 的编号顺序都一样。理由是
// 对拍口径必须一致：Kotlin 版手里的 AST 已经是解糖后的样子，原始写法（区间、step）
// 在树上**已经不存在了**，所以 rsf 版要是保留一个「FOR_IN」原始节点，两边就永远比不平——
// 除非在 Kotlin 侧的 dump 里把解糖后的树再「反解糖」回源码形状，那是自欺欺人。
//
// ================================================================ 出错怎么办：不做异常，做成 flag
//
// Kotlin 版遇错就抛 `RsfError`（消息很具体）。rsf 版**不用** `fail`：`fail` 会把整个
// 程序停下来，`!T` 又要顺着调用链一路标注到每一个 parse 函数上，写起来比语法本身还长。
// 这里沿用 `Lexer.rsf` 那套：`Parser` 对象上挂一个 `failed` 标志 + 消息 + 行列，
// 每个解析函数出错就 `failAt(...)`，然后返回一个占位节点继续往下走。
//
// **这样做是安全的**，因为：合法输入上 `failed` 永远是 false，占位那条路根本不走；
// 非法输入上我们只要求「两边都判定为失败」，不要求错误消息逐字相同（那是 17c 的事）。
// 每个循环都有 EOF / failed 出口，所以出错也不会转死循环。

import "Lexer.rsf"

// 数字字面量的「值」要按 JVM 的规则算（`Double.toString(3.141592653589793238)` 是
// `3.141592653589793`，不是源码里那串字符），所以直接借 java.lang 的静态方法，
// 与 Kotlin 版的 `raw.toDoubleOrNull()` / `Float.toString` 是**同一个 JVM 方法**。
import java.lang.Double
import java.lang.Float
import java.lang.Integer
import java.lang.Long

// ---------------------------------------------------------------- 节点种类
//
// 与 AstDump.kt 里那几个 dump 函数一一对应。**没有 else 的 switch 必须穷尽**，
// 所以漏了一个种类编译器会直接报错——这是胖节点设计里唯一还留着的一点类型安全。

public enum NodeKind {
    PROGRAM, PKG, IMPORTS, CLASS_IMPORT, SOURCE_IMPORT, MODULE_IMPORT,
    FUNCS, FUNC, PARAMS, PARAM,
    CLASSES, CLASS, TYPE_PARAMS, TYPE_PARAM, FIELDS, FIELD, METHODS,
    ENUMS, ENUM, VALUES, ENUM_VALUE,
    // 阶段 20：接口声明与 `:` 父类型子句（自举同步第 1 刀）
    INTERFACES, INTERFACE, SUPERS, SUPER,
    BLOCK, VAR_DECL, ASSIGN, MEMBER_ASSIGN, INDEX_ASSIGN, RETURN, EXPR_STMT,
    LABEL, THIS_CALL, SWITCH, CASES, CASE, GOTO, IF, WHILE, FOR, BREAK, CONTINUE,
    FAIL, TRY,
    ARGS, DIMS,
    INT_LIT, LONG_LIT, FLOAT_LIT, DOUBLE_LIT, STRING_LIT, CHAR_LIT, BOOL_LIT, NULL_LIT,
    VAR, CALL, NEW, NEW_ARRAY, MEMBER, INDEX, UNARY, BINARY, IF_EXPR, ELVIS, FORCE, THIS,
    // 只在对拍测试与 CLI 里出现：解析失败的落点（合法输入上永远不会建出来）
    ERROR,
    // 阶段 21：注解（自举同步第 3 刀）。
    // **一律追加在枚举末尾**：已有成员的名字与次序都不动，免得别处按序号读 NodeKind 时语义漂移。
    ANNOTATIONS, ANNOTATION, ANNOTATION_ELEMENTS, ANNOTATION_ELEMENT,
    ANNOTATION_USES, ANNOTATION_USE, ANNOTATION_ARGS, POSITIONAL_ARG, NAMED_ARG,
    COMPANION,
    // 阶段 25：类继承（自举同步第 6 刀）。同样**一律追加在枚举末尾**。
    // SUPER_CLASS = 父类槽位（Kotlin 侧 ClassDecl.superClass），其下挂 ARGS 子节点；
    // SUPER_CALL  = 构造体第一句 `super(实参)` 的委托（Kotlin 侧 SuperCallStmt）；
    // FINAL / ABSTRACT **不是 AST 节点**，只是「dump 行」的落点：AstDump.kt 在
    // 类/方法**写了这个修饰词**时会多打一行 FINAL/ABSTRACT，而 rsf 侧的 dumpAst
    // 是通用递归（没有任何 per-kind 分支），所以只能靠一个空 text 的子节点把这一行带出来。
    // 两个修饰词节点**只在写了时挂**：没写的既有语料一个孩子都不多，字节不变。
    SUPER_CLASS, SUPER_CALL, FINAL, ABSTRACT,
    // 阶段 24（自举同步 24b）：类型转换 / 类型判断。同样**一律追加在枚举末尾**。
    // AS  = `a as A` / `a ?as A`（`safe` 区分两者）；
    // IS  = `a is A` / `a !is A`（`negated` 区分两者）；
    // TARGET 和上面 FINAL/ABSTRACT 一样**不是 Kotlin 侧的 AST 节点**，只是 dump 行的
    // 落点：AstDump.kt 在 AS / IS 下面多打一行 `TARGET type=<类型文本>`，而 rsf 侧的
    // dumpAst 是通用递归（没有任何 per-kind 分支），所以只能靠一个子节点把这一行带出来。
    // TARGET 的 text 就是 `type=<TypeInfo.text()>`，与 VAR / PARAM 打类型文本的口径同一套。
    AS, IS, TARGET,
    // 阶段 30c：函数值字面量 `lam(x : int) -> int { … }`（自举同步第 11 刀）。同样追加在末尾。
    // 形状与 AstDump.kt 的 LambdaExpr 分支逐字节对齐：text = `params=<n> ret=<类型文本|->`，
    // 孩子依次是 PARAM（每个形参一行，text 是 `name=… type=…`）和最后那个 BLOCK；
    // **没有 PARAMS 包一层** —— Kotlin 那边 lambda 的形参不打 PARAMS 行。
    LAMBDA
}

// 枚举值 -> dump 里的名字。写成显式 switch（而不是靠 `"" + k` 拿 toString）有两个好处：
// 名字和 AstDump.kt 里写死的字符串**能一眼对上**，而且这一层穷尽性由编译器把关。
public fn kindName(k : NodeKind) -> string {
    switch (k) {
        NodeKind.PROGRAM : rtn "PROGRAM"
        NodeKind.PKG : rtn "PKG"
        NodeKind.IMPORTS : rtn "IMPORTS"
        NodeKind.CLASS_IMPORT : rtn "CLASS_IMPORT"
        NodeKind.SOURCE_IMPORT : rtn "SOURCE_IMPORT"
        NodeKind.MODULE_IMPORT : rtn "MODULE_IMPORT"
        NodeKind.FUNCS : rtn "FUNCS"
        NodeKind.FUNC : rtn "FUNC"
        NodeKind.PARAMS : rtn "PARAMS"
        NodeKind.PARAM : rtn "PARAM"
        NodeKind.CLASSES : rtn "CLASSES"
        NodeKind.CLASS : rtn "CLASS"
        NodeKind.TYPE_PARAMS : rtn "TYPE_PARAMS"
        NodeKind.TYPE_PARAM : rtn "TYPE_PARAM"
        NodeKind.FIELDS : rtn "FIELDS"
        NodeKind.FIELD : rtn "FIELD"
        NodeKind.METHODS : rtn "METHODS"
        NodeKind.ENUMS : rtn "ENUMS"
        NodeKind.ENUM : rtn "ENUM"
        NodeKind.VALUES : rtn "VALUES"
        NodeKind.ENUM_VALUE : rtn "ENUM_VALUE"
        NodeKind.INTERFACES : rtn "INTERFACES"
        NodeKind.INTERFACE : rtn "INTERFACE"
        NodeKind.SUPERS : rtn "SUPERS"
        NodeKind.SUPER : rtn "SUPER"
        NodeKind.BLOCK : rtn "BLOCK"
        NodeKind.VAR_DECL : rtn "VAR_DECL"
        NodeKind.ASSIGN : rtn "ASSIGN"
        NodeKind.MEMBER_ASSIGN : rtn "MEMBER_ASSIGN"
        NodeKind.INDEX_ASSIGN : rtn "INDEX_ASSIGN"
        NodeKind.RETURN : rtn "RETURN"
        NodeKind.EXPR_STMT : rtn "EXPR_STMT"
        NodeKind.LABEL : rtn "LABEL"
        NodeKind.THIS_CALL : rtn "THIS_CALL"
        NodeKind.SWITCH : rtn "SWITCH"
        NodeKind.CASES : rtn "CASES"
        NodeKind.CASE : rtn "CASE"
        NodeKind.GOTO : rtn "GOTO"
        NodeKind.IF : rtn "IF"
        NodeKind.WHILE : rtn "WHILE"
        NodeKind.FOR : rtn "FOR"
        NodeKind.BREAK : rtn "BREAK"
        NodeKind.CONTINUE : rtn "CONTINUE"
        NodeKind.FAIL : rtn "FAIL"
        NodeKind.TRY : rtn "TRY"
        NodeKind.ARGS : rtn "ARGS"
        NodeKind.DIMS : rtn "DIMS"
        NodeKind.INT_LIT : rtn "INT_LIT"
        NodeKind.LONG_LIT : rtn "LONG_LIT"
        NodeKind.FLOAT_LIT : rtn "FLOAT_LIT"
        NodeKind.DOUBLE_LIT : rtn "DOUBLE_LIT"
        NodeKind.STRING_LIT : rtn "STRING_LIT"
        NodeKind.CHAR_LIT : rtn "CHAR_LIT"
        NodeKind.BOOL_LIT : rtn "BOOL_LIT"
        NodeKind.NULL_LIT : rtn "NULL_LIT"
        NodeKind.VAR : rtn "VAR"
        NodeKind.CALL : rtn "CALL"
        NodeKind.NEW : rtn "NEW"
        NodeKind.NEW_ARRAY : rtn "NEW_ARRAY"
        NodeKind.MEMBER : rtn "MEMBER"
        NodeKind.INDEX : rtn "INDEX"
        NodeKind.UNARY : rtn "UNARY"
        NodeKind.BINARY : rtn "BINARY"
        NodeKind.IF_EXPR : rtn "IF_EXPR"
        NodeKind.ELVIS : rtn "ELVIS"
        NodeKind.FORCE : rtn "FORCE"
        NodeKind.THIS : rtn "THIS"
        NodeKind.ERROR : rtn "ERROR"
        // 阶段 21：注解（自举同步第 3 刀）——每加一个 NodeKind 成员都必须在这里补一行
        NodeKind.ANNOTATIONS : rtn "ANNOTATIONS"
        NodeKind.ANNOTATION : rtn "ANNOTATION"
        NodeKind.ANNOTATION_ELEMENTS : rtn "ANNOTATION_ELEMENTS"
        NodeKind.ANNOTATION_ELEMENT : rtn "ANNOTATION_ELEMENT"
        NodeKind.ANNOTATION_USES : rtn "ANNOTATION_USES"
        NodeKind.ANNOTATION_USE : rtn "ANNOTATION_USE"
        NodeKind.ANNOTATION_ARGS : rtn "ANNOTATION_ARGS"
        NodeKind.POSITIONAL_ARG : rtn "POSITIONAL_ARG"
        NodeKind.NAMED_ARG : rtn "NAMED_ARG"
        NodeKind.COMPANION : rtn "COMPANION"
        // 阶段 25：类继承（自举同步第 6 刀）
        NodeKind.SUPER_CLASS : rtn "SUPER_CLASS"
        NodeKind.SUPER_CALL : rtn "SUPER_CALL"
        NodeKind.FINAL : rtn "FINAL"
        NodeKind.ABSTRACT : rtn "ABSTRACT"
        // 阶段 24（自举同步 24b）：类型转换 / 类型判断
        NodeKind.AS : rtn "AS"
        NodeKind.IS : rtn "IS"
        NodeKind.TARGET : rtn "TARGET"
        // 阶段 30c：函数值字面量
        NodeKind.LAMBDA : rtn "LAMBDA"
    }
    // 上面那个 switch 已经穷尽了 NodeKind 的每一个值，这里只是给「函数一定有返回值」
    // 一个静态的落点（rsf 的返回值检查是看最后一条语句，不看 switch 的穷尽性）。
    rtn "?"
}

// ---------------------------------------------------------------- 胖节点

public class Node(kind : NodeKind, text : string) {
    var kind : NodeKind = kind
    // 阶段 33：列号（1 基，0 = 没定）。只给 Checker 报错用，**不进属性串** ⇒ dump 与对拍不受影响。
    var col : int = 0

    // 阶段 33：把源位置挂到节点上（链式写法：`new Node(...).at(tok)`）
    public fn at(t : Token) -> Node {
        this.line = t.line
        this.col = t.col
        rtn this
    }
    // 位置照抄另一个节点（二元表达式要报左操作数起点，不是运算符）
    public fn atNode(o : Node) -> Node {
        this.line = o.line
        this.col = o.col
        rtn this
    }
    // 属性串：`name=foo mutable=true`（字段之间正好一个空格）。
    // 值里的空格/换行已经在 escapeValue 里转义掉了，所以「按空格切」是无歧义的。
    var text : string = text
    var children : Node[] = new Node[0]
    var childCount : int = 0
    // 源码行号（1 起）；**0 表示还没定**，由最近的语句起头 token 补上，发射时统一钳到 >=1。
    // 只用来生成 `LineNumberTable`：Kotlin 侧每个 AST 节点带 `at: SourceLine`，这里对应地记一个行号。
    // dump（astLine）不打印它，所以不影响 17b 的差分对拍。
    var line : int = 0

    constructor(kind : NodeKind) {
        this(kind, "")
    }

    // 追加一个属性。属性顺序 = put 的顺序，必须与 AstDump.kt 里那几个函数写字段的顺序一致。
    public fn put(name : string, value : string) -> Node {
        if (text.length() == 0) {
            text = name + "=" + value
        } else {
            text = text + " " + name + "=" + value
        }
        rtn this
    }

    // 追加一个孩子。rsf 的数组长度固定，所以满了就翻倍（和 Lexer.rsf 的 pushToken 一个套路）。
    public fn add(child : Node) -> Node {
        if (childCount >= children.length) {
            var size = 8
            if (children.length > 0) { size = children.length * 2 }
            var bigger : Node[] = new Node[size]
            for (var i = 0; i < childCount; i = i + 1) {
                bigger[i] = children[i]
            }
            children = bigger
        }
        children[childCount] = child
        childCount = childCount + 1
        rtn this
    }

    // 列表节点的 `count=N`：必须在孩子都加完之后调。
    public fn countTag() -> Node {
        rtn put("count", intToString(childCount))
    }
}

// ---------------------------------------------------------------- 类型引用
//
// Kotlin 版的 TypeRef 是个节点，这里有两点不同：
//   * **不进 children**，而是内联成 `type=...` 属性（它没有孩子，拆成节点只会让 dump 变长）；
//   * **不是 Node**：`parseTypeRef()` 直接返回这个三字段的小对象，字符串形式按需拼。
//
// `name` 里可能带前导 `?`（可空写在名字里，和 Kotlin 版的 `TypeRef.name` 一样）；
// `args` 存的是**实参表内部**的文本（`int` / `int,string`），空串表示没有 `&<...>`；
// `nested` 存嵌套类型的第二段（`Marker::Impl` 里的 `Impl`），空串表示没有 `::`
// （和 Kotlin 版 `TypeRef.nested : String?` 一样，v1 只允许一层）。

public class TypeInfo(name : string, args : string, depth : int, nested : string) {
    var name : string = name
    var args : string = args
    var depth : int = depth
    var nested : string = nested
    // 阶段 30c：函数类型 `(int) -> int`。与 Kotlin 的 TypeRef.fnParams / fnRet 同一个口径：
    // 函数类型的名字固定是 "fn" / "?fn"（可空），形参与返回类型另存。
    // 形参存成**逗号分隔的类型文本**（每个元素自己已经渲染好，可以再含空格与括号），
    // 这样 Backend 只要按深度 0 的逗号切一刀就能还原参数表。
    var isFn : bool = false
    var fnParams : string = ""
    var fnRet : string = ""

    // 造一个函数类型的副本（`(int) -> int` / `?(int) -> int`）
    public fn asFn(params : string, ret : string) -> TypeInfo {
        var t = new TypeInfo(name, args, depth, nested)
        t.isFn = true
        t.fnParams = params
        t.fnRet = ret
        rtn t
    }

    public fn text() -> string {
        // 阶段 30c：函数类型先拼签名，再挂数组后缀（与 AstDump.typeText 同一套）：
        //   (int,int) -> int      ?(int) -> int      ((int) -> int)[]
        if (isFn) {
            var sig = "(" + fnParams + ") -> " + fnRet
            if (startsWithChar(name, '?')) { sig = "?" + sig }
            if (depth == 0) { rtn sig }
            rtn "(" + sig + ")" + repeatText("[]", depth)
        }
        var out = name
        if (args.length() > 0) { out = out + "&<" + args + ">" }
        if (nested.length() > 0) { out = out + "::" + nested }
        rtn out + repeatText("[]", depth)
    }

    public fn argsOrDash() -> string {
        if (args.length() == 0) { rtn "-" }
        rtn args
    }
}

// ---------------------------------------------------------------- 小工具

fn repeatText(s : string, n : int) -> string {
    var out = ""
    for (var i = 0; i < n; i = i + 1) {
        out = out + s
    }
    rtn out
}

fn boolText(b : bool) -> string {
    if (b) { rtn "true" }
    rtn "false"
}

fn startsWithChar(s : string, c : char) -> bool {
    if (s.length() == 0) { rtn false }
    rtn s.charAt(0) == c
}

public fn isTypeKeyword(kind : string) -> bool {
    if (kind == "KW_VOID") { rtn true }
    if (kind == "KW_INT") { rtn true }
    if (kind == "KW_LONG") { rtn true }
    if (kind == "KW_FLOAT") { rtn true }
    if (kind == "KW_DOUBLE") { rtn true }
    if (kind == "KW_STRING") { rtn true }
    if (kind == "KW_BOOL") { rtn true }
    if (kind == "KW_BYTE") { rtn true }
    if (kind == "KW_CHAR") { rtn true }
    rtn false
}

public fn isControlKeyword(kind : string) -> bool {
    if (kind == "KW_PUBLIC") { rtn true }
    if (kind == "KW_PRIVATE") { rtn true }
    if (kind == "KW_PROTECTED") { rtn true }
    rtn false
}

fn isStaticKeyword(kind : string) -> bool { rtn kind == "KW_STATIC" }

fn isOverrideKeyword(kind : string) -> bool { rtn kind == "KW_OVERRIDE" }

// 阶段 25：继承修饰词（阶段 27 起只剩 `final` / `abstract`，与 Kotlin 侧
// TokenKind.isInheritKeyword 同口径，见 src/main/kotlin/org/example/complie/lexing/Token.kt）。
// 注意 `super` **不在**这里：它不是修饰词，而是表达式位置上的接收者。
fn isInheritKeyword(kind : string) -> bool {
    if (kind == "KW_FINAL") { rtn true }
    rtn kind == "KW_ABSTRACT"
}

// 排在声明前面的修饰词（与 Kotlin 侧 TokenKind.isModifierKeyword 同口径：
// 权限修饰词 / static / override / 继承修饰词）。接口体的成员循环要用它把一整个修饰词串数完。
fn isModifierKeyword(kind : string) -> bool {
    if (isControlKeyword(kind)) { rtn true }
    if (isStaticKeyword(kind)) { rtn true }
    if (isInheritKeyword(kind)) { rtn true }
    rtn isOverrideKeyword(kind)
}

fn isVarKeyword(kind : string) -> bool {
    if (kind == "KW_VAR") { rtn true }
    rtn kind == "KW_IMUTVAR"
}

fn isReturnKeyword(kind : string) -> bool {
    if (kind == "KW_RTN") { rtn true }
    rtn kind == "KW_RETURN"
}

fn isComparisonKind(kind : string) -> bool {
    if (kind == "LT") { rtn true }
    if (kind == "GT") { rtn true }
    if (kind == "LE") { rtn true }
    rtn kind == "GE"
}

fn isEqualityKind(kind : string) -> bool {
    if (kind == "EQ") { rtn true }
    rtn kind == "NE"
}

fn isAddKind(kind : string) -> bool {
    if (kind == "PLUS") { rtn true }
    rtn kind == "MINUS"
}

fn isMulKind(kind : string) -> bool {
    if (kind == "STAR") { rtn true }
    if (kind == "SLASH") { rtn true }
    rtn kind == "PERCENT"
}

fn isLiteralKind(kind : string) -> bool {
    if (kind == "INT_LIT") { rtn true }
    if (kind == "LONG_LIT") { rtn true }
    if (kind == "FLOAT_LIT") { rtn true }
    if (kind == "DOUBLE_LIT") { rtn true }
    if (kind == "STRING_LIT") { rtn true }
    rtn kind == "CHAR_LIT"
}

// 控制词 -> ControlType 的名字（Kotlin 版是 ControlType.of(kind).name）
fn controlName(kind : string) -> string {
    if (kind == "KW_PUBLIC") { rtn "PUBLIC" }
    if (kind == "KW_PRIVATE") { rtn "PRIVATE" }
    if (kind == "KW_PROTECTED") { rtn "PROTECTED" }
    rtn "DEFAULT"
}

// 类型关键字 -> 规范类型名（Kotlin 版的 canonicalTypeName：别名 str / boolean 归一化）
fn canonicalTypeName(kind : string) -> string {
    if (kind == "KW_VOID") { rtn "void" }
    if (kind == "KW_INT") { rtn "int" }
    if (kind == "KW_LONG") { rtn "long" }
    if (kind == "KW_FLOAT") { rtn "float" }
    if (kind == "KW_DOUBLE") { rtn "double" }
    if (kind == "KW_STRING") { rtn "string" }
    if (kind == "KW_BOOL") { rtn "bool" }
    if (kind == "KW_BYTE") { rtn "byte" }
    if (kind == "KW_CHAR") { rtn "char" }
    rtn ""
}

// 阶段 28b：反引号只允许出现在「标签声明」和 `goto` 之后。其它位置（表达式、变量名、
// 字段名、函数名、goto 以外的语句首……）一律报这一句 —— 与 Kotlin 版
// Parser.labelNameOnlyError（:3090）**逐字一致**（含逗号后没有空格）。
public fn labelNameOnlyMessage() -> string {
    rtn "反引号只用来写标签名（合法写法只有 `名字:` 与 goto `名字` 两种），变量 / 字段 / 函数名不能用反引号"
}

// ---------------------------------------------------------------- 值转义
//
// 与 AstDump.kt 的 `esc` **是同一张表**：`\` `换行` `回车` `制表` `空格` 各自一个转义，
// 其余 < 0x20 的控制字符写成 `\xNN`（小写两位十六进制）。中文原样输出。
//
// 为什么非要转义空格：dump 的行格式是「字段之间正好一个空格」，值里再出现空格
// 就没法按空格切了 —— 而字符串字面量 `"hello world"` 里就有空格。

public fn escapeValue(s : string) -> string {
    var out = ""
    for (var i = 0; i < s.length(); i = i + 1) {
        var c = s.charAt(i)
        if (c == '\\') {
            out = out + "\\\\"
        } else {
            if (c == '\n') {
                out = out + "\\n"
            } else {
                if (c == '\r') {
                    out = out + "\\r"
                } else {
                    if (c == '\t') {
                        out = out + "\\t"
                    } else {
                        if (c == ' ') {
                            out = out + "\\s"
                        } else {
                            if (charToInt(c) < 32) {
                                out = out + "\\x" + hex2(charToInt(c))
                            } else {
                                out = out + c
                            }
                        }
                    }
                }
            }
        }
    }
    rtn out
}

fn hexDigitChar(v : int) -> char {
    if (v < 10) { rtn toChar(48 + v) }
    rtn toChar(87 + v)
}

fn hex2(v : int) -> string {
    rtn "" + hexDigitChar(v / 16) + hexDigitChar(v % 16)
}

// ---------------------------------------------------------------- import 路径
//
// Kotlin 版：`raw.split('\n').map { it.trim() }.filter { it.isNotEmpty() }.joinToString("")`。
// rsf 没有 split/join，只能自己走一遍字符；trim 用内置的 isWhitespace
// （正是 Kotlin 的 Char.isWhitespace，所以两边裁的是同一批字符）。

fn trimWhitespace(s : string) -> string {
    var from = 0
    var to = s.length()
    while (from < to) {
        if (!isWhitespace(s.charAt(from))) { break }
        from = from + 1
    }
    while (to > from) {
        if (!isWhitespace(s.charAt(to - 1))) { break }
        to = to - 1
    }
    rtn s.substring(from, to)
}

fn normalizeImportPath(raw : string) -> string {
    var out = ""
    var line = ""
    for (var i = 0; i < raw.length(); i = i + 1) {
        var c = raw.charAt(i)
        if (charToInt(c) == 10) {
            out = out + trimWhitespace(line)
            line = ""
        } else {
            line = line + c
        }
    }
    rtn out + trimWhitespace(line)
}

// ---------------------------------------------------------------- 字面量的「值」文本
//
// 与 Kotlin 版 AST 里存的值**一模一样**（`IntLit.value` / `DoubleLit.value` …），
// 走的也是同一批 JVM 方法，所以源码文本与值的十进制写法不同的那种输入
// （`007`、`3.141592653589793238`、`2.5D`）两端也能对上。

fn intLiteralText(t : Token) -> string {
    rtn Integer.toString(Integer.parseInt(t.text))
}

fn longLiteralText(t : Token) -> string {
    // 词法阶段已经把后缀统一成小写，所以 LONG_LIT 的文本一定是「数字 + l」
    rtn Long.toString(Long.parseLong(dropLast(t.text)))
}

fn floatLiteralText(t : Token) -> string {
    rtn Float.toString(Float.parseFloat(dropLast(t.text)))
}

fn doubleLiteralText(t : Token) -> string {
    // 带 d 后缀要去掉；不带后缀的（源码里写了小数点）整串就是数字
    if (endsWithLetter(t.text, 'd')) {
        rtn Double.toString(Double.parseDouble(dropLast(t.text)))
    }
    rtn Double.toString(Double.parseDouble(t.text))
}

// ---------------------------------------------------------------- 阶段 25：类继承的小结构
//
// Kotlin 侧对应 `Parser.kt:945` 的 `SuperClause` 与 `:952` 的 `InheritModifiers`
// （两个只装数据的私有类）。rsf 没有 `?` 可空类型，所以「父类槽位为空」用
// **baseName 为空串**表示（类名不可能是空串，不会歧义）。
// 父类型列表本身仍是一个 Node（SUPERS），与接口那条通路共用。

public class SuperClause(baseName : string, baseDisplay : string, baseArgs : Node, interfaces : Node) {
    var baseName : string = baseName
    // dump 里 `SUPER_CLASS display=` 打的是**类型文本**（可能带 `&<T>`），不是裸名字
    var baseDisplay : string = baseDisplay
    var baseArgs : Node = baseArgs
    var interfaces : Node = interfaces
}

public class InheritMods(isFinal : bool, isAbstract : bool) {
    var isFinal : bool = isFinal
    var isAbstract : bool = isAbstract
}

// ================================================================ 语法分析器本体

public class Parser(tokens : Token[]) {
    var ts : Token[] = tokens
    var pos : int = 0

    // `for (i in a..b)` 解糖时生成不重名的内部变量名（与 Kotlin 版的 synthCounter 一个意思，
    // 连「第几个 for-in」的编号顺序都要一样，否则 __rsf_forEnd0 会对不上 __rsf_forEnd1）
    var synth : int = 0

    var failed : bool = false
    var failMessage : string = ""
    var failLine : int = 0
    var failCol : int = 0
    // 接口里的方法**可以没有体**（抽象方法）——这是接口与类在语法上唯一的分叉。
    // parseInterfaceDecl 在成员循环期间把它置 true、循环结束还原；parseFuncDecl 靠它
    // 决定「没有 '{' 时不打 BLOCK、也不报错」。不给 parseFuncDecl 加参数，是为了不动
    // 它在别处的既有调用点（顶层 / 类体）。
    var abstractBodyOk : bool = false
    // `override` 只准写在**类体 / 接口体**的方法上——这是 Kotlin 版 parseFuncDecl 的
    // `allowOverride` 开关（缺省 false：顶层写 `override fun` 要判失败）。同样用「置位/还原」
    // 的字段表达，不加参数，保住 parseFuncDecl 的既有调用点形状与顶层的既有行为。
    var overrideOk : bool = false
    // `final` / `abstract` 只准写在**类头**与**类体里的方法**前面（阶段 25；阶段 27 起只剩这两个词）——
    // 这是 Kotlin 版 `parseInheritModifiers` 的 `allowInheritModifiers` 开关
    // （Parser.kt:1505，缺省 false：接口体与顶层都不认这两个词）。同样用「置位/还原」
    // 的字段表达，保住 parseFuncDecl 的既有调用点形状。
    var inheritOk : bool = false

    // ------------------------------------------------------------ 出错

    fn failAt(t : Token, message : string) -> void {
        if (failed) { rtn }
        failed = true
        failLine = t.line
        failCol = t.col
        failMessage = message
    }

    fn errorNode() -> Node {
        var n = new Node(NodeKind.ERROR)
        n.put("message", escapeValue(failMessage))
        rtn n
    }

    // ------------------------------------------------------------ 记号流

    fn peekAt(offset : int) -> Token {
        var i = pos + offset
        if (i >= ts.length) { i = ts.length - 1 }
        rtn ts[i]
    }

    fn peek() -> Token { rtn peekAt(0) }

    // 刚消费掉的那个记号（阶段 33：给二元表达式取运算符位置用）
    fn prevToken() -> Token {
        var i = pos - 1
        if (i < 0) { i = 0 }
        if (i >= ts.length) { i = ts.length - 1 }
        rtn ts[i]
    }

    fn check(kind : string) -> bool { rtn peek().kind == kind }

    fn checkAt(offset : int, kind : string) -> bool { rtn peekAt(offset).kind == kind }

    // 与 Kotlin 版一样：EOF 上 advance 不动（不然会越界，循环也停不下来）
    fn advance() -> Token {
        var t = peek()
        if (t.kind != "EOF") { pos = pos + 1 }
        rtn t
    }

    fn matchOne(kind : string) -> bool {
        if (!check(kind)) { rtn false }
        advance()
        rtn true
    }

    // 没有可变参数 / 重载，所以按参数个数各写一个（这是 rsf 目前最直接的缺口之一，
    // 见报告里「rsf 还缺什么」）
    fn matchAny2(a : string, b : string) -> bool {
        if (matchOne(a)) { rtn true }
        rtn matchOne(b)
    }

    fn matchAny3(a : string, b : string, c : string) -> bool {
        if (matchOne(a)) { rtn true }
        if (matchOne(b)) { rtn true }
        rtn matchOne(c)
    }

    fn matchAny4(a : string, b : string, c : string, d : string) -> bool {
        if (matchOne(a)) { rtn true }
        if (matchOne(b)) { rtn true }
        if (matchOne(c)) { rtn true }
        rtn matchOne(d)
    }

    fn expect(kind : string, message : string) -> Token {
        if (!check(kind)) {
            failAt(peek(), message)
            rtn advance()
        }
        rtn advance()
    }

    fn hasFailed() -> bool { rtn failed }
    fn errorMessage() -> string { rtn failMessage }
    fn errorLine() -> int { rtn failLine }
    fn errorCol() -> int { rtn failCol }

    // 从节点的 `k=v` 属性串里取一个值。**只给不含空格的短值用**（名字、类型参数表这类）：
    // 扫到空格或结尾就停。带空格的类型文本（`(int) -> int`）要走 Backend/Interp 那边
    // 的 prop/attr（它们的结束判据是「空格 + 标识符 + '='」）。
    fn nodeProp(n : Node, key : string) -> string {
        var mark = key + "="
        var at = n.text.indexOf(mark)
        if (at < 0) { rtn "" }
        var i = at + mark.length()
        var start = i
        while (i < n.text.length() && n.text.charAt(i) != ' ') { i = i + 1 }
        rtn n.text.substring(start, i)
    }

    // ============================================================ 顶层

    fn parseProgram() -> Node {
        var program = new Node(NodeKind.PROGRAM)

        // pkg 只能出现在最前面（在 import 之前），和 Java 的 package 一样
        var hasPkg = false
        var pkgName = ""
        if (check("KW_PKG")) {
            pkgName = parsePackageDecl()
            hasPkg = true
        }

        var imports = new Node(NodeKind.IMPORTS)
        var funcs = new Node(NodeKind.FUNCS)
        var classes = new Node(NodeKind.CLASSES)
        var enums = new Node(NodeKind.ENUMS)
        // 阶段 20：接口会归到单独的 INTERFACES 桶里，dump 时排在 ENUMS 后面（与 AstDump.kt 一致）
        var interfaces = new Node(NodeKind.INTERFACES)
        // 阶段 21：注解声明归到单独的 ANNOTATIONS 桶里，dump 时排在 INTERFACES 后面（与 AstDump.kt 一致）
        var annotations = new Node(NodeKind.ANNOTATIONS)

        while (!check("EOF") && !failed) {
            // 声明前的注解（阶段 21）：`@Marker public class C { }`。注解与 `public`/`static`/
            // `override` **顺序任意、可连写多个**，所以先在这里收干净再按「接下来是什么声明」分派；
            // 每种声明各自带走自己那份表。收不到就是空表（`ANNOTATION_USES count=0`）。
            var declAnnotations = parseAnnotations()
            if (check("KW_IMPORT") || check("KW_MODULE")) {
                imports.add(parseImport())
            } else {
                if (check("KW_PKG")) {
                    failAt(peek(), "'pkg' 只能写在文件最前面（在所有 import 之前）")
                } else {
                    if (check("KW_INTERFACE") || isInterfaceDeclAhead()) {
                        interfaces.add(parseInterfaceDecl(declAnnotations))
                    } else {
                        if (check("KW_ENUM") || isEnumDeclAhead()) {
                            // 枚举**不是** v1 的可标注位置（可标注位置只有类 / 接口 / 注解声明 /
                            // 方法 / 字段）：明确拦下，别让 `@Marker` 被悄悄丢掉——用户会以为标上了。
                            if (declAnnotations.childCount > 0) {
                                failAt(peek(), "注解不能标在枚举声明上：v1 的可标注位置是类 / 接口 / 注解声明 / 方法 / 字段（枚举留到后续阶段）")
                            }
                            enums.add(parseEnumDecl())
                        } else {
                            if (check("KW_CLASS") || isClassDeclAhead()) {
                                classes.add(parseClassDecl(declAnnotations))
                            } else {
                                if (check("KW_ANNOTATION") || isAnnotationDeclAhead()) {
                                    annotations.add(parseAnnotationDecl(declAnnotations))
                                } else {
                                    funcs.add(parseFuncDecl(declAnnotations))
                                }
                            }
                        }
                    }
                }
            }
        }

        // 孩子顺序固定为 PKG / IMPORTS / FUNCS / CLASSES / ENUMS / INTERFACES / ANNOTATIONS
        //（与 AstDump.kt 一致）。注解桶**追加在最后**：位置索引铁律见文件头的说明。
        if (hasPkg) {
            program.add(new Node(NodeKind.PKG).put("name", escapeValue(pkgName)))
        }
        program.add(imports.countTag())
        program.add(funcs.countTag())
        program.add(classes.countTag())
        program.add(enums.countTag())
        program.add(interfaces.countTag())
        program.add(annotations.countTag())
        rtn program
    }

    // 包名段之间 ` . ` ` \ ` `/` 都收，混写也行，最后统一成点分形式
    fn parsePackageDecl() -> string {
        advance()   // pkg
        var parts = readPkgIdent()
        var going = true
        while (going && !failed) {
            var separated = false
            if (matchOne("DOT")) {
                separated = true
            } else {
                if (matchOne("SLASH")) {
                    separated = true
                } else {
                    if (matchOne("BACKSLASH")) { separated = true }
                }
            }
            if (separated) {
                parts = parts + "." + readPkgIdent()
            } else {
                going = false
            }
        }
        rtn parts
    }

    fn readPkgIdent() -> string {
        var t = peek()
        if (t.kind != "IDENT") {
            failAt(t, "包名需要标识符（例如 pkg util 或 pkg a.b）")
            rtn ""
        }
        advance()
        rtn t.text
    }

    // 声明前面那一串修饰词的个数（权限 / static / override / final / abstract）。
    // 阶段 25 起 `class Base` 里 `class` 前面不再是「一个可选的权限修饰词」，
    // 所以四个前瞻都要按 Kotlin 版 modifierRun 的口径**整串**跳过去再认声明关键字。
    fn modifierRun() -> int {
        var offset = 0
        while (isModifierKeyword(peekAt(offset).kind)) {
            offset = offset + 1
        }
        rtn offset
    }

    // 继承修饰词后面是不是一个字段：`var x` / `final var x`。
    // 字段不吃继承修饰词（阶段 25 禁止字段遮蔽，DESIGN-25 §5），要单独给一句准确的报错
    // （Kotlin 版 isFieldDeclAheadAfterInherit，Parser.kt:1422）。
    fn isFieldDeclAheadAfterInherit() -> bool {
        if (!isInheritKeyword(peek().kind)) { rtn false }
        var n = 0
        while (isInheritKeyword(peekAt(n).kind)) {
            n = n + 1
        }
        rtn isVarKeyword(peekAt(n).kind)
    }

    fn isClassDeclAhead() -> bool {
        rtn peekAt(modifierRun()).kind == "KW_CLASS"
    }

    fn isEnumDeclAhead() -> bool {
        rtn peekAt(modifierRun()).kind == "KW_ENUM"
    }

    // `interface` 是硬关键字，写接口不用修饰词也认；带了 public 也要认，
    // 所以先跳过前缀里的修饰词（与 isClassDeclAhead 同一招）。
    fn isInterfaceDeclAhead() -> bool {
        rtn peekAt(modifierRun()).kind == "KW_INTERFACE"
    }

    // 阶段 21：`annotation` 跟 `interface` 一样是硬关键字，带了 public 也要认。
    // 注意调用点（parseProgram）**已经把声明前的注解收掉了**，所以这里只需要跳过修饰词，
    // 与 isClassDeclAhead / isEnumDeclAhead / isInterfaceDeclAhead 完全同款。
    fn isAnnotationDeclAhead() -> bool {
        rtn peekAt(modifierRun()).kind == "KW_ANNOTATION"
    }

    // 三种 import：点分路径（JVM 类）、字符串路径（rsf 源文件）、module 目录
    fn parseImport() -> Node {
        var kw = advance()
        var isModule = kw.kind == "KW_MODULE"

        if (check("STRING_LIT")) {
            var t = advance()
            var path = normalizeImportPath(t.text)
            if (path.length() == 0) {
                failAt(t, kw.text + " 的路径是空的")
            }
            if (isModule) {
                rtn new Node(NodeKind.MODULE_IMPORT).put("path", escapeValue(path))
            }
            rtn new Node(NodeKind.SOURCE_IMPORT).put("path", escapeValue(path))
        }

        if (isModule) {
            failAt(peek(), "'module' 后面需要一个目录路径，写成 module \"文件夹\"")
            rtn new Node(NodeKind.MODULE_IMPORT).put("path", "")
        }

        var firstTok = expect("IDENT", kw.text + " 后面需要一个类名（点分路径，例如 java.lang.Math）或者一个字符串路径")
        var path2 = firstTok.text
        while (matchOne("DOT")) {
            var seg = expect("IDENT", "'.' 后面需要标识符")
            path2 = path2 + "." + seg.text
        }
        rtn new Node(NodeKind.CLASS_IMPORT).put("path", escapeValue(path2))
    }

    // ============================================================ 枚举

    fn parseEnumDecl() -> Node {
        var control = "DEFAULT"
        if (isControlKeyword(peek().kind)) { control = controlName(advance().kind) }
        var enumTok = expect("KW_ENUM", "enum 声明缺少 'enum'")
        var nameTok = expect("IDENT", "'enum' 后面缺少枚举名")

        expect("LBRACE", "枚举 '" + nameTok.text + "' 缺少 '{'")

        var values = new Node(NodeKind.VALUES)
        while (!check("RBRACE") && !check("EOF") && !failed) {
            var valueTok = expect("IDENT", "枚举 '" + nameTok.text + "' 里需要一个值名（写法是 IDENT, INT_LIT, ...）")
            values.add(new Node(NodeKind.ENUM_VALUE).put("name", escapeValue(valueTok.text)))
            // 尾逗号可写可不写：没吃到逗号就说明值列完了
            if (!matchOne("COMMA")) { break }
        }
        expect("RBRACE", "枚举 '" + nameTok.text + "' 没有闭合，缺少 '}'")

        if (values.childCount == 0) {
            failAt(enumTok, "枚举 '" + nameTok.text + "' 至少要有一个值")
        }

        var n = new Node(NodeKind.ENUM).put("control", control).put("name", escapeValue(nameTok.text))
        n.add(values.countTag())
        rtn n
    }

    // ============================================================ 类

    // annotations：声明前收到的注解序列（`@Marker public class C { }`）；空表也要挂（count=0），
    // 而且**挂在最后**（位置索引铁律：Interp.rsf:792/805/888/919 与 Backend.rsf:5692 用位置读孩子）。
    fn parseClassDecl(annotations : Node) -> Node {
        // 阶段 25 K5a-fix：类头的权限修饰词与继承修饰词**任意穿插**（`public class` 与
        // `open public class` 等价），与 Kotlin 版 Parser.kt:669 的循环一一对应。
        // 权限修饰词仍然只收一个；被权限词隔开的几段继承修饰词由 mergeInheritMods 合起来
        // 判重与互斥（`open public final class`）——与 parseFuncDecl 收到两段时同一条通路。
        var control = "DEFAULT"
        var sawControl = false
        var mods = new InheritMods(false, false)
        var going = true
        while (going && !failed) {
            if (!sawControl && isControlKeyword(peek().kind)) {
                control = controlName(advance().kind)
                sawControl = true
            } else {
                if (isInheritKeyword(peek().kind)) {
                    mods = mergeInheritMods(mods, "类")
                } else {
                    going = false
                }
            }
        }
        var classTok = expect("KW_CLASS", "class 声明缺少 'class'")
        var nameTok = expect("IDENT", "'class' 后面缺少类名")

        // 类型参数子句 `class Box&<T>` / `class Pair&<K, V>`
        var typeParams = new Node(NodeKind.TYPE_PARAMS)
        var seenParams = new string[8]
        var seenCount = 0
        if (check("AMP")) {
            advance()
            expect("LT", "'&' 后面缺少 '<'：类型参数要写成 class " + nameTok.text + "&<T>")
            var going = true
            while (going && !failed) {
                var paramTok = expect("IDENT", "类型参数需要一个名字，写法是 class " + nameTok.text + "&<T>")
                // **没有 HashSet**：重名只能拿数组线性查（见报告里「rsf 还缺什么」）
                for (var i = 0; i < seenCount; i = i + 1) {
                    if (seenParams[i] == paramTok.text) {
                        failAt(paramTok, "类 '" + nameTok.text + "' 的类型参数 '" + paramTok.text + "' 重名了")
                    }
                }
                if (paramTok.text == nameTok.text) {
                    failAt(paramTok, "类型参数不能和类同名（都叫 '" + nameTok.text + "'）")
                }
                if (seenCount >= seenParams.length) {
                    var bigger : string[] = new string[seenParams.length * 2]
                    for (var i = 0; i < seenCount; i = i + 1) { bigger[i] = seenParams[i] }
                    seenParams = bigger
                }
                seenParams[seenCount] = paramTok.text
                seenCount = seenCount + 1
                typeParams.add(new Node(NodeKind.TYPE_PARAM).put("name", escapeValue(paramTok.text)))
                if (!matchOne("COMMA")) { going = false }
            }
            expect("GT", "类 '" + nameTok.text + "' 的类型参数表没有闭合，缺少 '>'")
        }

        // 主构造（类头那对括号）在解析时合成一个 FuncDecl：名字 = 类名、体是**空块**。
        // 它排进 METHODS 的**最前面**，字段与方法按源码顺序跟在后面。
        var methods = new Node(NodeKind.METHODS)
        if (check("LPAREN")) {
            var ctorParams = parseParamList("类 '" + nameTok.text + "' 的主构造参数表没有闭合，缺少 ')'", false)
            var primary = new Node(NodeKind.FUNC)
                .put("control", "DEFAULT")
                .put("static", "false")
                .put("main", "void")
                .put("name", escapeValue(nameTok.text))
                .put("ret", "OMITTED")
                .put("mayError", "false")
                .put("retType", "void")
                .put("ctor", "true")
                .put("primary", "true")
                .put("override", "false")
            primary.add(ctorParams)
            primary.add(new Node(NodeKind.BLOCK).countTag())
            // 阶段 21：注解表是每个 FUNC 的最后一个孩子；合成出来的主构造没有注解，打空表
            primary.add(new Node(NodeKind.ANNOTATION_USES).countTag())
            methods.add(primary)
        }

        // `:` 父类型子句：阶段 25 起「最前面那个带实参表的」是**父类**、其余是接口
        // （Kotlin 版 parseSuperClause，Parser.kt:850）。类与接口共用同一个父类型列表解析函数。
        // **顺序固定为「主构造括号 → ':' 子句 → '{'」**：Kotlin 版 parseClassDecl 就是这样
        // 排的（主构造先吃掉类头那对括号，再解析父类型），`class Impl(x : int) : Greeter`
        // 里的 `:` 在括号**后面**——子句解析放前面会让那个 `:` 撞上 expect('{')。
        var sup = parseSuperClause(nameTok.text)

        expect("LBRACE", "类 '" + nameTok.text + "' 缺少 '{'")

        var fields = new Node(NodeKind.FIELDS)
        // 成员方法允许写 `override`（阶段 20）与 `open`/`final`/`abstract`（阶段 25）：
        // 循环期间打开开关，循环结束（含中途报错退出）还原
        var oldOverrideOk = overrideOk
        var oldInheritOk = inheritOk
        overrideOk = true
        inheritOk = true
        while (!check("RBRACE") && !check("EOF") && !failed) {
            // 成员（字段 / 方法 / 次构造）也要行号：字段初始化块与函数体里的指令都要发
            // `LineNumberTable`，字段那条取的是**声明行**
            var memberLine = peek().line
            // 阶段 21：注解可以和修饰词混写（`@M public fun f()` / `public @M fun f()`），
            // 所以先收注解再分派；字段/方法各自带走自己的那份表（与 Kotlin 版 parseClassDecl 同序）。
            var memberAnnotations = parseAnnotations()
            if (isVarKeyword(peek().kind)) {
                var fld = parseFieldDecl(memberAnnotations)
                if (fld.line < 1) { fld.line = memberLine }
                fields.add(fld)
            } else {
                // 字段不吃继承修饰词（阶段 25 禁止字段遮蔽，DESIGN-25 §5）：`var x` 要报一句
                // 准确的错，而不是掉进 parseFuncDecl 撞「这里需要一个函数声明」
                // （Kotlin 版 isFieldDeclAheadAfterInherit，Parser.kt:1422）。
                if (isFieldDeclAheadAfterInherit()) {
                    failAt(peek(), "字段不能写 'final' / 'abstract'：子类不能重复声明父类已有的字段（阶段 25 禁止字段遮蔽，DESIGN-25 §5），所以字段没有「可被覆盖」这一说，把修饰词删掉")
                }
                // 构造器：`constructor` 以及「修饰词 + constructor」。修饰词可以排一串
                // （阶段 25 起还包括 final/abstract），所以按 Kotlin 版 modifierRun
                // 的口径整串跳过去再认（Parser.kt:721/738）。
                var ctorAhead = peek().kind == "KW_CONSTRUCTOR" ||
                    (isModifierKeyword(peek().kind) && peekAt(modifierRun()).kind == "KW_CONSTRUCTOR")
                var mem = new Node(NodeKind.ERROR)
                if (ctorAhead) {
                    // 构造器上不能写注解（v1 的可标注位置里没有构造器）
                    if (memberAnnotations.childCount > 0) {
                        failAt(peek(), "构造器上不能写注解（'@'）：v1 的注解只标在类/接口/注解声明/方法/字段上")
                    }
                    // 阶段 25：构造器上的 final/abstract 收下来就丢掉（构造器不参与继承），
                    // 与 Kotlin 版 parseClassDecl:745 完全同款——收下来是为了让 parseConstructor
                    // 看到的第一个记号就是 `constructor` 本身。
                    if (isInheritKeyword(peek().kind)) {
                        parseInheritModifiers("构造器")
                    }
                    mem = parseConstructor(nameTok.text, memberAnnotations)
                } else {
                    mem = parseFuncDecl(memberAnnotations)
                }
                if (mem.line < 1) { mem.line = memberLine }
                methods.add(mem)
            }
        }
        overrideOk = oldOverrideOk
        inheritOk = oldInheritOk
        expect("RBRACE", "类 '" + nameTok.text + "' 没有闭合，缺少 '}'")

        // 孩子顺序**必须**与 AstDump.kt 的 classDecl(:179) 一致：
        //   CLASS → SUPERS → [SUPER_CLASS + 它的 ARGS] → [FINAL | ABSTRACT] →
        //   TYPE_PARAMS → FIELDS → METHODS → ANNOTATION_USES
        // SUPERS/后四项一个都不能少（位置索引铁律：Interp.rsf:792/805/888/919 与
        // Backend.rsf:5692 按位置读孩子）。父类槽位与两个修饰词节点**只在写了时**挂，
        // 所以既有语料的字节一个都不变。
        var n = new Node(NodeKind.CLASS).put("control", control).put("name", escapeValue(nameTok.text)).at(classTok)
        n.add(sup.interfaces)
        if (sup.baseName.length() > 0) {
            var base = new Node(NodeKind.SUPER_CLASS)
                .put("name", escapeValue(sup.baseName))
                .put("display", escapeValue(sup.baseDisplay))
            base.add(sup.baseArgs.countTag())
            n.add(base)
        }
        if (mods.isFinal) { n.add(new Node(NodeKind.FINAL)) }
        if (mods.isAbstract) { n.add(new Node(NodeKind.ABSTRACT)) }
        n.add(typeParams.countTag())
        n.add(fields.countTag())
        n.add(methods.countTag())
        n.add(annotations.countTag())
        rtn n
    }

    // 次构造：`constructor(参数) { ... }`。没有返回类型、不能写权限修饰词、不能 static。
    // annotations：构造器声明前的注解表（类体里带注解的构造器在语法层就被拒，这里只是照签名带过来）。
    fn parseConstructor(className : string, annotations : Node) -> Node {
        if (isControlKeyword(peek().kind)) {
            failAt(peek(), "constructor 不能写权限修饰词：构造器只能通过 new 调用")
        }
        if (isStaticKeyword(peek().kind)) {
            failAt(peek(), "constructor 不能是 static：构造器一定要有当前对象（this）")
        }
        // 阶段 25：`override constructor` 也不能写（Kotlin 版 parseConstructor Parser.kt:1303）
        if (isOverrideKeyword(peek().kind)) {
            failAt(peek(), "构造器不能写 override（'" + peek().text + "'）：override 的意思是「覆盖父类型里的方法」，构造器没有父类型方法可覆盖。直接写 constructor(参数) { ... }")
        }
        advance()   // constructor

        var params = parseParamList("constructor 后面缺少 '('，写法是 constructor(参数) { ... }", false)

        var next = peek()
        if (next.kind == "ARROW" || next.kind == "DOUBLE_COLON" || next.kind == "COLON") {
            failAt(next, "constructor 不写返回类型（构造器没有返回值）：去掉 '" + next.text + "'，直接写 '{'")
        }

        var body = parseBlock()
        var n = new Node(NodeKind.FUNC)
            .put("control", "DEFAULT")
            .put("static", "false")
            .put("main", "void")
            .put("name", escapeValue(className))
            .put("ret", "OMITTED")
            .put("mayError", "false")
            .put("retType", "void")
            .put("ctor", "true")
            .put("primary", "false")
            .put("override", "false")
        n.add(params)
        n.add(body)
        n.add(annotations.countTag())
        rtn n
    }

    // -------- 阶段 25：继承修饰词（类头 + 类体方法） ----------------------------

    // 类头/方法前面那串继承修饰词（`open` / `final` / `abstract`）。与 Kotlin 版
    // Parser.kt:790 的 parseInheritModifiers 一一对应：同一个词写两遍、`open` 与 `final`
    // 同时写、`abstract` 与另两个一起写，都在**这里**当场判失败（报错位置指到后面那个词）。
    // ⇒ 三个词**至多一个为真**。`super` 不在这条通路上（它是表达式接收者，不是修饰词）。
    fn parseInheritModifiers(kindWord : string) -> InheritMods {
        var sawFinal = false
        var sawAbstract = false
        while (isInheritKeyword(peek().kind) && !failed) {
            var t = advance()
            if (t.kind == "KW_FINAL") {
                if (sawFinal) { failAt(t, kindWord + " 上 'final' 写了两遍——写一次就够了") }
                sawFinal = true
            } else {
                if (sawAbstract) { failAt(t, kindWord + " 上 'abstract' 写了两遍——写一次就够了") }
                sawAbstract = true
            }
        }
        if (sawAbstract && sawFinal) {
            var why = "抽象成员本来就是要被子类实现的"
            if (kindWord == "类") { why = "抽象类本来就是要被继承的" }
            failAt(peek(), kindWord + " 上 'abstract' 不能和 'final' 写在一起：" + why + "（DESIGN-25 §6），写 'abstract' 一个就够了")
        }
        rtn new InheritMods(sawFinal, sawAbstract)
    }

    // 两段修饰词合并（Kotlin 版 mergeInherit，Parser.kt:1724）：修饰词与注解可以夹着写
    // （`open @M final fun f()`），所以 parseFuncDecl 的收集循环可能前后收到两段。
    fn mergeInheritMods(cur : InheritMods, kindWord : string) -> InheritMods {
        var next = parseInheritModifiers(kindWord)
        if (cur.isFinal && next.isFinal) { failAt(peek(), kindWord + " 上 'final' 写了两遍——写一次就够了") }
        if (cur.isAbstract && next.isAbstract) { failAt(peek(), kindWord + " 上 'abstract' 写了两遍——写一次就够了") }
        var f = cur.isFinal || next.isFinal
        var a = cur.isAbstract || next.isAbstract
        if (a && f) {
            var why = "抽象成员本来就是要被子类实现的"
            if (kindWord == "类") { why = "抽象类本来就是要被继承的" }
            failAt(peek(), kindWord + " 上 'abstract' 不能和 'final' 写在一起：" + why + "（DESIGN-25 §6），写 'abstract' 一个就够了")
        }
        rtn new InheritMods(f, a)
    }

    // -------- 阶段 25：类头的 `:` 子句（父类 + 父接口） ------------------------

    // 类头 `:` 子句：父类可选（**最多一个**），父接口 0..n 个。
    // 判据是**语法**的（「类型引用后面紧跟着 `(`」），Kotlin 版 parseSuperClause
    // （Parser.kt:850）同口径：「这个名字到底是不是一份可以继承的类」留给语义层。
    fn parseSuperClause(className : string) -> SuperClause {
        if (!check("COLON")) {
            rtn new SuperClause("", "", new Node(NodeKind.ARGS), new Node(NodeKind.SUPERS).countTag())
        }
        advance()   // ':'

        // 第一个名字后面紧跟 '(' → 这是父类（实参表必须写，所以它一定是这个形状）
        if (isBaseAhead()) {
            var baseType = parseTypeRef()
            var args = parseSuperArgs(className)
            if (!check("COMMA")) {
                rtn new SuperClause(baseType.name, baseType.text(), args, new Node(NodeKind.SUPERS).countTag())
            }
            advance()   // ','
            if (isBaseAhead()) {
                failAt(peek(), "类 '" + className + "' 只能有一个父类：'" + baseType.text() + "(...)' 后面又出现了带实参表的 '" + peek().text + "'。父类型列表里**最多一个**带实参的父类，其余都是接口（写法是 ': 父类名(实参), 接口名'），rsf 不做多继承（DESIGN-25 §6）")
            }
            var tail = new Node(NodeKind.SUPERS)
            rtn new SuperClause(baseType.name, baseType.text(), args, parseSupertypeItems(tail, false))
        }

        var ifaces = parseSupertypeItems(new Node(NodeKind.SUPERS), true)
        if (isBaseAhead()) {
            var baseStart = peek()
            var lateBase = parseTypeRef()
            parseSuperArgs(className)
            failAt(baseStart, "类 '" + className + "' 的父类 '" + lateBase.text() + "' 必须排在父类型列表的最前面：写法是 ': 父类名(实参), 接口名'，把 '" + lateBase.text() + "(...)' 挪到最前面")
        }
        rtn new SuperClause("", "", new Node(NodeKind.ARGS), ifaces)
    }

    // 下一个记号开始的是不是一个**带了实参表的父类**（`: X(...)`）。
    // 只看两项：IDENT 加上紧跟的 `(`——因为父类的实参表是**必须写的**（DESIGN-25 §2），
    // 「带括号的类型名」在 `:` 子句里只可能是父类。泛型父类要把 `&<...>` 尖括号对跳过去，
    // 再看后面是不是构造实参表的 `(`（Kotlin 版 isBaseAhead，Parser.kt:893）。
    fn isBaseAhead() -> bool {
        if (!check("IDENT")) { rtn false }
        var n = 1
        if (peekAt(n).kind == "AMP") {
            n = n + 1
            if (peekAt(n).kind != "LT") { rtn false }
            var depth = 0
            var going = true
            while (going) {
                var k = peekAt(n).kind
                if (k == "EOF") { rtn false }
                if (k == "LT") { depth = depth + 1 }
                if (k == "GT") {
                    depth = depth - 1
                    if (depth == 0) {
                        n = n + 1
                        going = false
                    }
                }
                if (going) { n = n + 1 }
            }
        }
        rtn peekAt(n).kind == "LPAREN"
    }

    // 父类构造实参表：`Base(实参)`。**必须写**——没有括号直接报错（DESIGN-25 §2）。
    // 返回的是一个还没打 count 的 ARGS 节点，由调用方 countTag 后挂到 SUPER_CLASS 下面。
    fn parseSuperArgs(className : string) -> Node {
        if (!check("LPAREN")) {
            failAt(peek(), "类 '" + className + "' 的父类后面必须写出构造实参：写法是 `: 父类名(实参)` 或 `: 父类名()`（父类可能没有无参构造器，所以这一对括号不能省），实际读到 '" + peek().text + "'")
            rtn new Node(NodeKind.ARGS)
        }
        advance()   // '('
        var args = new Node(NodeKind.ARGS)
        if (!check("RPAREN")) {
            var going = true
            while (going && !failed) {
                args.add(parseExpr())
                if (!matchOne("COMMA")) { going = false }
            }
        }
        expect("RPAREN", "类 '" + className + "' 的父类构造实参表没有闭合，缺少 ')'")
        rtn args
    }

    // `:` 父类型子句：**接口声明 / 伴生体**走这条（类头走 parseSuperClause，父类是独立槽位）。
    // 语法是 `:` 类型 (`,` 类型)*，类型可以带类型实参。
    // 三条当场判失败（与 Kotlin 版 parseSupertypeItems 同口径，文案不要求一致）：
    // 父类型带 `?`、父类型不是类型名（例如 `:` 后面直接跟 `{`）、父类型是内置类型名或数组。
    // 类型本身交给 parseTypeRef 解析，免得正例的显示文本与别处的类型写法不一致。
    fn parseSupertypeList() -> Node {
        var supers = new Node(NodeKind.SUPERS)
        // Kotlin 版 `supers()` 的那一行**总是**带 `count=`（没有父类型就是 SUPERS count=0），
        // 所以这里两条出口都要打 count：早点返回的那条也不能漏。
        if (!check("COLON")) { rtn supers.countTag() }
        advance()   // ':'
        rtn parseSupertypeItems(supers, false)
    }

    // 父类型列表本体。`stopAtBase` = 碰到「带实参表的父类」就停下、把它留给调用方
    // （Kotlin 版 parseSupertypeItems(owner, stopAtBase)，Parser.kt:1011）。
    fn parseSupertypeItems(supers : Node, stopAtBase : bool) -> Node {
        var going = true
        while (going && !failed) {
            if (stopAtBase && isBaseAhead()) {
                // 父类要排在最前面：这里停下来，让调用方去报那句「父类必须排最前面」
                going = false
            } else {
                var t = peek()
                if (t.kind == "QUESTION") {
                    failAt(t, "父类型不能可空：'?' 只写在变量/参数/返回的类型上")
                } else {
                    if (!isTypeKeyword(t.kind) && t.kind != "IDENT") {
                        failAt(t, "父类型列表里需要一个接口名（写法是 ': 名字, 名字'），实际读到 '" + t.text + "'")
                    } else {
                        var superType = parseTypeRef()
                        if (isTypeKeyword(t.kind)) {
                            failAt(t, "'" + superType.name + "' 是内置类型，不能当父类型——父类型只能是接口名")
                        } else {
                            if (superType.depth > 0) {
                                failAt(t, "父类型不能是数组（'" + superType.text() + "'）：父类型只能是接口名")
                            } else {
                                var superNode = new Node(NodeKind.SUPER)
                                    .put("name", escapeValue(superType.name))
                                    .put("display", escapeValue(superType.text()))
                                    .put("typeArgs", boolText(superType.args.length() > 0))
                                superNode.line = t.line
                                supers.add(superNode)
                            }
                        }
                    }
                }
                if (!matchOne("COMMA")) { going = false }
            }
        }
        rtn supers.countTag()
    }

    // 接口声明（阶段 20）：`[public] interface 名字[&<T>][: 父接口, ...] { 方法* }`
    // 接口体里**只能写方法**：不能有字段、不能有构造器、不能 static、不能写非 public 的权限修饰词。
    // 方法可以没有体（抽象方法，dump 里不打 BLOCK），也可以有体（默认方法）；接口方法允许 override。
    // annotations：声明前收到的注解序列（`@Marker interface I { }`），空表也挂（count=0），挂在最后
    fn parseInterfaceDecl(annotations : Node) -> Node {
        var control = "DEFAULT"
        if (isControlKeyword(peek().kind)) { control = controlName(advance().kind) }
        var ifaceTok = expect("KW_INTERFACE", "interface 声明缺少 'interface'")
        var nameTok = expect("IDENT", "'interface' 后面缺少接口名")

        // 类型参数子句与类完全同形（`interface Box&<T>`），重名检查同 parseClassDecl
        var typeParams = new Node(NodeKind.TYPE_PARAMS)
        var seenParams = new string[8]
        var seenCount = 0
        if (check("AMP")) {
            advance()
            expect("LT", "'&' 后面缺少 '<'：类型参数要写成 interface " + nameTok.text + "&<T>")
            var going = true
            while (going && !failed) {
                var paramTok = expect("IDENT", "类型参数需要一个名字，写法是 interface " + nameTok.text + "&<T>")
                for (var i = 0; i < seenCount; i = i + 1) {
                    if (seenParams[i] == paramTok.text) {
                        failAt(paramTok, "接口 '" + nameTok.text + "' 的类型参数 '" + paramTok.text + "' 重名了")
                    }
                }
                if (paramTok.text == nameTok.text) {
                    failAt(paramTok, "类型参数不能和接口同名（都叫 '" + nameTok.text + "'）")
                }
                if (seenCount >= seenParams.length) {
                    var bigger : string[] = new string[seenParams.length * 2]
                    for (var i = 0; i < seenCount; i = i + 1) { bigger[i] = seenParams[i] }
                    seenParams = bigger
                }
                seenParams[seenCount] = paramTok.text
                seenCount = seenCount + 1
                typeParams.add(new Node(NodeKind.TYPE_PARAM).put("name", escapeValue(paramTok.text)))
                if (!matchOne("COMMA")) { going = false }
            }
            expect("GT", "接口 '" + nameTok.text + "' 的类型参数表没有闭合，缺少 '>'")
        }

        var supers = parseSupertypeList()

        expect("LBRACE", "接口 '" + nameTok.text + "' 缺少 '{'")

        var methods = new Node(NodeKind.METHODS)
        // 只有接口体的成员循环允许「方法没有体」，循环结束（含中途报错退出）立刻还原；
        // 接口方法同样允许 `override`，所以 overrideOk 一起打开
        var oldAbstractOk = abstractBodyOk
        var oldOverrideOkHere = overrideOk
        abstractBodyOk = true
        overrideOk = true
        while (!check("RBRACE") && !check("EOF") && !failed) {
            var memberLine = peek().line
            // 阶段 21：接口方法也能带注解（`@Marker fun m() -> void`），先收再分派；
            // 收完再看剩下的是什么（字段/构造器那两条报错路径与以前一模一样）。
            var methodAnnotations = parseAnnotations()
            if (isVarKeyword(peek().kind)) {
                failAt(peek(), "接口里只能写方法：'" + peek().text + "' 是字段/变量声明，接口没有字段")
            } else {
                if (peek().kind == "KW_CONSTRUCTOR") {
                    failAt(peek(), "接口里不能写构造器：接口没有字段要初始化，也不会被 new")
                } else {
                    // 修饰词可以排好几个、顺序随意（`override public fun`），所以先把这一串数完：
                    // 检查要落在**真正写了那个词**的位置上（`override private fun` 也得拦住）
                    var offset = 0
                    while (isModifierKeyword(peekAt(offset).kind)) {
                        var m = peekAt(offset)
                        if (isStaticKeyword(m.kind)) {
                            failAt(m, "接口里暂时不支持 static 方法：去掉 'static' 写成普通方法")
                        }
                        if (isControlKeyword(m.kind) && m.kind != "KW_PUBLIC") {
                            failAt(m, "接口里的方法只能是 public：'" + m.text + "' 会让实现类没法实现它（不写修饰词就是 public）")
                        }
                        offset = offset + 1
                    }
                    if (failed) {
                        // 上面已经报过错、报错位置已定住：别再往下解析成员
                    } else {
                        if (peekAt(offset).kind != "KW_FUN") {
                            failAt(peek(), "接口里只能写方法（格式是 'fn 名字(参数) 返回子句'，可以有方法体），实际读到 '" + peek().text + "'")
                        } else {
                            var mem = parseFuncDecl(methodAnnotations)
                            if (mem.line < 1) { mem.line = memberLine }
                            methods.add(mem)
                            while (matchOne("SEMI")) { }   // 可选的分号，吃掉
                        }
                    }
                }
            }
        }
        abstractBodyOk = oldAbstractOk
        overrideOk = oldOverrideOkHere
        expect("RBRACE", "接口 '" + nameTok.text + "' 没有闭合，缺少 '}'")

        var n = new Node(NodeKind.INTERFACE).put("control", control).put("name", escapeValue(nameTok.text)).at(ifaceTok)
        n.add(supers)
        n.add(typeParams.countTag())
        n.add(methods.countTag())
        n.add(annotations.countTag())
        rtn n
    }

    // ============================================================ 注解（阶段 21，自举同步第 3 刀）
    //
    // 语法与 Kotlin 版（`Parser.kt` 的 parseAnnotations/parseAnnotationUse/parseAnnotationArgs/
    // parseAnnotationDecl/parseAnnotationElementList/parseAnnotationElement/parseAnnotationBody/
    // parseCompanionEntity）一一对应，dump 形态由 AstDump.kt 冻结。
    // **注解子节点一律追加在最后**：Interp.rsf:792/805/888/919 与 Backend.rsf:5692 用位置读孩子。

    // 声明前的注解序列：`@Marker @Other("x") public class C { }`。
    // 收不到就返回**空表本身**（dump 成 `ANNOTATION_USES count=0`），由调用方挂到节点最后。
    fn parseAnnotations() -> Node {
        var list = new Node(NodeKind.ANNOTATION_USES)
        collectLeadingAnnotations(list)
        rtn list
    }

    // 往已经建好的表里再收一轮 `@...`。抽出来是因为「函数修饰词之间」也要能写注解，
    // 需要重复调用（与 Kotlin 版 collectLeadingAnnotations 同口径）。
    fn collectLeadingAnnotations(into : Node) -> void {
        while (check("AT") && !failed) {
            into.add(parseAnnotationUse())
        }
    }

    // 一个使用点：`@Marker` / `@a.b` / `@Outer::Inner("hi", count = 3)`。
    // 名字里的 `.` 与 `::` 都拼成点分形式（跟 Kotlin 版一样：`name + "." + 段`）。
    fn parseAnnotationUse() -> Node {
        var atTok = expect("AT", "注解要写在 '@' 后面")
        var nameTok = expect("IDENT", "'@' 后面缺少注解名（写法是 @Marker 或 @Marker(...)）")
        var name = nameTok.text
        while (check("DOT") || check("DOUBLE_COLON")) {
            advance()
            var partTok = expect("IDENT", "注解名 '" + name + "' 后面缺少名字：'.' / '::' 后面要跟一个名字（例如 @a.b 或 @Outer::Inner）")
            name = name + "." + partTok.text
        }
        var args = new Node(NodeKind.ANNOTATION_ARGS).countTag()
        if (check("LPAREN")) {
            args = parseAnnotationArgs()
        }
        var n = new Node(NodeKind.ANNOTATION_USE).put("name", escapeValue(name))
        n.add(args)
        n.line = atTok.line
        rtn n
    }

    // 使用点的实参表：位置式与具名式**可以混写**（`@M("hi", count = 3)`），允许尾逗号。
    // 两种实参用**两个节点名**区分（与 AstDump.kt 的 POSITIONAL_ARG / NAMED_ARG 一一对应）：
    // 具名式的判据是「IDENT 后面紧跟 ASSIGN」（记号表里没有复合赋值，这个前瞻不会误伤）。
    // 空表照实打 `count=0`：`@M` 与 `@M()` 在 AST 里分不出，别发明区分。
    fn parseAnnotationArgs() -> Node {
        expect("LPAREN", "注解实参表缺少 '('")
        var args = new Node(NodeKind.ANNOTATION_ARGS)
        var sawNamed = false
        if (!check("RPAREN")) {
            var going = true
            while (going && !failed) {
                if (check("IDENT") && checkAt(1, "ASSIGN")) {
                    var nameTok = advance()
                    advance()   // =
                    var named = new Node(NodeKind.NAMED_ARG).put("name", escapeValue(nameTok.text))
                    named.add(parseExpr())
                    args.add(named)
                    sawNamed = true
                } else {
                    // 一旦出现过具名实参，后面的位置式就没法确定对应哪个元素了——当场判失败
                    if (sawNamed) {
                        failAt(peek(), "注解实参里具名式要写在最后：'名字 = 值' 后面不能再写位置式实参，位置式没法确定对应哪个元素")
                    }
                    var pos = new Node(NodeKind.POSITIONAL_ARG)
                    pos.add(parseExpr())
                    args.add(pos)
                }
                if (!matchOne("COMMA")) {
                    going = false
                } else {
                    if (check("RPAREN")) { going = false }   // 尾逗号
                }
            }
        }
        expect("RPAREN", "注解实参表没有闭合，缺少 ')'")
        rtn args.countTag()
    }

    // 注解声明：`[public] annotation 名字(元素表) { companion entity ... }`。
    // 元素表**只有写了 '(' 才收**（`annotation M { }` 与 `annotation M() { }` 都是空表，分不出）；
    // 注解体里至多一个 companion entity，别的成员（fun / var / constructor）是语法错误——
    // 在 parser 层就报，不留给语义层。annotations：声明前的注解序列（元注解 `@Meta annotation M`）。
    fn parseAnnotationDecl(annotations : Node) -> Node {
        var control = "DEFAULT"
        if (isControlKeyword(peek().kind)) { control = controlName(advance().kind) }
        expect("KW_ANNOTATION", "注解声明缺少 'annotation'")
        var nameTok = expect("IDENT", "'annotation' 后面缺少注解名")

        var elements = new Node(NodeKind.ANNOTATION_ELEMENTS)
        if (check("LPAREN")) {
            elements = parseAnnotationElementList(nameTok.text)
        }

        var n = new Node(NodeKind.ANNOTATION).put("control", control).put("name", escapeValue(nameTok.text))
        n.add(elements.countTag())
        // 孩子顺序：ANNOTATION_ELEMENTS → [COMPANION] → ANNOTATION_USES（与 AstDump.kt 一致）

        if (check("LBRACE")) {
            advance()
            parseAnnotationBody(nameTok.text, n)
            // 体里**至多一个** companion entity：第二个当场报错
            if (check("KW_COMPANION") && !failed) {
                failAt(peek(), "注解 '" + nameTok.text + "' 的体里只能有一个 companion entity")
            }
            expect("RBRACE", "注解 '" + nameTok.text + "' 没有闭合，缺少 '}'")
        }

        n.add(annotations.countTag())
        rtn n
    }

    // 注解体：至多一个 `companion entity [名字] [: 父接口] { 类体 }`；别的成员一律报错。
    // 伴生实体自己也能带注解，但**语义层忽略**（与 Kotlin 版 parseAnnotationBody 一样：
    // 收下就丢掉，AST 里 CompanionEntityDecl 根本没有注解字段），所以这里不把结果往上挂。
    // 解析出来的 COMPANION 直接挂到 owner（ANNOTATION 节点）上，位置紧跟在 ANNOTATION_ELEMENTS 之后。
    fn parseAnnotationBody(annotationName : string, owner : Node) -> void {
        parseAnnotations()
        if (check("KW_COMPANION")) {
            owner.add(parseCompanionEntity(annotationName))
        } else {
            if (!check("RBRACE")) {
                failAt(peek(), "注解 '" + annotationName + "' 的体里只能写一个 companion entity（例如 companion entity Impl : Runnable { ... }）——注解不是类：字段 / 方法 / 构造器都要写进伴生实体里")
            }
        }
    }

    // 元素表：`(value : string = "x", count : int = 0,)`——**允许尾逗号**，重名在解析期报错。
    // 重名只能拿数组线性查（rsf 还没有 HashSet，与类型参数那段同一个写法）。
    fn parseAnnotationElementList(annotationName : string) -> Node {
        expect("LPAREN", "注解 '" + annotationName + "' 的元素表缺少 '('")
        var elements = new Node(NodeKind.ANNOTATION_ELEMENTS)
        var seenNames = new string[8]
        var seenCount = 0
        if (!check("RPAREN")) {
            var going = true
            while (going && !failed) {
                var nameTok = expect("IDENT", "注解元素的写法是「名字 : 类型」[= 默认值]（后缀风格，不是 Java 的「类型 名字」）")
                for (var i = 0; i < seenCount; i = i + 1) {
                    if (seenNames[i] == nameTok.text) {
                        failAt(nameTok, "注解 '" + annotationName + "' 的元素 '" + nameTok.text + "' 重名了")
                    }
                }
                if (seenCount >= seenNames.length) {
                    var bigger : string[] = new string[seenNames.length * 2]
                    for (var i = 0; i < seenCount; i = i + 1) { bigger[i] = seenNames[i] }
                    seenNames = bigger
                }
                seenNames[seenCount] = nameTok.text
                seenCount = seenCount + 1
                elements.add(parseAnnotationElement(nameTok))
                if (!matchOne("COMMA")) {
                    going = false
                } else {
                    if (check("RPAREN")) { going = false }   // 尾逗号
                }
            }
        }
        expect("RPAREN", "注解 '" + annotationName + "' 的元素表没有闭合，缺少 ')'")
        rtn elements
    }

    // 一个元素：名字已经被调用方吃掉，这里接 `: 类型` 与可省的 `= 默认值`。
    // 有默认值才挂一棵表达式子树（照 FIELD 的 initializer 那样打，与 AstDump.kt 一致）。
    fn parseAnnotationElement(nameTok : Token) -> Node {
        expect("COLON", "注解元素 '" + nameTok.text + "' 要写成「名字 : 类型」，类型不能省")
        var ty = parseSuffixType("注解元素 '" + nameTok.text + "' 的类型要写成「名字 : 类型」")
        var hasDefault = false
        var defaultExpr = new Node(NodeKind.ERROR)
        if (matchOne("ASSIGN")) {
            defaultExpr = parseAnnotationDefault(nameTok.text)
            hasDefault = true
        }
        var n = new Node(NodeKind.ANNOTATION_ELEMENT)
            .put("name", escapeValue(nameTok.text))
            .put("type", ty.text())
            .put("hasDefault", boolText(hasDefault))
        // 行号取**元素名 token**：Kotlin 侧 `AnnotationElement.at` 就是元素名那一行
        //（`Parser.kt:456-469`），伴生类给元素访问器发 LineNumberTable 时要用它；
        // 缺这一行，4a 的元素访问器就少一条 LineNumberTable 属性（对拍会差文件）。
        n.line = nameTok.line
        if (hasDefault) { n.add(defaultExpr) }
        rtn n
    }

    // 默认值：v1 只收**字面量**，或者数值前**一个** `-`
    //（与 Kotlin 版 validateAnnotationDefault / isDefaultConstantLiteral 同口径）。
    // 枚举常量 / 注解 / 数组默认值 v1 不支持 ⇒ 这里直接判失败。
    // 注意 rsf 的 isLiteralKind 少了 BOOL_LIT/NULL_LIT，所以这里逐个列全，不用它。
    fn parseAnnotationDefault(owner : string) -> Node {
        var e = parseExpr()
        var ok = false
        if (e.kind == NodeKind.INT_LIT || e.kind == NodeKind.LONG_LIT || e.kind == NodeKind.FLOAT_LIT ||
            e.kind == NodeKind.DOUBLE_LIT || e.kind == NodeKind.STRING_LIT || e.kind == NodeKind.CHAR_LIT ||
            e.kind == NodeKind.BOOL_LIT || e.kind == NodeKind.NULL_LIT) {
            ok = true
        } else {
            // UNARY 节点的属性串就是 `op=MINUS`（parseUnary 里 put("op", opTok.kind)）；只认数值前的一个 '-'
            if (e.kind == NodeKind.UNARY && e.childCount == 1 && e.text == "op=MINUS") {
                var inner = e.children[0]
                if (inner.kind == NodeKind.INT_LIT || inner.kind == NodeKind.LONG_LIT ||
                    inner.kind == NodeKind.FLOAT_LIT || inner.kind == NodeKind.DOUBLE_LIT) {
                    ok = true
                }
            }
        }
        if (!ok) {
            failAt(peek(), "注解元素 '" + owner + "' 的默认值只能是字面量（整数 / 小数 / 字符串 / 字符 / true / false / null，或者数值前一个 '-'）：枚举常量 / 注解 / 数组默认值 v1 不支持")
        }
        rtn e
    }

    // 伴生实体：`companion entity [名字] [: 父接口, ...] { 普通类体 }`。
    // 名字可省（匿名，dump 里打占位 `name=-`）；父接口子句复用第 1 刀的 parseSupertypeList()；
    // 体就是普通类体（字段 / 方法 / 构造器），复用同一批解析函数。
    fn parseCompanionEntity(annotationName : string) -> Node {
        var companionTok = expect("KW_COMPANION", "伴生实体缺少 'companion'")
        expect("KW_ENTITY", "companion 后面缺少 'entity'（伴生实体要写成 companion entity [名字] [: 父接口] { ... }）")

        var hasName = false
        var name = "-"
        if (check("IDENT")) {
            name = advance().text
            hasName = true
        }
        // 名字后面跟类型关键字 = 把父接口写成了变量类型的形状，单独报一句（与 Kotlin 版同款边界）
        if (hasName && isTypeKeyword(peek().kind)) {
            failAt(peek(), "伴生实体 '" + name + "' 缺少 '{'：名字后面的类型要写成父接口列表（companion entity " + name + " : 父接口 { ... }）")
        }

        var supers = parseSupertypeList()
        expect("LBRACE", "伴生实体缺少 '{'（伴生实体要有类体，写法是 companion entity 名字 : 父接口 { ... }）")

        // 构造器的名字沿用 Kotlin 版：具名用名字，匿名用注解名
        var ctorName = annotationName
        if (hasName) { ctorName = name }

        var fields = new Node(NodeKind.FIELDS)
        var methods = new Node(NodeKind.METHODS)
        // 伴生实体的体就是类体：override 在这里合法（与 Kotlin 版 allowOverride = true 对应）
        var oldOverrideOk = overrideOk
        overrideOk = true
        while (!check("RBRACE") && !check("EOF") && !failed) {
            var memberLine = peek().line
            var memberAnnotations = parseAnnotations()
            if (isVarKeyword(peek().kind)) {
                var fld = parseFieldDecl(memberAnnotations)
                if (fld.line < 1) { fld.line = memberLine }
                fields.add(fld)
            } else {
                if (peek().kind == "KW_CONSTRUCTOR") {
                    if (memberAnnotations.childCount > 0) {
                        failAt(peek(), "伴生实体的构造器上不能写注解（'@'）：注解只标在类 / 接口 / 注解声明 / 方法 / 字段上")
                    }
                    var ctor = parseConstructor(ctorName, memberAnnotations)
                    if (ctor.line < 1) { ctor.line = memberLine }
                    methods.add(ctor)
                } else {
                    var mem = parseFuncDecl(memberAnnotations)
                    if (mem.line < 1) { mem.line = memberLine }
                    methods.add(mem)
                    while (matchOne("SEMI")) { }   // 可选的分号，吃掉
                }
            }
        }
        overrideOk = oldOverrideOk
        expect("RBRACE", "伴生实体没有闭合，缺少 '}'")

        // 孩子顺序：SUPERS → FIELDS → METHODS（**没有 TYPE_PARAMS**，与 AstDump.kt 一致）
        var n = new Node(NodeKind.COMPANION).put("name", escapeValue(name))
        n.add(supers)
        n.add(fields.countTag())
        n.add(methods.countTag())
        n.line = companionTok.line
        rtn n
    }

    // 字段：`var 名字 : 类型 = 初值`（类型与初值都必须写）
    // annotations：声明前收到的注解序列（`@Marker var f : int = 0`），空表也挂（count=0），挂在最后
    fn parseFieldDecl(annotations : Node) -> Node {
        var kwTok = advance()
        var mutable = kwTok.kind == "KW_VAR"
        var nameTok = expect("IDENT", "字段缺少名字：写法是 '" + kwTok.text + " 名字 : 类型 = 初值'")
        if (!check("COLON")) {
            failAt(peek(), "字段必须写类型：'" + kwTok.text + " " + nameTok.text + " : int = 初值'")
        }
        advance()   // :
        var ty = parseSuffixType("字段 '" + nameTok.text + "' 的类型要写成 '" + kwTok.text + " " + nameTok.text + " : 类型 = 初值'")
        expect("ASSIGN", "字段 '" + nameTok.text + "' 必须给初值")
        var init = parseExpr()

        var n = new Node(NodeKind.FIELD)
            .put("name", escapeValue(nameTok.text))
            .put("mutable", boolText(mutable))
            .put("type", ty.text())
        n.add(init)
        n.add(annotations.countTag())
        rtn n
    }

    // ============================================================ 函数

    // annotations：调用方已经收好的那份注解表（顶层声明前 / 类体 / 接口体 / 伴生实体成员）。
    // 函数自己的修饰词之间**还能**再写注解（`@M public fun f()` / `public @M fun f()`），
    // 所以进来之后、每吃下一个修饰词之后都再收一轮（与 Kotlin 版 collectLeadingAnnotations 同口径）。
    // 注解列表挂在**最后**（PARAMS → [BLOCK] → ANNOTATION_USES）。
    fn parseFuncDecl(annotations : Node) -> Node {
        var fnTok = prevToken()
        var anns = annotations
        var control = "DEFAULT"
        var isOverride = false
        var isStatic = false
        // 阶段 25：方法的继承修饰词（阶段 27 起只剩 final / abstract）。缺省两个都为 false
        // ⇒ 不写就一个 dump 行都不挂（AstDump 只在写了时打 FINAL）。
        var inherit = new InheritMods(false, false)

        collectLeadingAnnotations(anns)

        // 修饰词可以排好几个、顺序随意（`static override fun` / `override static fun`）：
        // 与 Kotlin 版 parseFuncDecl 同一个循环——权限修饰词与 static 各至多一次、
        // override 只置位，而且**只有类体/接口体**里才收（overrideOk，见字段上的注释）。
        // 继承修饰词同理走 inheritOk（只有类体里才收；接口体/顶层写了会掉到下面那个报错）。
        var going = true
        while (going && !failed) {
            if (isControlKeyword(peek().kind)) {
                control = controlName(advance().kind)
                collectLeadingAnnotations(anns)
            } else {
                if (isStaticKeyword(peek().kind)) {
                    advance()
                    isStatic = true
                    collectLeadingAnnotations(anns)
                } else {
                    if (overrideOk && isOverrideKeyword(peek().kind)) {
                        advance()
                        isOverride = true
                        collectLeadingAnnotations(anns)
                    } else {
                        if (inheritOk && isInheritKeyword(peek().kind)) {
                            inherit = mergeInheritMods(inherit, "方法")
                            collectLeadingAnnotations(anns)
                        } else {
                            going = false
                        }
                    }
                }
            }
        }

        // 静态方法不参与继承（DESIGN-25 §3）：static 与 final/abstract 不能写到一起
        if (isStatic && (inherit.isFinal || inherit.isAbstract)) {
            failAt(peek(), "静态方法不能是 'final' / 'abstract'：静态方法只能写成 '类名.方法名' 调用（static 不参与继承，DESIGN-25 §3），把它上面的继承修饰词删掉")
        }

        if (peek().kind != "KW_FUN") {
            failAt(peek(), "顶层只能写函数声明，格式是 '[public|protected|private] [static] [override] [final|abstract] fn [类型] 名字() 返回子句 函数体'")
            rtn emptyFunc(control, isStatic, isOverride)
        }
        fnTok = advance()   // fun

        // 曾经写反的修饰符位置
        if (isControlKeyword(peek().kind) || isStaticKeyword(peek().kind) || isOverrideKeyword(peek().kind) || isInheritKeyword(peek().kind)) {
            failAt(peek(), "修饰符要写在 fn 前面：改成 '" + peek().text + " fn ...'")
        }

        // <MainType>：fun 之后、函数名之前的类型槽，缺省 void
        var mainType = "void"
        if (isTypeKeyword(peek().kind)) {
            mainType = parseTypeRef().text()
        }

        var nameTok = expect("IDENT", "缺少函数名")
        // 阶段 31：泛型函数的类型参数表 `fn id&<T, U>(...)`（与类/接口同形，但**非空才挂**节点，
        // 因为 AstDump 的 FUNC 分支只在写了时打 TYPE_PARAMS —— 普通函数的 dump 一个字都不能变）。
        var fnTypeParams = new Node(NodeKind.TYPE_PARAMS)
        var fnTpSeen = new string[4]
        var fnTpCount = 0
        if (check("AMP")) {
            advance()
            expect("LT", "'&' 后面缺少 '<'：类型参数要写成 fn " + nameTok.text + "&<T>")
            var tpGoing = true
            while (tpGoing && !failed) {
                var tpTok = expect("IDENT", "类型参数需要一个名字，写法是 fn " + nameTok.text + "&<T>")
                for (var i = 0; i < fnTpCount; i = i + 1) {
                    if (fnTpSeen[i] == tpTok.text) {
                        failAt(tpTok, "函数 '" + nameTok.text + "' 的类型参数 '" + tpTok.text + "' 重名了")
                    }
                }
                if (tpTok.text == nameTok.text) {
                    failAt(tpTok, "类型参数不能和函数同名（都叫 '" + nameTok.text + "'）")
                }
                if (fnTpCount >= fnTpSeen.length) {
                    var biggerTp : string[] = new string[fnTpSeen.length * 2]
                    for (var i = 0; i < fnTpCount; i = i + 1) { biggerTp[i] = fnTpSeen[i] }
                    fnTpSeen = biggerTp
                }
                fnTpSeen[fnTpCount] = tpTok.text
                fnTpCount = fnTpCount + 1
                fnTypeParams.add(new Node(NodeKind.TYPE_PARAM).put("name", escapeValue(tpTok.text)))
                if (!matchOne("COMMA")) { tpGoing = false }
            }
            expect("GT", "函数 '" + nameTok.text + "' 的类型参数表没有闭合，缺少 '>'")
        }
        var params = parseParamList("函数名 '" + nameTok.text + "' 后面缺少 '('", false)

        // 返回子句：`->` 与 `:` 等价（`::` 那条别名 2026-10-15 删掉，`::` 腾给 xxx::xx）
        var retStyle = "OMITTED"
        var mayError = false
        var retType = "void"
        if (matchOne("ARROW")) {
            retStyle = "ARROW"
        } else {
            if (matchOne("COLON")) {
                retStyle = "COLON"
            } else {
                if (check("DOUBLE_COLON")) {
                    failAt(peek(), "返回类型子句不再接受 '::'：请用 '->' 或者 ':'")
                }
            }
        }
        if (retStyle != "OMITTED") {
            mayError = matchOne("BANG")
            if (check("KW_NULL")) {
                advance()
                retType = "void"
            } else {
                retType = parseTypeRef().text()
            }
        }

        // 接口里的抽象方法**只写签名不写体**：此时 abstractBodyOk 为真，既不打 BLOCK 也不报错。
        // 有体就是普通函数（放在接口里即「默认方法」）。
        // 阶段 25：类里的 `abstract fun` 也只写签名（还没有体就没到实现），但**要写出返回子句**；
        // 反过来说，抽象方法写了体就是当场判失败（DESIGN-25 §6，Kotlin 版 Parser.kt:1678 同序）。
        var hasBody = false
        var body = new Node(NodeKind.ERROR)
        if (abstractBodyOk && !check("LBRACE")) {
            // 接口体里的方法必须是抽象方法：签名收完就结束
        } else {
            if (inherit.isAbstract) {
                if (check("LBRACE")) {
                    failAt(peek(), "抽象方法不能写函数体：'abstract fn 名字(...)' 只写签名，没有 '{ ... }'。要么把 'abstract' 删掉、把体留下，要么把体删掉（DESIGN-25 §6）")
                } else {
                    if (retStyle == "OMITTED") {
                        failAt(peek(), "抽象方法要写出返回子句：'abstract fn 名字(...) -> 返回类型'。没有体就没有返回值可以推断，返回类型必须写出来（DESIGN-25 §6）")
                    }
                }
            } else {
                if (check("LBRACE")) {
                    body = parseBlock()
                    hasBody = true
                } else {
                    if (!abstractBodyOk) {
                        failAt(peek(), "函数体需要以 '{' 开始")
                    }
                }
            }
        }
        var n = new Node(NodeKind.FUNC)
            .at(fnTok)
            .put("control", control)
            .put("static", boolText(isStatic))
            .put("main", mainType)
            .put("name", escapeValue(nameTok.text))
            .put("ret", retStyle)
            .put("mayError", boolText(mayError))
            .put("retType", retType)
            .put("ctor", "false")
            .put("primary", "false")
            .put("override", boolText(isOverride))
        // AstDump 的方法分支顺序是 FUNC 行 → FINAL → PARAMS → [BLOCK] → ANNOTATION_USES，
        // 而且**只在写了时**才有那一行（ABSTRACT 在方法上不打：抽象方法体现为没有 BLOCK 孩子）。
        if (inherit.isFinal) { n.add(new Node(NodeKind.FINAL)) }
        // 阶段 31：TYPE_PARAMS 排在 PARAMS 前面（AstDump.kt:174-177 的顺序），空表不挂
        if (fnTpCount > 0) { n.add(fnTypeParams.countTag()) }
        n.add(params)
        if (hasBody) { n.add(body) }
        n.add(anns.countTag())
        rtn n
    }

    fn emptyFunc(control : string, isStatic : bool, isOverride : bool) -> Node {
        var n = new Node(NodeKind.FUNC)
            .put("control", control)
            .put("static", boolText(isStatic))
            .put("main", "void")
            .put("name", "")
            .put("ret", "OMITTED")
            .put("mayError", "false")
            .put("retType", "void")
            .put("ctor", "false")
            .put("primary", "false")
            .put("override", boolText(isOverride))
        n.add(new Node(NodeKind.PARAMS).countTag())
        n.add(new Node(NodeKind.BLOCK).countTag())
        // 阶段 21：每个 FUNC 都要有末尾的注解表（这条是报错路径上的兜底节点）
        n.add(new Node(NodeKind.ANNOTATION_USES).countTag())
        rtn n
    }

    // 参数表：`(int a, b : string)`。两种风格靠记号前瞻分流，同一个表里可以混写。
    // 阶段 30c：`allowUntyped` —— lambda 的形参类型可以省（`lam(x) -> int { … }`），
    // 省了就落成空类型占位，留给 Backend 按期望类型补（Kotlin 侧 Param(TypeRef(""))）。
    fn parseParamList(missingParen : string, allowUntyped : bool) -> Node {
        expect("LPAREN", missingParen)
        var params = new Node(NodeKind.PARAMS)
        if (!check("RPAREN")) {
            var going = true
            while (going && !failed) {
                params.add(parseParam(allowUntyped))
                if (!matchOne("COMMA")) { going = false }
            }
        }
        expect("RPAREN", "参数表没有闭合，缺少 ')'")
        rtn params.countTag()
    }

    fn parseParam(allowUntyped : bool) -> Node {
        var t = peek()

        // 1. Kotlin 风格：名字 : 类型
        if (t.kind == "IDENT" && checkAt(1, "COLON")) {
            var nameTok = advance()
            advance()   // :
            var ty = parseSuffixType("参数类型要写成 '" + nameTok.text + " : 类型'（Kotlin 风格）或者 '类型 " + nameTok.text + "'（Java 风格）")
            rtn new Node(NodeKind.PARAM).put("type", ty.text()).put("name", escapeValue(nameTok.text))
        }

        // 2/3. Java 风格：类型 名字
        var javaStyle = isTypeKeyword(t.kind) || t.kind == "QUESTION" ||
            (t.kind == "IDENT" && (checkAt(1, "IDENT") || checkAt(1, "AMP") || checkAt(1, "LBRACKET")))
        if (javaStyle) {
            var ty2 = parseTypeRef()
            var nameTok2 = expect("IDENT", "参数缺少名字。两种写法都可以：Java 风格 '" + ty2.text() + " 名字'，或者 Kotlin 风格 '名字 : " + ty2.text() + "'")
            rtn new Node(NodeKind.PARAM).put("type", ty2.text()).put("name", escapeValue(nameTok2.text))
        }

        // 4. 阶段 30c：lambda 的形参可以只写名字（`lam(x) -> int`）。
        // 注意 text 的键序是 `name=` 在前 —— AstDump 的 LambdaExpr 分支打的是
        // `PARAM name=… type=…`，与函数的 `PARAM type=… name=…` 恰好相反。
        if (allowUntyped && t.kind == "IDENT" && (checkAt(1, "COMMA") || checkAt(1, "RPAREN"))) {
            var bare = advance()
            rtn new Node(NodeKind.PARAM).put("name", escapeValue(bare.text)).put("type", "")
        }

        failAt(t, "参数要写成「类型 名字」或者「名字 : 类型」")
        rtn new Node(NodeKind.PARAM).put("type", "?").put("name", "")
    }

    // `名字 : 类型` 里冒号后面那个类型槽（局部变量、字段、Kotlin 风格参数共用）
    fn parseSuffixType(hint : string) -> TypeInfo {
        var t = peek()
        // 阶段 30c：`(` 也要放行——`x : (int) -> int` 里的类型是函数类型
        if (!isTypeKeyword(t.kind) && t.kind != "IDENT" && t.kind != "QUESTION" && t.kind != "LPAREN") {
            failAt(t, hint)
            rtn new TypeInfo("?", "", 0, "")
        }
        rtn parseTypeRef()
    }

    // 类型引用：可空 `?` 前缀、泛型实参 `&<...>`、嵌套类型 `注解名::伴生名`、数组后缀 `[]`（可叠多层）
    fn parseTypeRef() -> TypeInfo {
        var nullable = matchOne("QUESTION")
        // 阶段 30c：类型位置的 `(` —— 函数类型 `(int, string) -> bool` /
        // 「给函数类型加括号再挂 `[]`」`((int) -> int)[]`。与 Kotlin 的
        // Parser.kt:1841 `if (check(LPAREN)) return parseParenType(nullable)` 同一位置。
        if (check("LPAREN")) { rtn parseParenType(nullable) }
        var t = peek()
        var name = ""
        var builtin = false
        if (isTypeKeyword(t.kind)) {
            advance()
            name = canonicalTypeName(t.kind)
            builtin = true
        } else {
            if (t.kind == "IDENT") {
                advance()
                name = t.text
            } else {
                failAt(t, "这里需要一个类型（void / int / long / float / double / string / bool / byte / char，或者一个类名）")
                rtn new TypeInfo("?", "", 0, "")
            }
        }
        if (nullable) { name = "?" + name }

        var args = ""
        if (check("AMP")) {
            if (builtin) {
                failAt(peek(), "'" + name + "' 是内置类型，没有类型参数——'&<实参类型>' 只能跟在一个类名后面")
                rtn new TypeInfo(name, "", 0, "")
            }
            args = parseTypeArgs()
        }

        // 嵌套类型名 `注解名::伴生名`（例如 `Marker::Impl`）。Kotlin 版 v1 只支持一层，
        // 内置类型后面不能写 `::`，`::` 后面必须跟一个名字。
        var nested = ""
        if (check("DOUBLE_COLON")) {
            if (builtin) {
                failAt(peek(), "'" + name + "' 是内置类型，没有嵌套类型：'::' 只能写成「注解名 :: 伴生名」（例如 Marker::Impl）")
                rtn new TypeInfo(name, args, 0, "")
            }
            advance()
            if (!check("IDENT")) {
                failAt(peek(), "'::' 后面缺少嵌套类型名：写法是「注解名 :: 伴生名」（例如 Marker::Impl）")
                rtn new TypeInfo(name, args, 0, "")
            }
            nested = peek().text
            advance()
            if (check("DOUBLE_COLON")) {
                failAt(peek(), "嵌套类型 v1 只支持一层：'A::B::...' 里的第二个 '::' 不支持（写法是「注解名 :: 伴生名」，例如 Marker::Impl）")
                rtn new TypeInfo(name, args, 0, nested)
            }
        }

        // `[]` 只吃**紧挨着的**一对空括号（`new int[5]` 里的 `[5]` 是维度、不是类型后缀）
        var depth = 0
        while (check("LBRACKET") && checkAt(1, "RBRACKET") && !failed) {
            advance()
            advance()
            depth = depth + 1
        }
        if (depth > 0 && startsWithChar(name, '?')) {
            failAt(t, "数组类型不能写 '?'：数组本身就是引用，去掉 '?' 写成 '" + name.substring(1, name.length()) + "[]'")
        }
        rtn new TypeInfo(name, args, depth, nested)
    }

    // 类型位置的 `(`（阶段 30c）：函数类型，或者「给函数类型加括号再挂 `[]`」。
    // 两种写法靠**配对的 `)` 后面那个记号**区分，没有歧义：
    //   (int, string) -> bool    函数类型：`)` 后面是 `->`
    //   () -> void               参数表可以为空
    //   ((int) -> int)[]         分组：`)` 后面是 `[`（整体括号 + 数组后缀）
    // 分组那一层是**必需的**：`int[] -> int` 里 `[]` 属于参数类型。
    fn parseParenType(nullable : bool) -> TypeInfo {
        var at = peek()
        var closeOffset = matchingParenOffset()
        if (closeOffset < 0) {
            failAt(at, "函数类型要写成 '(参数类型表) -> 返回类型'（DESIGN-30）——括号没有配对，缺少 ')'")
            rtn new TypeInfo("?", "", 0, "")
        }
        if (checkAt(closeOffset + 1, "ARROW")) {
            rtn parseFunctionType(nullable, at)
        }
        // `)` 后面既不是 `->` 也不是 `[]`：这不是分组，就是函数类型缺了返回类型。
        if (!checkAt(closeOffset + 1, "LBRACKET")) {
            failAt(at, "函数类型要写成 '(参数类型表) -> 返回类型'（DESIGN-30）")
            rtn new TypeInfo("?", "", 0, "")
        }
        // 分组：`((int) -> int)[]`。`?` 只能写在整个函数类型最前面（`?(int) -> int`）。
        if (nullable) {
            failAt(at, "'?' 要写在函数类型的最前面（?(int) -> int），不要套在括号外面")
            rtn new TypeInfo("?", "", 0, "")
        }
        advance()   // (
        var inner = parseTypeRef()
        expect("RPAREN", "类型外面的括号没有闭合，缺少 ')'")
        if (!inner.isFn || inner.fnRet.length() == 0) {
            failAt(at, "类型外面的括号只能用来包函数类型（例如 ((int) -> int)[]）：'(" + inner.text() + ")' 直接写成 '" + inner.text() + "'")
            rtn inner
        }
        var depth = 0
        while (check("LBRACKET") && checkAt(1, "RBRACKET") && !failed) {
            advance()
            advance()
            depth = depth + 1
        }
        if (depth == 0) { rtn inner }
        var grouped = new TypeInfo(inner.name, inner.args, inner.depth + depth, inner.nested)
        rtn grouped.asFn(inner.fnParams, inner.fnRet)
    }

    // 函数类型本体（阶段 30c）：`(` 类型列表 `)` `->` 类型。返回类型**必填**。
    fn parseFunctionType(nullable : bool, at : Token) -> TypeInfo {
        advance()   // (
        var params = ""
        if (!check("RPAREN")) {
            var going = true
            while (going && !failed) {
                var p = parseTypeRef()
                if (params.length() == 0) {
                    params = p.text()
                } else {
                    params = params + "," + p.text()
                }
                if (!matchOne("COMMA")) { going = false }
            }
        }
        expect("RPAREN", "函数类型的参数表没有闭合，缺少 ')'")
        if (!check("ARROW")) {
            failAt(peek(), "函数类型要写成 '(参数类型表) -> 返回类型'（DESIGN-30）")
            rtn new TypeInfo("?", "", 0, "")
        }
        advance()   // ->
        var ret = parseTypeRef()
        var nm = "fn"
        if (nullable) { nm = "?fn" }
        var ft = new TypeInfo(nm, "", 0, "")
        rtn ft.asFn(params, ret.text())
    }

    // 从当前位置（必须是 `(`）数到配对 `)` 的偏移；数不到返回 -1。
    // 4096 的防御与 Kotlin Parser.kt:2009 的 matchingParenOffset 一致。
    fn matchingParenOffset() -> int {
        var depth = 0
        var i = 0
        var going = true
        while (going) {
            var k = peekAt(i).kind
            if (k == "LPAREN") {
                depth = depth + 1
            } else {
                if (k == "RPAREN") {
                    depth = depth - 1
                    if (depth == 0) { rtn i }
                } else {
                    if (k == "EOF") { rtn -1 }
                }
            }
            i = i + 1
            if (i > 4096) { rtn -1 }
        }
        rtn -1
    }

    // 类型实参表 `&<int>` / `&<string, int>` / `&<Box&<int>>`；返回的是**内部**文本
    fn parseTypeArgs() -> string {
        advance()   // &
        expect("LT", "'&' 后面缺少 '<'：类型实参要写成 '&<实参类型>'（单独的 '<' 是比较运算）")
        var out = ""
        var going = true
        while (going && !failed) {
            var arg = parseTypeRef()
            if (out.length() == 0) {
                out = arg.text()
            } else {
                out = out + "," + arg.text()
            }
            if (!matchOne("COMMA")) { going = false }
        }
        expect("GT", "类型实参表没有闭合，缺少 '>'")
        rtn out
    }

    // ============================================================ 语句

    fn parseBlock() -> Node {
        expect("LBRACE", "函数体需要以 '{' 开始")
        var b = new Node(NodeKind.BLOCK)
        while (!check("RBRACE") && !check("EOF") && !failed) {
            b.add(parseStmt())
            while (matchOne("SEMI")) { }
        }
        expect("RBRACE", "函数体没有闭合，缺少 '}'")
        rtn b.countTag()
    }

    // 语句节点的行号 = 这条语句**第一个 token** 的行号（与 Kotlin 版 `at` 同口径）。
    // 表达式里的节点不带行号（只有语句节点需要），行号由 parseStmt 统一补。
    fn parseStmt() -> Node {
        var ln = peek().line
        var n = parseStmtInner()
        if (n.line < 1) { n.line = ln }
        rtn n
    }

    fn parseStmtInner() -> Node {
        var t = peek()
        var k = t.kind

        if (k == "LBRACE") { rtn parseBlock() }
        if (isVarKeyword(k)) { rtn parseVarDecl() }
        if (k == "KW_LET") {
            failAt(t, "'let' 已经换成两个关键字了：'var'（可变）和 'imutvar'（不可变）")
            rtn errorNode()
        }
        if (isReturnKeyword(k)) { rtn parseReturn() }
        if (k == "KW_IF") { rtn parseIfStmt() }
        if (k == "KW_ELSE") {
            failAt(t, "'else' 要跟在 if 的分支后面，不能单独成句")
            rtn errorNode()
        }
        if (k == "KW_WHILE") {
            advance()
            var cond = parseExpr()
            var body = parseBody("while")
            var n = new Node(NodeKind.WHILE)
            n.add(cond)
            n.add(body)
            rtn n
        }
        if (k == "KW_FOR") { rtn parseFor() }
        if (k == "KW_SWITCH") { rtn parseSwitch() }
        if (k == "KW_CASE") {
            failAt(t, "'case' 只能写在 switch 的块里（而且从 0.9.0 起可以不写了）：写法是 switch (值) { 枚举名.值名 : 语句 ... }")
            rtn errorNode()
        }
        if (k == "KW_BREAK") {
            var breakTok = advance()
            rtn new Node(NodeKind.BREAK).at(breakTok)
        }
        if (k == "KW_CONTINUE") {
            var contTok = advance()
            rtn new Node(NodeKind.CONTINUE).at(contTok)
        }
        if (k == "KW_GOTO") {
            advance()
            // 阶段 28b：`goto` 后面既收普通 IDENT，也收反引号标签名（Kotlin Parser.kt:2068）
            if (check("IDENT") || check("LABEL_NAME")) {
                var gotoKw = prevToken()
                var gotoTok = advance()
                rtn new Node(NodeKind.GOTO).put("label", escapeValue(gotoTok.text)).at(gotoKw)
            }
            failAt(peek(), "'goto' 后面缺少标签名")
            rtn errorNode()
        }
        if (k == "KW_FAIL") { rtn parseFail() }
        if (k == "KW_TRY") { rtn parseTry() }

        // `this(实参)` 是构造器委托，必须排在成员访问前面判断（靠后面跟 '(' 还是 '.' 分流）
        if (k == "KW_THIS" && checkAt(1, "LPAREN")) { rtn parseThisCall() }
        // 阶段 25：`super(实参)` = 父类构造器委托，同样只能当构造体的第一句
        // （顺序判据在语义层；自举侧这里是纯语法，与 Kotlin 版 Parser.kt:2098 同位置）。
        if (k == "KW_SUPER" && checkAt(1, "LPAREN")) { rtn parseSuperCall() }

        if (k == "KW_CONSTRUCTOR") {
            failAt(t, "'constructor' 只能写在类体里（它是次构造：constructor(参数) { ... }）")
            rtn errorNode()
        }
        if (k == "KW_CATCH") {
            failAt(t, "'catch' 只能跟在 try 块后面，写法是 try { ... } catch (e : string) { ... }")
            rtn errorNode()
        }

        if (k == "IDENT" && checkAt(1, "ASSIGN")) { rtn parseAssign() }

        // 阶段 28b：标签声明 `名字:` —— 普通 IDENT 与反引号标签名两种记号都收
        // （Kotlin Parser.kt:2113）。放在赋值判断之后，两种记号不会打架。
        if (k == "LABEL_NAME" && checkAt(1, "COLON")) {
            advance()
            advance()   // :
            rtn new Node(NodeKind.LABEL).put("name", escapeValue(t.text))
        }

        if (k == "IDENT" && checkAt(1, "COLON")) {
            advance()
            advance()   // :
            rtn new Node(NodeKind.LABEL).put("name", escapeValue(t.text))
        }

        // 阶段 28b：走到这里说明 LABEL_NAME 出现在不允许的位置（语句首、表达式……）
        if (k == "LABEL_NAME") {
            failAt(t, labelNameOnlyMessage())
            rtn errorNode()
        }

        rtn finishExprStmt(parseExpr())
    }

    // 表达式语句，顺带认出两种赋值目标：`p.x = 1`（成员）与 `a[i] = 1`（下标）
    fn finishExprStmt(e : Node) -> Node {
        if (check("ASSIGN")) {
            if (e.kind == NodeKind.MEMBER) {
                advance()   // =
                var n = new Node(NodeKind.MEMBER_ASSIGN)
                n.add(e)
                n.add(parseExpr())
                rtn n
            }
            if (e.kind == NodeKind.INDEX) {
                advance()   // =
                var n2 = new Node(NodeKind.INDEX_ASSIGN)
                n2.add(e)
                n2.add(parseExpr())
                rtn n2
            }
        }
        var stmt = new Node(NodeKind.EXPR_STMT)
        stmt.add(e)
        rtn stmt
    }

    fn parseAssign() -> Node {
        var nameTok = advance()
        advance()   // =
        var value = parseExpr()
        var n = new Node(NodeKind.ASSIGN).put("name", escapeValue(nameTok.text)).put("synthetic", "false").at(nameTok)
        n.add(value)
        rtn n
    }

    fn parseVarDecl() -> Node {
        var kwTok = advance()
        var mutable = kwTok.kind == "KW_VAR"
        var nameTok = expect("IDENT", "'" + kwTok.text + "' 后面缺少变量名")

        var hasType = false
        var tyText = "-"
        if (matchOne("COLON")) {
            hasType = true
            tyText = parseSuffixType("变量 '" + nameTok.text + "' 的类型要写成 '" + kwTok.text + " " + nameTok.text + " : 类型 = 初值'").text()
        }
        expect("ASSIGN", "变量 '" + nameTok.text + "' 声明时必须初始化")

        var init = parseExpr()
        var n = new Node(NodeKind.VAR_DECL)
            .at(kwTok)
            .put("name", escapeValue(nameTok.text))
            .put("mutable", boolText(mutable))
            .put("typed", boolText(hasType))
            .put("type", tyText)
        n.add(init)
        rtn n
    }

    // `rtn` / `return`：后面跟不跟值，靠「右大括号 / 分号 / 文件结束 / 换行了」判断
    // （rsf 不靠换行分词，所以这里必须看行号，否则下一行的语句会被当成返回值）
    fn parseReturn() -> Node {
        var rtnTok = advance()
        var next = peek()
        if (next.kind == "RBRACE" || next.kind == "EOF" || next.kind == "SEMI" || next.line != rtnTok.line) {
            rtn new Node(NodeKind.RETURN).put("hasValue", "false").at(rtnTok)
        }
        var n = new Node(NodeKind.RETURN).put("hasValue", "true").at(rtnTok)
        n.add(parseExpr())
        rtn n
    }

    fn parseFail() -> Node {
        var failTok = advance()
        var next = peek()
        if (next.kind == "RBRACE" || next.kind == "EOF" || next.kind == "SEMI" || next.line != failTok.line) {
            failAt(next, "'fail' 后面要跟错误消息，写法是 'fail \"出错了\"'（消息必须是 string 表达式）")
            rtn errorNode()
        }
        var n = new Node(NodeKind.FAIL)
        n.add(parseExpr())
        rtn n
    }

    // `try { ... } catch (e : string) { ... }`（也收老写法 `catch (e string)`）
    fn parseTry() -> Node {
        advance()   // try
        var body = parseBody("try")

        if (!check("KW_CATCH")) {
            failAt(peek(), "try 块后面必须跟一个 catch，写法是 try { ... } catch (e : string) { ... }")
            rtn errorNode()
        }
        advance()   // catch

        expect("LPAREN", "catch 后面需要 '('，写法是 catch (错误变量 : string)")
        var nameTok = expect("IDENT", "catch 里需要错误变量名，写法是 catch (e : string)")

        if (matchOne("COLON")) {
            if (check("KW_STRING")) {
                advance()
            } else {
                failAt(peek(), catchTypeError(nameTok.text))
            }
        } else {
            if (check("KW_STRING")) {
                advance()   // 老写法 catch (e string)
            } else {
                failAt(peek(), catchTypeError(nameTok.text))
            }
        }
        expect("RPAREN", "catch 的参数表没有闭合，缺少 ')'")
        var catchBody = parseBody("catch")

        var n = new Node(NodeKind.TRY).put("catch", escapeValue(nameTok.text))
        n.add(body)
        n.add(catchBody)
        rtn n
    }

    fn catchTypeError(name : string) -> string {
        rtn "catch 的错误变量类型只能是 string。两种写法都可以：Kotlin 风格 'catch (" + name + " : string)'，或者 Java 风格 'catch (" + name + " string)'"
    }

    // if：花括号块、`c : 语句`、以及「三目出现在语句位置」（值被丢弃）
    fn parseIfStmt() -> Node {
        advance()   // if
        var cond = parseExpr()

        if (check("QUESTION")) {
            var e = parseIfTail(cond)
            var stmt = new Node(NodeKind.EXPR_STMT)
            stmt.add(e)
            rtn stmt
        }

        var body = parseBody("if")
        var n = new Node(NodeKind.IF)
        n.add(cond)
        n.add(body)
        if (matchOne("KW_ELSE")) {
            n.add(parseElseBody())
            n.put("hasElse", "true")
        } else {
            n.put("hasElse", "false")
        }
        rtn n
    }

    // else 后面：另一个 if（形成 else-if 链），或者一个普通体
    fn parseElseBody() -> Node {
        if (check("KW_IF")) {
            // 走 parseStmt 而不是直接 parseIfStmt：链上的每个 if 都要带**自己那一行**行号
            // （Kotlin 的 LineNumberTable 里 else-if 的条件属于 else-if 所在行）
            var nested = parseStmt()
            var b = new Node(NodeKind.BLOCK)
            b.add(nested)
            rtn b.countTag()
        }
        rtn parseBody("else")
    }

    // if / while / for / case / else / try / catch 的体：花括号块，或者冒号后面的单条语句
    // （单条语句也被包成一个只有一条语句的块，于是下游只有一种「体」形状）
    fn parseBody(what : string) -> Node {
        if (check("LBRACE")) {
            var lb = peek().line
            var blk = parseBlock()
            if (blk.line < 1) { blk.line = lb }
            rtn blk
        }
        if (check("COLON")) {
            advance()
            var single = parseStmt()
            var b = new Node(NodeKind.BLOCK)
            b.add(single)
            // 块的行号 = 它第一条语句的行号：`case X : 语句` 的标签要发这一行
            if (single.line > 0) { b.line = single.line }
            rtn b.countTag()
        }
        failAt(peek(), "'" + what + "' 后面需要 '{' 开始一个块，或者 ':' 后面跟单条语句")
        rtn errorNode()
    }

    // 三目的后半截：`? 值1 : 值2`
    fn parseIfTail(condition : Node) -> Node {
        expect("QUESTION", "三目运算符需要 '?'，写法是 'if 条件 ? 值1 : 值2'")
        var whenTrue = parseExpr()
        expect("COLON", "三目运算符缺少 ':'（写法是 'if 条件 ? 值1 : 值2'）")
        var whenFalse = parseExpr()
        var n = new Node(NodeKind.IF_EXPR)
        n.add(condition)
        n.add(whenTrue)
        n.add(whenFalse)
        rtn n
    }

    // 枚举分派（阶段 19c；阶段 21 起分支不写 `case`）：`switch (值) { 枚举名.值名 : 语句 / else : 语句 }`
    fn parseSwitch() -> Node {
        var switchTok = advance()   // switch
        expect("LPAREN", "'switch' 后面需要 '('（写法是 switch (值) { ... }）")
        var subject = parseExpr()
        expect("RPAREN", "switch 的条件没有闭合，缺少 ')'")
        expect("LBRACE", "switch 缺少 '{'")

        var cases = new Node(NodeKind.CASES)
        var hasElse = false
        var elseBody = errorNode()
        var sawElse = false

        while (!check("RBRACE") && !check("EOF") && !failed) {
            if (matchOne("SEMI")) {
                // 多写几个空语句不算错
            } else {
                if (check("KW_ELSE")) {
                    var elseTok = advance()
                    if (sawElse) { failAt(elseTok, "switch 里只能有一个 'else' 分支") }
                    sawElse = true
                    hasElse = true
                    elseBody = parseBody("else")
                } else {
                    if (check("IDENT") && peek().text == "default") {
                        failAt(peek(), "rsf 的默认分支写成 'else :'（不是 Java 的 'default :'）")
                    }
                    // 阶段 21：`case` 弃用——分支直接写「枚举名.值名 : 语句」，旧写法照收（提醒一次）
                    var oldCase = false
                    var caseTok = peek()
                    if (check("KW_CASE")) {
                        caseTok = advance()
                        oldCase = true
                    }
                    if (!check("IDENT")) {
                        if (oldCase) {
                            failAt(peek(), "'case' 后面需要一个枚举名（现在可以不写 'case'，直接写「枚举名.值名 : 语句」）")
                        } else {
                            failAt(peek(), "switch 的块里只能写 '枚举名.值名 : 语句' 或者 'else : 语句'")
                        }
                    }
                    var enumTok = expect("IDENT", "分支需要一个枚举名（写法是 枚举名.值名 : 语句）")
                    expect("DOT", "'" + enumTok.text + "' 后面需要 '.'——分支只接受枚举常量")
                    var valueTok = expect("IDENT", "'" + enumTok.text + ".' 后面需要一个值名")
                    var caseBody = parseBody("case")
                    var c = new Node(NodeKind.CASE)
                        .put("enum", escapeValue(enumTok.text))
                        .put("value", escapeValue(valueTok.text))
                    c.add(caseBody)
                    cases.add(c)
                    if (oldCase) {
                        System.err.println("[rsf] 警告: 第 " + intToString(caseTok.line) + " 行: 'case' 已弃用（is deprecated since 0.9.0）：switch 的分支直接写 '枚举名.值名 : 语句'，不用再写 'case'")
                    }
                }
            }
        }
        expect("RBRACE", "switch 没有闭合，缺少 '}'")

        if (cases.childCount == 0 && !hasElse) {
            failAt(switchTok, "switch 里什么都没有：至少要有一个 '枚举名.值名 : 语句' 分支")
        }

        var n = new Node(NodeKind.SWITCH)
        n.add(subject)
        n.add(cases.countTag())
        if (hasElse) { n.add(elseBody) }
        n.put("caseCount", intToString(cases.childCount)).put("hasElse", boolText(hasElse))
        rtn n
    }

    // 构造器委托 `this(实参)`
    fn parseThisCall() -> Node {
        advance()   // this
        expect("LPAREN", "'this' 后面需要 '('（构造器委托写成 this(实参)）")
        var args = new Node(NodeKind.ARGS)
        if (!check("RPAREN")) {
            var going = true
            while (going && !failed) {
                args.add(parseExpr())
                if (!matchOne("COMMA")) { going = false }
            }
        }
        expect("RPAREN", "this(...) 的参数表没有闭合，缺少 ')'")
        var n = new Node(NodeKind.THIS_CALL).put("argc", intToString(args.childCount))
        n.add(args.countTag())
        rtn n
    }

    // 阶段 25：父类构造器委托 `super(实参)`（Kotlin 版 parseSuperCall，Parser.kt:2184）。
    // 与 this(实参) 完全同形，只是节点换成 SUPER_CALL——dump 是 `SUPER_CALL argc=N` + ARGS。
    // 「只能写第一句」「与 this(...) 互斥」是语义层的判据，留给 K5b/K5c。
    fn parseSuperCall() -> Node {
        advance()   // super
        expect("LPAREN", "'super' 后面需要 '('（父类构造器委托写成 super(实参)）")
        var args = new Node(NodeKind.ARGS)
        if (!check("RPAREN")) {
            var going = true
            while (going && !failed) {
                args.add(parseExpr())
                if (!matchOne("COMMA")) { going = false }
            }
        }
        expect("RPAREN", "super(...) 的参数表没有闭合，缺少 ')'")
        var n = new Node(NodeKind.SUPER_CALL).put("argc", intToString(args.childCount))
        n.add(args.countTag())
        rtn n
    }

    // 阶段 25：`super` 表达式（Kotlin 版 parseSuperExpr，Parser.kt:2808）。两种写法：
    //   `super.f(实参)`         —— 直接父类的成员（target 打 `-`）
    //   `super(接口名).f(实参)` —— 指名某个接口的默认实现（target 打接口名；带类型实参时
    //                              打 `名字&<实参>`，与 AstDump.typeText 的口径一致）
    // 单独一个 `super` 没有值可取，必须跟方法调用（rsf 不支持 `super.字段`）。
    // **节点复用 NodeKind.SUPER**：dump 名 `SUPER` 本来就同时被「接口父类型」
    // （`SUPER name=… display=… typeArgs=…`）与「super 表达式」（`SUPER target=…`）用。
    fn parseSuperExpr() -> Node {
        // `super(接口名)`
        if (check("LPAREN")) {
            advance()   // '('
            if (!check("IDENT")) {
                failAt(peek(), "super(接口名).方法名() 里的括号中要写一个接口名，例如 super(Greeter).tag()（这一步是消歧两个父接口的默认方法），实际读到 '" + peek().text + "'")
                rtn new Node(NodeKind.SUPER).put("target", "-")
            }
            var ifaceTok = advance()
            var args = ""
            if (check("AMP")) { args = parseTypeArgs() }
            var target = ifaceTok.text
            if (args.length() > 0) { target = target + "&<" + args + ">" }
            expect("RPAREN", "super(接口名).方法名() 里的括号没有闭合，缺少 ')'")
            var sup = new Node(NodeKind.SUPER).put("target", escapeValue(target))
            rtn parseSuperMember(sup, "super(" + ifaceTok.text + ")")
        }
        // 裸 `super.方法名(...)`
        var sup2 = new Node(NodeKind.SUPER).put("target", "-")
        var dotTok = peek()
        if (!check("DOT")) {
            failAt(peek(), "'super' 只能当方法调用的接收者：写法是 super.方法名(实参)，或者 super(接口名).方法名(实参)。单独一个 'super' 没有值可取，实际读到 '" + peek().text + "'")
            rtn sup2
        }
        rtn parseSuperMember(sup2, "super")
    }

    // `super.成员名(实参)`：只认方法调用（Kotlin 版 parseSuperMember，Parser.kt:2847）。
    // 落成的是普通 MEMBER 节点（与 parsePostfix 里 `a.b(实参)` 同形），
    // 接收者孩子就是上面那个 SUPER 节点。
    fn parseSuperMember(sup : Node, who : string) -> Node {
        var dotTok = peek()
        expect("DOT", "'" + who + "' 后面需要 '.'：写法是 " + who + ".方法名(实参)")
        var nameTok = expect("IDENT", "'" + who + ".' 后面需要成员名")
        if (!check("LPAREN")) {
            failAt(peek(), "'" + who + "." + nameTok.text + "' 只能是方法调用：要写出实参表（" + who + "." + nameTok.text + "(...)）。rsf 不支持 super.字段（字段本来也不许遮蔽，DESIGN-25 §5/§6），实际读到 '" + peek().text + "'")
            rtn sup
        }
        advance()   // '('
        var args = new Node(NodeKind.ARGS)
        if (!check("RPAREN")) {
            var going = true
            while (going && !failed) {
                args.add(parseExpr())
                if (!matchOne("COMMA")) { going = false }
            }
        }
        expect("RPAREN", "'" + who + "." + nameTok.text + "(...)' 的参数表没有闭合，缺少 ')'")
        var m = new Node(NodeKind.MEMBER).put("name", escapeValue(nameTok.text)).put("call", "true").at(dotTok)
        m.add(sup)
        m.add(args.countTag())
        rtn m
    }

    // ============================================================ for

    fn parseFor() -> Node {
        var forTok = advance()   // for
        expect("LPAREN", "'for' 后面需要 '('")
        if (peek().kind == "IDENT" && checkAt(1, "KW_IN")) {
            rtn parseForIn(forTok)
        }
        rtn parseForClassic()
    }

    fn parseForClassic() -> Node {
        var init = new Node(NodeKind.BLOCK)
        if (!check("SEMI")) {
            var going = true
            while (going && !failed) {
                init.add(parseForClauseStmt())
                if (!matchOne("COMMA")) { going = false }
            }
        }
        expect("SEMI", "for 的初始化部分后面需要 ';'")

        var hasCond = false
        var cond = errorNode()
        if (!check("SEMI")) {
            cond = parseExpr()
            hasCond = true
        }
        expect("SEMI", "for 的条件部分后面需要 ';'")

        var steps = new Node(NodeKind.BLOCK)
        if (!check("RPAREN")) {
            var going2 = true
            while (going2 && !failed) {
                steps.add(parseForClauseStmt())
                if (!matchOne("COMMA")) { going2 = false }
            }
        }
        expect("RPAREN", "for 的头部没有闭合，缺少 ')'")

        var body = parseBody("for")

        // 更新部分：0 条没有、1 条直接用、多条包成一个块（与 Kotlin 版的 when 一致）
        var hasStep = false
        var stepNode = errorNode()
        if (steps.childCount == 1) {
            stepNode = steps.children[0]
            hasStep = true
        } else {
            if (steps.childCount > 1) {
                stepNode = steps.countTag()
                hasStep = true
            }
        }

        var loop = new Node(NodeKind.FOR)
        if (hasCond) { loop.add(cond) }
        if (hasStep) { loop.add(stepNode) }
        loop.add(body)
        loop.put("hasCond", boolText(hasCond)).put("hasStep", boolText(hasStep))

        // 初始化语句和循环本体一起放进块里，初始化变量就只在循环内可见
        if (init.childCount == 0) { rtn loop }
        var outer = new Node(NodeKind.BLOCK)
        for (var i = 0; i < init.childCount; i = i + 1) {
            outer.add(init.children[i])
        }
        outer.add(loop)
        rtn outer.countTag()
    }

    fn parseForClauseStmt() -> Node {
        var t = peek()
        if (isVarKeyword(t.kind)) { rtn parseVarDecl() }
        if (t.kind == "KW_LET") {
            failAt(t, "'let' 已经换成两个关键字了：'var'（可变）和 'imutvar'（不可变）")
            rtn errorNode()
        }
        if (t.kind == "IDENT" && checkAt(1, "ASSIGN")) { rtn parseAssign() }
        rtn finishExprStmt(parseExpr())
    }

    // `for (i in 起点..终点 step 步长)` —— 与 Kotlin 版**逐字对应**地解糖。
    // 终点与步长只求值一次（和 Java / Kotlin 一致），步长为负就自动变成递减。
    fn parseForIn(forTok : Token) -> Node {
        var nameTok = advance()   // IDENT
        advance()                   // in

        var start = parseExpr()
        expect("RANGE", "for-in 需要一个区间，写法是 'for (" + nameTok.text + " in 起点..终点)'。数组还不能用 for-in 遍历，按下标写：for (var i = 0; i < 数组.length; i = i + 1)")
        var end = parseExpr()

        // step 是上下文关键字：只有出现在这里才当关键字，别处照样能叫 step
        var stepExpr = new Node(NodeKind.INT_LIT).put("value", "1")
        if (peek().kind == "IDENT" && peek().text == "step") {
            advance()
            stepExpr = parseExpr()
        }

        expect("RPAREN", "for 的头部没有闭合，缺少 ')'")
        var body = parseBody("for")

        // 计数器与 Kotlin 版一样**在解析完 body 之后**自增（嵌套时内层因此拿的是更小的编号）
        var k = synth
        synth = synth + 1
        var endName = "__rsf_forEnd" + intToString(k)
        var stepName = "__rsf_forStep" + intToString(k)

        var endDecl = new Node(NodeKind.VAR_DECL).put("name", endName).put("mutable", "false").put("typed", "false").put("type", "-")
        endDecl.add(end)
        var stepDecl = new Node(NodeKind.VAR_DECL).put("name", stepName).put("mutable", "false").put("typed", "false").put("type", "-")
        stepDecl.add(stepExpr)
        var loopVar = new Node(NodeKind.VAR_DECL).put("name", escapeValue(nameTok.text)).put("mutable", "false").put("typed", "false").put("type", "-")
        loopVar.add(start)

        // 条件：步长非负就 i <= 终点，否则 i >= 终点
        var nonNegative = binaryNode("GE", varNode(stepName), intNode("0"))
        var ascending = binaryNode("LE", varNode(nameTok.text), varNode(endName))
        var descending = binaryNode("GE", varNode(nameTok.text), varNode(endName))
        var cond = new Node(NodeKind.IF_EXPR)
        cond.add(nonNegative)
        cond.add(ascending)
        cond.add(descending)

        var advanceStep = new Node(NodeKind.ASSIGN).put("name", escapeValue(nameTok.text)).put("synthetic", "true")
        advanceStep.add(binaryNode("PLUS", varNode(nameTok.text), varNode(stepName)))

        var loop = new Node(NodeKind.FOR)
        loop.add(cond)
        loop.add(advanceStep)
        loop.add(body)
        loop.put("hasCond", "true").put("hasStep", "true")

        var outer = new Node(NodeKind.BLOCK)
        outer.add(endDecl)
        outer.add(stepDecl)
        outer.add(loopVar)
        outer.add(loop)
        rtn outer.countTag()
    }

    fn varNode(name : string) -> Node {
        rtn new Node(NodeKind.VAR).put("name", escapeValue(name))
    }

    fn intNode(value : string) -> Node {
        rtn new Node(NodeKind.INT_LIT).put("value", value)
    }

    fn binaryNode(op : string, left : Node, right : Node) -> Node {
        var opTok = prevToken()
        // 运算符的位置不取 `opTok`：Kotlin 侧报错指在**左操作数**起点（c15 期望 2:19 而不是 2:23）
        var n = new Node(NodeKind.BINARY).put("op", op).atNode(left)
        n.add(left)
        n.add(right)
        rtn n
    }

    // ============================================================ 表达式
    //
    // 优先级从松到紧（与 Java / Kotlin 完全一致）：
    //   ?:  <  ||  <  &&  <  == !=  <  < > <= >=  <  + -  <  * / %  <  一元  <  后缀

    fn parseExpr() -> Node { rtn parseElvis() }

    fn parseElvis() -> Node {
        var left = parseOr()
        while (matchOne("ELVIS") && !failed) {
            var right = parseOr()
            var n = new Node(NodeKind.ELVIS)
            n.add(left)
            n.add(right)
            left = n
        }
        rtn left
    }

    fn parseOr() -> Node {
        var left = parseAnd()
        while (matchOne("OROR") && !failed) {
            var right = parseAnd()
            left = binaryNode("OROR", left, right)
        }
        rtn left
    }

    fn parseAnd() -> Node {
        var left = parseEquality()
        while (matchOne("ANDAND") && !failed) {
            var right = parseEquality()
            left = binaryNode("ANDAND", left, right)
        }
        rtn left
    }

    fn parseEquality() -> Node {
        var left = parseComparison()
        while (isEqualityKind(peek().kind) && !failed) {
            var op = advance().kind
            left = binaryNode(op, left, parseComparison())
        }
        rtn left
    }

    fn parseComparison() -> Node {
        var left = parseTerm()
        while (isComparisonKind(peek().kind) && !failed) {
            var op = advance().kind
            left = binaryNode(op, left, parseTerm())
        }
        rtn left
    }

    fn parseTerm() -> Node {
        var left = parseFactor()
        while (isAddKind(peek().kind) && !failed) {
            var op = advance().kind
            left = binaryNode(op, left, parseFactor())
        }
        rtn left
    }

    fn parseFactor() -> Node {
        var left = parseUnary()
        while (isMulKind(peek().kind) && !failed) {
            var op = advance().kind
            left = binaryNode(op, left, parseUnary())
        }
        rtn left
    }

    fn parseUnary() -> Node {
        if (check("MINUS") || check("BANG")) {
            var opTok = advance()
            var operand = parseUnary()
            var n = new Node(NodeKind.UNARY).put("op", opTok.kind)
            n.add(operand)
            rtn n
        }
        rtn parsePostfix()
    }

    // 后缀：`!!`、`.`（成员）、`[i]`（下标）。三者同一个循环，所以 a[i][j]、p.f[0].g!! 自然层层套。
    fn parsePostfix() -> Node {
        var e = parsePrimary()
        var going = true
        while (going && !failed) {
            if (check("BANG") && checkAt(1, "BANG")) {
                advance()
                advance()
                var n = new Node(NodeKind.FORCE)
                n.add(e)
                e = n
            } else {
                if (check("DOT")) {
                    var dotTok = advance()
                    var nameTok = expect("IDENT", "'.' 后面需要成员名")
                    var isCall = false
                    var args = new Node(NodeKind.ARGS)
                    if (matchOne("LPAREN")) {
                        isCall = true
                        if (!check("RPAREN")) {
                            var g = true
                            while (g && !failed) {
                                args.add(parseExpr())
                                if (!matchOne("COMMA")) { g = false }
                            }
                        }
                        expect("RPAREN", "成员调用的参数表没有闭合，缺少 ')'")
                    }
                    var m = new Node(NodeKind.MEMBER).put("name", escapeValue(nameTok.text)).put("call", boolText(isCall)).at(dotTok)
                    m.add(e)
                    if (isCall) { m.add(args.countTag()) }
                    e = m
                } else {
                    if (check("LBRACKET")) {
                        advance()
                        var index = parseExpr()
                        expect("RBRACKET", "下标访问缺少 ']'（写法是 数组[下标]，例如 a[0]）")
                        var ix = new Node(NodeKind.INDEX)
                        ix.add(e)
                        ix.add(index)
                        e = ix
                    } else {
                        // 阶段 24（自举同步 24b）：类型转换 / 类型判断。四种写法都在 postfix
                        // 这一层（所以 `a as A` 的结果能直接接 `.成员` / `[下标]` / `!!`），
                        // 并且**解析完立刻 rtn**——只允许写一层，见 expectNoChainedCast。
                        // 四者的 token 前缀互斥，所以下面四条并列 if 的先后无关紧要；
                        // 每支都以 rtn 收尾，走到 `going = false` 的只有「四者都不是」。
                        if (check("KW_AS")) {
                            advance()
                            var castTarget = parseCastTarget("as")
                            expectNoChainedCast("as")
                            var castNode = new Node(NodeKind.AS).put("safe", boolText(false))
                            castNode.add(e)
                            castNode.add(new Node(NodeKind.TARGET).put("type", castTarget.text()))
                            rtn castNode
                        }
                        if (check("QUESTION") && checkAt(1, "KW_AS")) {
                            // `?as` 的 '?' 在 `as` **前面**（Kotlin 是 `as?`）——DESIGN-24 §3 的 Q3 拍板。
                            advance()
                            advance()
                            var safeTarget = parseCastTarget("?as")
                            expectNoChainedCast("?as")
                            var safeNode = new Node(NodeKind.AS).put("safe", boolText(true))
                            safeNode.add(e)
                            safeNode.add(new Node(NodeKind.TARGET).put("type", safeTarget.text()))
                            rtn safeNode
                        }
                        if (check("KW_IS")) {
                            advance()
                            var isTarget = parseCastTarget("is")
                            expectNoChainedCast("is")
                            var isNode = new Node(NodeKind.IS).put("negated", boolText(false))
                            isNode.add(e)
                            isNode.add(new Node(NodeKind.TARGET).put("type", isTarget.text()))
                            rtn isNode
                        }
                        if (check("BANG") && checkAt(1, "KW_IS")) {
                            advance()
                            advance()
                            var negTarget = parseCastTarget("!is")
                            expectNoChainedCast("!is")
                            var negNode = new Node(NodeKind.IS).put("negated", boolText(true))
                            negNode.add(e)
                            negNode.add(new Node(NodeKind.TARGET).put("type", negTarget.text()))
                            rtn negNode
                        }
                        // 阶段 30c：`f!!(1)` —— 可空的函数值先断言非空再调用。
                        // 只认「`!!` 之后紧跟实参表」这一种形状（非空的 `f(1)` 仍然走
                        // IDENT→CALL 那条老路），所以不会跟别的语法打架。
                        // CALL 节点的第二个孩子是 callee（Kotlin 的 CallExpr.callee），
                        // name 照抄 calleeText 的口径。
                        if (check("LPAREN") && e.kind == NodeKind.FORCE) {
                            advance()
                            var fargs = new Node(NodeKind.ARGS)
                            if (!check("RPAREN")) {
                                var fg = true
                                while (fg && !failed) {
                                    fargs.add(parseExpr())
                                    if (!matchOne("COMMA")) { fg = false }
                                }
                            }
                            expect("RPAREN", "调用函数值的参数表没有闭合，缺少 ')'")
                            var fcall = new Node(NodeKind.CALL).put("name", escapeValue(calleeTextOf(e)))
                            // dump 里 callee 排在实参表**前面**（AstDump 的 CallExpr：
                            // 先打 callee 那一行，再打 ARGS）
                            fcall.add(e)
                            fcall.add(fargs.countTag())
                            e = fcall
                        } else {
                            going = false
                        }
                    }
                }
            }
        }
        rtn e
    }

    // `f!!(1)` 的调用名（照抄 Kotlin 的 calleeText，Parser.kt:3129）：
    // 剥掉 `!!` 再看这到底是谁的名字；认不出来就给空串。
    fn calleeTextOf(e : Node) -> string {
        if (e.kind == NodeKind.FORCE) { rtn calleeTextOf(e.children[0]) }
        if (e.kind == NodeKind.VAR) { rtn nodeProp(e, "name") }
        if (e.kind == NodeKind.MEMBER) { rtn nodeProp(e, "name") }
        rtn ""
    }

    // `as` / `is` 后面的目标类型（阶段 24，自举同步 24b）。
    // 复用 parseTypeRef()，所以 `A`、`A[]`、`Box&<int>`、`A::Nested` 都能写；
    // 只多一条限制：**目标不许可空**。null 的三种行为已经被拍死
    // （`null is A` 恒 false、`null as A` 抛、`null ?as A` 得 null，见 DESIGN-24 §3 的 Q2），
    // 目标再写 `?` 不会带来任何区别，只会让人误会「有 '?' 才是安全的那一种」——
    // 所以直接在语法层拒掉。
    fn parseCastTarget(opText : string) -> TypeInfo {
        var t = peek()
        // `?` 单拎出来报：否则会落到下面「需要一个目标类型」那条，把人引向
        // 「该写什么类型」而不是「不许写 ?」，而 n1 的判据看的就是这条口径。
        if (t.kind == "QUESTION") {
            failAt(t, "目标类型不许写可空：'... " + opText + " ?...' 不合法——" +
                "'null is A' 恒为 false、'null as A' 抛、'null ?as A' 得 null，" +
                "行为由「写的是 as 还是 ?as」决定，跟目标带不带 '?' 无关；" +
                "去掉 '?' 写成 '" + opText + " ...'")
            rtn new TypeInfo("?", "", 0, "")
        }
        // 阶段 30c：`(` 也放行（函数类型目标）；「目标不能是函数类型」由 Checker 报
        if (!isTypeKeyword(t.kind) && t.kind != "IDENT" && t.kind != "LPAREN") {
            failAt(t, "'" + opText + "' 后面需要一个目标类型（类名 / 接口名 / 数组类型），" +
                "实际读到 " + tokenDescribe(t))
            rtn new TypeInfo("?", "", 0, "")
        }
        var ref = parseTypeRef()
        if (startsWithChar(ref.name, '?')) {
            failAt(t, "目标类型不许写可空：'... " + opText + " " + ref.text() + "' 不合法——" +
                "'null is A' 恒为 false、'null as A' 抛、'null ?as A' 得 null，" +
                "行为由「写的是 as 还是 ?as」决定，跟目标带不带 '?' 无关；" +
                "去掉 '?' 写成 '" + opText + " " + dropFirstChar(ref.text()) + "'")
            rtn new TypeInfo("?", "", 0, "")
        }
        rtn ref
    }

    // `failAt` 文案里那个「实际读到的记号」：口径对齐 Kotlin 版 Token.describe()
    // （EOF 说「文件结束」、标识符带引号说明、字面量原样、其余打记号原文）。
    fn tokenDescribe(t : Token) -> string {
        if (t.kind == "EOF") { rtn "文件结束" }
        if (t.kind == "IDENT") { rtn "标识符 '" + t.text + "'" }
        if (t.kind == "INT_LIT" || t.kind == "LONG_LIT" || t.kind == "FLOAT_LIT" ||
            t.kind == "DOUBLE_LIT" || t.kind == "STRING_LIT" || t.kind == "CHAR_LIT") {
            rtn t.text
        }
        rtn "'" + t.text + "'"
    }

    // 去掉首字符（`?A` -> `A`）。只在「可空目标」那条错误文案里用，语义是 String.removePrefix。
    fn dropFirstChar(s : string) -> string {
        if (s.length() <= 1) { rtn "" }
        rtn s.substring(1, s.length())
    }

    // `as` / `is` **只允许写一层**（阶段 24，DESIGN-24 §3 的 Q4 拍板）。
    //
    // 写完一个转换/判型后立刻看一眼下一个记号：若是 `as` / `?as` / `is` / `!is` 就报错。
    // 理由：`a as A as B` 的结论等价于 `a as B`（判型只认最后那个类型），
    // 中间那层既不改变结果、也不做额外检查，链下去只让人误会它「逐层收窄」。
    fn expectNoChainedCast(opText : string) -> void {
        var t = peek()
        var next = ""
        if (t.kind == "KW_AS") { next = "as" }
        if (t.kind == "KW_IS") { next = "is" }
        if (t.kind == "QUESTION" && checkAt(1, "KW_AS")) { next = "?as" }
        if (t.kind == "BANG" && checkAt(1, "KW_IS")) { next = "!is" }
        if (next.length() == 0) { rtn }
        failAt(t, "'as' / 'is' 只允许写一层：'" + opText + " ... " + next + " ...' 不合法——" +
            "判型只看最后一个目标类型，中间那层不改变结论；" +
            "确实需要两步就分开写（`var x = a as A` 再 `x as B`）")
    }

    fn parsePrimary() -> Node {
        var t = peek()
        var k = t.kind

        if (k == "INT_LIT") {
            advance()
            rtn new Node(NodeKind.INT_LIT).put("value", intLiteralText(t)).at(t)
        }
        if (k == "LONG_LIT") {
            advance()
            rtn new Node(NodeKind.LONG_LIT).put("value", longLiteralText(t))
        }
        if (k == "FLOAT_LIT") {
            advance()
            rtn new Node(NodeKind.FLOAT_LIT).put("value", floatLiteralText(t))
        }
        if (k == "DOUBLE_LIT") {
            advance()
            rtn new Node(NodeKind.DOUBLE_LIT).put("value", doubleLiteralText(t))
        }
        if (k == "STRING_LIT") {
            advance()
            rtn new Node(NodeKind.STRING_LIT).put("value", escapeValue(t.text)).at(t)
        }
        if (k == "CHAR_LIT") {
            advance()
            rtn new Node(NodeKind.CHAR_LIT).put("value", escapeValue(charLiteralValue(t.text)))
        }
        if (k == "KW_TRUE") {
            advance()
            rtn new Node(NodeKind.BOOL_LIT).put("value", "true")
        }
        if (k == "KW_FALSE") {
            advance()
            rtn new Node(NodeKind.BOOL_LIT).put("value", "false")
        }
        if (k == "KW_NULL") {
            advance()
            rtn new Node(NodeKind.NULL_LIT)
        }
        if (k == "KW_IF") {
            advance()
            var cond = parseExpr()
            rtn parseIfTail(cond)
        }
        if (k == "KW_THIS") {
            advance()
            rtn new Node(NodeKind.THIS)
        }
        // 阶段 25：`super` 只能当方法调用的接收者（裸 super / super(接口名)），
        // 解析入口与修饰词分支完全无关（Kotlin 版 parsePrimary 同位置，Parser.kt:2894）。
        if (k == "KW_SUPER") {
            advance()
            rtn parseSuperExpr()
        }
        if (k == "KW_NEW") {
            advance()
            rtn parseNewExpr()
        }
        // 阶段 30c：`lam(...) -> T { ... }` 是函数值字面量（与 Kotlin 的
        // parsePrimary 里 `TokenKind.KW_LAM -> parseLambda(t.at)` 同一位置）
        if (k == "KW_LAM") {
            rtn parseLambda()
        }
        if (k == "IDENT") {
            advance()
            // `Box&<int>(0)`：类型实参只会出现在类型上，所以「标识符 +&<...> + (」无歧义地是一次构造
            if (check("AMP")) {
                var typeArgs = parseTypeArgs()
                expect("LPAREN", "'" + t.text + "&<...>' 后面缺少 '('：构造对象要写实参表，例如 new " + t.text + "&<int>(0)（new 可以省）")
                var newArgs = new Node(NodeKind.ARGS)
                if (!check("RPAREN")) {
                    var g2 = true
                    while (g2 && !failed) {
                        newArgs.add(parseExpr())
                        if (!matchOne("COMMA")) { g2 = false }
                    }
                }
                expect("RPAREN", "构造 '" + t.text + "' 的参数表没有闭合，缺少 ')'")
                var ctor = new Node(NodeKind.NEW).put("class", escapeValue(t.text)).put("typeArgs", typeArgs)
                ctor.add(newArgs.countTag())
                rtn ctor
            }
            if (matchOne("LPAREN")) {
                var callArgs = new Node(NodeKind.ARGS)
                if (!check("RPAREN")) {
                    var g3 = true
                    while (g3 && !failed) {
                        callArgs.add(parseExpr())
                        if (!matchOne("COMMA")) { g3 = false }
                    }
                }
                expect("RPAREN", "调用 '" + t.text + "' 的参数表没有闭合，缺少 ')'")
                var call = new Node(NodeKind.CALL).put("name", escapeValue(t.text)).at(t)
                call.add(callArgs.countTag())
                rtn call
            }
            rtn new Node(NodeKind.VAR).put("name", escapeValue(t.text)).at(t)
        }
        if (k == "LPAREN") {
            advance()
            var inner = parseExpr()
            expect("RPAREN", "括号没有闭合，缺少 ')'")
            rtn inner
        }

        // 阶段 28b：反引号标签名不能出现在表达式里（Kotlin Parser.kt:3041 同一位置），
        // 文案必须比笼统的「这里需要一个表达式」更准确
        if (k == "LABEL_NAME") {
            failAt(t, labelNameOnlyMessage())
            rtn errorNode()
        }

        failAt(t, "这里需要一个表达式")
        rtn errorNode()
    }

    // `new 类名(实参)` / `new 类名&<T>(实参)` / `new T[n]` / `new T[n][m]`
    // 两条路靠「类型后面跟的是 '(' 还是 '['」区分，没有歧义。
    fn parseNewExpr() -> Node {
        var t = peek()
        if (!isTypeKeyword(t.kind) && t.kind != "IDENT") {
            failAt(t, "'new' 后面需要类名（new Point(1, 2)）或者数组类型（new int[5]）")
            rtn errorNode()
        }
        var ty = parseTypeRef()
        if (startsWithChar(ty.name, '?')) {
            failAt(t, "'new' 后面的类型不能写 '?'")
        }

        if (check("LBRACKET")) {
            var dims = new Node(NodeKind.DIMS)
            while (matchOne("LBRACKET") && !failed) {
                if (check("RBRACKET")) {
                    failAt(peek(), "数组创建必须给出每一维的长度：new " + ty.text() + "[n]")
                }
                dims.add(parseExpr())
                expect("RBRACKET", "'new " + ty.text() + "[...]' 缺少 ']'")
            }
            if (ty.depth > 0) {
                failAt(t, "new 后面的数组类型不能再写 '[]'：长度写在方括号里，例如 new int[5]")
            }
            var arr = new Node(NodeKind.NEW_ARRAY).put("elem", ty.text())
            arr.add(dims.countTag())
            rtn arr
        }

        if (isTypeKeyword(t.kind)) {
            failAt(t, "'" + ty.name + "' 是内置类型，不能 new（没有构造器）。要造数组写成 new " + ty.name + "[长度]")
            rtn errorNode()
        }
        if (ty.depth > 0) {
            failAt(t, "数组类型要用 'new " + ty.name + "[长度]' 创建（长度写在方括号里）")
            rtn errorNode()
        }

        expect("LPAREN", "'new " + ty.text() + "' 后面缺少 '('（对象要写实参表，数组要写长度）")
        var args = new Node(NodeKind.ARGS)
        if (!check("RPAREN")) {
            var going = true
            while (going && !failed) {
                args.add(parseExpr())
                if (!matchOne("COMMA")) { going = false }
            }
        }
        expect("RPAREN", "'new " + ty.text() + "' 的参数表没有闭合，缺少 ')'")

        var n = new Node(NodeKind.NEW).put("class", escapeValue(ty.name)).put("typeArgs", ty.argsOrDash())
        n.add(args.countTag())
        rtn n
    }

    // 函数值字面量（阶段 30c）：`lam(x : int) -> int { rtn x + 1 }`。
    // 形参类型与返回子句**都可以省**（省了留给 Backend 按期望类型补）。
    // 节点形状与 AstDump.kt 的 LambdaExpr 分支逐字节对齐：
    //   text = `params=<n> ret=<类型文本|->`，孩子依次是 PARAM… 然后 BLOCK。
    fn parseLambda() -> Node {
        advance()   // lam
        var params = parseParamList("'lam' 后面需要一个形参表：写法是 lam(x : int) -> int { … }", true)
        var ret = "-"
        if (matchOne("ARROW")) {
            ret = parseTypeRef().text()
        }
        if (!check("LBRACE")) {
            failAt(peek(), "lambda 体要写成块：lam(…) -> 类型 { … }（写法是 lam(x : int) -> int { rtn x + 1 }）")
            rtn errorNode()
        }
        var body = parseBlock()
        var n = new Node(NodeKind.LAMBDA)
        n.put("params", intToString(params.childCount))
        n.put("ret", ret)
        // PARAMS 那一层不搬进来：Kotlin 的 lambda dump 没有 PARAMS 行。
        // 而且 lambda 的形参行是 `PARAM name=… type=…`（与函数形参的
        // `PARAM type=… name=…` **顺序相反**），所以这里重新渲染。
        var i = 0
        while (i < params.childCount) {
            var p = params.children[i]
            n.add(new Node(NodeKind.PARAM).put("name", nodeProp(p, "name")).put("type", lambdaParamTypeOf(p)))
            i = i + 1
        }
        n.add(body)
        rtn n
    }

    // lambda 形参的 PARAM 节点是 `type=<类型> name=<名字>`，这里把类型那一段抠出来。
    // 类型文本可能自带空格（`(int) -> int`），所以不能按空格切，要找**最后**那个 ` name=`。
    fn lambdaParamTypeOf(p : Node) -> string {
        var t = p.text
        var at = t.indexOf(" name=")
        if (at < 0) { rtn "" }
        rtn t.substring(5, at)
    }
}

// ================================================================ 对外接口

// 解析一份源码。**合法输入上与 Kotlin 版 Parser 建出结构相同的树**。
// 失败时不抛（rsf 版不用异常）：返回一个 kind = ERROR 的节点，消息在 text 里。
public fn parseSource(source : string) -> Node {
    var ts = lex(source)
    if (ts.length == 0) {
        // 词法就挂了：Kotlin 版这时抛的是 RsfError，rsf 版把词法消息落进 ERROR 节点
        var e = new Node(NodeKind.ERROR)
        e.put("message", escapeValue(lexError(source)))
        rtn e
    }
    var p = new Parser(ts)
    var ast = p.parseProgram()
    // 解析中途出错时**不能**把半棵树交出去：CLI 与对拍都要一个明确的「失败」信号
    if (p.hasFailed()) {
        var e = new Node(NodeKind.ERROR)
        e.put("message", escapeValue(p.errorMessage()))
        rtn e
    }
    rtn ast
}

// 判定一份源码能不能解析（对拍「两边都失败」那条边界用的）
public fn parseFailed(source : string) -> bool {
    var ts = lex(source)
    if (ts.length == 0) { rtn true }
    var p = new Parser(ts)
    var ast = p.parseProgram()
    if (p.hasFailed()) { rtn true }
    rtn ast.kind == NodeKind.ERROR
}

// 解析失败时的消息（没失败就是空串）
public fn parseErrorMessage(source : string) -> string {
    var ts = lex(source)
    if (ts.length == 0) { rtn lexError(source) }
    var p = new Parser(ts)
    p.parseProgram()
    rtn p.errorMessage()
}

// 解析失败时的行 / 列（1 基）；没失败或词法阶段就挂了给 -1。
// 阶段 32c 的 `CheckCli` 要用它把失败翻成 `file:行:列: error[parser]: 文案`。
public fn parseErrorLine(source : string) -> int {
    var ts = lex(source)
    if (ts.length == 0) { rtn -1 }
    var p = new Parser(ts)
    p.parseProgram()
    if (!p.hasFailed()) { rtn -1 }
    rtn p.errorLine()
}

public fn parseErrorCol(source : string) -> int {
    var ts = lex(source)
    if (ts.length == 0) { rtn -1 }
    var p = new Parser(ts)
    p.parseProgram()
    if (!p.hasFailed()) { rtn -1 }
    rtn p.errorCol()
}

// 读文件再解析（路径用 / 分隔；不写死任何绝对路径）
public fn parseFile(path : string) -> !Node {
    var text = readText(path)!!
    rtn parseSource(text)
}

// ================================================================ dump

fn astLine(node : Node, depth : int) -> string {
    var head = repeatText("  ", depth) + kindName(node.kind)
    if (node.text.length() > 0) { head = head + " " + node.text }
    rtn head
}

public fn dumpAstAt(node : Node, depth : int) -> void {
    println(astLine(node, depth))
    for (var i = 0; i < node.childCount; i = i + 1) {
        dumpAstAt(node.children[i], depth + 1)
    }
}

public fn dumpAst(node : Node) -> void {
    dumpAstAt(node, 0)
}

// 与 dumpAst 同样的内容，但拼成一个字符串返回（测试与工具用起来更方便）
public fn astTextAt(node : Node, depth : int) -> string {
    var out = astLine(node, depth) + "\n"
    for (var i = 0; i < node.childCount; i = i + 1) {
        out = out + astTextAt(node.children[i], depth + 1)
    }
    rtn out
}

public fn astText(node : Node) -> string {
    rtn astTextAt(node, 0)
}

// ---------------------------------------------------------------- 说明
//
// 和 Lexer.rsf 一样，**这个文件故意没有 main**：rsf 一个程序里只能有一个 main，
// 留在库里会让任何 import 它的程序撞名。入口单独放在 `ParserCli.rsf`。
//
// rsf 的 main 也**收不到命令行参数**，所以 ParserCli 用系统属性 `rsf.ast.file`
// 指定输入（属性不存在时 `System.getProperty` 返回 null，要按 `?string` 接住再兜底）。
