// rainStarfox 阶段 33a：自举 Checker 的第一层（声明 + 最简单的表达式/语句检查）
//
// 判据：`build/verify32/run-parity.sh self` 里「语义已实现」的那几份必须与 Kotlin 的第一处错误
// **逐字相同**（`build/verify32/checkcli-parity.sh` 统计）。
//
// 33a 覆盖：
//   未声明的变量 / 未定义的函数 / 变量不能是 void / 不能把 X 赋给 Y 变量
// 其余（参数个数与类型、返回、继承、接口、标签、泛型、lambda）留给 33b–35。
//
// 注意：这里**不做**后端的活，只做「能不能过」。

import "Parser.rsf"
import "Types.rsf"
import "Scopes.rsf"
import "Diag.rsf"

// 一份源码的检查失败：第一处错就停（与 Kotlin Checker 一致）
pub class CheckFailure(detail : string, line : int, col : int) {
    var detail : string = detail
    var line : int = line
    var col : int = col
}

// 函数签名（参数类型用文本存，够用；类型运算交给 Types.rsf）
pub class FnSig(name : string, retText : string, paramTexts : string[], paramNames : string[], typeParamNames : string[]) {
    var name : string = name
    var retText : string = retText
    var paramTexts : string[] = paramTexts
    var paramNames : string[] = paramNames
    var paramCount : int = paramTexts.length
    var typeParamNames : string[] = typeParamNames
    var typeParamCount : int = typeParamNames.length

    // `f(a : int, b : int)`：报「候选有 N 个」时逐条印出来
    pub fn signatureText() -> string {
        var out = name + "("
        var i = 0
        while (i < paramCount) {
            if (i > 0) { out = out + ", " }
            out = out + paramNames[i] + " : " + paramTexts[i]
            i = i + 1
        }
        rtn out + ")"
    }
}

pub class Checker(failure : ?CheckFailure) {
    var failure : ?CheckFailure = failure
    var fns : FnSig[] = new FnSig[8]
    var fnCount : int = 0
    var curFnName : string = ""
    var loopDepth : int = 0
    var cls : ClsInfo[] = new ClsInfo[8]
    var enums : string[] = new string[0]
    var enumCount : int = 0
    var clsCount : int = 0
    var labels : string[] = new string[0]
    var labelCount : int = 0
    var curRetText : string = "void"
    var curVoid : bool = true
    var warnLines : int[] = new int[8]
    var warnCols : int[] = new int[8]
    var warnTexts : string[] = new string[8]
    var warnCount : int = 0
    var warnOnly : bool = false
    var curExpect : string = ""
    var curBodyHasTypeParam : bool = false
    var scopes : Scopes = new Scopes()

    // ---------------------------------------------------------------- 类型文本

    fn typeOfTextT(text : string) -> RType {
        var t = text
        var nullable = false
        if (t.length() > 0 && t.charAt(0) == '?') {
            nullable = true
            t = rangeFrom(t, 1)
        }
        var depth = 0
        while (t.length() > 2 && t.charAt(t.length() - 1) == ']' && t.charAt(t.length() - 2) == '[') {
            depth = depth + 1
            t = rangeTo(t, t.length() - 2)
        }
        var empty : RType[] = new RType[0]
        if (t == "int") { rtn new RType("INT", nullable, "", empty, depth) }
        if (t == "long") { rtn new RType("LONG", nullable, "", empty, depth) }
        if (t == "byte") { rtn new RType("BYTE", nullable, "", empty, depth) }
        if (t == "char") { rtn new RType("CHAR", nullable, "", empty, depth) }
        if (t == "float") { rtn new RType("FLOAT", nullable, "", empty, depth) }
        if (t == "double") { rtn new RType("DOUBLE", nullable, "", empty, depth) }
        if (t == "bool") { rtn new RType("BOOL", nullable, "", empty, depth) }
        if (t == "string") { rtn new RType("STRING", nullable, "", empty, depth) }
        if (t == "void") { rtn new RType("VOID", nullable, "", empty, depth) }
        rtn new RType("EXTERNAL", nullable, t, empty, depth)
    }

    fn rangeFrom(s : string, from : int) -> string {
        var out = ""
        var i = from
        while (i < s.length()) {
            out = out + s.charAt(i)
            i = i + 1
        }
        rtn out
    }

    fn rangeTo(s : string, to : int) -> string {
        var out = ""
        var i = 0
        while (i < to) {
            out = out + s.charAt(i)
            i = i + 1
        }
        rtn out
    }

    // ---------------------------------------------------------------- 报错

    fn failAtLC(detail : string, line : int, col : int) -> void {
        if (failure == null) { failure = new CheckFailure(detail, line, col) }
    }

    fn failAt(detail : string, node : Node) -> void {
        if (failure != null) { rtn }
        failure = new CheckFailure(detail, node.line, node.col)
    }

    // 阶段 38：不可达代码警告（与 Kotlin `Diagnostic(Severity.WARNING, "checker", …)` 同款）
    fn addWarn(line : int, col : int, detail : string) -> void {
        if (warnCount >= warnLines.length) {
            var b1 = new int[warnLines.length * 2]
            var b2 = new int[warnCols.length * 2]
            var b3 = new string[warnTexts.length * 2]
            var i = 0
            while (i < warnCount) {
                b1[i] = warnLines[i]
                b2[i] = warnCols[i]
                b3[i] = warnTexts[i]
                i = i + 1
            }
            warnLines = b1
            warnCols = b2
            warnTexts = b3
        }
        warnLines[warnCount] = line
        warnCols[warnCount] = col
        warnTexts[warnCount] = detail
        warnCount = warnCount + 1
    }

    pub fn failed() -> bool { rtn failure != null }
    pub fn failureOf() -> ?CheckFailure { rtn failure }
    pub fn warningCount() -> int { rtn warnCount }
    pub fn warnLine(i : int) -> int { rtn warnLines[i] }
    pub fn warnText(i : int) -> string { rtn warnTexts[i] }

    // ---------------------------------------------------------------- 函数表

    fn declareFunctions(program : Node) -> void {
        var funcs = childNodeOf(program, NodeKind.FUNCS)
        if (funcs == null) { rtn }
        var i = 0
        while (i < funcs!!.childCount) {
            var fnode = funcs!!.children[i]
            var paramsNode = childNodeOf(fnode, NodeKind.PARAMS)
            var ptexts : string[] = new string[0]
            var pnames : string[] = new string[0]
            if (paramsNode != null) {
                ptexts = new string[paramsNode!!.childCount]
                pnames = new string[paramsNode!!.childCount]
                var j = 0
                while (j < paramsNode!!.childCount) {
                    var prm = paramsNode!!.children[j]
                    ptexts[j] = nodeProp(prm, "type")
                    pnames[j] = nodeProp(prm, "name")
                    j = j + 1
                }
            }
            var tpNames : string[] = new string[0]
            var tpNode = childNodeOf(fnode, NodeKind.TYPE_PARAMS)
            if (tpNode != null) {
                tpNames = new string[tpNode!!.childCount]
                var t = 0
                while (t < tpNode!!.childCount) {
                    tpNames[t] = nodeProp(tpNode!!.children[t], "name")
                    t = t + 1
                }
            }
            var sig = new FnSig(nodeProp(fnode, "name"), nodeProp(fnode, "retType"), ptexts, pnames, tpNames)
            pushFn(sig)
            i = i + 1
        }
    }

    fn pushFn(sig : FnSig) -> void {
        if (fnCount >= fns.length) {
            var bigger : FnSig[] = new FnSig[fns.length * 2]
            var i = 0
            while (i < fnCount) {
                bigger[i] = fns[i]
                i = i + 1
            }
            fns = bigger
        }
        fns[fnCount] = sig
        fnCount = fnCount + 1
    }

    fn findFn(name : string) -> ?FnSig {
        var i = 0
        while (i < fnCount) {
            if (fns[i].name == name) { rtn fns[i] }
            i = i + 1
        }
        rtn null
    }

    // ---------------------------------------------------------------- 遍历

    pub fn check(program : Node) -> void {
        declareFunctions(program)
        gatherClasses(program)
        checkClasses()
        if (failure != null) { rtn }
        var funcs = childNodeOf(program, NodeKind.FUNCS)
        if (funcs == null) { rtn }
        var i = 0
        while (i < funcs!!.childCount && failure == null) {
            var fnode = funcs!!.children[i]
            curFnName = nodeProp(fnode, "name")
            curRetText = nodeProp(fnode, "retType")
            curVoid = curRetText == "void"
            curBodyHasTypeParam = childNodeOf(fnode, NodeKind.TYPE_PARAMS) != null
            scopes = new Scopes()
            var paramsNode = childNodeOf(fnode, NodeKind.PARAMS)
            if (paramsNode != null) {
                var j = 0
                while (j < paramsNode!!.childCount) {
                    var prm = paramsNode!!.children[j]
                    scopes.declare(symOf(nodeProp(prm, "name"), "param", nodeProp(prm, "type"), prm.line, prm.col))
                    j = j + 1
                }
            }
            loopDepth = 0
            collectLabels(fnode)
            var body = childNodeOf(fnode, NodeKind.BLOCK)
            if (body != null) {
                checkBlock(body!!)
                if (failure == null && !curVoid) {
                    var last = body!!.childCount
                    var endsWithReturn = false
                    if (last > 0 && body!!.children[last - 1].kind == NodeKind.RETURN) { endsWithReturn = true }
                    if (!endsWithReturn) {
                        failAt("函数 '" + curFnName + "' 声明返回 " + curRetText + "）但存在一条没写 rtn 就走到函数末尾的路径", fnode)
                    }
                }
            }
            i = i + 1
        }
    }


    // ---------------------------------------------------------------- 类表与类级检查

    fn addClass(node : Node, isIface : bool) -> void {
        var ci = new ClsInfo(nodeProp(node, "name"),
                             childNodeOf(node, NodeKind.FINAL) != null,
                             childNodeOf(node, NodeKind.ABSTRACT) != null,
                             isIface, "", node.line, node.col)
        var sc = childNodeOf(node, NodeKind.SUPER_CLASS)
        if (sc != null) {
            ci.parent = nodeProp(sc!!, "name")
            ci.setSuper(sc!!)
        }
        var supers = childNodeOf(node, NodeKind.SUPERS)
        if (supers != null) {
            var k = 0
            while (k < supers!!.childCount) {
                ci.addIface(nodeProp(supers!!.children[k], "name"))
                k = k + 1
            }
        }
        var ms = childNodeOf(node, NodeKind.METHODS)
        if (ms != null) {
            var j = 0
            while (j < ms!!.childCount) {
                var fnode = ms!!.children[j]
                var plist = childNodeOf(fnode, NodeKind.PARAMS)
                var texts : string[] = new string[0]
                if (plist != null) {
                    texts = new string[plist!!.childCount]
                    var q = 0
                    while (q < plist!!.childCount) {
                        texts[q] = nodeProp(plist!!.children[q], "type")
                        q = q + 1
                    }
                }
                var mi = new MethInfo(nodeProp(fnode, "name"), texts.length, texts,
                                      nodeProp(fnode, "retType"),
                                      nodeProp(fnode, "stc") == "true",
                                      nodeProp(fnode, "control") == "PRIVATE",
                                      childNodeOf(fnode, NodeKind.BLOCK) == null,
                                      nodeProp(fnode, "override") == "true",
                                      childNodeOf(fnode, NodeKind.BLOCK) != null,
                                      fnode.line, fnode.col,
                                      nodeProp(fnode, "ctor") == "true")
                mi.setFnNode(fnode)
                ci.addMeth(mi)
                j = j + 1
            }
        }
        if (clsCount >= cls.length) {
            var bigger = new ClsInfo[cls.length * 2]
            var i = 0
            while (i < clsCount) { bigger[i] = cls[i]; i = i + 1 }
            cls = bigger
        }
        cls[clsCount] = ci
        clsCount = clsCount + 1
    }

    fn gatherClasses(prg : Node) -> void {
        cls = new ClsInfo[8]
        clsCount = 0
        var cs = childNodeOf(prg, NodeKind.CLASSES)
        if (cs != null) {
            var i = 0
            while (i < cs!!.childCount) { addClass(cs!!.children[i], false); i = i + 1 }
        }
        var isf = childNodeOf(prg, NodeKind.INTERFACES)
        if (isf != null) {
            var j = 0
            while (j < isf!!.childCount) { addClass(isf!!.children[j], true); j = j + 1 }
        }
        // 阶段 34：枚举名单独记一张表，`Color.RED` 才能当常量读
        enums = new string[8]
        enumCount = 0
        var es = childNodeOf(prg, NodeKind.ENUMS)
        if (es != null) {
            var k = 0
            while (k < es!!.childCount) {
                if (enumCount >= enums.length) {
                    var bigger = new string[enums.length * 2]
                    var q = 0
                    while (q < enumCount) { bigger[q] = enums[q]; q = q + 1 }
                    enums = bigger
                }
                enums[enumCount] = nodeProp(es!!.children[k], "name")
                enumCount = enumCount + 1
                k = k + 1
            }
        }
    }

    fn enumNamesOf(nm : string) -> bool {
        var i = 0
        while (i < enumCount) {
            if (enums[i] == nm) { rtn true }
            i = i + 1
        }
        rtn false
    }

    fn findCls(nm : string) -> ?ClsInfo {
        var i = 0
        while (i < clsCount) {
            if (cls[i].name == nm) { rtn cls[i] }
            i = i + 1
        }
        rtn null
    }

    fn checkClasses() -> void {
        var i = 0
        while (i < clsCount && failure == null) {
            checkOneClass(cls[i])
            i = i + 1
        }
    }

    fn checkOneClass(c : ClsInfo) -> void {
        if (c.parent.length() > 0) {
            var p = findCls(c.parent)
            if (p != null && p!!.isFinal) {
                failAtLC("类 '" + c.name + "' 不能继承 '" + c.parent + "'：'" + c.parent + "' 是 final 的（DESIGN-27）。rsf 的类默认可以被继承，只有写了 'final' 才禁止——把父类那行的 'final' 去掉才能继承：\n  class " + c.parent + "(...) { ... }", c.line, c.col)
                rtn
            }
        }
        // 父类构造实参：`class B : A("s")` 的类型要对得上 A 的构造器形参
        if (c.superNode != null) {
            var p2 = findCls(c.parent)
            if (p2 != null) {
                var sargs = childNodeOf(c.superNode!!, NodeKind.ARGS)
                var sargc = 0
                if (sargs != null) { sargc = sargs!!.childCount }
                if (sargc > 0) {
                    var ctor = ctorOf(p2!!, sargc)
                    if (ctor != null) {
                        var q2 = 0
                        while (q2 < sargc) {
                            var aType = checkExpr(sargs!!.children[q2])
                            if (failure != null) { rtn }
                            var want = ctor!!.paramTexts[q2]
                            if (!acceptsText(want, aType)) {
                                failAtLC(c.parent + "(...) 的 第 " + ("" + (q2 + 1)) + " 个实参类型不对：需要 " + want + "，实际给人 " + aType, c.line, c.col)
                                rtn
                            }
                            q2 = q2 + 1
                        }
                    }
                }
            }
        }
        // `super.xxx()` 只能指向父类链上真有的方法
        var sj = 0
        while (sj < c.methCount && failure == null) {
            var sm = c.meths[sj]
            if (sm.hasBody) {
                var sb = childNodeOf(sm.fnNode!!, NodeKind.BLOCK)
                if (sb != null) { superWalk(c, sb!!) }
            }
            sj = sj + 1
        }
        var j = 0
        while (j < c.methCount && failure == null) {
            var m = c.meths[j]
            if (!m.isOverride) {
                var pm = inheritedMeth(c.parent, m.name, m.argCount)
                if (pm != null) {
                    var own = inheritedOwnerOf(c.parent, m.name, m.argCount)
                    failAtLC("类 '" + c.name + "' 的 '" + m.name + "' 和父类 '" + own + "' 的 " + pm!!.sigText() + " 同签名了，但没写 override。rsf 不许遮蔽（DESIGN-25 §5）——要覆盖它就写成 'override fn " + m.name + "(...)'，只是重名就换个名字", m.line, m.col)
                    rtn
                }
            }
            j = j + 1
        }
        if (!c.isAbstract && !c.isIface && c.parent.length() > 0) {
            var missing = ""
            var count = 0
            var pn = c.parent
            while (pn.length() > 0) {
                var p = findCls(pn)
                if (p == null) { pn = "" }
                else {
                    var k = 0
                    while (k < p!!.methCount) {
                        var am = p!!.meths[k]
                        if (am.isAbstract && c.ownMeth(am.name, am.argCount) == null) {
                            count = count + 1
                            missing = missing + "\n  - " + am.sigText() + "（父类 '" + p!!.name + "' 的）"
                        }
                        k = k + 1
                    }
                    pn = p!!.parent
                }
            }
            if (count > 0) {
                failAtLC("类 '" + c.name + "' 还没有实现父类继承来的全部抽象方法，还缺 " + ("" + count) + " 个：" + missing + "\n（在类 '" + c.name + "' 里写一个同名、同参数类型的方法把它实现掉，或者把本类也写成 'abstract class " + c.name + "(...)'）", c.line, c.col)
                rtn
            }
        }
        if (!c.isIface && !c.isAbstract) {
            var miss = ""
            var n = 0
            var q = 0
            while (q < c.ifaceCount) {
                var iface = findCls(c.ifaces[q])
                if (iface != null) {
                    var k = 0
                    while (k < iface!!.methCount) {
                        var im = iface!!.meths[k]
                        var om = c.ownMeth(im.name, im.argCount)
                        if (!im.hasBody && om == null) {
                            n = n + 1
                            miss = miss + "\n  - " + im.fullText() + "（来自 接口 '" + iface!!.name + "'）"
                        } else if (!im.hasBody && om != null && (om!!.isPrivate || om!!.isStatic)) {
                            var kw = "prv"
                            if (om!!.isStatic) { kw = "stc" }
                            failAtLC("类 '" + c.name + "' 里的 '" + om!!.name + "' 是 " + kw + " 方法，实现不了接口要求的 " + im.fullText() + "（来自 接口 '" + iface!!.name + "'）：接口方法必须是 pub 的实例方法（不写修饰词就是 pub）", om!!.line, om!!.col)
                            rtn
                        }
                        k = k + 1
                    }
                }
                q = q + 1
            }
            if (n > 0) {
                failAtLC("类 '" + c.name + "' 没有实现接口要求的全部方法，还缺 " + ("" + n) + " 个：" + miss + "\n（在类里写一个同名、同参数类型、同返回类型的方法就补上了；接口里写了方法体（默认方法）的不用实现）", c.line, c.col)
                rtn
            }
        }
    }

    fn ctorOf(c : ClsInfo, argc : int) -> ?MethInfo {
        var i = 0
        while (i < c.methCount) {
            var m = c.meths[i]
            if (m.isCtor && m.argCount == argc) { rtn m }
            i = i + 1
        }
        rtn null
    }

    // 抽象类还没实现的成员（本类声明的 + 继承来的 + 接口要求的），用 `、` 连起来
    fn abstractMissing(c : ClsInfo) -> string {
        var out = ""
        var k = 0
        while (k < c.methCount) {
            var m = c.meths[k]
            if (m.isAbstract) {
                if (out.length() > 0) { out = out + "、" }
                out = out + m.sigText() + "（本类声明的）"
            }
            k = k + 1
        }
        var pn = c.parent
        while (pn.length() > 0) {
            var p = findCls(pn)
            if (p == null) { pn = "" }
            else {
                var k2 = 0
                while (k2 < p!!.methCount) {
                    var am = p!!.meths[k2]
                    if (am.isAbstract && c.ownMeth(am.name, am.argCount) == null) {
                        if (out.length() > 0) { out = out + "、" }
                        out = out + am.sigText() + "（父类 '" + p!!.name + "' 的）"
                    }
                    k2 = k2 + 1
                }
                pn = p!!.parent
            }
        }
        var q = 0
        while (q < c.ifaceCount) {
            var iface = findCls(c.ifaces[q])
            if (iface != null) {
                var k3 = 0
                while (k3 < iface!!.methCount) {
                    var im = iface!!.meths[k3]
                    if (!im.hasBody && c.ownMeth(im.name, im.argCount) == null) {
                        if (out.length() > 0) { out = out + "、" }
                        out = out + im.fullText() + "（来自 接口 '" + iface!!.name + "'）"
                    }
                    k3 = k3 + 1
                }
            }
            q = q + 1
        }
        rtn out
    }

    fn superWalk(c : ClsInfo, n : Node) -> void {
        if (failure != null) { rtn }
        if (n.kind == NodeKind.MEMBER && n.childCount > 0 && n.children[0].kind == NodeKind.SUPER) {
            var nm = nodeProp(n, "name")
            var argc = 0
            var args = childNodeOf(n, NodeKind.ARGS)
            if (args != null) { argc = args!!.childCount }
            if (inheritedMeth(c.parent, nm, argc) == null) {
                var hint = ""
                if (c.ownMeth(nm, argc) != null) {
                    hint = "（'" + nm + "' 只在 '" + c.name + "' 自己这里，直接写 " + nm + "(...) 就行）"
                }
                failAtLC("类 '" + c.name + "' 的父类链上没有方法 '" + nm + "'：super." + nm + "(...) 走的是父类那一份实现" + hint, n.line, n.col)
                rtn
            }
        }
        var i = 0
        while (i < n.childCount) {
            superWalk(c, n.children[i])
            i = i + 1
        }
    }

    fn inheritedMeth(parentName : string, nm : string, argc : int) -> ?MethInfo {
        var pn = parentName
        while (pn.length() > 0) {
            var p = findCls(pn)
            if (p == null) { rtn null }
            var m = p!!.ownMeth(nm, argc)
            if (m != null) { rtn m }
            pn = p!!.parent
        }
        rtn null
    }

    fn inheritedOwnerOf(parentName : string, nm : string, argc : int) -> string {
        var pn = parentName
        while (pn.length() > 0) {
            var p = findCls(pn)
            if (p == null) { rtn "" }
            if (p!!.ownMeth(nm, argc) != null) { rtn p!!.name }
            pn = p!!.parent
        }
        rtn ""
    }

    fn methOfType(typeText : string, nm : string, argc : int) -> ?MethInfo {
        var nm2 = typeText
        if (nm2.endsWith("?")) { nm2 = nm2.substring(0, nm2.length() - 1) }
        var c = findCls(nm2)
        if (c == null) { rtn null }
        rtn c!!.ownMeth(nm, argc)
    }

    // 只做「不可达代码」流分析，不做类型检查（build/run 驱动用：与 Kotlin 的警告一致就够）
    fn flowOnlyStmt(stmt : Node) -> void {
        if (stmt.kind == NodeKind.BLOCK) { checkBlock(stmt); rtn }
        if (stmt.kind == NodeKind.TRY) {
            var i = 0
            while (i < stmt.childCount) {
                var ch = stmt.children[i]
                if (ch.kind == NodeKind.BLOCK) {
                    if (i > 0) { warnDead(ch) }
                    checkBlock(ch)
                }
                i = i + 1
            }
            rtn
        }
        if (stmt.kind == NodeKind.IF || stmt.kind == NodeKind.WHILE || stmt.kind == NodeKind.FOR) {
            var k = 0
            while (k < stmt.childCount) {
                var ch2 = stmt.children[k]
                if (ch2.kind == NodeKind.BLOCK) { checkBlock(ch2) }
                k = k + 1
            }
        }
    }

    pub fn flowAll(prg : Node) -> void {
        var funcs = childNodeOf(prg, NodeKind.FUNCS)
        if (funcs == null) { rtn }
        var i = 0
        while (i < funcs!!.childCount) {
            var fnode = funcs!!.children[i]
            var body = childNodeOf(fnode, NodeKind.BLOCK)
            if (body != null) { checkBlock(body!!) }
            i = i + 1
        }
    }

    fn checkBlock(block : Node) -> void {
        scopes.enter()
        var i = 0
        var live = true
        while (i < block.childCount && failure == null) {
            var st = block.children[i]
            if (!live) { warnDead(st) }
            checkStmt(st)
            if (st.kind == NodeKind.LABEL) { live = true }
            else if (stmtEndsFlow(st)) { live = false }
            i = i + 1
        }
        scopes.leave()
    }

    // 语句之后还有没有「顺序往下走」这条路（对应 Kotlin 侧 IR 的无条件终结指令）
    fn stmtEndsFlow(st : Node) -> bool {
        if (st.kind == NodeKind.RETURN || st.kind == NodeKind.FAIL) { rtn true }
        if (st.kind == NodeKind.BREAK || st.kind == NodeKind.CONTINUE || st.kind == NodeKind.GOTO) { rtn true }
        if (st.kind == NodeKind.BLOCK) { rtn blockEndsFlow(st) }
        if (st.kind == NodeKind.IF) {
            if (st.childCount < 3) { rtn false }
            var tb = st.children[1]
            var eb = st.children[2]
            if (tb.kind != NodeKind.BLOCK || eb.kind != NodeKind.BLOCK) { rtn false }
            rtn blockEndsFlow(tb) && blockEndsFlow(eb)
        }
        if (st.kind == NodeKind.WHILE) {
            var cond = st.children[0]
            if (cond.kind == NodeKind.BOOL_LIT && nodeProp(cond, "value") == "true") {
                // 体内有 break 就有出口边（break 跳到循环之后）
                if (st.childCount > 1 && !bodyHasBreak(st.children[1], false)) { rtn true }
            }
        }
        if (st.kind == NodeKind.TRY) {
            var body = st.children[0]
            if (body.kind == NodeKind.BLOCK) { rtn blockEndsFlow(body) }
        }
        rtn false
    }

    // 循环体里有没有直接针对本层的 break（嵌套循环里的都不算）
    fn bodyHasBreak(n : Node, nested : bool) -> bool {
        if (n.kind == NodeKind.BREAK && !nested) { rtn true }
        var i = 0
        while (i < n.childCount) {
            var ch = n.children[i]
            var deep = nested
            if (ch.kind == NodeKind.WHILE || ch.kind == NodeKind.FOR) { deep = true }
            if (bodyHasBreak(ch, deep)) { rtn true }
            i = i + 1
        }
        rtn false
    }

    fn blockEndsFlow(b : Node) -> bool {
        if (b.childCount == 0) { rtn false }
        rtn stmtEndsFlow(b.children[b.childCount - 1])
    }

    // 不可达区域：每条用户语句各报一条；label / goto / 块本身不算
    fn warnDead(n : Node) -> void {
        if (n.kind != NodeKind.LABEL && n.kind != NodeKind.GOTO && n.kind != NodeKind.BLOCK && n.line > 0) {
            addWarn(n.line, n.col, "不可达代码（永远执行不到）")
        }
        var i = 0
        while (i < n.childCount) {
            var ch = n.children[i]
            if (isStmtNode(ch)) { warnDead(ch) }
            i = i + 1
        }
    }

    fn isStmtNode(n : Node) -> bool {
        if (n.kind == NodeKind.BLOCK || n.kind == NodeKind.IF || n.kind == NodeKind.WHILE || n.kind == NodeKind.FOR || n.kind == NodeKind.TRY) { rtn true }
        if (n.kind == NodeKind.RETURN || n.kind == NodeKind.VAR_DECL || n.kind == NodeKind.EXPR_STMT || n.kind == NodeKind.ASSIGN) { rtn true }
        if (n.kind == NodeKind.BREAK || n.kind == NodeKind.CONTINUE || n.kind == NodeKind.GOTO || n.kind == NodeKind.LABEL) { rtn true }
        if (n.kind == NodeKind.FAIL) { rtn true }
        rtn false
    }

    fn checkStmt(stmt : Node) -> void {
        if (warnOnly) { flowOnlyStmt(stmt); rtn }
        if (stmt.kind == NodeKind.VAR_DECL) { checkVarDecl(stmt) }
        else if (stmt.kind == NodeKind.EXPR_STMT) { checkExpr(stmt.children[0]) }
        else if (stmt.kind == NodeKind.ASSIGN) { checkAssign(stmt) }
        else if (stmt.kind == NodeKind.RETURN) { checkReturn(stmt) }
        else if (stmt.kind == NodeKind.IF || stmt.kind == NodeKind.WHILE || stmt.kind == NodeKind.FOR) {
            checkNested(stmt)
        } else if (stmt.kind == NodeKind.BLOCK) { checkBlock(stmt) }
        else if (stmt.kind == NodeKind.TRY) { checkTry(stmt) }
        else if (stmt.kind == NodeKind.BREAK) {
            if (loopDepth == 0) { failAt("'break' 只能用在 while 循环里", stmt) }
        } else if (stmt.kind == NodeKind.CONTINUE) {
            if (loopDepth == 0) { failAt("'continue' 只能用在 while 循环里", stmt) }
        } else if (stmt.kind == NodeKind.GOTO) {
            var lbl = nodeProp(stmt, "label")
            if (!hasLabel(lbl)) {
                failAt("goto 的标签 '" + lbl + "' 在函数 '" + curFnName + "' 里没有定义（标签是函数作用域，不能跨函数跳）", stmt)
            }
        } else if (stmt.kind == NodeKind.LABEL) {
            scopes.declare(symOf(nodeProp(stmt, "name"), "label", "void", stmt.line, stmt.col))
        }
    }

    fn collectLabels(n : Node) -> void {
        labels = new string[0]
        labelCount = 0
        labelWalk(n)
    }

    fn labelWalk(n : Node) -> void {
        if (n.kind == NodeKind.LABEL) {
            if (labelCount >= labels.length) {
                var bigger = new string[labels.length * 2 + 4]
                var i = 0
                while (i < labelCount) { bigger[i] = labels[i]; i = i + 1 }
                labels = bigger
            }
            labels[labelCount] = nodeProp(n, "name")
            labelCount = labelCount + 1
        }
        var i = 0
        while (i < n.childCount) {
            labelWalk(n.children[i])
            i = i + 1
        }
    }

    fn hasLabel(name : string) -> bool {
        var i = 0
        while (i < labelCount) {
            if (labels[i] == name) { rtn true }
            i = i + 1
        }
        rtn false
    }

    fn checkNested(stmt : Node) -> void {
        var isLoop = stmt.kind == NodeKind.WHILE || stmt.kind == NodeKind.FOR
        if (isLoop) { loopDepth = loopDepth + 1 }
        var i = 0
        while (i < stmt.childCount && failure == null) {
            var ch = stmt.children[i]
            if (ch.kind == NodeKind.BLOCK) { checkBlock(ch) }
            else if (ch.kind != NodeKind.VAR_DECL && ch.kind != NodeKind.PARAMS && ch.kind != NodeKind.CASES && ch.kind != NodeKind.ARGS && ch.kind != NodeKind.TARGET) {
                var condType = checkExpr(ch)
                if (failure == null && i == 0 && (stmt.kind == NodeKind.IF || stmt.kind == NodeKind.WHILE)) {
                    if (!acceptsText(condType, "bool")) {
                        failAt(wordOf(stmt.kind) + " 的条件必须是 bool，实际是 " + condType, ch)
                    }
                }
            }
            i = i + 1
        }
        if (isLoop) { loopDepth = loopDepth - 1 }
    }

    // try/catch：体照常检查；handler 在 Kotlin 侧 CFG 里收不到异常边（Checker 没传 handlers），
    // 所以整段 handler 都被判「不可达」——这里照抄这个口径。
    fn checkTry(stmt : Node) -> void {
        scopes.enter()
        var cname = nodeProp(stmt, "catch")
        if (cname.length() > 0) {
            scopes.declare(symOf(cname, "imutvar", "string", stmt.line, stmt.col))
        }
        if (stmt.childCount > 0) {
            var body = stmt.children[0]
            if (body.kind == NodeKind.BLOCK) { checkBlock(body) }
        }
        if (failure != null) { scopes.leave(); rtn }
        var i = 1
        while (i < stmt.childCount) {
            var ch = stmt.children[i]
            if (ch.kind == NodeKind.BLOCK) {
                warnDead(ch)
                checkBlock(ch)
            }
            i = i + 1
        }
        scopes.leave()
    }

    fn wordOf(k : NodeKind) -> string {
        if (k == NodeKind.IF) { rtn "if" }
        if (k == NodeKind.WHILE) { rtn "while" }
        rtn "for"
    }


    fn checkReturn(stmt : Node) -> void {
        if (stmt.childCount == 0) {
            if (!curVoid) {
                failAt("函数 '" + curFnName + "' 声明返回 " + curRetText + "）'rtn' 后面必须跟一个 " + curRetText + " 的值", stmt)
            }
            rtn
        }
        var got = checkExpr(stmt.children[0])
        if (failure != null) { rtn }
        if (curVoid) {
            failAt("函数 '" + curFnName + "' 是 void 函数，不能 rtn 一个 " + got + " 值（写成 'rtn' 或 'rtn null'）", stmt)
            rtn
        }
        if (curBodyHasTypeParam) { rtn }
        if (!acceptsText(got, curRetText)) {
            failAt("返回类型不匹配：'" + curFnName + "' 声明返回 " + curRetText + "）实际 rtn 的是 " + got, stmt)
        }
    }

    fn checkVarDecl(stmt : Node) -> void {
        var declared = nodeProp(stmt, "type")
        var typed = nodeProp(stmt, "typed") == "true"
        var savedExpect = curExpect
        if (typed) { curExpect = declared }
        var initType = checkExpr(stmt.children[0])
        curExpect = savedExpect
        if (scopes.lookupCurrent(nodeProp(stmt, "name")) != null) {
            failAt("变量 '" + nodeProp(stmt, "name") + "' 在同一个作用域里重复声明", stmt)
            rtn
        }
        if (typeOfTextT(declared).voidQ()) {
            failAt("变量不能是 void 类型", stmt)
            rtn
        }
        if (initType == "void") {
            failAt("void 不能作为变量的值", stmt)
            rtn
        }
        if (typed && !acceptsText(initType, declared)) {
            failAt("不能把 " + initType + " 赋给 " + declared + " 变量 '" + nodeProp(stmt, "name") + "'", stmt)
            rtn
        }
        var kindWord = "imutvar"
        if (nodeProp(stmt, "mutable") == "true") { kindWord = "var" }
        // 阶段 34：没写类型的 `var x = 1` 绑到推出来的类型上（`declared` 这时是 "-"）
        var bindingType = declared
        if (!typed) { bindingType = initType }
        scopes.declare(symOf(nodeProp(stmt, "name"), kindWord, bindingType, stmt.line, stmt.col))
    }

    fn checkAssign(stmt : Node) -> void {
        var sym = scopes.lookup(nodeProp(stmt, "name"))
        var valueType = checkExpr(stmt.children[0])
        if (sym == null) {
            failAt("未声明的变量 '" + nodeProp(stmt, "name") + "'", stmt)
            rtn
        }
        if (sym!!.kind == "imutvar") {
            failAt("变量 '" + nodeProp(stmt, "name") + "' 是 'imutvar' 声明的，不能重新赋值。想改值就把它声明成 'var'。", stmt)
            rtn
        }
        if (!acceptsText(valueType, sym!!.typeText)) {
            failAt("不能把 " + valueType + " 赋给 " + sym!!.typeText + " 变量 '" + nodeProp(stmt, "name") + "'", stmt)
        }
    }

    // ---------------------------------------------------------------- 表达式

    fn checkExpr(e : Node) -> string {
        if (failure != null) { rtn "void" }
        if (e.kind == NodeKind.INT_LIT) { rtn "int" }
        if (e.kind == NodeKind.LONG_LIT) { rtn "long" }
        if (e.kind == NodeKind.FLOAT_LIT) { rtn "float" }
        if (e.kind == NodeKind.DOUBLE_LIT) { rtn "double" }
        if (e.kind == NodeKind.STRING_LIT) { rtn "string" }
        if (e.kind == NodeKind.CHAR_LIT) { rtn "char" }
        if (e.kind == NodeKind.BOOL_LIT) { rtn "bool" }
        if (e.kind == NodeKind.VAR) {
            var nm = nodeProp(e, "name")
            var sym = scopes.lookup(nm)
            if (sym != null) { rtn sym!!.typeText }
            // 类名当接收者（`System.exit` / `Math.abs` / 声明的类名）
            if (isClassNameRef(nm)) { rtn nm }
            failAt("未声明的变量 '" + nm + "'", e)
            rtn "void"
        }
        if (e.kind == NodeKind.CALL) { rtn checkCall(e) }
        if (e.kind == NodeKind.INDEX) {
            var baseType = checkExpr(e.children[0])
            if (baseType.length() > 2 && baseType.substring(baseType.length() - 2, baseType.length()) == "[]") {
                rtn dropTwoTail(baseType)
            }
            rtn "void"
        }
        if (e.kind == NodeKind.IS) { rtn checkIs(e) }
        if (e.kind == NodeKind.AS) { rtn checkAs(e) }
        if (e.kind == NodeKind.LAMBDA) { rtn checkLambda(e) }
        if (e.kind == NodeKind.NEW) {
            var cname = nodeProp(e, "class")
            var cl = findCls(cname)
            if (cl != null && cl!!.isAbstract) {
                failAt("'" + cname + "' 是抽象类，不能 new——抽象类只能当父类，要用一个把抽象成员都实现的子类（abstract class " + cname + "）。它还没实现的有：" + abstractMissing(cl!!), e)
            }
            rtn cname
        }
        if (e.kind == NodeKind.NEW_ARRAY) {
            var dim = 0
            while (dim < e.childCount) {
                checkExpr(e.children[dim])
                dim = dim + 1
            }
            var suffix = ""
            var d2 = 0
            while (d2 < e.childCount) {
                suffix = suffix + "[]"
                d2 = d2 + 1
            }
            rtn nodeProp(e, "elem") + suffix
        }
        if (e.kind == NodeKind.MEMBER) { rtn checkMember(e) }
        if (e.kind == NodeKind.BINARY) { rtn checkBinary(e) }
        if (e.kind == NodeKind.ELVIS) {
            var lt = checkExpr(e.children[0])
            checkExpr(e.children[1])
            if (lt.length() > 0 && lt.charAt(0) == '?') { rtn rangeFrom(lt, 1) }
            rtn lt
        }
        if (e.kind == NodeKind.FORCE) {
            var ft = checkExpr(e.children[0])
            if (ft.length() > 0 && ft.charAt(0) == '?') { rtn rangeFrom(ft, 1) }
            rtn ft
        }
        var i = 0
        while (i < e.childCount) {
            checkExpr(e.children[i])
            i = i + 1
        }
        rtn "void"
    }

    fn checkCall(e : Node) -> string {
        var name = nodeProp(e, "name")
        var args = childNodeOf(e, NodeKind.ARGS)
        var argc = 0
        if (args != null) { argc = args!!.childCount }
        var types : string[] = new string[argc]
        var i = 0
        while (i < argc) {
            types[i] = checkExpr(args!!.children[i])
            i = i + 1
        }
        if (failure != null) { rtn "void" }
        var sig = findFn(name)
        if (sig == null) {
            if (name == "println" || name == "print") {
                if (argc != 1) {
                    failAt("调用 '" + name + "' 的参数个数不对：实际给了 " + ("" + argc) + " 个，候选有 1 个 —— " + name + "(value : string)", e)
                }
                rtn "void"
            }
            var fsym = scopes.lookup(name)
            if (fsym != null && containsSub(fsym!!.typeText, "->")) {
                if (argc != 0) {
                    failAt("函数值 '" + name + "' 一个参数都不收", e)
                }
                rtn retPartOf(fsym!!.typeText)
            }
            failAt("未定义的函数 '" + name + "'", e)
            rtn "void"
        }
        if (argc != sig!!.paramCount) {
            failAt("调用 '" + name + "' 的参数个数不对：实际给了 " + ("" + argc) + " 个，候选有 1 个 —— " + sig!!.signatureText(), e)
            rtn "void"
        }
        if (sig!!.typeParamCount > 0) { rtn bindGenericCall(e, sig!!, types, argc) }
        var k = 0
        while (k < argc) {
            if (!acceptsText(types[k], sig!!.paramTexts[k])) {
                failAt("参数类型不匹配：'" + name + "' 的第 " + ("" + (k + 1)) + " 个参数 '" + sig!!.paramNames[k] + "' 需要 " + sig!!.paramTexts[k] + "，实际给人 " + types[k], e)
                rtn "void"
            }
            k = k + 1
        }
        rtn sig!!.retText
    }


    // 成员访问/成员调用（33c 只认「接收者是类的实例」与「接收者是类名（静态）」两种，
    // 字段读写先按名字放过——语料还没用到）
    fn checkMember(e : Node) -> string {
        var nm = nodeProp(e, "name")
        var isCall = nodeProp(e, "call") == "true"
        var recv = e.children[0]
        var argc = 0
        var args = childNodeOf(e, NodeKind.ARGS)
        if (args != null) { argc = args!!.childCount }

        // `A.get()`：接收者是类名本身 ⇒ 只许调 stc 方法；`Color.RED` 是枚举常量
        if (recv.kind == NodeKind.VAR) {
            var rn = nodeProp(recv, "name")
            if (scopes.lookup(rn) == null) {
                if (enumNamesOf(rn)) { rtn rn }
                var ownCls = findCls(rn)
                if (ownCls != null) {
                    var sm = ownCls!!.ownMeth(nm, argc)
                    if (sm != null && !sm!!.isStatic) {
                        failAt("'" + nm + "' 的调用方式不对——它不是 stc 的，要先有对象：对象." + nm + "(...)", e)
                        rtn "void"
                    }
                    var k = 0
                    while (k < argc) {
                        checkExpr(args!!.children[k])
                        k = k + 1
                    }
                    if (sm != null) { rtn sm!!.retText }
                    failAt("类 '" + rn + "' 里没有方法 '" + nm + "'", e)
                    rtn "void"
                }
                if (jdkMemberType(rn, nm).length() > 0 || isJdkClass(rn)) {
                    var k2 = 0
                    while (k2 < argc) {
                        checkExpr(args!!.children[k2])
                        k2 = k2 + 1
                    }
                    rtn jdkMemberType(rn, nm)
                }
            }
        }

        var recvType = checkExpr(recv)
        if (failure != null) { rtn "void" }
        var k = 0
        while (k < argc) {
            checkExpr(args!!.children[k])
            k = k + 1
        }
        if (failure != null) { rtn "void" }
        var mm = methOfType(recvType, nm, argc)
        if (mm == null) {
            var builtin = builtinMemberType(recvType, nm, isCall)
            if (builtin.length() > 0) { rtn builtin }
            rtn recvType
        }
        if (mm!!.isPrivate && !inOwnClass(recvType)) {
            var ownerName = baseClsName(recvType)
            failAt("'" + nm + "' 是 " + ownerName + " 的 prv 方法，只能在这个类内部使用。要让外面也能用，把它改成 prot 或 pub", e)
            rtn "void"
        }
        if (isCall) { rtn mm!!.retText }
        rtn mm!!.retText
    }

    fn baseClsName(typeText : string) -> string {
        var t = typeText
        if (t.endsWith("?")) { t = t.substring(0, t.length() - 1) }
        rtn t
    }

    // 当前语句是不是写在某个类的方法体里（33c 只检查顶层函数，所以恒 false；
    // 留着是为了 34 检查类方法体时不必改调用点）
    fn inOwnClass(typeText : string) -> bool {
        rtn false
    }

    fn checkBinary(e : Node) -> string {
        var left = checkExpr(e.children[0])
        var right = checkExpr(e.children[1])
        if (failure != null) { rtn "void" }
        var op = opText(nodeProp(e, "op"))
        if (op == "==" || op == "!=") { rtn "bool" }
        if (op == "<" || op == ">" || op == "<=" || op == ">=") {
            if (!isNumeric(left) || !isNumeric(right)) {
                failAt("'" + op + "' 只能比较非空数值（byte / char / int / long / float / double），实际是 " + left + " 和 " + right + "（字符串只能用 == / !=；可空值要先解包）", e)
                rtn "void"
            }
            rtn "bool"
        }
        if (op == "&&" || op == "||") {
            if (left != "bool" || right != "bool") {
                failAt("运算符 '" + op + "' 需要 bool，实际是 " + left + " 和 " + right, e)
                rtn "void"
            }
            rtn "bool"
        }
        if (op == "+" && (left == "string" || right == "string")) { rtn "string" }
        if (!isNumeric(left) || !isNumeric(right)) {
            failAt("运算符 '" + op + "' 需要数值（byte / char / int / long / float / double），实际是 " + left + " 和 " + right + "（字符串拼接只支持 '+'）", e)
            rtn "void"
        }
        rtn left
    }

    // AST 的 `op` 存的是记号种类（`PLUS`），报错与打印要用符号（`+`）
    fn opText(kind : string) -> string {
        if (kind == "PLUS") { rtn "+" }
        if (kind == "MINUS") { rtn "-" }
        if (kind == "STAR") { rtn "*" }
        if (kind == "SLASH") { rtn "/" }
        if (kind == "PERCENT") { rtn "%" }
        if (kind == "EQ") { rtn "==" }
        if (kind == "NE") { rtn "!=" }
        if (kind == "LT") { rtn "<" }
        if (kind == "GT") { rtn ">" }
        if (kind == "LE") { rtn "<=" }
        if (kind == "GE") { rtn ">=" }
        if (kind == "AND" || kind == "ANDAND") { rtn "&&" }
        if (kind == "OR" || kind == "OROR") { rtn "||" }
        rtn kind
    }

    fn isNumeric(t : string) -> bool {
        rtn t == "byte" || t == "char" || t == "int" || t == "long" || t == "float" || t == "double"
    }

    fn acceptsText(from : string, to : string) -> bool {
        var ft = typeOfTextT(from)
        var tt = typeOfTextT(to)
        if (tt.accepts(ft)) { rtn true }
        // 阶段 38：类/接口子类型（Kotlin 的 `RsfType.accepts` 只认同一类型名，
        // 子类赋给父类由 `checker` 的继承检查兜住，这里补上）
        if (tt.base != "EXTERNAL" || ft.base != "EXTERNAL") { rtn false }
        if (tt.depth != ft.depth) { rtn false }
        if (ft.nullable && !tt.nullable) { rtn false }
        rtn isSubclassName(ft.extName, tt.extName)
    }

    // `have` 是不是 `want` 的子类型（沿父类链 + 自己的接口 + 接口继承闭包）
    fn isSubclassName(have : string, want : string) -> bool {
        if (have == want) { rtn true }
        var c = findCls(have)
        var guard = 0
        while (c != null && guard < 64) {
            var i = 0
            while (i < c!!.ifaceCount) {
                if (ifaceExtendsName(c!!.ifaces[i], want)) { rtn true }
                i = i + 1
            }
            if (c!!.parent == want) { rtn true }
            c = findCls(c!!.parent)
            guard = guard + 1
        }
        rtn false
    }

    fn ifaceExtendsName(nm : string, want : string) -> bool {
        if (nm == want) { rtn true }
        var i = findCls(nm)
        if (i == null) { rtn false }
        var k = 0
        while (k < i!!.ifaceCount) {
            if (ifaceExtendsName(i!!.ifaces[k], want)) { rtn true }
            k = k + 1
        }
        rtn false
    }

    // ------------------------------------------------------------ 阶段 33d：IS / lambda / 泛型推导

    // `x as T` / `x ?as T`：静态类型就是目标类型（Kotlin 侧同样只看目标）
    // 类名当值用：声明的类/接口/枚举 + 常用 JDK 类（自举链自己就在用 System/File/String）
    // 内建成员的返回类型（string / 数组 / ArrayList），自举链编译自身要靠这些
    fn builtinMemberType(recvType : string, nm : string, isCall : bool) -> string {
        var t = recvType
        if (t.length() > 0 && t.charAt(0) == '?') { t = rangeFrom(t, 1) }
        if (t.length() > 2 && t.charAt(t.length() - 1) == ']' && t.charAt(t.length() - 2) == '[') {
            if (!isCall && nm == "length") { rtn "int" }
            rtn ""
        }
        if (t == "string") {
            if (nm == "length" || nm == "indexOf" || nm == "lastIndexOf" || nm == "compareTo") { rtn "int" }
            if (nm == "charAt") { rtn "char" }
            if (nm == "substring" || nm == "trim" || nm == "toUpperCase" || nm == "toLowerCase" || nm == "replace" || nm == "toString") { rtn "string" }
            if (nm == "contains" || nm == "startsWith" || nm == "endsWith" || nm == "isEmpty" || nm == "equals") { rtn "bool" }
            if (nm == "split") { rtn "string[]" }
            rtn ""
        }
        if (t == "ArrayList") {
            if (nm == "size" || nm == "indexOf") { rtn "int" }
            if (nm == "get") { rtn "Object" }
            if (nm == "add" || nm == "set" || nm == "remove" || nm == "clear") { rtn "void" }
            if (nm == "contains" || nm == "isEmpty") { rtn "bool" }
            rtn ""
        }
        if (t == "StringBuilder") {
            if (nm == "toString") { rtn "string" }
            if (nm == "length") { rtn "int" }
            rtn "StringBuilder"
        }
        if (t == "PrintStream") { rtn "void" }
        rtn ""
    }

    fn isJdkClass(nm : string) -> bool {
        if (nm == "System" || nm == "String" || nm == "Math" || nm == "File") { rtn true }
        if (nm == "Integer" || nm == "Long" || nm == "Double" || nm == "Float" || nm == "Boolean") { rtn true }
        if (nm == "Character" || nm == "Byte" || nm == "Short" || nm == "Object") { rtn true }
        if (nm == "ArrayList" || nm == "HashMap" || nm == "StringBuilder" || nm == "PrintStream") { rtn true }
        rtn false
    }

    // 自举链用到的 JDK 静态成员（只覆盖实际用到的那些，别的给 void）
    fn jdkMemberType(recv : string, nm : string) -> string {
        if (recv == "System") {
            if (nm == "getProperty" || nm == "getenv") { rtn "?string" }
            if (nm == "err" || nm == "out") { rtn "PrintStream" }
            if (nm == "currentTimeMillis" || nm == "nanoTime") { rtn "long" }
            rtn "void"
        }
        if (recv == "String") {
            if (nm == "valueOf" || nm == "format") { rtn "string" }
            rtn "void"
        }
        if (recv == "Integer") {
            if (nm == "parseInt") { rtn "int" }
            if (nm == "toString" || nm == "toHexString") { rtn "string" }
            if (nm == "valueOf") { rtn "Integer" }
            rtn "void"
        }
        if (recv == "Long") {
            if (nm == "parseLong") { rtn "long" }
            if (nm == "toString") { rtn "string" }
            rtn "void"
        }
        if (recv == "Math") {
            if (nm == "abs") { rtn "int" }
            rtn "double"
        }
        if (recv == "File") {
            if (nm == "mkdirs" || nm == "exists" || nm == "isFile" || nm == "isDirectory" || nm == "delete") { rtn "bool" }
            if (nm == "getPath" || nm == "getAbsolutePath" || nm == "getName") { rtn "string" }
            rtn "void"
        }
        if (recv == "PrintStream") { rtn "void" }
        if (recv == "StringBuilder") {
            if (nm == "toString") { rtn "string" }
            rtn "StringBuilder"
        }
        rtn ""
    }

    fn isClassNameRef(nm : string) -> bool {
        if (findCls(nm) != null || enumNamesOf(nm)) { rtn true }
        if (nm == "System" || nm == "String" || nm == "Math" || nm == "Integer" || nm == "Long") { rtn true }
        if (nm == "Double" || nm == "Float" || nm == "Boolean" || nm == "Character" || nm == "Byte" || nm == "Short") { rtn true }
        if (nm == "File" || nm == "ArrayList" || nm == "HashMap" || nm == "StringBuilder" || nm == "Object") { rtn true }
        rtn false
    }

    fn checkAs(e : Node) -> string {
        checkExpr(e.children[0])
        var tgt = childNodeOf(e, NodeKind.TARGET)
        if (tgt == null) { rtn "void" }
        rtn nodeProp(tgt!!, "type")
    }

    fn checkIs(e : Node) -> string {
        var tgt = childNodeOf(e, NodeKind.TARGET)
        if (tgt != null && containsSub(nodeProp(tgt!!, "type"), "->")) {
            failAt("'is' 的目标不能是函数类型（DESIGN-30）", e)
            rtn "void"
        }
        checkExpr(e.children[0])
        rtn "bool"
    }

    fn captureScan(n : Node) -> void {
        if (failure != null) { rtn }
        if (n.kind == NodeKind.VAR) {
            var nm = nodeProp(n, "name")
            var sym = scopes.lookup(nm)
            if (sym != null && sym!!.kind == "var") {
                failAt("lambda 只能值捕获：'" + nm + "' 是 var（DESIGN-30）——改成 imutvar，或者把它当参数传进来", n)
                rtn
            }
        }
        var i = 0
        while (i < n.childCount) {
            captureScan(n.children[i])
            i = i + 1
        }
    }

    fn checkLambda(e : Node) -> string {
        var fnType = curExpect
        if (!containsSub(fnType, "->")) { fnType = "" }
        var declaredRet = nodeProp(e, "ret")
        if (fnType == "" && declaredRet == "") {
            failAt("lambda 的参数类型推不出来：参数上写类型，或者把 lambda 赋给一个声明了函数类型的变量（DESIGN-30）", e)
            rtn "void"
        }
        var lambdaRet = declaredRet
        if (lambdaRet == "") { lambdaRet = retPartOf(fnType) }
        var body = childNodeOf(e, NodeKind.BLOCK)
        if (body == null) { rtn "void" }
        scopes.enter()
        var j = 0
        while (j < e.childCount && e.children[j].kind == NodeKind.PARAM) {
            var prm = e.children[j]
            scopes.declare(symOf(nodeProp(prm, "name"), "param", nodeProp(prm, "type"), prm.line, prm.col))
            j = j + 1
        }
        captureScan(body!!)
        if (failure != null) { scopes.leave(); rtn "void" }
        var savedRet = curRetText
        var savedVoid = curVoid
        curRetText = lambdaRet
        curVoid = lambdaRet == "void"
        checkBlock(body!!)
        curRetText = savedRet
        curVoid = savedVoid
        scopes.leave()
        if (fnType != "") { rtn fnType }
        rtn lambdaRet
    }

    fn bindPattern(e : Node, pat : string, act : string, names : string[], vals : string[], bound : bool[]) -> void {
        var p = pat
        var a = act
        if (p.length() > 0 && p.charAt(0) == '?') { p = dropOne(p) }
        if (a.length() > 0 && a.charAt(0) == '?') { a = dropOne(a) }
        if (p.length() > 2 && a.length() > 2 && p.substring(p.length() - 2, p.length()) == "[]" && a.substring(a.length() - 2, a.length()) == "[]") {
            var pe = dropTwoTail(p)
            var ae = dropTwoTail(a)
            var pi = typeParamIndexIn(pe, names)
            if (pi >= 0 && isPrimTypeName(ae)) {
                failAt("泛型参数 '" + pe + "' 绑到了基本类型 '" + ae + "'：'" + pe + "[]' 在 JVM 上擦成 Object[]，装不下基本类型数组（DESIGN-31 §8）——把实参换成引用元素数组（例如 string[] 或类数组）", e)
                rtn
            }
            bindPattern(e, pe, ae, names, vals, bound)
            rtn
        }
        var idx = typeParamIndexIn(p, names)
        if (idx >= 0 && !bound[idx]) {
            vals[idx] = a
            bound[idx] = true
        }
    }

    fn bindGenericCall(e : Node, sig : FnSig, types : string[], argc : int) -> string {
        var vals : string[] = new string[sig.typeParamCount]
        var bound : bool[] = new bool[sig.typeParamCount]
        var k = 0
        while (k < argc) {
            bindPattern(e, sig.paramTexts[k], types[k], sig.typeParamNames, vals, bound)
            if (failure != null) { rtn "void" }
            k = k + 1
        }
        var m = 0
        while (m < sig.typeParamCount) {
            if (!bound[m]) {
                failAt("类型参数 '" + sig.typeParamNames[m] + "' 推不出来：它只出现在返回类型里，让它出现在某个参数类型里（例如 'fn f(x : T) -> T'）", e)
                rtn "void"
            }
            m = m + 1
        }
        rtn substSimple(sig.retText, sig.typeParamNames, vals)
    }
}

// 取第一个指定种类的孩子（没有就是 null）
pub fn childNodeOf(n : Node, kind : NodeKind) -> ?Node {
    var i = 0
    while (i < n.childCount) {
        if (n.children[i].kind == kind) { rtn n.children[i] }
        i = i + 1
    }
    rtn null
}

// 从属性串里取 `k=v`
fn propIsWord(c : char) -> bool {
    if (c >= 'a' && c <= 'z') { rtn true }
    if (c >= 'A' && c <= 'Z') { rtn true }
    if (c >= '0' && c <= '9') { rtn true }
    rtn c == '_'
}

fn propKeyStartsAt(t : string, i : int) -> bool {
    var len = t.length()
    if (i >= len) { rtn false }
    if (t.charAt(i) != ' ') { rtn false }
    var j = i + 1
    var n = 0
    var going = true
    while (j < len && going) {
        if (propIsWord(t.charAt(j))) {
            j = j + 1
            n = n + 1
        } else {
            going = false
        }
    }
    if (n == 0 || j >= len) { rtn false }
    rtn t.charAt(j) == '='
}

// 属性串是 "k=v k=v"：值里可以有空格（函数类型 `(int) -> int`），
// 只有「空格 + 标识符 + `=`」才算下一个属性的开头（与 Backend.rsf 的 prop 同一套）。
pub fn nodeProp(n : Node, key : string) -> string {
    var t = n.text
    var i = 0
    var len = t.length()
    while (i < len) {
        var keyStart = i
        while (i < len && t.charAt(i) != '=') { i = i + 1 }
        if (i >= len) { rtn "" }
        var k = t.substring(keyStart, i)
        i = i + 1
        var valStart = i
        while (i < len && !propKeyStartsAt(t, i)) { i = i + 1 }
        var v = t.substring(valStart, i)
        if (k == key) { rtn v }
        i = i + 1
    }
    rtn ""
}


// ---------------------------------------------------------------- 类模型（33c）

// 一个方法/接口方法的签名（报错文案要印 `tag()` / `id(T)` / `run() -> int`）
pub class MethInfo(name : string, argCount : int, paramTexts : string[], retText : string,
                      isStatic : bool, isPrivate : bool, isAbstract : bool, isOverride : bool,
                      hasBody : bool, line : int, col : int, isCtor : bool) {
    var name : string = name
    var argCount : int = argCount
    var paramTexts : string[] = paramTexts
    var retText : string = retText
    var isStatic : bool = isStatic
    var isPrivate : bool = isPrivate
    var isAbstract : bool = isAbstract
    var isOverride : bool = isOverride
    var hasBody : bool = hasBody
    var isCtor : bool = isCtor
    var fnNode : ?Node = null
    var line : int = line
    var col : int = col

    pub fn setFnNode(n : Node) -> void { fnNode = n }

    pub fn sigText() -> string {
        var out = name + "("
        var i = 0
        while (i < argCount) {
            if (i > 0) { out = out + ", " }
            out = out + paramTexts[i]
            i = i + 1
        }
        rtn out + ")"
    }

    pub fn fullText() -> string { rtn sigText() + " -> " + retText }
}

pub class ClsInfo(name : string, isFinal : bool, isAbstract : bool, isIface : bool,
                     parent : string, line : int, col : int) {
    var name : string = name
    var isFinal : bool = isFinal
    var isAbstract : bool = isAbstract
    var isIface : bool = isIface
    var parent : string = parent
    var line : int = line
    var col : int = col
    var ifaces : string[] = new string[4]
    var ifaceCount : int = 0
    var meths : MethInfo[] = new MethInfo[4]
    var methCount : int = 0
    var superNode : ?Node = null

    pub fn setSuper(n : Node) -> void { superNode = n }

    pub fn addIface(nm : string) -> void {
        if (ifaceCount >= ifaces.length) {
            var bigger = new string[ifaces.length * 2]
            var i = 0
            while (i < ifaceCount) { bigger[i] = ifaces[i]; i = i + 1 }
            ifaces = bigger
        }
        ifaces[ifaceCount] = nm
        ifaceCount = ifaceCount + 1
    }

    pub fn addMeth(m : MethInfo) -> void {
        if (methCount >= meths.length) {
            var bigger = new MethInfo[meths.length * 2]
            var i = 0
            while (i < methCount) { bigger[i] = meths[i]; i = i + 1 }
            meths = bigger
        }
        meths[methCount] = m
        methCount = methCount + 1
    }

    pub fn ownMeth(nm : string, argc : int) -> ?MethInfo {
        var i = 0
        while (i < methCount) {
            if (meths[i].name == nm && meths[i].argCount == argc) { rtn meths[i] }
            i = i + 1
        }
        rtn null
    }
}

// 检查一份源码：通过就 rtn null，否则返回第一处错
pub fn checkSourceFull(text : string) -> Checker {
    var ast = parseSource(text)
    var c = new Checker(null)
    if (ast.kind == NodeKind.ERROR) { rtn c }
    c.check(ast)
    rtn c
}

// 只算「不可达代码」警告，不跑类型检查（`build`/`run` 驱动用）
pub fn warningsOnly(text : string) -> Checker {
    var ast = parseSource(text)
    var c = new Checker(null)
    if (ast.kind == NodeKind.ERROR) { rtn c }
    c.warnOnly = true
    c.flowAll(ast)
    rtn c
}

pub fn checkSource(text : string) -> ?CheckFailure {
    var c = checkSourceFull(text)
    rtn c.failureOf()
}

// 与 Kotlin `Main` 同款：`[rsf] 警告: <文件名>:<行>: <文案>`（只有行号，没有列）
pub fn printWarnings(c : Checker, file : string) -> void {
    var i = 0
    while (i < c.warningCount()) {
        System.err.println("[rsf] 警告: " + file + ":" + ("" + c.warnLine(i)) + ": " + c.warnText(i))
        i = i + 1
    }
}

// ---------------------------------------------------------------- 阶段 33d：纯字符串/类型名工具

pub fn containsSub(s : string, sub : string) -> bool {
    var i = 0
    while (i + sub.length() <= s.length()) {
        if (s.substring(i, i + sub.length()) == sub) { rtn true }
        i = i + 1
    }
    rtn false
}

fn dropOne(s : string) -> string {
    rtn s.substring(1, s.length())
}

fn dropTwoTail(s : string) -> string {
    rtn s.substring(0, s.length() - 2)
}

// `(int) -> bool` 的返回部分（`->` 之后、去掉空白）
pub fn retPartOf(fnType : string) -> string {
    var i = 0
    while (i + 1 < fnType.length()) {
        if (fnType.charAt(i) == '-' && fnType.charAt(i + 1) == '>') {
            var j = i + 2
            while (j < fnType.length() && fnType.charAt(j) == ' ') { j = j + 1 }
            rtn fnType.substring(j, fnType.length())
        }
        i = i + 1
    }
    rtn "void"
}

fn isPrimTypeName(t : string) -> bool {
    if (t == "int" || t == "long" || t == "short" || t == "byte" || t == "char" || t == "float" || t == "double" || t == "bool") { rtn true }
    rtn false
}

fn typeParamIndexIn(name : string, names : string[]) -> int {
    var i = 0
    while (i < names.length) {
        if (names[i] == name) { rtn i }
        i = i + 1
    }
    rtn -1
}

// 只处理 33d 需要的三种形状：`T`、`T[]`、`?T`
fn substSimple(t : string, names : string[], vals : string[]) -> string {
    var i = 0
    while (i < names.length) {
        if (t == names[i]) { rtn vals[i] }
        if (t == names[i] + "[]") { rtn vals[i] + "[]" }
        if (t == "?" + names[i]) { rtn "?" + vals[i] }
        i = i + 1
    }
    rtn t
}
