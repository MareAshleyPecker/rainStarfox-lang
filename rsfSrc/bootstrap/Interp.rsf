// rainStarfox 阶段 17c：**用 rsf 自己写的解释器**（自举的第三步）
//
// 基准是 Kotlin 版 `src/main/kotlin/org/example/complie/interp/Interpreter.kt`：同一份 `.rsf`
// 输入，这里跑出来的 **stdout 必须与 `rsf run` 逐字节相同**（对拍见 BOOTSTRAP.md 的 17c 段）。
//
// 这个文件是**纯库**（没有 main）：`import "Interp.rsf"` 就能用 `runSource(source)`。
// 要跑起来看输出用旁边的 `InterpCli.rsf`：
//
//     rsf build rsfSrc/bootstrap/InterpCli.rsf -o out
//     java -Drsf.interp.file=rsfSrc/lang/main.rsf -cp out InterpCli
//
// 查：rsf check rsfSrc/bootstrap/InterpCli.rsf
//
// ================================================================ 内部流程
//
//     rsf 版 lex（Lexer.rsf）→ rsf 版 parse（Parser.rsf）→ 在这棵**胖节点树**上遍历执行
//
// 所以它是**树遍历解释器**，而 Kotlin 版跑的是降级后的扁平 IR。两条实现路径不同，
// 但**观察到的语义必须一致**——这就是本阶段的对拍口径。
//
// ================================================================ 值怎么表示：标签联合
//
// rsf 没有继承/接口，写不出 `sealed class Value`，所以值是一个**标签联合**：
// `Val` 上挂一个 `kind : Kind` 枚举 + 每种载荷一个字段（`iv : int`、`dv : double`、
// `sv : string`、`ov : ?Obj`…）。对象/数组单独用 `Obj` / `Arr` 两个类，
// `Val` 里存它们的**引用**——于是 `var b = a` 天然是共享引用（和 JVM 一致）。
//
// **静态类型怎么补上**：Kotlin 版有一整套 Checker 算出来的静态类型，很多语义（int 除法
// 还是 double 除法、`render` 按哪个类型打、`byte` 怎么截断）都靠它。树遍历器没有那张表，
// 用的是**运行期标签**：只要在每个类型边界（变量声明、参数、返回、字段、数组元素）
// 按标注把值收敛一次，运行期标签就恒等于静态类型，两种做法给出的结果就一样。
// 这正是 `coerceTo` 存在的理由，不是可选的优化。
//
// ================================================================ 控制流怎么表示：fail + 信号
//
// rsf 只有 `fail` / `!T`（没有异常），而解释器需要四种「跳出」：return / break /
// continue / goto。做法是**借用 `fail` 做非局部跳转**，用一条带前缀的消息区分信号与真错误：
//
//     消息 = toChar(1) + 种类 + ":" + 载荷
//
// 前缀用 `toChar(1)`（运行期算出来的控制字符）而不是字符串字面量里的 `\u0001`，
// 免得踩到词法器转义表的边角；用户 `fail` 出来的消息不可能以它开头。
//
// 每种跳出都在**离它最近的、能处理它的那一层**被接住，接不住就原样重新 `fail`：
//   BLOCK  接 goto（标签在本块里才接；否则往上传）
//   WHILE  接 break / continue
//   FOR    接 break / continue（continue 要把它自己的「更新」跑一遍）
//   TRY    接真错误；信号一律原样往上传（否则 `try { rtn 5 } catch ...` 会把 return 吃掉）
//   函数调用 接 return
// 还有一个「不可接」的信号 `X`：`!!` 打到 null。Kotlin 版那里抛的是
// `NullPointerException`，而解释器的 `try` **只接 rsf 自己的错误**，所以它必须穿过去。
//
// ================================================================ 调用约定
//
// 本文件里所有「可能出错」的函数都标成 `!T`，调用点一律用 `!!` 往上抛——和 Parser.rsf
// 的 flag 路线不同：解释器的错误本来就是「跳出去」，用 `fail` 才是同构的写法。
// 纯 void 的中间函数写成 `-> !int`（恒返回 0）只是为了让 `!!` 能用
// （rsf 的 `!void` 取不出值、写不了 `!!`）。

import "Lexer.rsf"
import "Parser.rsf"

import java.lang.System
// 数字字面量的「值」在树上是**规范化过的文本**（Parser.rsf 用同一批 JVM 方法算出来的），
// 所以这里用同一批方法读回来：`Double.toString(0.5)` 写出来的东西只有
// `Double.parseDouble` 能一字不差地读回去。
import java.lang.Long
import java.lang.Float
import java.lang.Double
// 互操作替身用的两个类（只有 files.rsf 那条路会碰）：路径拼接与删除**交给 JVM 自己做**，
// 免得自己拼分隔符、也免得自己实现 unlink
import java.io.File

// ================================================================ 运行期错误消息
//
// **和 sema/Builtins.kt 里的那几个 object 一字不差**。它们是「两端逐字节一致」的
// 直接依赖：`try { ... } catch (e : string) { println(e) }` 打出来的就是这些串。

// ArrayRuntime
public fun arrayIndexFailure(length : int, index : int) -> string {
    rtn "数组下标越界：长度 " + length + "，下标 " + index
}

public fun arrayLengthFailure(length : int) -> string {
    rtn "数组长度不能是负数：" + length
}

// EnumRuntime
public fun switchNoMatchFailure(enumName : string) -> string {
    rtn "switch 没匹配到任何分支：" + enumName + " 的常量都不是 null，" +
        "所以被分派的值只能是 null（数组元素的默认值、泛型容器取出来的空槽都会是 null）。" +
        "给这个 switch 加一支 'else : ...' 就能兜住它"
}

// Builtins.parseIntFailure —— 消息本身由 rsf 内置的 `parseInt` 抛出来，那条路径已经一致；
// 这里只是把「解释器自己也要能给出同一条」写下来，供 `?:` 那条路复核。
public fun parseIntFailure(text : string) -> string {
    rtn "parseInt: 不是合法的整数：'" + text + "'"
}

// 17c 解释器自己的「暂不支持」前缀。凡是没实现的语法/语义**一律走这里**，
// 绝不允许静默算错（静默算错是对拍测试唯一抓不住的东西）。
public fun unsupported(what : string) -> string {
    rtn "17c 解释器暂不支持：" + what
}

// ================================================================ 信号
//
// 见文件头。`toChar(1)` 是运行期算出来的，源码里不出现这个控制字符。

fun sigMark() -> string {
    rtn "" + toChar(1)
}

public fun makeSignal(kind : string, payload : string) -> string {
    rtn sigMark() + kind + ":" + payload
}

public fun isSignal(m : string) -> bool {
    if (m.length() == 0) { rtn false }
    rtn m.charAt(0) == toChar(1)
}

public fun signalKind(m : string) -> string {
    if (!isSignal(m)) { rtn "" }
    if (m.length() < 2) { rtn "" }
    rtn m.substring(1, 2)
}

public fun signalPayload(m : string) -> string {
    if (!isSignal(m)) { rtn "" }
    if (m.length() < 3) { rtn "" }
    rtn m.substring(3, m.length())
}

// ================================================================ 胖节点上的小工具
//
// Parser.rsf 把「这一层的属性」拼成了一个形如 `name=foo mutable=true` 的串（值里的
// 空格/换行都转义过，所以按空格切无歧义）。这里把它读回来。

fun hexCharValue(c : char) -> int {
    var n = charToInt(c)
    if (n >= 48 && n <= 57) { rtn n - 48 }
    if (n >= 97 && n <= 102) { rtn n - 87 }
    if (n >= 65 && n <= 70) { rtn n - 55 }
    rtn 0
}

// escapeValue 的逆（Parser.escapeValue 那张转义表）
public fun unescapeValue(s : string) -> string {
    var out = ""
    var i = 0
    var len = s.length()
    while (i < len) {
        var c = s.charAt(i)
        if (c == '\\' && i + 1 < len) {
            var d = s.charAt(i + 1)
            if (d == 'n') {
                out = out + '\n'
                i = i + 2
            } else if (d == 'r') {
                out = out + '\r'
                i = i + 2
            } else if (d == 't') {
                out = out + '\t'
                i = i + 2
            } else if (d == 's') {
                out = out + ' '
                i = i + 2
            } else if (d == '\\') {
                out = out + '\\'
                i = i + 2
            } else if (d == 'x' && i + 3 < len) {
                var hi = hexCharValue(s.charAt(i + 2))
                var lo = hexCharValue(s.charAt(i + 3))
                out = out + toChar(hi * 16 + lo)
                i = i + 4
            } else {
                out = out + c
                i = i + 1
            }
        } else {
            out = out + c
            i = i + 1
        }
    }
    rtn out
}

// 取一个属性；没有就返回空串
public fun attr(n : Node, key : string) -> string {
    var t = n.text
    var i = 0
    var len = t.length()
    while (i < len) {
        var keyStart = i
        while (i < len && t.charAt(i) != '=') { i = i + 1 }
        var k = t.substring(keyStart, i)
        i = i + 1
        var valStart = i
        while (i < len && t.charAt(i) != ' ') { i = i + 1 }
        var v = t.substring(valStart, i)
        if (k == key) { rtn unescapeValue(v) }
        i = i + 1
    }
    rtn ""
}

fun attrBool(n : Node, key : string) -> bool {
    rtn attr(n, key) == "true"
}

fun attrInt(n : Node, key : string) -> int {
    var raw = attr(n, key)
    if (raw.length() == 0) { rtn 0 }
    rtn parseInt(raw) ?: 0
}

// 孩子按位置取（越界给一个 ERROR 占位节点，调用方不必到处判长度）
fun kid(n : Node, index : int) -> Node {
    if (index < 0 || index >= n.childCount) { rtn new Node(NodeKind.ERROR) }
    rtn n.children[index]
}

fun isErrorNode(n : Node) -> bool {
    rtn n.kind == NodeKind.ERROR
}

// ================================================================ 值的标签
//
// 每一个载荷对应 Kotlin 解释器里的一种「运行时载体」：
//   INTV -> java.lang.Integer、LONGV -> Long、FLOATV -> Float、DOUBLEV -> Double、
//   BOOLV -> Boolean、CHARV -> Character、BYTEV -> Byte、STRV -> String、
//   OBJV -> Interpreter.RsfObject、ARRV -> JVM 数组、ENUMV -> Interpreter.RsfEnumValue、
//   LISTV -> java.util.ArrayList（互操作）、CTYPEV -> 「类名」这个静态接收者。
//
// 分成 INT / LONG / FLOAT / DOUBLE 四档不是为了省事，而是必须：`10 / 3` 与 `10 / 3.0`
// 的差别只能靠运行期标签还原（见文件头「静态类型怎么补上」）。

public enum Kind {
    NULLV, INTV, LONGV, FLOATV, DOUBLEV, BOOLV, CHARV, BYTEV,
    STRV, OBJV, ARRV, ENUMV, LISTV, CTYPEV, FILEV
}

// 数值提升的档位（和 RsfBase.rank 同一张表：byte/char 与 int 同档，先提升成 int）
fun kindRank(k : Kind) -> int {
    switch (k) {
        Kind.BYTEV : rtn 0
        Kind.CHARV : rtn 0
        Kind.INTV : rtn 0
        Kind.LONGV : rtn 1
        Kind.FLOATV : rtn 2
        Kind.DOUBLEV : rtn 3
        else : rtn -1
    }
    // 和 Parser.kindName 一样：rsf 的返回值检查看的是「最后一条语句」，
    // 不看这个 switch 是否已经把每种取值都覆盖了，所以这里留一个静态落点。
    rtn -1
}

fun isNumericKind(k : Kind) -> bool {
    rtn kindRank(k) >= 0
}

// ================================================================ 值

public class Val(kind : Kind) {
    var k : Kind = kind
    var iv : int = 0
    var lv : long = 0L
    var fv : float = 0.0f
    var dv : double = 0.0
    var bv : bool = false
    var cv : char = ' '
    var yv : byte = 0
    var sv : string = ""
    var en : string = ""
    var ov : ?Obj = null
    var av : ?Arr = null
    var lsv : ?JList = null
    var cname : string = ""
}

public fun vNull() -> Val {
    rtn new Val(Kind.NULLV)
}

public fun vInt(n : int) -> Val {
    var v = new Val(Kind.INTV)
    v.iv = n
    rtn v
}

public fun vLong(n : long) -> Val {
    var v = new Val(Kind.LONGV)
    v.lv = n
    rtn v
}

public fun vFloat(n : float) -> Val {
    var v = new Val(Kind.FLOATV)
    v.fv = n
    rtn v
}

public fun vDouble(n : double) -> Val {
    var v = new Val(Kind.DOUBLEV)
    v.dv = n
    rtn v
}

public fun vBool(b : bool) -> Val {
    var v = new Val(Kind.BOOLV)
    v.bv = b
    rtn v
}

public fun vChar(c : char) -> Val {
    var v = new Val(Kind.CHARV)
    v.cv = c
    rtn v
}

public fun vByte(b : byte) -> Val {
    var v = new Val(Kind.BYTEV)
    v.yv = b
    rtn v
}

public fun vStr(s : string) -> Val {
    var v = new Val(Kind.STRV)
    v.sv = s
    rtn v
}

public fun vEnum(enumName : string, valueName : string) -> Val {
    var v = new Val(Kind.ENUMV)
    v.en = enumName
    v.sv = valueName
    rtn v
}

public fun vObj(o : Obj) -> Val {
    var v = new Val(Kind.OBJV)
    v.ov = o
    rtn v
}

public fun vArr(a : Arr) -> Val {
    var v = new Val(Kind.ARRV)
    v.av = a
    rtn v
}

public fun vList(l : JList) -> Val {
    var v = new Val(Kind.LISTV)
    v.lsv = l
    rtn v
}

// 类名当接收者（`Point.origin()` 里的 `Point`）。它不是一个真的值，
// 只在「静态成员访问」这条路上出现。
public fun vCType(name : string) -> Val {
    var v = new Val(Kind.CTYPEV)
    v.cname = name
    rtn v
}

// java.io.File 的替身：只装一个路径（真正的文件操作由外部那几个函数代劳）。
// 见 17c 报告：跨语言互操作这一块**只做示例用到的那几个**，其余显式报「暂不支持」。
public fun vFile(path : string) -> Val {
    var v = new Val(Kind.FILEV)
    v.sv = path
    rtn v
}

// ================================================================ 对象 / 数组 / 列表

// 一个 rsf 对象：类名 + 按声明顺序排的字段数组（和 Kotlin 版的 RsfObject 同构）
public class Obj(cn : string) {
    var cls : string = cn
    var fs : Val[] = new Val[0]
}

// 一个 rsf 数组。`depth` 是「还套着几层」（`new int[2][3]` 的最外层是 2）；
// 只有 depth == 1 的那一层直接装值，其余装的是子数组的 Val。
public class Arr(d : int) {
    var depth : int = d
    var es : Val[] = new Val[0]
    // 最内层的元素类型（`new int[3]` 是 `int`）——元素赋值时的运行期收敛要用它
    var elemType : string = ""
}

// java.util.ArrayList 的替代品（见 17c 报告：`ArrayList&<T>` 是唯一能用的
// JVM 泛型容器——`HashMap&<K,V>` 因为两个类型实参拿不到擦除替换，形参全是 Object，
// 传不进 string/int）。这里按 rsf 自己的动态数组实现，语义与 ArrayList 一致。
public class JList() {
    var es : Val[] = new Val[8]
    var n : int = 0
}

// ================================================================ 作用域
//
// 手写的符号表（rsf 用不了 HashMap）：每个作用域两条平行数组 + 线性查找。
// 名字解析顺序与 Checker 一致：**先局部/参数，后字段**——所以 `Env` 链上找不到时
// 才去当前类的字段里找。

public class Env(p : ?Env) {
    var up : ?Env = p
    var me : ?Obj = null
    var cl : ?Cls = null
    // 阶段 25 K5c：这个方法**声明**在哪个类 —— `super.f()` 的解析起点。
    // `cl` 是「帧所在的类」（虚分派时取**运行期真实类**），`dc` 是「静态声明类」，
    // 两者必须分开：`super.f()` 要跳开本类的 override，从**声明类**的父类起找。
    var dc : ?Cls = null
    var names : string[] = new string[8]
    var vals : Val[] = new Val[8]
    var n : int = 0

    public fun define(name : string, v : Val) -> void {
        if (n >= names.length) {
            var size = names.length * 2
            var nn : string[] = new string[size]
            var nv : Val[] = new Val[size]
            var i = 0
            while (i < n) {
                nn[i] = names[i]
                nv[i] = vals[i]
                i = i + 1
            }
            names = nn
            vals = nv
        }
        names[n] = name
        vals[n] = v
        n = n + 1
        rtn
    }

    public fun find(name : string) -> ?Val {
        var i = n - 1
        while (i >= 0) {
            if (names[i] == name) { rtn vals[i] }
            i = i - 1
        }
        rtn null
    }

    // 一路往上找
    public fun lookup(name : string) -> ?Val {
        var e : ?Env = this
        while (e != null) {
            var hit = e!!.find(name)
            if (hit != null) { rtn hit }
            e = e!!.up
        }
        rtn null
    }

    public fun assign(name : string, v : Val) -> bool {
        var e : ?Env = this
        while (e != null) {
            var i = e!!.n - 1
            while (i >= 0) {
                if (e!!.names[i] == name) {
                    e!!.vals[i] = v
                    rtn true
                }
                i = i - 1
            }
            e = e!!.up
        }
        rtn false
    }

    // 当前 this（沿链找）
    public fun thisObj() -> ?Obj {
        var e : ?Env = this
        while (e != null) {
            if (e!!.me != null) { rtn e!!.me }
            e = e!!.up
        }
        rtn null
    }

    // 当前所在的类（沿链找）
    public fun curClass() -> ?Cls {
        var e : ?Env = this
        while (e != null) {
            if (e!!.cl != null) { rtn e!!.cl }
            e = e!!.up
        }
        rtn null
    }

    // 当前方法**声明**在哪个类（沿链找）—— `super.f()` 的解析起点用它，不用 curClass()
    public fun declClass() -> ?Cls {
        var e : ?Env = this
        while (e != null) {
            if (e!!.dc != null) { rtn e!!.dc }
            e = e!!.up
        }
        rtn null
    }
}

// ================================================================ 函数 / 类 / 枚举的表

public class Fn(nm : string) {
    var name : string = nm
    var pnames : string[] = new string[0]
    var ptypes : string[] = new string[0]
    var pcount : int = 0
    var body : Node = new Node(NodeKind.ERROR)
    var retType : string = "void"
    var mayError : bool = false
    var isCtor : bool = false
    var isStatic : bool = false
    var isPrimary : bool = false
    // 阶段 25 K5c：**声明**这个方法的类名（`super.f()` 从它的父类起找；全局函数留空）。
    var ownerCls : string = ""
}

public class Cls(nm : string) {
    var name : string = nm
    var fnames : string[] = new string[0]
    var ftypes : string[] = new string[0]
    var finits : Node[] = new Node[0]
    var fcount : int = 0
    var ctors : Fn[] = new Fn[0]
    var ccount : int = 0
    var methods : Fn[] = new Fn[0]
    var mcount : int = 0
    // 阶段 20：接口。接口也复用 Cls（另存一张表，不进 classes —— 这样 `new I()` 照旧报错）。
    // `supers` 是父类型的**简单名**（与 `findCls` 同一套命名；JDK 接口在表里找不到就跳过）。
    var isIface : bool = false
    var supers : string[] = new string[0]
    var scount : int = 0
    // 阶段 21：注解。注解声明的**伴生类**也复用 Cls，并且直接进 `classes` ——
    // `new Marker(...)` 走的就是 `findCls("Marker")` 这条既有路径，不必给 `new` 加特例。
    // `isAnn` 把「缺省实参填元素默认值」这条规则限定在这一类上（普通类零开销）。
    var isAnn : bool = false
    // 前 elemCount 个字段是注解元素（声明序）；它们之后才是伴生体自己声明的字段。
    var elemCount : int = 0

    // 阶段 25 K5c：类继承。`baseName` 是**类父**（`SUPER_CLASS` 的 `name`），接口父仍堆在
    // 上面的 `supers` 里 —— 与 K5b 的 CInfo.parent / supers 完全同口径。`baseArgs` 是类头
    // 父类子句的实参表（`SUPER_CLASS` 的唯一孩子，一个 `ARGS` 节点），`hasBase` 是「写了
    // 类父」的标志（`findCls("")` 也是 null，但两者语义不同，分开存）。
    var baseName : string = ""
    var baseArgs : Node = new Node(NodeKind.ERROR)
    var hasBase : bool = false
    // 类头上的 `abstract`（只有写了才挂 ABSTRACT 节点，所以默认 false）
    var isAbstract : bool = false

    public fun addSuper(nm2 : string) -> void {
        var i = 0
        while (i < scount) {
            if (supers[i] == nm2) { rtn }
            i = i + 1
        }
        if (scount >= supers.length) { supers = growText(supers, scount, nm2) }
        supers[scount] = nm2
        scount = scount + 1
    }

    // 这个接口自己声明的、**带体**的默认方法（接口抽象方法只有 PARAMS 一个孩子）。
    public fun defaultNamed(nm2 : string, argc : int) -> ?Fn {
        var i = 0
        while (i < mcount) {
            var m = methods[i]
            if (m.name == nm2 && m.pcount == argc && m.body.kind == NodeKind.BLOCK) { rtn m }
            i = i + 1
        }
        rtn null
    }

    // 接口里任意一个同名同形的方法（抽象也算）—— 静态类型是接口时用
    public fun anyNamed(nm2 : string, argc : int) -> ?Fn {
        var i = 0
        while (i < mcount) {
            var m = methods[i]
            if (m.name == nm2 && m.pcount == argc) { rtn m }
            i = i + 1
        }
        rtn null
    }

    public fun fieldIndex(nm2 : string) -> int {
        var i = 0
        while (i < fcount) {
            if (fnames[i] == nm2) { rtn i }
            i = i + 1
        }
        rtn -1
    }

    public fun methodNamed(nm2 : string) -> ?Fn {
        var i = 0
        while (i < mcount) {
            if (methods[i].name == nm2) { rtn methods[i] }
            i = i + 1
        }
        rtn null
    }

    // 阶段 25 K5c：本类**自己声明**的方法，按「名字 + 实参个数」查（不含构造器）——
    // 与 K5b 的 `methOf(nm, argc)` 同口径。接口的默认方法走 defaultNamed（还要看有没有体）。
    // 沿类链的查找在 Interp.methInChain 里做。
    public fun methNamed(nm2 : string, argc : int) -> ?Fn {
        var i = 0
        while (i < mcount) {
            var m = methods[i]
            if (m.name == nm2 && m.pcount == argc) { rtn m }
            i = i + 1
        }
        rtn null
    }
}

public class Enm(nm : string) {
    var name : string = nm
    var values : string[] = new string[0]
    var vcount : int = 0
    var cached : Val[] = new Val[0]

    public fun has(v : string) -> bool {
        var i = 0
        while (i < vcount) {
            if (values[i] == v) { rtn true }
            i = i + 1
        }
        rtn false
    }

    // 枚举值是**单例**：同一个 `枚举名.值名` 永远返回同一个 Val 对象，
    // `==` 的引用相等才成立（和 Kotlin 版 enumCache 同一个理由）
    public fun valueOf(v : string) -> ?Val {
        var i = 0
        while (i < vcount) {
            if (values[i] == v) { rtn cached[i] }
            i = i + 1
        }
        rtn null
    }
}

// ================================================================ 表扩容（rsf 没有 ArrayList）
//
// 和 Parser.rsf 的 `Node.add` 一个套路：满了翻倍。解释器只在**装载**阶段用这几条，
// 运行期不会碰（所以不心疼）。

fun growFn(a : Fn[], used : int, add : Fn) -> Fn[] {
    if (used < a.length) {
        a[used] = add
        rtn a
    }
    var size = 4
    if (a.length > 0) { size = a.length * 2 }
    var bigger : Fn[] = new Fn[size]
    var i = 0
    while (i < used) {
        bigger[i] = a[i]
        i = i + 1
    }
    bigger[used] = add
    rtn bigger
}

fun growCls(a : Cls[], used : int, add : Cls) -> Cls[] {
    if (used < a.length) {
        a[used] = add
        rtn a
    }
    var size = 4
    if (a.length > 0) { size = a.length * 2 }
    var bigger : Cls[] = new Cls[size]
    var i = 0
    while (i < used) {
        bigger[i] = a[i]
        i = i + 1
    }
    bigger[used] = add
    rtn bigger
}

fun growEnm(a : Enm[], used : int, add : Enm) -> Enm[] {
    if (used < a.length) {
        a[used] = add
        rtn a
    }
    var size = 4
    if (a.length > 0) { size = a.length * 2 }
    var bigger : Enm[] = new Enm[size]
    var i = 0
    while (i < used) {
        bigger[i] = a[i]
        i = i + 1
    }
    bigger[used] = add
    rtn bigger
}

fun growVal(a : Val[], used : int, add : Val) -> Val[] {
    if (used < a.length) {
        a[used] = add
        rtn a
    }
    var size = 8
    if (a.length > 0) { size = a.length * 2 }
    var bigger : Val[] = new Val[size]
    var i = 0
    while (i < used) {
        bigger[i] = a[i]
        i = i + 1
    }
    bigger[used] = add
    rtn bigger
}

fun growText(a : string[], used : int, add : string) -> string[] {
    if (used < a.length) {
        a[used] = add
        rtn a
    }
    var size = 8
    if (a.length > 0) { size = a.length * 2 }
    var bigger : string[] = new string[size]
    var i = 0
    while (i < used) {
        bigger[i] = a[i]
        i = i + 1
    }
    bigger[used] = add
    rtn bigger
}
// 类型文本上的小工具：找字符 / 找子串（rsf 的 string 没有 indexOf）
fun indexOfCharIn(s : string, want : char) -> int {
    var i = 0
    while (i < s.length()) {
        if (s.charAt(i) == want) { rtn i }
        i = i + 1
    }
    rtn -1
}

fun indexOfTextIn(s : string, want : string) -> int {
    if (want.length() == 0) { rtn 0 }
    var i = 0
    var last = s.length() - want.length()
    while (i <= last) {
        if (s.substring(i, i + want.length()) == want) { rtn i }
        i = i + 1
    }
    rtn -1
}

// ================================================================ java.io.File 的替身
//
// 只有 files.rsf 那条路用得到。路径拼接 / 绝对路径 / 文件名 / 删除这四件事
// **直接交给 JVM 的 java.io.File 做**（自己拼分隔符迟早会在某个平台上错），
// 解释器这边只负责把结果搬来搬去。

fun fileJoinPath(parent : string, child : string) -> string {
    var f = new File(parent, child)
    rtn f.getAbsolutePath()
}

fun fileAbsolutePath(path : string) -> string {
    var f = new File(path)
    rtn f.getAbsolutePath()
}

fun fileBaseName(path : string) -> string {
    var f = new File(path)
    rtn f.getName()
}

fun fileDeletePath(path : string) -> bool {
    var f = new File(path)
    rtn f.delete()
}

fun fileExistsPath(path : string) -> bool {
    var f = new File(path)
    rtn f.exists()
}

// ================================================================ 解释器
//
// 表的形状：进程内一次性装载（函数表 / 类表 / 枚举表），运行期只读。
// 名字解析全部是线性查找——rsf 用不了 HashMap（见 17c 报告），而示例的规模上
// 线性查找完全够；真慢下来也是先慢在「按名字查局部变量」那条路上。

public class Interp(prog : Node) {
    var p : Node = prog
    var globals : Env = new Env(null)
    var funcs : Fn[] = new Fn[0]
    var fcount : int = 0
    var classes : Cls[] = new Cls[0]
    var ccount : int = 0
    var enums : Enm[] = new Enm[0]
    var ecount : int = 0
    // 阶段 20：用户接口（另存一张表，**不混进 classes** —— `new I()` 因此照旧报错）。
    // 接口链查找的出口（rsf 没有出参 / 元组，只能这么带出来）：
    //   ifaceHit = 命中的默认方法，ifaceHitCount = 命中几个不同接口。
    var ifcs : Cls[] = new Cls[0]
    var icount : int = 0
    var ifaceHit : ?Fn = null
    var ifaceHitCount : int = 0
    var depth : int = 0

    // 最近一次 `rtn` 带出来的值（信号 `R` 的载荷走这里——信号消息只能是字符串）
    var retVal : Val = new Val(Kind.NULLV)

    // `?:` 的「接住了」哨兵：和 Kotlin 版的 CAUGHT 同一个作用。
    // 用一个**独有的 Val 对象**，靠引用相等判断，所以不可能是任何真实值。
    var caughtVal : Val = new Val(Kind.NULLV)

    // ------------------------------------------------------------------ 装载

    public fun load() -> void {
        var i = 0
        while (i < p.childCount) {
            var c = p.children[i]
            if (c.kind == NodeKind.FUNCS) { loadFuncs(c) }
            else if (c.kind == NodeKind.CLASSES) { loadClasses(c) }
            else if (c.kind == NodeKind.ENUMS) { loadEnums(c) }
            else if (c.kind == NodeKind.INTERFACES) { loadIfaces(c) }
            else if (c.kind == NodeKind.ANNOTATIONS) { loadAnns(c) }
            i = i + 1
        }
        rtn
    }

    fun makeFn(node : Node) -> Fn {
        var f = new Fn(attr(node, "name"))
        // 阶段 25：FUNC 的孩子里 FINAL **只在写了时才挂**，而且挂在 PARAMS **前面**
        // （Parser.rsf:1814-1815），所以参数表与函数体都必须**按 kind 找**，不能按下标 ——
        // 按下标的话 `fun` 的参数表会被当成函数体（跑起来就是「方法体没跑、返回 null」）。
        // 抽象方法没有 BLOCK 孩子，留 `NodeKind.ERROR` 当哨兵（判据：`body.kind == NodeKind.BLOCK`）。
        var ps = new Node(NodeKind.ERROR)
        var body = new Node(NodeKind.ERROR)
        var ci = 0
        while (ci < node.childCount) {
            var ck = node.children[ci]
            if (ck.kind == NodeKind.PARAMS) { ps = ck }
            else if (ck.kind == NodeKind.BLOCK) { body = ck }
            ci = ci + 1
        }
        var n = ps.childCount
        var pn : string[] = new string[n]
        var pt : string[] = new string[n]
        var k = 0
        while (k < n) {
            pn[k] = attr(ps.children[k], "name")
            pt[k] = attr(ps.children[k], "type")
            k = k + 1
        }
        f.pnames = pn
        f.ptypes = pt
        f.pcount = n
        f.body = body
        f.retType = attr(node, "retType")
        f.mayError = attrBool(node, "mayError")
        f.isCtor = attrBool(node, "ctor")
        f.isStatic = attrBool(node, "static")
        f.isPrimary = attrBool(node, "primary")
        rtn f
    }

    fun loadFuncs(fs : Node) -> void {
        var i = 0
        while (i < fs.childCount) {
            funcs = growFn(funcs, fcount, makeFn(fs.children[i]))
            fcount = fcount + 1
            i = i + 1
        }
        rtn
    }

    fun loadClasses(cs : Node) -> void {
        var i = 0
        while (i < cs.childCount) {
            var cn = cs.children[i]
            var c = new Cls(attr(cn, "name"))
            var j = 0
            while (j < cn.childCount) {
                var part = cn.children[j]
                if (part.kind == NodeKind.FIELDS) { loadFields(c, part) }
                else if (part.kind == NodeKind.METHODS) { loadMethods(c, part) }
                else if (part.kind == NodeKind.SUPERS) { loadSupers(c, part) }
                // 阶段 25 K5c：类父槽位与类头上的 `abstract`。**按 kind 找**，不能按下标 ——
                // 这两部分只在写了时才挂在类节点上（Parser.rsf:1013-1030），位置会漂。
                else if (part.kind == NodeKind.SUPER_CLASS) { loadBase(c, part) }
                else if (part.kind == NodeKind.ABSTRACT) { c.isAbstract = true }
                j = j + 1
            }
            classes = growCls(classes, ccount, c)
            ccount = ccount + 1
            i = i + 1
        }
        rtn
    }

    // 阶段 20：用户接口。方法装载完全复用 `loadMethods`（抽象方法只是没有 BLOCK，
    // `makeFn` 会把 `body` 留成 ERROR 节点 —— 判据是 `body.kind == BLOCK`，不是「空」）。
    // 阶段 25 K5c：类头父类子句 `: 父类(实参)`。`SUPER_CLASS.name` 是**简单名**（与
    // `findCls` 同一套命名），唯一孩子是那个实参表（`ARGS`）；父类本身在装载后被
    // `validate()` 检查 —— 不在本程序里就是 JDK 父类，**响亮报错**（这一刀不做 JDK 父类）。
    fun loadBase(c : Cls, part : Node) -> void {
        c.baseName = attr(part, "name")
        c.hasBase = c.baseName.length() > 0
        c.baseArgs = kid(part, 0)
        rtn
    }

    fun loadIfaces(cs : Node) -> void {
        var i = 0
        while (i < cs.childCount) {
            var cn = cs.children[i]
            var c = new Cls(attr(cn, "name"))
            c.isIface = true
            var j = 0
            while (j < cn.childCount) {
                var part = cn.children[j]
                if (part.kind == NodeKind.METHODS) { loadMethods(c, part) }
                else if (part.kind == NodeKind.SUPERS) { loadSupers(c, part) }
                j = j + 1
            }
            ifcs = growCls(ifcs, icount, c)
            icount = icount + 1
            i = i + 1
        }
        rtn
    }

    // 阶段 21：注解声明。`ANNOTATION` 的孩子顺序 = ANNOTATION_ELEMENTS → [COMPANION]
    // → ANNOTATION_USES（注解**自己的**使用处，解释器不看）。
    // 注解不是普通类：`new Marker(...)` 构造的是**伴生类的对象**（Kotlin 侧类名
    // `Marker$Impl` / 匿名时 `Marker$companion`）。这里把伴生类**按注解名**登记进
    // classes —— 运行期类名、`findCls`、`evNew`、`objMember` 就全部复用既有路径；
    // 元素 = 前 elemCount 个字段（元素的默认值就是该字段的初值表达式）。
    fun loadAnns(cs : Node) -> void {
        var i = 0
        while (i < cs.childCount) {
            var an = cs.children[i]
            var c = new Cls(attr(an, "name"))
            c.isAnn = true
            var j = 0
            while (j < an.childCount) {
                var part = an.children[j]
                if (part.kind == NodeKind.ANNOTATION_ELEMENTS) { loadElemFields(c, part) }
                else if (part.kind == NodeKind.COMPANION) { loadCompanion(c, part) }
                j = j + 1
            }
            classes = growCls(classes, ccount, c)
            ccount = ccount + 1
            i = i + 1
        }
        rtn
    }

    // 元素表 → 字段表。**没有默认值**的元素没有孩子，`kid` 越界给 ERROR 节点；
    // 构造时按类型零值填（对齐 Kotlin `fillElementDefaults` 的 `getOrElse(index){INT}`）。
    fun loadElemFields(c : Cls, els : Node) -> void {
        var n = els.childCount
        var nms : string[] = new string[n]
        var tys : string[] = new string[n]
        var inits : Node[] = new Node[n]
        var k = 0
        while (k < n) {
            var el = els.children[k]
            nms[k] = attr(el, "name")
            tys[k] = attr(el, "type")
            inits[k] = kid(el, 0)
            k = k + 1
        }
        c.fnames = nms
        c.ftypes = tys
        c.finits = inits
        c.fcount = n
        c.elemCount = n
        rtn
    }

    // 伴生体：孩子顺序 SUPERS → FIELDS → METHODS。字段**追加在元素之后**（元素先装），
    // 方法名与构造器装载完全复用 loadMethods / loadSupers。
    fun loadCompanion(c : Cls, cm : Node) -> void {
        var j = 0
        while (j < cm.childCount) {
            var part = cm.children[j]
            if (part.kind == NodeKind.SUPERS) { loadSupers(c, part) }
            else if (part.kind == NodeKind.FIELDS) { appendFields(c, part) }
            else if (part.kind == NodeKind.METHODS) { loadMethods(c, part) }
            j = j + 1
        }
        rtn
    }

    fun appendFields(c : Cls, fields : Node) -> void {
        var n = fields.childCount
        if (n == 0) { rtn }
        var total = c.fcount + n
        var nms : string[] = new string[total]
        var tys : string[] = new string[total]
        var inits : Node[] = new Node[total]
        var k = 0
        while (k < c.fcount) {
            nms[k] = c.fnames[k]
            tys[k] = c.ftypes[k]
            inits[k] = c.finits[k]
            k = k + 1
        }
        var m = 0
        while (m < n) {
            var fd = fields.children[m]
            nms[c.fcount + m] = attr(fd, "name")
            tys[c.fcount + m] = attr(fd, "type")
            inits[c.fcount + m] = kid(fd, 0)
            m = m + 1
        }
        c.fnames = nms
        c.ftypes = tys
        c.finits = inits
        c.fcount = total
        rtn
    }

    // 父类型子句：`SUPERS` 的孩子是 `SUPER`，`name` 属性是**简单名**（与 `findCls`
    // 同一套命名）。JDK 接口不在表里，`findIface` 自然跳过（对齐 Kotlin
    // `findInterfaceDefault` 里 `sup.fromClassPath` 那条 continue）。
    fun loadSupers(c : Cls, part : Node) -> void {
        var i = 0
        while (i < part.childCount) {
            c.addSuper(attr(part.children[i], "name"))
            i = i + 1
        }
        rtn
    }

    fun loadFields(c : Cls, fields : Node) -> void {
        var n = fields.childCount
        var nms : string[] = new string[n]
        var tys : string[] = new string[n]
        var inits : Node[] = new Node[n]
        var k = 0
        while (k < n) {
            var fd = fields.children[k]
            nms[k] = attr(fd, "name")
            tys[k] = attr(fd, "type")
            inits[k] = kid(fd, 0)
            k = k + 1
        }
        c.fnames = nms
        c.ftypes = tys
        c.finits = inits
        c.fcount = n
        rtn
    }

    fun loadMethods(c : Cls, ms : Node) -> void {
        var k = 0
        while (k < ms.childCount) {
            var f = makeFn(ms.children[k])
            // 阶段 25 K5c：记下**声明**这个方法的类 —— 虚分派时帧的类取这一份方法的声明类，
            // `super.f()` 也从它的父类起找（见 Interp.invokeInstance / evSuperMember）。
            f.ownerCls = c.name
            if (f.isCtor) {
                c.ctors = growFn(c.ctors, c.ccount, f)
                c.ccount = c.ccount + 1
            } else {
                c.methods = growFn(c.methods, c.mcount, f)
                c.mcount = c.mcount + 1
            }
            k = k + 1
        }
        rtn
    }

    fun loadEnums(es : Node) -> void {
        var i = 0
        while (i < es.childCount) {
            var en = es.children[i]
            var e = new Enm(attr(en, "name"))
            var vals = kid(en, 0)
            var n = vals.childCount
            var vs : string[] = new string[n]
            var cs : Val[] = new Val[n]
            var k = 0
            while (k < n) {
                vs[k] = attr(vals.children[k], "name")
                cs[k] = vEnum(e.name, vs[k])
                k = k + 1
            }
            e.values = vs
            e.cached = cs
            e.vcount = n
            enums = growEnm(enums, ecount, e)
            ecount = ecount + 1
            i = i + 1
        }
        rtn
    }

    // ------------------------------------------------------------------ 查表

    public fun findFunc(nm : string) -> ?Fn {
        var i = 0
        while (i < fcount) {
            if (funcs[i].name == nm) { rtn funcs[i] }
            i = i + 1
        }
        rtn null
    }

    public fun findCls(nm : string) -> ?Cls {
        var i = 0
        while (i < ccount) {
            if (classes[i].name == nm) { rtn classes[i] }
            i = i + 1
        }
        rtn null
    }

    public fun findEnum(nm : string) -> ?Enm {
        var i = 0
        while (i < ecount) {
            if (enums[i].name == nm) { rtn enums[i] }
            i = i + 1
        }
        rtn null
    }

    // ------------------------------------------------------------ 接口分派（阶段 20）

    public fun findIface(nm : string) -> ?Cls {
        var i = 0
        while (i < icount) {
            if (ifcs[i].name == nm) { rtn ifcs[i] }
            i = i + 1
        }
        rtn null
    }

    // ------------------------------------------------------------ 类继承（阶段 25 K5c）
    //
    // 与 K5b 的 CInfo 同口径：类父在 `Cls.baseName` 一个槽里，接口父仍走 `Cls.supers`。
    // 字段布局与 Kotlin 的 `fieldChainOf / fieldBaseOf` 一字对齐：**父类字段在前**，
    // 对象数组 = 整条父链的字段拼接；每一层在自己那一段里的下标从 `baseOf` 起算。

    // 类 c 的字段段在对象数组里的起始下标（= 它所有祖先的字段总数）
    public fun baseOf(c : Cls) -> int {
        if (!c.hasBase) { rtn 0 }
        var b = findCls(c.baseName)
        if (b == null) { rtn 0 }
        rtn totalOf(b!!)
    }

    // 类 c 的对象数组总长（自己那一段 + 全部祖先）
    public fun totalOf(c : Cls) -> int {
        rtn baseOf(c) + c.fcount
    }

    // 类链（**父类在前、自己在最后**）—— 与 Kotlin `fieldChainOf` 的顺序一致
    fun chainArray(root : string) -> Cls[] {
        var rev : Cls[] = new Cls[0]
        var n = 0
        var c = findCls(root)
        while (c != null) {
            rev = growCls(rev, n, c!!)
            n = n + 1
            if (!c!!.hasBase) { c = null }
            else { c = findCls(c!!.baseName) }
        }
        var out : Cls[] = new Cls[n]
        var i = 0
        while (i < n) {
            out[i] = rev[n - 1 - i]
            i = i + 1
        }
        rtn out
    }

    // 声明该字段的类：沿类父链找，**最近的类优先**（子类同名字段遮蔽父类的）
    public fun fieldOwnerInChain(root : string, nm : string) -> ?Cls {
        var c = findCls(root)
        while (c != null) {
            if (c!!.fieldIndex(nm) >= 0) { rtn c!! }
            if (!c!!.hasBase) { rtn null }
            c = findCls(c!!.baseName)
        }
        rtn null
    }

    // 字段在对象数组里的**绝对**下标（-1 = 整条链上都没有这个字段）
    public fun fieldIndexInChain(root : string, nm : string) -> int {
        var o = fieldOwnerInChain(root, nm)
        if (o == null) { rtn -1 }
        rtn baseOf(o!!) + o!!.fieldIndex(nm)
    }

    // 沿类父链（含 root 自己）找「名字 + 实参个数」都对的方法声明（不含构造器）——
    // **最近的类优先**，也就是虚分派该跑的那一份（Kotlin classChainOf + findClassImplementation）。
    // 个数对不上时退一步只按名字找（`anyMethInChain`），那是给「只知道名字」的地方用的。
    public fun methInChain(root : string, nm : string, argc : int) -> ?Fn {
        var c = findCls(root)
        while (c != null) {
            var m = c!!.methNamed(nm, argc)
            if (m != null) { rtn m!! }
            if (!c!!.hasBase) { rtn null }
            c = findCls(c!!.baseName)
        }
        rtn null
    }

    // 同上，但返回**声明那个方法的类**（帧的类 / `super` 的解析起点都用它）
    public fun methOwnerInChain(root : string, nm : string, argc : int) -> ?Cls {
        var c = findCls(root)
        while (c != null) {
            if (c!!.methNamed(nm, argc) != null) { rtn c!! }
            if (!c!!.hasBase) { rtn null }
            c = findCls(c!!.baseName)
        }
        rtn null
    }

    // 沿类父链按**名字**找（不看实参个数）—— 给 `isErrorCapable` 这类只知道名字的地方用
    fun anyMethInChain(root : string, nm : string) -> ?Fn {
        var c = findCls(root)
        while (c != null) {
            var m = c!!.methodNamed(nm)
            if (m != null) { rtn m!! }
            if (!c!!.hasBase) { rtn null }
            c = findCls(c!!.baseName)
        }
        rtn null
    }

    // 装载后的静态检查（**响亮报错，绝不静默降级**）：
    //   ① 类父必须在本程序里 —— JDK 父类这一刀不做（K5b 的后端也是这么报的：
    //      Backend.rsf:6470-6490 `K5b 暂不支持 JDK 父类：`）。静默当 Object / 静默跳过
    //      都会让「两端对拍」在某一份语料上悄悄分叉，所以宁可当场报错。
    //   ② 非抽象类不许把父链上的抽象方法留着不实现（Kotlin 侧是 Checker 报的；自举
    //      解释器没有独立的检查期，就在装载完统一报）。
    public fun validate() -> !int {
        var i = 0
        while (i < ccount) {
            var c = classes[i]
            if (c.hasBase && findCls(c.baseName) == null) {
                if (findIface(c.baseName) != null) {
                    fail "K5c：类 '" + c.name + "' 的父类型 '" + c.baseName + "' 是接口 —— ':' 后面第一个必须带实参表、且必须是一个类（写法 ': 父类名(实参)'，接口写在它后面用逗号隔开）"
                }
                fail "K5c 暂不支持 JDK 父类：" + c.baseName + "（类 '" + c.name + "' 的父类不在本程序里）"
            }
            if (!c.isAbstract && !c.isAnn) {
                var miss = firstUnimplemented(c)
                if (miss != null) {
                    fail "K5c：类 '" + c.name + "' 还有抽象成员没有实现：" + miss!!.name + "()（" + intToString(miss!!.pcount) + " 个参数）—— 要么写出实现，要么把类头上写成 'abstract class'"
                }
            }
            i = i + 1
        }
        rtn 0
    }

    // 类链上有没有「声明了但没落地」的抽象方法。`abstract fun f()` 在树上**没有 BLOCK 孩子**
    // （Parser.rsf:1784-1815），所以判据是 `body.kind == NodeKind.BLOCK` —— 与 `defaultNamed`
    // 同一个判据。沿链逐层看抽象声明，再看「最近的实现」有没有把它接住。
    fun firstUnimplemented(c : Cls) -> ?Fn {
        var cur = c
        while (cur.hasBase) {
            var b = findCls(cur.baseName)
            if (b == null) { rtn null }
            cur = b!!
            var i = 0
            while (i < cur.mcount) {
                var m = cur.methods[i]
                if (m.body.kind != NodeKind.BLOCK) {
                    var impl = methInChain(c.name, m.name, m.pcount)
                    if (impl == null || impl!!.body.kind != NodeKind.BLOCK) { rtn m }
                }
                i = i + 1
            }
        }
        rtn null
    }

    // 沿 root（**运行期真实类的名字**）的接口链找**带体**的同名同形默认方法。
    // 与 Kotlin `findInterfaceDefault` 同口径：穿过父接口、菱形只走一次
    // （visited 按名字）、JDK 接口跳过（findIface 找不到就跳过）。
    // 命中写进 ifaceHit / ifaceHitCount：>1 就是歧义（两份默认方法并列），
    // 调用方**必须报错**，绝不能按声明顺序挑一个（对齐 Kotlin Checker 的重载歧义判定）。
    public fun ifaceDefaultScan(root : string, nm : string, argc : int) -> void {
        ifaceHit = null
        ifaceHitCount = 0
        // 没有接口就整条路都不用走（自举的 9 个源都没有接口，这条守卫让它们零开销）
        if (icount == 0) { rtn }
        var seen : string[] = new string[4]
        var sn = 0
        var queue : string[] = new string[8]
        var qn = 0
        var head = 0
        var c0 = findCls(root)
        if (c0 != null) {
            var s0 = 0
            while (s0 < c0!!.scount) {
                queue = growText(queue, qn, c0!!.supers[s0])
                qn = qn + 1
                s0 = s0 + 1
            }
        }
        var i0 = findIface(root)
        if (i0 != null) {
            var s1 = 0
            while (s1 < i0!!.scount) {
                queue = growText(queue, qn, i0!!.supers[s1])
                qn = qn + 1
                s1 = s1 + 1
            }
        }
        while (head < qn) {
            var cur = queue[head]
            head = head + 1
            var dup = false
            var vi = 0
            while (vi < sn) {
                if (seen[vi] == cur) { dup = true }
                vi = vi + 1
            }
            if (!dup) {
                seen = growText(seen, sn, cur)
                sn = sn + 1
                var ic = findIface(cur)
                if (ic != null) {
                    var hm = ic!!.defaultNamed(nm, argc)
                    if (hm != null) {
                        ifaceHitCount = ifaceHitCount + 1
                        ifaceHit = hm
                    }
                    var s2 = 0
                    while (s2 < ic!!.scount) {
                        queue = growText(queue, qn, ic!!.supers[s2])
                        qn = qn + 1
                        s2 = s2 + 1
                    }
                }
            }
        }
        rtn
    }

    // 运行期真实类 / 接口链上的默认方法：命中唯一才返回，0 或 ≥2 交给调用方报错。
    fun ifaceDefaultOf(root : string, nm : string, argc : int) -> ?Fn {
        ifaceDefaultScan(root, nm, argc)
        if (ifaceHitCount == 1) { rtn ifaceHit }
        rtn null
    }

    // ------------------------------------------------------------------ 类型文本
    //
    // 类型在树上是**文本**（`int` / `?string` / `Point` / `int[]` / `Box&<int>`）。
    // 解释器只需要「基础名」这一个信息来做运行期收敛，所以这里把修饰全部剥掉。

    public fun baseTypeName(typeText : string) -> string {
        var t = typeText
        if (t.length() > 0 && t.charAt(0) == '?') { t = t.substring(1, t.length()) }
        var amp = indexOfCharIn(t, '&')
        if (amp >= 0) { t = t.substring(0, amp) }
        var br = indexOfTextIn(t, "[]")
        if (br >= 0) { t = t.substring(0, br) }
        rtn t
    }

    fun isPrimitiveName(nm : string) -> bool {
        if (nm == "int") { rtn true }
        if (nm == "long") { rtn true }
        if (nm == "float") { rtn true }
        if (nm == "double") { rtn true }
        if (nm == "bool") { rtn true }
        if (nm == "char") { rtn true }
        if (nm == "byte") { rtn true }
        if (nm == "string") { rtn true }
        rtn false
    }

    // ------------------------------------------------------------ 阶段 24d：as / ?as / is / !is
    //
    // 判型口径照抄 Kotlin 解释器 `Interpreter.kt:1747-1856`（`runtimeIs` /
    // `runtimeIsArray` / `elementIsInstance` / `rsfTypeIs` / `castFailure`）：
    //
    //   * 数组**协变**（`B[]` 是 `A[]`）：先比层数，再比元素层；基本类型数组不协变；
    //   * 用户对象先看整条**类链**，再对链上每一层走**接口闭包**；
    //   * 枚举比枚举名；`string` / `ArrayList` / `File` 各自比名字。
    //
    // 报错文案逐字对齐工单 §2.7：`rsf: 不能把 <实际 JVM 名> 当成 <目标 JVM 名>`。
    // 两端的名字都按 `SemanticModel.jvmRuntimeNameOf` 的规则现算：
    // 数组是 `[`×depth + 元素描述符（`C[]` → `[LC;`、`int[][]` → `[[I`），
    // `string` 是 `java.lang.String`，装值的那几个 JDK 类给全名，其余类名原样。
    //
    // **已知差异（工单 §4 陷阱①）**：自举版完全不认识 `pkg` —— `Cls.name` 只有**简单名**，
    // 所以带包名的程序里同一个类在文案/比较里会是 `C` 而不是 `demo.C`。
    // 判据语料没有包名；这里只把差异写下来，不动 Sources.rsf 的装载口径。

    // 类型文本末尾 `[]` 的层数：`A`→0、`A[]`→1、`int[][]`→2。
    // 形状由 `TypeInfo.text()` 定死（`[]` 永远在最外、`&<...>` 在它里侧，见
    // Parser.rsf:291-297），所以从**尾部**剥就不会误伤泛型实参里的 `[]`（`Box&<int[]>`）。
    fun arrayDepthOfText(typeText : string) -> int {
        var t = typeText
        var dep = 0
        while (t.length() >= 2 && t.endsWith("[]")) {
            t = t.substring(0, t.length() - 2)
            dep = dep + 1
        }
        rtn dep
    }

    // 剥掉末尾所有 `[]` 之后的**元素**类型文本（擦形之前，可能还带 `&<...>` / `::` / `?`）
    fun elemTextOfArray(typeText : string) -> string {
        var t = typeText
        while (t.length() >= 2 && t.endsWith("[]")) {
            t = t.substring(0, t.length() - 2)
        }
        rtn t
    }

    // 去掉类型文本里的可空标记（前导 `?`）——判型和取名都不看它（`A?` 与 `A` 同义）
    fun dropNullableMark(nm : string) -> string {
        if (nm.length() > 0 && nm.charAt(0) == '?') { rtn nm.substring(1, nm.length()) }
        rtn nm
    }

    // `s` 重复 `n` 次（拼 `[`×depth 用；rsf 没有字符串乘法）
    fun repeatStr(s : string, n : int) -> string {
        var out = ""
        var i = 0
        while (i < n) {
            out = out + s
            i = i + 1
        }
        rtn out
    }

    // 类名 → `Class.getName()` 的写法：擦掉泛型实参（`&<...>`）与 `[]`、去掉 `?`，
    // 嵌套类型的 `::` 换成 `$`（class 文件里就是 `A$Nested`）。
    fun jvmDottedNameOf(nm : string) -> string {
        var t = baseTypeName(nm)
        var i = indexOfTextIn(t, "::")
        if (i < 0) { rtn t }
        rtn t.substring(0, i) + "$" + t.substring(i + 2, t.length())
    }

    // 类名 → JVM **内部**名（数组描述符里用）：`::`→`$`、包分隔 `.`→`/`
    fun jvmInternalNameOf(nm : string) -> string {
        var t = jvmDottedNameOf(nm)
        var out = ""
        var i = 0
        while (i < t.length()) {
            var ch = t.charAt(i)
            if (ch == '.') {
                out = out + "/"
            } else {
                out = out + ("" + ch)
            }
            i = i + 1
        }
        rtn out
    }

    // 元素类型文本 → JVM 描述符里的**元素段**：int→`I` … byte→`B`、
    // string→`Ljava/lang/String;`、用户类→`L<内部名>;`。`[`×depth 由调用方补。
    fun elemDescriptorOf(elemText : string) -> string {
        var t = baseTypeName(dropNullableMark(elemText))
        if (t == "int") { rtn "I" }
        if (t == "long") { rtn "J" }
        if (t == "float") { rtn "F" }
        if (t == "double") { rtn "D" }
        if (t == "bool") { rtn "Z" }
        if (t == "char") { rtn "C" }
        if (t == "byte") { rtn "B" }
        if (t == "string") { rtn "Ljava/lang/String;" }
        rtn "L" + jvmInternalNameOf(t) + ";"
    }

    // 目标类型文本 → `jvmRuntimeNameOf` 的写法：
    //   数组 → `[`×depth + 元素段（元素先擦泛型、擦 `?`）；
    //   string → `java.lang.String`；其余基础类型按描述符（Kotlin 侧同口径）；
    //   类名 → 原样（泛型实参擦掉、`::`→`$`）。
    fun jvmTypeNameOf(typeText : string) -> string {
        var depth = arrayDepthOfText(typeText)
        if (depth > 0) {
            rtn repeatStr("[", depth) + elemDescriptorOf(elemTextOfArray(typeText))
        }
        var nm = baseTypeName(typeText)
        if (nm == "string") { rtn "java.lang.String" }
        if (isPrimitiveName(nm)) { rtn elemDescriptorOf(nm) }
        rtn jvmDottedNameOf(nm)
    }

    // 一个值在运行期的 JVM 名（`runtimeNameOfValue` 的自举版）
    fun runtimeNameOfVal(v : Val) -> !string {
        switch (v.k) {
            Kind.NULLV : rtn "null"
            Kind.STRV : rtn "java.lang.String"
            Kind.INTV : rtn "java.lang.Integer"
            Kind.LONGV : rtn "java.lang.Long"
            Kind.FLOATV : rtn "java.lang.Float"
            Kind.DOUBLEV : rtn "java.lang.Double"
            Kind.BOOLV : rtn "java.lang.Boolean"
            Kind.CHARV : rtn "java.lang.Character"
            Kind.BYTEV : rtn "java.lang.Byte"
            Kind.LISTV : rtn "java.util.ArrayList"
            Kind.FILEV : rtn "java.io.File"
            Kind.ENUMV : rtn jvmDottedNameOf(v.en)
            Kind.OBJV : rtn objClsOf(v)!!
            Kind.ARRV : rtn arrNameOf(v)!!
            else : fail unsupported("转型失败文案：值种类 " + ("" + v.k))
        }
        rtn ""
    }

    // 对象值的运行期类名（OBJV 的载荷一定在；不在说明内部状态坏了，响亮报错）
    fun objClsOf(v : Val) -> !string {
        var o = v.ov
        if (o == null) { fail unsupported("类型名：对象值没有载荷") }
        rtn jvmDottedNameOf(o!!.cls)
    }

    // 数组值的运行期名：`[`×depth + 元素段（`C[]`→`[LC;`、`int[][]`→`[[I`）。
    // 声明类型记在 `Arr.depth` / `Arr.elemType` 上（`makeArray` 装的），正是 Kotlin 侧
    // `arrayTypes` 那张表的自举版——JVM 上用户对象数组的载体分不出 `B[]` 和 `C[]`，
    // 所以这里只能问这两个槽。
    fun arrNameOf(v : Val) -> !string {
        var a = v.av
        if (a == null) { fail unsupported("类型名：数组值没有载荷") }
        rtn repeatStr("[", a!!.depth) + elemDescriptorOf(a!!.elemType)
    }

    // 工单 §2.7 的逐字文案（`as` 失败必须走 `fail`，让 rsf 的 `try` 接得住）
    fun castFailure(v : Val, typeText : string) -> !string {
        rtn "rsf: 不能把 " + runtimeNameOfVal(v)!! + " 当成 " + jvmTypeNameOf(typeText)
    }

    // `A::B` 这类**嵌套写法**的属主（`A`）。没有 `::` 就返回空串。
    //
    // 自举解释器只有注解伴生类（`annotation Marker() { companion entity Impl … }`）
    // 会写成 `Marker::Impl`，而 `loadCompanion` 是**把伴生体的成员并进属主类 `Marker`**
    // （`Interp.rsf:989-999`）——所以 `Marker::Impl` 这个类型在解释器里的身份就是 `Marker`。
    // 判型时必须认这一条，否则 `x is Marker::Impl` 会静默给 false（Kotlin 侧给 true）。
    // Parser/Checker 保证 `::` 只出现在注解伴生类上，所以「取 `::` 前面那段」不会误伤别的类型。
    fun nestedOwnerOf(typeText : string) -> string {
        var t = baseTypeName(dropNullableMark(typeText))
        var i = indexOfTextIn(t, "::")
        if (i < 0) { rtn "" }
        rtn t.substring(0, i)
    }

    // `[className]`（含它链上每一层）能不能当成 [want]：先比类链上的名字，
    // 再认「注解伴生类 `A::B` 的身份是 `A`」，最后对每一层走接口闭包
    // （Kotlin `rsfTypeIs` :1789-1794 同口径）。
    fun rsfTypeIsName(className : string, want : string) -> bool {
        var chain = chainArray(className)
        var wk = jvmDottedNameOf(want)
        var owner = nestedOwnerOf(want)
        var wkOwner = ""
        if (owner.length() > 0) { wkOwner = jvmDottedNameOf(owner) }
        var i = 0
        while (i < chain.length) {
            var c = chain[i]
            if (jvmDottedNameOf(c.name) == wk) { rtn true }
            if (wkOwner.length() > 0 && jvmDottedNameOf(c.name) == wkOwner) { rtn true }
            if (ifaceClosureHas(c.name, wk)) { rtn true }
            i = i + 1
        }
        rtn false
    }

    // [startName] 的**接口闭包**（直接父接口 + 父接口的父接口……）里有没有 [want]。
    // BFS 结构与 `ifaceDefaultScan` 一致：名字数组 + 线性查重防环（rsf 没有 HashSet，
    // 规模也只有个位数）。起点同样两处：`findCls(startName).supers`（类声明的父类型）
    // 与 `findIface(startName).supers`（接口自己继承的父接口）——与 Kotlin
    // `interfaceClosureContains` :1801-1812 从 `superInterfacesOf` 出发同义。
    fun ifaceClosureHas(startName : string, want : string) -> bool {
        var seen : string[] = new string[4]
        var sn = 0
        var queue : string[] = new string[8]
        var qn = 0
        var head = 0
        var c0 = findCls(startName)
        if (c0 != null) {
            var s0 = 0
            while (s0 < c0!!.scount) {
                queue = growText(queue, qn, c0!!.supers[s0])
                qn = qn + 1
                s0 = s0 + 1
            }
        }
        var i0 = findIface(startName)
        if (i0 != null) {
            var s1 = 0
            while (s1 < i0!!.scount) {
                queue = growText(queue, qn, i0!!.supers[s1])
                qn = qn + 1
                s1 = s1 + 1
            }
        }
        while (head < qn) {
            var cur = queue[head]
            head = head + 1
            if (jvmDottedNameOf(cur) == want) { rtn true }
            var dup = false
            var vi = 0
            while (vi < sn) {
                if (seen[vi] == cur) { dup = true }
                vi = vi + 1
            }
            if (!dup) {
                seen = growText(seen, sn, cur)
                sn = sn + 1
                var ic = findIface(cur)
                if (ic != null) {
                    var s2 = 0
                    while (s2 < ic!!.scount) {
                        queue = growText(queue, qn, ic!!.supers[s2])
                        qn = qn + 1
                        s2 = s2 + 1
                    }
                }
            }
        }
        rtn false
    }

    // 数组**元素层**的赋值兼容（Kotlin `elementIsInstance` :1773-1786）：
    // 擦形后同名直接相容（`Box&<int>` 与 `Box&<string>` 都擦成 `Box`）；
    // 任一边是基础类型就**不协变**（`int[]` 不是 `long[]`）；其余按类链/接口闭包判。
    fun elemIsInstance(actual : string, target : string) -> bool {
        var ab = baseTypeName(dropNullableMark(actual))
        var tb = baseTypeName(dropNullableMark(target))
        if (ab == tb) { rtn true }
        if (isPrimitiveName(ab) || isPrimitiveName(tb)) { rtn false }
        rtn rsfTypeIsName(ab, tb)
    }

    // `v` 能不能当成类型文本 [typeText]（`A` / `A[]` / `int[][]` / `Box&<int>` / `A::Nested`）。
    // 不认识的**值种类**一律 `fail`（工单 §2.4 / 17c 铁律：绝不许兜底 false 或静默降级）。
    public fun isInstanceOf(v : Val, typeText : string) -> !bool {
        var depth = arrayDepthOfText(typeText)
        if (depth > 0) {
            if (v.k != Kind.ARRV) { rtn false }
            var a = v.av
            if (a == null) { fail unsupported("is 判型：数组值没有载荷") }
            if (a!!.depth != depth) { rtn false }
            rtn elemIsInstance(a!!.elemType, elemTextOfArray(typeText))
        }
        var want = baseTypeName(typeText)
        switch (v.k) {
            Kind.NULLV : rtn false
            // 目标是**非数组**类型，值却是数组：JVM 上数组永远不是任何一个引用类型的实例
            // （`Class.isInstance` 只认 `Object`/`Cloneable`/`Serializable`，rsf 都没有），
            // 所以 Kotlin 版 `runtimeIs` 落到 `jvmClassOf(target)?.isInstance(value) ?: false`
            // 时答案恒为 false —— 这里给同一个答案，`as` 才走得出 §2.7 的文案
            // （`arr as string` → `rsf: 不能把 [[I 当成 java.lang.String`），不会变成
            // 「暂不支持」。这不是兜底：数组在这条分支上的答案本来就是确定的 false。
            Kind.ARRV : rtn false
            Kind.OBJV : rtn rsfTypeIsName(objClsOf(v)!!, want)
            Kind.ENUMV : rtn jvmDottedNameOf(v.en) == jvmDottedNameOf(want)
            Kind.STRV : rtn want == "string"
            Kind.INTV : rtn want == "int"
            Kind.LONGV : rtn want == "long"
            Kind.FLOATV : rtn want == "float"
            Kind.DOUBLEV : rtn want == "double"
            Kind.BOOLV : rtn want == "bool"
            Kind.CHARV : rtn want == "char"
            Kind.BYTEV : rtn want == "byte"
            Kind.LISTV : rtn want == "ArrayList"
            Kind.FILEV : rtn want == "File"
            else : fail unsupported("is 判型：值种类 " + ("" + v.k))
        }
        rtn false
    }

    // ------------------------------------------------------------------ 数值取值
    //
    // 每种「按目标类型取数」写成一个函数，是因为 rsf 的数值转换只允许**加宽**
    // （没有 (int) 这种强转）——所以能取到哪几种来源，就直接在函数体里穷举掉。

    // 注意：rsf 的数值转换**只允许加宽**（没有 (int) 这种强转），所以每个函数
    // 只列它真能接住的来源；接不住的档位在合法程序里根本不会出现（Checker 管着），
    // 真碰上就返回 0——不会静默算错一个「看起来像」的值。
    fun intOf(v : Val) -> int {
        switch (v.k) {
            Kind.INTV : rtn v.iv
            Kind.BYTEV : rtn v.yv
            Kind.CHARV : rtn charToInt(v.cv)
            else : rtn 0
        }
        rtn 0
    }

    fun longOf(v : Val) -> long {
        switch (v.k) {
            Kind.INTV : rtn v.iv
            Kind.BYTEV : rtn v.yv
            Kind.CHARV : rtn charToInt(v.cv)
            Kind.LONGV : rtn v.lv
            else : rtn 0L
        }
        rtn 0L
    }

    fun floatOf(v : Val) -> float {
        switch (v.k) {
            Kind.INTV : rtn v.iv
            Kind.BYTEV : rtn v.yv
            Kind.CHARV : rtn charToInt(v.cv)
            Kind.LONGV : rtn v.lv
            Kind.FLOATV : rtn v.fv
            else : rtn 0.0f
        }
        rtn 0.0f
    }

    fun doubleOf(v : Val) -> double {
        switch (v.k) {
            Kind.INTV : rtn v.iv
            Kind.BYTEV : rtn v.yv
            Kind.CHARV : rtn charToInt(v.cv)
            Kind.LONGV : rtn v.lv
            Kind.FLOATV : rtn v.fv
            Kind.DOUBLEV : rtn v.dv
            else : rtn 0.0
        }
        rtn 0.0
    }

    // 运行期收敛到声明的静态类型。**只在加宽方向生效**（rsf 的语义本来也不允许反向），
    // 非数值（string / 对象 / 数组 / 枚举 / null）原样放行。
    public fun coerceTo(typeText : string, v : Val) -> Val {
        var base = baseTypeName(typeText)
        if (!isPrimitiveName(base)) { rtn v }
        var r = kindRank(v.k)
        if (r < 0) { rtn v }
        if (base == "int") {
            if (r == 0) { rtn vInt(intOf(v)) }
            rtn v
        }
        if (base == "long") {
            if (r <= 1) { rtn vLong(longOf(v)) }
            rtn v
        }
        if (base == "float") {
            if (r <= 2) { rtn vFloat(floatOf(v)) }
            rtn v
        }
        if (base == "double") { rtn vDouble(doubleOf(v)) }
        if (base == "byte") {
            if (r == 0) { rtn vByte(toByte(intOf(v))) }
            rtn v
        }
        if (base == "char") {
            if (r == 0) { rtn vChar(toChar(intOf(v))) }
            rtn v
        }
        rtn v
    }

    // 数组元素的默认值（和 JVM 的 new 数组规则一致：数值 0、bool false、引用 null）
    public fun defaultOf(typeText : string) -> Val {
        var base = baseTypeName(typeText)
        if (base == "int") { rtn vInt(0) }
        if (base == "long") { rtn vLong(0L) }
        if (base == "float") { rtn vFloat(0.0f) }
        if (base == "double") { rtn vDouble(0.0) }
        if (base == "bool") { rtn vBool(false) }
        if (base == "char") { rtn vChar(toChar(0)) }
        if (base == "byte") { rtn vByte(toByte(0)) }
        rtn vNull()
    }

    fun truth(v : Val) -> !bool {
        if (v.k == Kind.BOOLV) { rtn v.bv }
        fail unsupported("条件位置上的 " + ("" + v.k) + "（要求 bool）")
        rtn false
    }

    // ------------------------------------------------------------------ 渲染
    //
    // 与 Kotlin 版 `render(v, t)` / `ObjectFormat.valueText` 对齐：静态类型是 string
    // 的原样给，null 给 "null"，其余走 JVM 的 toString（这里就是 `"" + 值`）。

    public fun render(v : Val) -> !string {
        switch (v.k) {
            Kind.NULLV : rtn "null"
            Kind.INTV : rtn "" + v.iv
            Kind.LONGV : rtn "" + v.lv
            Kind.FLOATV : rtn "" + v.fv
            Kind.DOUBLEV : rtn "" + v.dv
            Kind.BOOLV : rtn "" + v.bv
            Kind.CHARV : rtn "" + v.cv
            Kind.BYTEV : rtn "" + v.yv
            Kind.STRV : rtn v.sv
            Kind.ENUMV : rtn v.sv
            Kind.OBJV : rtn renderObj(v.ov!!)!!
            Kind.LISTV : rtn renderList(v.lsv!!)!!
            Kind.ARRV : rtn renderArray(v.av!!)!!
            Kind.CTYPEV : rtn v.cname
            Kind.FILEV : rtn v.sv
        }
        rtn "?"
    }

    // 数组直接打印是 Kotlin 版检查期就拦掉的事（身份哈希两端没法一致），
    // 解释器这条路上也拦住，别静默打出一串没意义的东西。
    fun renderArray(a : Arr) -> !string {
        fail "数组不能直接打印或拼进字符串：JVM 上打出来的是身份哈希（像 [I@1b6d3586），" +
            "每次运行都不同，两端没法保证一致。要看清内容就按下标逐个取，比如 a[0]、a.length，或者用循环"
        rtn ""
    }

    // java.util.AbstractCollection.toString 的格式：`[a, b]`
    fun renderList(l : JList) -> !string {
        var out = "["
        var i = 0
        while (i < l.n) {
            if (i > 0) { out = out + ", " }
            out = out + render(l.es[i])!!
            i = i + 1
        }
        rtn out + "]"
    }

    // ObjectFormat.render：`类名(字段=值, 字段=值)`，字段按声明顺序，
    // 只有「基础类型 / string / 可空基础类型 / 枚举」的字段真的打值，数组与对象字段一律 `...`。
    // 阶段 25 K5c：字段沿**整条父链**渲染、**父类字段在前**（与 Kotlin 的
    // `ObjectFormat.render` + `fieldChainOf` 同口径；p11_tostr_chain 对的就是这一条）。
    fun renderObj(o : Obj) -> !string {
        var c = findCls(o.cls)
        if (c == null) { rtn o.cls + "()" }
        var out = o.cls + "("
        var first = true
        var chain = chainArray(o.cls)
        var i = 0
        while (i < chain.length) {
            var lv = chain[i]
            var base = baseOf(lv)
            var k = 0
            while (k < lv.fcount) {
                if (!first) { out = out + ", " }
                first = false
                out = out + lv.fnames[k] + "="
                if (isDisplayableField(lv.ftypes[k])) {
                    out = out + renderFieldValue(o.fs[base + k], lv.ftypes[k])!!
                } else {
                    out = out + "..."
                }
                k = k + 1
            }
            i = i + 1
        }
        rtn out + ")"
    }

    // 整条父链的字段先按类型零值铺一遍（父类在前）—— 没写构造器 / 没写初值的字段
    // 也要有确定的值，与 Kotlin 构造前的 fillDefaults 同一个用意。
    fun fillChainDefaults(root : string, o : Obj) -> void {
        var chain = chainArray(root)
        var i = 0
        while (i < chain.length) {
            var lv = chain[i]
            var base = baseOf(lv)
            var k = 0
            while (k < lv.fcount) {
                o.fs[base + k] = defaultOf(lv.ftypes[k])
                k = k + 1
            }
            i = i + 1
        }
        rtn
    }

    fun isDisplayableField(typeText : string) -> bool {
        if (indexOfTextIn(typeText, "[]") >= 0) { rtn false }
        var base = baseTypeName(typeText)
        if (base == "string") { rtn true }
        if (base == "int" || base == "long" || base == "float" || base == "double") { rtn true }
        if (base == "bool" || base == "char" || base == "byte") { rtn true }
        rtn findEnum(base) != null
    }

    fun renderFieldValue(v : Val, typeText : string) -> !string {
        if (v.k == Kind.NULLV) { rtn "null" }
        if (findEnum(baseTypeName(typeText)) != null) { rtn v.sv }
        rtn render(v)!!
    }

    // ------------------------------------------------------------------ 算术
    //
    // 提升规则与 RsfType.rank 一致：byte/char 与 int 同档（先提升成 int），
    // 结果取两边更高的那一档。**int 档一定用 int 运算**——溢出的回绕行为
    // 只有这样才和 JVM 的 IADD/IMUL 一致（用 long 算再截是另一回事）。

    fun intOp(op : string, a : int, b : int) -> !int {
        if (op == "PLUS") { rtn a + b }
        if (op == "MINUS") { rtn a - b }
        if (op == "STAR") { rtn a * b }
        if (op == "SLASH") {
            if (b == 0) { fail makeSignal("X", "除以零") }
            rtn a / b
        }
        if (op == "PERCENT") {
            if (b == 0) { fail makeSignal("X", "除以零") }
            rtn a % b
        }
        fail unsupported("算术运算符 " + op)
        rtn 0
    }

    fun longOp(op : string, a : long, b : long) -> !long {
        if (op == "PLUS") { rtn a + b }
        if (op == "MINUS") { rtn a - b }
        if (op == "STAR") { rtn a * b }
        if (op == "SLASH") {
            if (b == 0L) { fail makeSignal("X", "除以零") }
            rtn a / b
        }
        if (op == "PERCENT") {
            if (b == 0L) { fail makeSignal("X", "除以零") }
            rtn a % b
        }
        fail unsupported("算术运算符 " + op)
        rtn 0L
    }

    fun floatOp(op : string, a : float, b : float) -> !float {
        if (op == "PLUS") { rtn a + b }
        if (op == "MINUS") { rtn a - b }
        if (op == "STAR") { rtn a * b }
        if (op == "SLASH") { rtn a / b }
        if (op == "PERCENT") { rtn a % b }
        fail unsupported("算术运算符 " + op)
        rtn 0.0f
    }

    fun doubleOp(op : string, a : double, b : double) -> !double {
        if (op == "PLUS") { rtn a + b }
        if (op == "MINUS") { rtn a - b }
        if (op == "STAR") { rtn a * b }
        if (op == "SLASH") { rtn a / b }
        if (op == "PERCENT") { rtn a % b }
        fail unsupported("算术运算符 " + op)
        rtn 0.0
    }

    public fun arithOp(op : string, a : Val, b : Val) -> !Val {
        var ra = kindRank(a.k)
        var rb = kindRank(b.k)
        if (ra < 0 || rb < 0) {
            fail unsupported("算术运算 '" + op + "' 用在 " + ("" + a.k) + " 与 " + ("" + b.k) + " 上")
        }
        var c = ra
        if (rb > c) { c = rb }
        if (c == 0) { rtn vInt(intOp(op, intOf(a), intOf(b))!!) }
        if (c == 1) { rtn vLong(longOp(op, longOf(a), longOf(b))!!) }
        if (c == 2) { rtn vFloat(floatOp(op, floatOf(a), floatOf(b))!!) }
        rtn vDouble(doubleOp(op, doubleOf(a), doubleOf(b))!!)
    }

    fun cmpInt(a : int, b : int) -> int {
        if (a < b) { rtn -1 }
        if (a > b) { rtn 1 }
        rtn 0
    }

    fun cmpLong(a : long, b : long) -> int {
        if (a < b) { rtn -1 }
        if (a > b) { rtn 1 }
        rtn 0
    }

    fun cmpFloat(a : float, b : float) -> int {
        if (a < b) { rtn -1 }
        if (a > b) { rtn 1 }
        rtn 0
    }

    fun cmpDouble(a : double, b : double) -> int {
        if (a < b) { rtn -1 }
        if (a > b) { rtn 1 }
        rtn 0
    }

    // 非数值的比较：字符串按内容，对象/数组/枚举按**引用相等**——和 Kotlin 版
    // 统一走 `a == b`（Object.equals）是同一件事。
    fun valuesEqual(a : Val, b : Val) -> bool {
        if (a.k == Kind.NULLV || b.k == Kind.NULLV) {
            rtn a.k == Kind.NULLV && b.k == Kind.NULLV
        }
        if (a.k == Kind.STRV && b.k == Kind.STRV) { rtn a.sv == b.sv }
        if (a.k == Kind.BOOLV && b.k == Kind.BOOLV) { rtn a.bv == b.bv }
        if (a.k == Kind.OBJV && b.k == Kind.OBJV) { rtn a.ov == b.ov }
        if (a.k == Kind.ARRV && b.k == Kind.ARRV) { rtn a.av == b.av }
        if (a.k == Kind.LISTV && b.k == Kind.LISTV) { rtn a.lsv == b.lsv }
        if (a.k == Kind.ENUMV && b.k == Kind.ENUMV) { rtn a == b }
        rtn false
    }

    public fun compareOp(op : string, a : Val, b : Val) -> !Val {
        var ra = kindRank(a.k)
        var rb = kindRank(b.k)
        if (ra >= 0 && rb >= 0) {
            var c = ra
            if (rb > c) { c = rb }
            var d = 0
            if (c == 0) { d = cmpInt(intOf(a), intOf(b)) }
            else if (c == 1) { d = cmpLong(longOf(a), longOf(b)) }
            else if (c == 2) { d = cmpFloat(floatOf(a), floatOf(b)) }
            else { d = cmpDouble(doubleOf(a), doubleOf(b)) }
            if (op == "EQ") { rtn vBool(d == 0) }
            if (op == "NE") { rtn vBool(d != 0) }
            if (op == "LT") { rtn vBool(d < 0) }
            if (op == "GT") { rtn vBool(d > 0) }
            if (op == "LE") { rtn vBool(d <= 0) }
            rtn vBool(d >= 0)
        }
        if (op != "EQ" && op != "NE") {
            fail unsupported("比较运算符 '" + op + "' 用在非数值上（" + ("" + a.k) + " / " + ("" + b.k) + "）")
        }
        var eq = valuesEqual(a, b)
        if (op == "EQ") { rtn vBool(eq) }
        rtn vBool(!eq)
    }

    // ------------------------------------------------------------------ 数组
    //
    // 越界与负长度**显式检查**（不让 JVM 自己抛）：消息要和 Kotlin 版一字不差，
    // 而且解释器的 `try` 接不住 JVM 的异常——两端会分叉。

    // 返回 `!int` 而不是 `!void`：rsf 的 `!void` 取不出值、因此写不了 `!!`，
    // 调用点就得各包一层 try。恒返回 0 只是为了让调用点能一行写完。
    public fun checkIndex(length : int, index : int) -> !int {
        if (index < 0 || index >= length) {
            fail arrayIndexFailure(length, index)
        }
        rtn 0
    }

    public fun makeArray(elemText : string, dims : int[], at : int) -> Arr {
        var left = dims.length - at
        var a = new Arr(left)
        a.elemType = elemText
        var cnt = dims[at]
        a.es = new Val[cnt]
        var i = 0
        if (left == 1) {
            while (i < cnt) {
                a.es[i] = defaultOf(elemText)
                i = i + 1
            }
        } else {
            while (i < cnt) {
                a.es[i] = vArr(makeArray(elemText, dims, at + 1))
                i = i + 1
            }
        }
        rtn a
    }

    // ==== PART3 ====

    // ------------------------------------------------------------------ 表达式求值

    public fun evalArgs(argsNode : Node, env : Env) -> !Val[] {
        var cnt = argsNode.childCount
        var out : Val[] = new Val[cnt]
        var i = 0
        while (i < cnt) {
            out[i] = ev(argsNode.children[i], env)!!
            i = i + 1
        }
        rtn out
    }

    public fun ev(n : Node, env : Env) -> !Val {
        switch (n.kind) {
            NodeKind.INT_LIT : rtn vInt(parseInt(attr(n, "value")) ?: 0)
            NodeKind.LONG_LIT : rtn vLong(Long.parseLong(attr(n, "value")))
            NodeKind.FLOAT_LIT : rtn vFloat(Float.parseFloat(attr(n, "value")))
            NodeKind.DOUBLE_LIT : rtn vDouble(Double.parseDouble(attr(n, "value")))
            NodeKind.STRING_LIT : rtn vStr(attr(n, "value"))
            NodeKind.CHAR_LIT : rtn vChar(charOfLiteral(attr(n, "value")))
            NodeKind.BOOL_LIT : rtn vBool(attr(n, "value") == "true")
            NodeKind.NULL_LIT : rtn vNull()
            NodeKind.VAR : rtn evVar(n, env)!!
            NodeKind.CALL : rtn evCall(n, env)!!
            NodeKind.NEW : rtn evNew(n, env)!!
            NodeKind.NEW_ARRAY : rtn evNewArray(n, env)!!
            NodeKind.MEMBER : rtn evMember(n, env)!!
            NodeKind.INDEX : rtn evIndex(n, env)!!
            NodeKind.UNARY : rtn evUnary(n, env)!!
            NodeKind.BINARY : rtn evBinary(n, env)!!
            NodeKind.IF_EXPR : rtn evIfExpr(n, env)!!
            NodeKind.ELVIS : rtn evElvis(n, env)!!
            NodeKind.FORCE : rtn evForce(n, env)!!
            NodeKind.THIS : rtn evThis(n, env)!!
            // 阶段 25 K5c：`super` 只作为 `super.f(...)` / `super(接口).f(...)` 的**接收者**
            // 出现（Parser.rsf:2376-2419）；选择哪一份声明在 evMember 里做
            NodeKind.SUPER : rtn evSuper(n, env)!!
            // 阶段 24d：`x as A` / `x ?as A` / `x is A` / `x !is A`。
            // 孩子 = [操作数, TARGET]，TARGET 的 `type` 是目标类型文本（Parser.rsf:2716-2748）。
            NodeKind.AS : rtn evAs(n, env)!!
            NodeKind.IS : rtn evIs(n, env)!!
            else : fail unsupported("表达式节点 " + kindName(n.kind))
        }
        rtn vNull()
    }

    // 阶段 24d：`x as A` / `x ?as A`（工单 §2.6）。判型成功**原样**给值（不改值、不改引用，
    // 与 Kotlin `coerce(value, model.typeOf(expr))` 同义，收敛交给声明处）；`?as` 失败给 null；
    // `as` 失败走 `fail` —— rsf 的 `try` 只接 `fail` 的消息，抛 JVM 异常接不住。
    public fun evAs(n : Node, env : Env) -> !Val {
        var v = ev(kid(n, 0), env)!!
        var target = attr(kid(n, 1), "type")
        if (isInstanceOf(v, target)!!) { rtn v }
        if (attrBool(n, "safe")) { rtn vNull() }
        var msg = castFailure(v, target)!!
        fail msg
        rtn vNull()
    }

    // 阶段 24d：`x is A` / `x !is A` —— 恒 `bool`（v1 不做智能转换），否定就是取反
    public fun evIs(n : Node, env : Env) -> !Val {
        var v = ev(kid(n, 0), env)!!
        var r = isInstanceOf(v, attr(kid(n, 1), "type"))!!
        if (attrBool(n, "negated")) { r = !r }
        rtn vBool(r)
    }

    // `super` 表达式本身语义上就是 this（哪一份实现在 evSuperMember 里挑）
    public fun evSuper(n : Node, env : Env) -> !Val {
        var o = env.thisObj()
        if (o == null) { fail "K5c：super 只能用在类的方法或构造器里（这里没有 this）" }
        rtn vObj(o!!)
    }

    // 字符字面量的值在树上是**字符串**（`'a'` 是 "a"，`'\n'` 是真的换行符）
    fun charOfLiteral(s : string) -> char {
        if (s.length() == 0) { rtn toChar(0) }
        rtn s.charAt(0)
    }

    public fun evVar(n : Node, env : Env) -> !Val {
        var nm = attr(n, "name")
        var v = env.lookup(nm)
        if (v != null) { rtn v!! }
        // 方法体里的裸字段名（`rtn x`）：局部没找到才看字段（与 Checker 的解析顺序一致）。
        // 阶段 25 K5c：字段沿**类父链**找（继承来的字段在本类方法里可以直接用），
        // 归属类决定它在对象数组里的那一段（父类字段在前）。
        var c = env.curClass()
        if (c != null) {
            var fo = fieldOwnerInChain(c!!.name, nm)
            if (fo != null) {
                var o = env.thisObj()
                if (o == null) { fail "17c 解释器：字段 '" + nm + "' 出现在没有 this 的地方" }
                rtn o!!.fs[baseOf(fo!!) + fo!!.fieldIndex(nm)]
            }
        }
        // 类名 / 枚举名当静态接收者（`Point.origin()`、`TokenKind.IDENT`）
        if (findCls(nm) != null || findEnum(nm) != null) { rtn vCType(nm) }
        // JVM 互操作里「当类名用」的几个名字（见 17c 报告：只做示例用到的那几个）
        if (isInteropClassName(nm)) { rtn vCType(nm) }
        fail "17c 解释器：找不到名字 '" + nm + "'"
        rtn vNull()
    }

    public fun evThis(n : Node, env : Env) -> !Val {
        var o = env.thisObj()
        if (o == null) { fail "17c 解释器：这里没有 this" }
        rtn vObj(o!!)
    }

    public fun evIfExpr(n : Node, env : Env) -> !Val {
        var c = ev(kid(n, 0), env)!!
        if (truth(c)!!) { rtn ev(kid(n, 1), env)!! }
        rtn ev(kid(n, 2), env)!!
    }

    // `!!`：Kotlin 版这里抛的是 NullPointerException，而解释器的 `try` 只接 rsf 自己的
    // 错误——所以走**不可接**的信号 `X`，语义上才是同构的。
    public fun evForce(n : Node, env : Env) -> !Val {
        var v = ev(kid(n, 0), env)!!
        if (v.k == Kind.NULLV) { fail makeSignal("X", "rsf: 对 null 使用了 '!!'") }
        rtn v
    }

    public fun evUnary(n : Node, env : Env) -> !Val {
        var op = attr(n, "op")
        var v = ev(kid(n, 0), env)!!
        if (op == "BANG") {
            var bv2 = truth(v)!!
            rtn vBool(!bv2)
        }
        if (op != "MINUS") { fail unsupported("一元运算符 " + op) }
        // byte / char 取负之后是 **int**（RsfType 的提升规则），别的地方照原档。
        // 注意 byte 那一支写成 `0 - v.yv` 而不是 `-v.yv`：**字节码后端在一元负号上只认
        // int/long/float/double 四种静态类型**（BytecodeCompiler.kt:1286），
        // 操作数是 byte / char 时 Checker 放行、后端直接抛
        // `IllegalStateException: 一元减号的操作数不是数值`——这是 17c 期间实测到的
        // 编译器缺陷（本阶段不动 Kotlin 编译器，先在自己的 rsf 源码里绕开）。
        switch (v.k) {
            Kind.INTV : rtn vInt(-v.iv)
            Kind.BYTEV : rtn vInt(0 - v.yv)
            Kind.CHARV : rtn vInt(0 - charToInt(v.cv))
            Kind.LONGV : rtn vLong(-v.lv)
            Kind.FLOATV : rtn vFloat(-v.fv)
            Kind.DOUBLEV : rtn vDouble(-v.dv)
            else : fail unsupported("一元 '-' 用在 " + ("" + v.k) + " 上")
        }
        rtn vNull()
    }

    public fun evBinary(n : Node, env : Env) -> !Val {
        var op = attr(n, "op")
        var ln = kid(n, 0)
        var rn = kid(n, 1)

        // `&&` / `||` 真短路：右边在能定结果时**一次都不能求值**
        // （右边的副作用会直接体现在输出上，这条错了对拍立刻红）
        if (op == "ANDAND") {
            var l = ev(ln, env)!!
            if (!truth(l)!!) { rtn vBool(false) }
            rtn vBool(truth(ev(rn, env)!!)!!)
        }
        if (op == "OROR") {
            var l = ev(ln, env)!!
            if (truth(l)!!) { rtn vBool(true) }
            rtn vBool(truth(ev(rn, env)!!)!!)
        }

        var a = ev(ln, env)!!
        var b = ev(rn, env)!!
        // 字符串拼接：Kotlin 版按**静态结果类型**分派，这里按运行期标签——
        // 只要有一边是 string，静态类型就一定是 string（Checker 的规则）
        if (op == "PLUS" && (a.k == Kind.STRV || b.k == Kind.STRV)) {
            rtn vStr(render(a)!! + render(b)!!)
        }
        if (op == "EQ" || op == "NE" || op == "LT" || op == "GT" || op == "LE" || op == "GE") {
            rtn compareOp(op, a, b)!!
        }
        rtn arithOp(op, a, b)!!
    }

    public fun evIndex(n : Node, env : Env) -> !Val {
        var a = ev(kid(n, 0), env)!!
        var iv = ev(kid(n, 1), env)!!
        if (a.k != Kind.ARRV) { fail unsupported("下标访问用在 " + ("" + a.k) + " 上") }
        var idx = intOf(iv)
        checkIndex(a.av!!.es.length, idx)!!
        rtn a.av!!.es[idx]
    }

    public fun evNewArray(n : Node, env : Env) -> !Val {
        var elemText = attr(n, "elem")
        var dimsNode = kid(n, 0)
        var cnt = dimsNode.childCount
        var dims : int[] = new int[cnt]
        var i = 0
        while (i < cnt) {
            var d = intOf(ev(dimsNode.children[i], env)!!)
            if (d < 0) { fail arrayLengthFailure(d) }
            dims[i] = d
            i = i + 1
        }
        rtn vArr(makeArray(elemText, dims, 0))
    }

    // ------------------------------------------------------------------ 构造

    public fun evNew(n : Node, env : Env) -> !Val {
        var raw = attr(n, "class")
        var base = baseTypeName(raw)
        var args = evalArgs(kid(n, 0), env)!!
        var c = findCls(base)
        if (c != null) { rtn constructUser(c!!, args)!! }
        // JVM 互操作：只做示例用到的那几个（ArrayList / File）
        if (base == "ArrayList") { rtn vList(new JList()) }
        if (base == "File") {
            if (args.length == 1) { rtn vFile(fileAbsolutePath(render(args[0])!!)) }
            if (args.length == 2) { rtn vFile(fileJoinPath(render(args[0])!!, render(args[1])!!)) }
            fail unsupported("java.io.File 的 " + args.length + " 个实参的构造器")
        }
        fail unsupported("构造 JVM 类 '" + raw + "'（本阶段只做了 java.util.ArrayList 与 java.io.File）")
        rtn vNull()
    }

    public fun constructUser(c : Cls, args : Val[]) -> !Val {
        // 阶段 25 K5c：抽象类不能 new（Kotlin 侧由 Checker 拦，自举解释器在这里拦）。
        // 允许它会构造出「抽象成员没有实现」的对象，后面的调用只能靠运行期报错兜着 ——
        // 与其那样，不如在这里就响亮报错。
        if (c.isAbstract) {
            fail "K5c：抽象类 '" + c.name + "' 不能 new —— 抽象类只能当父类用（要么把抽象的成员都实现出来，要么把类头上的 'abstract' 去掉）"
        }
        var o = new Obj(c.name)
        // 阶段 25 K5c：对象数组 = **整条父链**的字段（父类字段在前），与 Kotlin
        // `fieldCountOf` / `fieldChainOf` 同口径
        o.fs = new Val[totalOf(c)]
        fillChainDefaults(c.name, o)
        if (c.isAnn) {
            // 阶段 21：注解伴生类。实参是**前缀**（`new Tag()` 给 0 个实参、3 个元素），
            // 没给的元素求**它自己的默认值表达式**；没有默认值的按类型零值。
            // 伴生体另外声明的字段仍走普通字段初值。Kotlin 侧这一段是
            // runConstructor → fillElementDefaults + runFieldInitializers（:1016-1106）。
            var ae0 = new Env(globals)
            ae0.me = o
            ae0.cl = c
            var ak = 0
            while (ak < c.fcount) {
                if (ak < c.elemCount && ak < args.length) {
                    o.fs[ak] = coerceTo(c.ftypes[ak], args[ak])
                } else if (c.finits[ak].kind == NodeKind.ERROR) {
                    o.fs[ak] = defaultOf(c.ftypes[ak])
                } else {
                    o.fs[ak] = coerceTo(c.ftypes[ak], ev(c.finits[ak], ae0)!!)
                }
                ak = ak + 1
            }
            // 伴生类**自己声明**的构造器（Checker 要求形参 = 元素表，两边对齐见 runAnnCtor）
            if (c.ccount > 0) { runAnnCtor(c, c.ctors[0], o, args)!! }
            rtn vObj(o)
        }
        var ctor = pickCtor(c, args)
        if (ctor == null) {
            // 隐式无参构造器：父类那一跳（Kotlin `implicitSuperDelegationOf`）+ 自己的字段初值。
            // 父类有构造器时，实参来自**类头父类子句**（`class Child : Base(1)`，Checker
            // :1155/:1189 那条同理）；父类一个构造器都没写时 runSuperDelegation 会往下递归。
            var e0 = new Env(globals)
            e0.me = o
            e0.cl = c
            var supArgs : ?Node = null
            if (c.hasBase) { supArgs = c.baseArgs }
            runSuperDelegation(c, o, e0, supArgs)!!
            runFieldInits(c, o, e0)!!
        } else {
            runCtor(c, ctor!!, o, args)!!
        }
        rtn vObj(o)
    }

    // 构造器重载按「个数 + 类型契合度」挑，和 Checker 的口径一致（个数优先、精确优先）
    public fun pickCtor(c : Cls, args : Val[]) -> ?Fn {
        var best : ?Fn = null
        var bestScore = 2147483647
        var i = 0
        while (i < c.ccount) {
            if (c.ctors[i].pcount == args.length) {
                var s = 0
                var k = 0
                while (k < args.length) {
                    if (!typeMatches(c.ctors[i].ptypes[k], args[k])) { s = s + 1 }
                    k = k + 1
                }
                if (s < bestScore) {
                    bestScore = s
                    best = c.ctors[i]
                }
            }
            i = i + 1
        }
        rtn best
    }

    fun typeMatches(typeText : string, v : Val) -> bool {
        var base = baseTypeName(typeText)
        if (base == "int") { rtn kindRank(v.k) == 0 }
        if (base == "long" || base == "float" || base == "double") { rtn kindRank(v.k) >= 0 }
        if (base == "byte" || base == "char") { rtn kindRank(v.k) == 0 }
        if (base == "bool") { rtn v.k == Kind.BOOLV }
        if (base == "string") { rtn v.k == Kind.STRV || v.k == Kind.NULLV }
        if (findEnum(base) != null) { rtn v.k == Kind.ENUMV || v.k == Kind.NULLV }
        rtn v.k == Kind.OBJV || v.k == Kind.NULLV || v.k == Kind.LISTV || v.k == Kind.ARRV
    }

    // 构造器体里有没有 `this(...)` 委托：只有链的**根**跑字段初值（和 JVM 同一个道理）。
    // 只看顶层语句——委托必须是首句，这是语法层面的约定。
    fun hasThisCall(bodyNode : Node) -> bool {
        var i = 0
        while (i < bodyNode.childCount) {
            if (bodyNode.children[i].kind == NodeKind.THIS_CALL) { rtn true }
            i = i + 1
        }
        rtn false
    }

    public fun runFieldInits(c : Cls, o : Obj, env : Env) -> !int {
        // 阶段 25 K5c：只写**本类那一段**（父类的字段由父类那一跳或父类自己的构造写）
        var base = baseOf(c)
        var i = 0
        while (i < c.fcount) {
            o.fs[base + i] = coerceTo(c.ftypes[i], ev(c.finits[i], env)!!)
            i = i + 1
        }
        rtn 0
    }

    // 构造体**第一句**的 `super(实参)`（`SUPER_CALL` 的唯一孩子就是 ARGS，Parser.rsf:2352-2367）；
    // 没写就给 null。语法层保证它只可能出现在第一句（Checker :1201-1239 是这么校验的）。
    fun superCallArgs(bodyNode : Node) -> ?Node {
        var i = 0
        while (i < bodyNode.childCount) {
            if (bodyNode.children[i].kind == NodeKind.SUPER_CALL) { rtn kid(bodyNode.children[i], 0) }
            i = i + 1
        }
        rtn null
    }

    // 在 o 上跑「父类那一跳」：父类构造器（实参在**当前帧**里求值，Kotlin runSuperDelegation
    // 同口径 —— 主构造那一跳的实参就是类头子句，可能引用本构造器的形参，p1/p9 靠这条）。
    // 父类一个构造器都没写时递归到父类的父类 + 父类字段初值（Kotlin implicitSuperDelegationOf）。
    // 只有**叶子类**会跑到这里：父类的构造体在它自己的 runCtor 里跑（K3 的 runConstructor 口径：
    // 父类构造器 → 自己字段初值 → 构造体）。
    public fun runSuperDelegation(c : Cls, o : Obj, env : Env, argsNode : ?Node) -> !int {
        if (!c.hasBase) { rtn 0 }
        var parent = findCls(c.baseName)
        if (parent == null) {
            // 装载后的 validate() 已经拦过一次；这里兜住「运行期才拼出来的类名」这种不可能的情况
            fail "K5c 暂不支持 JDK 父类：" + c.baseName + "（类 '" + c.name + "' 的父类不在本程序里）"
        }
        var args : Val[] = new Val[0]
        if (argsNode != null) { args = evalArgs(argsNode!!, env)!! }
        var pc = pickCtor(parent!!, args)
        if (pc != null) { rtn runCtor(parent!!, pc!!, o, args)!! }
        // 父类没有构造器可挑：顺着父类的类头子句再往上跳一层，然后跑父类自己的字段初值
        var e2 = new Env(env)
        e2.me = o
        e2.cl = parent!!
        var up : ?Node = null
        if (parent!!.hasBase) { up = parent!!.baseArgs }
        runSuperDelegation(parent!!, o, e2, up)!!
        runFieldInits(parent!!, o, e2)!!
        rtn 0
    }

    public fun runCtor(c : Cls, f : Fn, o : Obj, args : Val[]) -> !int {
        var env = new Env(globals)
        env.me = o
        env.cl = c
        // 阶段 25 K5c：帧里记下这个构造器**声明**在哪个类（`super.f()` 的解析起点）
        env.dc = findCls(f.ownerCls)
        var i = 0
        while (i < f.pcount) {
            var a = vNull()
            if (i < args.length) { a = args[i] }
            env.define(f.pnames[i], coerceTo(f.ptypes[i], a))
            i = i + 1
        }
        if (!hasThisCall(f.body)) {
            // 阶段 25 K5c 构造顺序（K3 runConstructor 口径）：
            //   父类构造器（显式 `super(…)`，否则类头子句） → 自己的字段初值 → 自己的构造体。
            // 写了 `this(…)` 就整跳交给被委托的构造器去跑（Kotlin：delegationOf(ctor) != null
            // 时既不跑父类那一跳也不跑字段初值）。
            var supArgs = superCallArgs(f.body)
            if (supArgs != null && !c.hasBase) {
                fail "K5c：类 '" + c.name + "' 没有父类，不能写 super(...)"
            }
            if (supArgs == null && c.hasBase) { supArgs = c.baseArgs }
            runSuperDelegation(c, o, env, supArgs)!!
            runFieldInits(c, o, env)!!
        }
        var sig = ""
        try {
            blk(f.body, env)!!
        } catch (e : string) {
            if (signalKind(e) != "R") { sig = e }
        }
        if (sig.length() > 0) { fail sig }
        rtn 0
    }

    // 阶段 21：注解伴生类**自己声明**的构造器。Checker 要求它的形参名与顺序与元素表一致；
    // 声明多个时不禁止，但 `new` 选的是**第一个**（实测 Kotlin 与这里同取 `ctors[0]`），
    // 所以不走 `pickCtor` 的按个数挑 —— `new A()` 给 0 个实参也照样跑这个构造器体。
    // 元素字段在 `constructUser` 里已经填好（实参优先、否则元素默认值），形参槽直接取字段值；
    // **不能再跑 `runFieldInits`** —— 那会把实参填好的元素字段冲回默认值。
    // 对齐 Kotlin `runConstructor`：fillElementDefaults 填形参槽 → runFieldInitializers → 构造器体。
    public fun runAnnCtor(c : Cls, f : Fn, o : Obj, args : Val[]) -> !int {
        var env = new Env(globals)
        env.me = o
        env.cl = c
        var i = 0
        while (i < f.pcount) {
            var a = vNull()
            if (i < c.elemCount) { a = o.fs[i] }
            else if (i < args.length) { a = args[i] }
            env.define(f.pnames[i], coerceTo(f.ptypes[i], a))
            i = i + 1
        }
        var sig = ""
        try {
            blk(f.body, env)!!
        } catch (e : string) {
            if (signalKind(e) != "R") { sig = e }
        }
        if (sig.length() > 0) { fail sig }
        rtn 0
    }

    // ------------------------------------------------------------------ 调用

    public fun callFn(f : Fn, self : ?Obj, c : ?Cls, args : Val[]) -> !Val {
        var env = new Env(globals)
        env.me = self
        env.cl = c
        // 阶段 25 K5c：帧里记下这个方法**声明**在哪个类（`super.f()` 的解析起点；
        // 全局函数 ownerCls 为空 → findCls("") 给 null，和原来一样）
        env.dc = findCls(f.ownerCls)
        var i = 0
        while (i < f.pcount) {
            var a = vNull()
            if (i < args.length) { a = args[i] }
            env.define(f.pnames[i], coerceTo(f.ptypes[i], a))
            i = i + 1
        }
        rtn execFnBody(f, env)!!
    }

    // 阶段 25 K5c：实例方法调用 = **静态解析**（调用点上按静态接收者沿类链找到一份声明）
    // + **虚分派**（真正跑的那一份按运行期真实类沿类链找最近的声明 —— K3 的
    // invokeUserMethod / findClassImplementation 同口径，最近的类优先）。
    // 帧的类 = 真正执行的那份方法的**声明类** —— 这样方法体里的裸字段名按声明类的归属解析
    // （子类同名遮蔽父类时才落在正确的那一段），`super.f()` 也从这个类往上找一层。
    // `static` 方法不参与分派（K5b 的 methOf/fieldOwnerInChain 也只沿类链找**非静态**的）。
    public fun invokeInstance(m : Fn, self : ?Obj, declC : Cls, args : Val[]) -> !Val {
        if (self == null) { rtn callFn(m, null, declC, args)!! }
        if (m.isStatic) { rtn callFn(m, null, declC, args)!! }
        var rc = self!!.cls
        var tf = methInChain(rc, m.name, args.length)
        if (tf == null) { tf = m }
        var tc = methOwnerInChain(rc, tf!!.name, tf!!.pcount)
        if (tc == null) { rtn callFn(tf!!, self, declC, args)!! }
        rtn callFn(tf!!, self, tc!!, args)!!
    }

    public fun execFnBody(f : Fn, env : Env) -> !Val {
        depth = depth + 1
        if (depth > 2000) {
            depth = depth - 1
            fail "调用层级超过 2000 层，多半是无限递归"
        }
        var out = vNull()
        var sig = ""
        try {
            blk(f.body, env)!!
        } catch (e : string) {
            if (signalKind(e) == "R") { out = retVal } else { sig = e }
        }
        depth = depth - 1
        if (sig.length() > 0) { fail sig }
        rtn out
    }

    public fun evCall(n : Node, env : Env) -> !Val {
        var args = evalArgs(kid(n, 0), env)!!
        rtn invokeCall(attr(n, "name"), args, env)!!
    }

    public fun isBuiltinName(nm : string) -> bool {
        if (nm == "toByte" || nm == "toChar" || nm == "charToInt") { rtn true }
        if (nm == "intToString" || nm == "parseInt") { rtn true }
        if (nm == "isDigit" || nm == "isLetter" || nm == "isWhitespace") { rtn true }
        if (nm == "toUpper" || nm == "toLower") { rtn true }
        if (nm == "readText" || nm == "writeText") { rtn true }
        if (nm == "readBytes" || nm == "writeBytes") { rtn true }
        rtn false
    }

    // 可能失败的内置函数（`?:` 要按这个判断「左边这次调用自己会不会失败」）
    public fun isErrorBuiltin(nm : string) -> bool {
        if (nm == "parseInt") { rtn true }
        if (nm == "readText" || nm == "readBytes") { rtn true }
        if (nm == "writeText" || nm == "writeBytes") { rtn true }
        rtn false
    }

    // JVM 互操作里可以被当成「类名」用的名字
    public fun isInteropClassName(nm : string) -> bool {
        if (nm == "System" || nm == "File") { rtn true }
        if (nm == "ArrayList") { rtn true }
        rtn false
    }

    // `readBytes` 给回来的是 rsf 的 `byte[]`，解释器里用「元素类型是 byte 的数组」接住
    public fun bytesToArray(raw : byte[]) -> Arr {
        var a = new Arr(1)
        a.elemType = "byte"
        a.es = new Val[raw.length]
        var i = 0
        while (i < raw.length) {
            a.es[i] = vByte(raw[i])
            i = i + 1
        }
        rtn a
    }

    public fun arrayToBytes(a : Arr) -> byte[] {
        var raw : byte[] = new byte[a.es.length]
        var i = 0
        while (i < a.es.length) {
            raw[i] = toByte(intOf(a.es[i]))
            i = i + 1
        }
        rtn raw
    }

    public fun callBuiltin(nm : string, args : Val[]) -> !Val {
        if (args.length == 0) { fail unsupported("内置函数 '" + nm + "' 没有实参") }
        var a0 = args[0]
        if (nm == "toByte") { rtn vByte(toByte(intOf(a0))) }
        if (nm == "toChar") { rtn vChar(toChar(intOf(a0))) }
        if (nm == "charToInt") { rtn vInt(charToInt(a0.cv)) }
        if (nm == "intToString") { rtn vStr(intToString(intOf(a0))) }
        // parseInt 的失败消息直接由 rsf 自己的内置 parseInt 抛出来，
        // 与 Builtins.parseIntFailure 是同一个格式（两端天然一字不差）
        if (nm == "parseInt") { rtn vInt(parseInt(render(a0)!!)!!) }
        if (nm == "isDigit") { rtn vBool(isDigit(a0.cv)) }
        if (nm == "isLetter") { rtn vBool(isLetter(a0.cv)) }
        if (nm == "isWhitespace") { rtn vBool(isWhitespace(a0.cv)) }
        if (nm == "toUpper") { rtn vChar(toUpper(a0.cv)) }
        if (nm == "toLower") { rtn vChar(toLower(a0.cv)) }
        // 四个文件函数：调的是 rsf **自己**的 readText / writeText / readBytes / writeBytes，
        // 也就是 Kotlin 版解释器 callBuiltin 里同一批 java.nio.file 调用 —— 失败消息天然一字不差
        if (nm == "readText") { rtn vStr(readText(render(a0)!!)!!) }
        if (nm == "readBytes") { rtn vArr(bytesToArray(readBytes(render(a0)!!)!!)) }
        if (nm == "writeText") {
            var failed = false
            var failedMsg = ""
            try {
                writeText(render(a0)!!, render(args[1])!!)
            } catch (w : string) {
                failed = true
                failedMsg = w
            }
            if (failed) { fail failedMsg }
            rtn vNull()
        }
        if (nm == "writeBytes") {
            var failed2 = false
            var failedMsg2 = ""
            try {
                writeBytes(render(a0)!!, arrayToBytes(args[1].av!!))
            } catch (w2 : string) {
                failed2 = true
                failedMsg2 = w2
            }
            if (failed2) { fail failedMsg2 }
            rtn vNull()
        }
        fail unsupported("内置函数 '" + nm + "'")
        rtn vNull()
    }

    public fun invokeCall(nm : string, args : Val[], env : Env) -> !Val {
        if (nm == "print" || nm == "println") {
            if (args.length == 0) {
                if (nm == "println") { println() }
                rtn vNull()
            }
            var text = render(args[0])!!
            if (nm == "println") { println(text) } else { print(text) }
            rtn vNull()
        }
        if (isBuiltinName(nm)) { rtn callBuiltin(nm, args)!! }
        // 省掉 new 的构造写法（`Point(1, 2)`）：类名与函数名不可能重名
        var c = findCls(nm)
        if (c != null) { rtn constructUser(c!!, args)!! }
        // 类里按名字直接调本类方法（隐式 this / 隐式类名）
        var cur = env.curClass()
        if (cur != null) {
            // 阶段 25 K5c：沿**类父链**找（继承来的方法也能直接调），再按运行期真实类虚分派；
            // 个数对不上时退回只按名字找（旧口径，`methodNamed` 不看实参个数）
            var m = methInChain(cur!!.name, nm, args.length)
            if (m == null) { m = cur!!.methodNamed(nm) }
            if (m != null) { rtn invokeInstance(m!!, env.thisObj(), cur!!, args)!! }
            // 阶段 20：本类（或本接口）没有这个成员 —— 沿接口链找带体的默认方法。
            // root 优先取**运行期真实类**（有 this 时），这样默认方法体里的下一次隐式
            // 调用同样是动态分派（对齐 Kotlin `callInterfaceMethod` 的 self.className）。
            var self0 = env.thisObj()
            var root = cur!!.name
            if (self0 != null) { root = self0!!.cls }
            ifaceDefaultScan(root, nm, args.length)
            if (ifaceHitCount > 1) {
                fail "调用 '" + nm + "' 无法确定用哪个默认实现（接口链上有 " + render(vInt(ifaceHitCount))!! + " 个候选）"
            }
            if (ifaceHitCount == 1) {
                var rc = findCls(root)
                if (rc != null) { rtn callFn(ifaceHit!!, self0, rc!!, args)!! }
                rtn callFn(ifaceHit!!, self0, cur!!, args)!!
            }
        }
        var f = findFunc(nm)
        if (f != null) { rtn callFn(f!!, null, null, args)!! }
        fail unsupported("调用 '" + nm + "'（既不是内置函数，也不是本程序里的函数或类）")
        rtn vNull()
    }

    // ------------------------------------------------------------------ 成员访问

    public fun evMember(n : Node, env : Env) -> !Val {
        var recvNode = kid(n, 0)
        var nm = attr(n, "name")
        var isCall = attrBool(n, "call")

        // 阶段 25 K5c：`super.f(实参)` / `super(接口名).f(实参)` —— 接收者语义上是 this，
        // 但**不走虚分派**：裸 super 从本方法**声明类的父类**起沿类链找那一份声明（跳开本类的
        // override），`super(接口名)` 只认那个接口的默认方法。两边都对齐 Kotlin K3 从
        // `model.classModel.superCallOf(expr)` 拿 Checker 预先选定的那一份声明、运行期绝不重查
        // （重查会命中本类的 override → 自我递归）。
        if (recvNode.kind == NodeKind.SUPER) { rtn evSuperMember(n, env)!! }

        // 枚举常量 `TokenKind.IDENT`：接收者是个**枚举名**（不是变量）时才算
        if (!isCall && recvNode.kind == NodeKind.VAR) {
            var rn = attr(recvNode, "name")
            if (env.lookup(rn) == null) {
                var en = findEnum(rn)
                if (en != null) {
                    var got = en!!.valueOf(nm)
                    if (got == null) { fail "枚举 '" + rn + "' 里没有常量 '" + nm + "'" }
                    rtn got!!
                }
            }
        }

        var recv = ev(recvNode, env)!!

        // 数组的 .length 是**属性**（不带括号）
        if (recv.k == Kind.ARRV && !isCall && nm == "length") {
            rtn vInt(recv.av!!.es.length)
        }

        if (!isCall) {
            if (recv.k == Kind.OBJV) {
                var o = recv.ov!!
                if (findCls(o.cls) == null) { fail "17c 解释器：类 '" + o.cls + "' 不在本程序里" }
                // 阶段 25 K5c：字段沿**类父链**找（继承来的字段能直接读）
                var idx = fieldIndexInChain(o.cls, nm)
                if (idx < 0) { fail "类 '" + o.cls + "' 里没有字段 '" + nm + "'" }
                rtn o.fs[idx]
            }
            fail unsupported("成员访问 " + ("" + recv.k) + "." + nm)
        }

        var args = evalArgs(kid(n, 1), env)!!
        rtn invokeMember(recv, nm, args, env)!!
    }

    // `super.f(...)` / `super(接口名).f(...)`：**非虚**地跑指定的一份声明。
    // 裸 super 的 target 是字面量 "-"（Parser.rsf:2365/2374），其余是接口名。
    public fun evSuperMember(n : Node, env : Env) -> !Val {
        var sup = kid(n, 0)
        var nm = attr(n, "name")
        var starget = attr(sup, "target")
        var args = evalArgs(kid(n, 1), env)!!
        var self = env.thisObj()
        if (self == null) { fail "K5c：super 只能用在类的方法或构造器里（这里没有 this）" }
        if (starget.length() > 0 && starget != "-") {
            var iname = baseTypeName(starget)
            var sif = findIface(iname)
            if (sif == null) {
                fail "K5c：super(" + starget + ")：" + starget + " 不是本程序里的接口（super 括号里只能写接口名）"
            }
            var sm = sif!!.defaultNamed(nm, args.length)
            if (sm == null) { sm = sif!!.anyNamed(nm, args.length) }
            if (sm == null) {
                fail "K5c：接口 " + starget + " 里没有方法 " + nm + "()（" + intToString(args.length) + " 个参数）"
            }
            // 非虚：只跑这一个接口的这一份默认方法体（K3 callInterfaceMethod 的静态那一支）
            rtn callFn(sm!!, self, sif!!, args)!!
        }
        // 裸 super：从**声明本方法的类**的父类起找（跳开本类的 override）
        var dc = env.declClass()
        if (dc == null) { fail "K5c：super." + nm + "() 出现在类的方法之外（找不到当前方法声明在哪个类）" }
        if (!dc!!.hasBase) { fail "K5c：super." + nm + "()：类 '" + dc!!.name + "' 没有父类" }
        var m = methInChain(dc!!.baseName, nm, args.length)
        if (m == null) {
            fail "K5c：父类没有方法 " + nm + "()（" + intToString(args.length) + " 个参数）"
        }
        var owner = methOwnerInChain(dc!!.baseName, nm, args.length)
        if (owner == null) { rtn callFn(m!!, self, dc!!, args)!! }
        rtn callFn(m!!, self, owner!!, args)!!
    }

    public fun invokeMember(recv : Val, nm : string, args : Val[], env : Env) -> !Val {
        if (recv.k == Kind.STRV) { rtn stringMember(recv.sv, nm, args)!! }
        if (recv.k == Kind.LISTV) { rtn listMember(recv.lsv!!, nm, args, env)!! }
        if (recv.k == Kind.CTYPEV) { rtn staticMember(recv.cname, nm, args, env)!! }
        if (recv.k == Kind.OBJV) { rtn objMember(recv.ov!!, nm, args, env)!! }
        if (recv.k == Kind.FILEV) { rtn fileMember(recv.sv, nm, args)!! }
        fail unsupported("成员方法 " + ("" + recv.k) + "." + nm + "()")
        rtn vNull()
    }

    // java.io.File 的替身（只做 files.rsf 用到的那几个）
    public fun fileMember(path : string, nm : string, args : Val[]) -> !Val {
        if (nm == "getAbsolutePath") { rtn vStr(fileAbsolutePath(path)) }
        if (nm == "getPath") { rtn vStr(path) }
        if (nm == "getName") { rtn vStr(fileBaseName(path)) }
        if (nm == "delete") { rtn vBool(fileDeletePath(path)) }
        if (nm == "exists") { rtn vBool(fileExistsPath(path)) }
        fail unsupported("java.io.File 的方法 '" + nm + "'")
        rtn vNull()
    }

    // string 的三个方法（length / charAt / substring）在 Kotlin 版里走 JVM 反射，
    // 这里直接实现；多出来的几个（contains 之类）是为了 files.rsf 那类程序。
    public fun stringMember(s : string, nm : string, args : Val[]) -> !Val {
        if (nm == "length") { rtn vInt(s.length()) }
        if (nm == "charAt") { rtn vChar(s.charAt(intOf(args[0]))) }
        if (nm == "substring") { rtn vStr(s.substring(intOf(args[0]), intOf(args[1]))) }
        if (nm == "isEmpty") { rtn vBool(s.length() == 0) }
        if (nm == "contains") { rtn vBool(indexOfTextIn(s, render(args[0])!!) >= 0) }
        if (nm == "equals") { rtn vBool(s == render(args[0])!!) }
        if (nm == "startsWith") { rtn vBool(indexOfTextIn(s, render(args[0])!!) == 0) }
        if (nm == "endsWith") {
            var tail = render(args[0])!!
            if (tail.length() > s.length()) { rtn vBool(false) }
            rtn vBool(s.substring(s.length() - tail.length(), s.length()) == tail)
        }
        fail unsupported("string 的方法 '" + nm + "'")
        rtn vNull()
    }

    public fun listMember(l : JList, nm : string, args : Val[], env : Env) -> !Val {
        if (nm == "size") { rtn vInt(l.n) }
        if (nm == "isEmpty") { rtn vBool(l.n == 0) }
        if (nm == "clear") {
            l.n = 0
            rtn vNull()
        }
        if (nm == "add") {
            l.es = growVal(l.es, l.n, args[0])
            l.n = l.n + 1
            rtn vBool(true)
        }
        if (nm == "get") {
            var i = intOf(args[0])
            checkIndex(l.n, i)!!
            rtn l.es[i]
        }
        if (nm == "set") {
            var i = intOf(args[0])
            checkIndex(l.n, i)!!
            var old = l.es[i]
            l.es[i] = args[1]
            rtn old
        }
        if (nm == "remove") {
            var i = intOf(args[0])
            checkIndex(l.n, i)!!
            var old = l.es[i]
            var k = i
            while (k < l.n - 1) {
                l.es[k] = l.es[k + 1]
                k = k + 1
            }
            l.n = l.n - 1
            rtn old
        }
        if (nm == "contains") {
            var k = 0
            while (k < l.n) {
                if (valuesEqual(l.es[k], args[0])) { rtn vBool(true) }
                k = k + 1
            }
            rtn vBool(false)
        }
        if (nm == "indexOf") {
            var k = 0
            while (k < l.n) {
                if (valuesEqual(l.es[k], args[0])) { rtn vInt(k) }
                k = k + 1
            }
            rtn vInt(-1)
        }
        fail unsupported("ArrayList 的方法 '" + nm + "'")
        rtn vNull()
    }

    public fun objMember(o : Obj, nm : string, args : Val[], env : Env) -> !Val {
        var c = findCls(o.cls)
        if (c == null) { fail "17c 解释器：类 '" + o.cls + "' 不在本程序里" }
        // 阶段 25 K5c：先沿**类父链**找（继承来的方法也要能调），再按运行期真实类虚分派。
        // 个数对不上时退回只按名字找（旧口径）
        var m = methInChain(o.cls, nm, args.length)
        if (m == null) { m = c!!.methodNamed(nm) }
        if (m != null) { rtn invokeInstance(m!!, o, c!!, args)!! }
        // 阶段 21：注解对象的**元素访问器** `m.value()`。运行期是伴生类的对象，静态类型
        // 却是注解接口，所以这份访问器是**非虚**的：查到元素字段直接返回字段值。
        // 与 Kotlin `annotationElementCall`（Interpreter.kt:1132-1136）同口径 ——
        // 排在接口默认方法之前（注解接口不进 `interfaces` 表，走不到虚分派那条路）。
        if (c!!.isAnn) {
            var fi = c!!.fieldIndex(nm)
            if (fi >= 0 && fi < c!!.elemCount && args.length == 0) { rtn o.fs[fi] }
        }
        // 阶段 20：运行期真实类自己没有这个成员 —— 沿接口链找带体的默认方法。
        // `this` 与**帧的类**都用运行期真实类（对齐 Kotlin `callMethod(self.className, decl, self, args)`），
        // 这样默认方法体里的隐式调用经 `env.curClass()` 拿到的是实现类，动态分派才对。
        ifaceDefaultScan(o.cls, nm, args.length)
        if (ifaceHitCount > 1) {
            fail "调用 '" + nm + "' 无法确定用哪个默认实现（接口链上有 " + render(vInt(ifaceHitCount))!! + " 个候选）"
        }
        if (ifaceHitCount == 1) { rtn callFn(ifaceHit!!, o, c!!, args)!! }
        // 阶段 25 K5c（K4b 口径的 Object 方法族）：用户类**没有 JDK 父链**，所以
        // `toString()` / `equals(x)` / `hashCode()` / `getClass()` 这几条 rsf 自己的语义
        // 兜在这里（Kotlin `rsfObjectFamily`，Interpreter.kt:896-913）。
        var fam = objectFamily(o, nm, args)!!
        if (fam.k != Kind.NULLV) { rtn fam }
        fail "类 '" + o.cls + "' 里没有方法 '" + nm + "'"
        rtn vNull()
    }

    // K4b 的 Object 方法族。**绝不放宽**：`hashCode()` 在 Kotlin 一侧给的是
    // `System.identityHashCode`（每次运行都不同），自举解释器复现不了那个值 —— 与其
    // 对拍时静默分叉，不如响亮报错；`getClass()` 在 K4b 就是明着抛的。
    // 这一族也不许经 JDK 父链漏进用户类：用户类想覆盖就必须自己写同名方法
    // （那时候 `methInChain` 先命中，走不到这里）。
    // 返回 `!Val`：这一族**可能失败**（hashCode/getClass 响亮报错）。命中给值，
    // 没命中给 `vNull()`（这一族没有一个方法会返回真 null，所以哨兵没有歧义）。
    fun objectFamily(o : Obj, nm : string, args : Val[]) -> !Val {
        if (args.length == 0 && nm == "toString") { rtn vStr(renderObj(o)!!) }
        if (args.length == 1 && nm == "equals") {
            if (args[0].k != Kind.OBJV) { rtn vBool(false) }
            rtn vBool(args[0].ov!! == o)
        }
        if (args.length == 0 && nm == "hashCode") {
            fail "K5c：'hashCode()' 在自举解释器里做不到与 Kotlin 一侧逐字节一致（那边给的是 System.identityHashCode，每次运行都不同）"
        }
        if (args.length == 0 && nm == "getClass") {
            fail "K5c：'getClass()' —— rsf 的用户类在解释器里没有真实的 Class 对象（K4b 口径，两端拿不到同一个 Class）"
        }
        rtn vNull()
    }

    public fun staticMember(clsName : string, nm : string, args : Val[], env : Env) -> !Val {
        var c = findCls(clsName)
        if (c != null) {
            var m = c!!.methodNamed(nm)
            if (m == null) { fail "类 '" + clsName + "' 里没有静态方法 '" + nm + "'" }
            rtn callFn(m!!, null, c!!, args)!!
        }
        // JVM 静态互操作：目前只做 files.rsf 用得到的 System.getProperty
        if (clsName == "System" && nm == "getProperty") {
            var key = render(args[0])!!
            var got : ?string = System.getProperty(key)
            if (got == null) { rtn vNull() }
            rtn vStr(got!!)
        }
        fail unsupported("JVM 静态方法 " + clsName + "." + nm + "()")
        rtn vNull()
    }

    // ------------------------------------------------------------------ `?:`

    // 左边这次调用「自己可能失败」吗？（!T 函数 / !T 方法 / parseInt）
    fun isErrorCapable(ln : Node, env : Env) -> bool {
        if (ln.kind == NodeKind.CALL) {
            var nm = attr(ln, "name")
            if (isErrorBuiltin(nm)) { rtn true }
            var f = findFunc(nm)
            if (f != null && f!!.mayError) { rtn true }
            var cur = env.curClass()
            if (cur != null) {
                // 阶段 25 K5c：沿类父链按名字找（继承来的方法可能是 mayError 的）
                var m = anyMethInChain(cur!!.name, nm)
                if (m != null && m!!.mayError) { rtn true }
            }
            rtn false
        }
        if (ln.kind == NodeKind.MEMBER && attrBool(ln, "call")) {
            var nm = attr(ln, "name")
            var i = 0
            while (i < ccount) {
                var m = classes[i].methodNamed(nm)
                if (m != null && m!!.mayError) { rtn true }
                i = i + 1
            }
            // 阶段 20：接口里的方法也要算（默认方法可能是 `!T`）
            var j = 0
            while (j < icount) {
                var im = ifcs[j].methodNamed(nm)
                if (im != null && im!!.mayError) { rtn true }
                j = j + 1
            }
            rtn false
        }
        rtn false
    }

    // 只把**目标调用本身**包进保护范围：实参求值时的失败要继续往外传
    // （Kotlin 版那边靠 failure.frames 的第一个是不是目标函数来区分，效果相同）。
    // 接住了就返回哨兵 caughtVal。
    public fun tryCallProtected(ln : Node, env : Env) -> !Val {
        if (ln.kind == NodeKind.MEMBER) {
            var recv = ev(kid(ln, 0), env)!!
            var args = evalArgs(kid(ln, 1), env)!!
            var got = vNull()
            var bad = false
            try {
                got = invokeMember(recv, attr(ln, "name"), args, env)!!
            } catch (e : string) {
                if (isSignal(e)) { fail e }
                bad = true
            }
            if (bad) { rtn caughtVal }
            rtn got
        }
        var args2 = evalArgs(kid(ln, 0), env)!!
        var got2 = vNull()
        var bad2 = false
        try {
            got2 = invokeCall(attr(ln, "name"), args2, env)!!
        } catch (e2 : string) {
            if (isSignal(e2)) { fail e2 }
            bad2 = true
        }
        if (bad2) { rtn caughtVal }
        rtn got2
    }

    public fun evElvis(n : Node, env : Env) -> !Val {
        var ln = kid(n, 0)
        var rn = kid(n, 1)
        if (isErrorCapable(ln, env)) {
            var got = tryCallProtected(ln, env)!!
            if (got == caughtVal) { rtn ev(rn, env)!! }
            rtn got
        }
        var l = ev(ln, env)!!
        if (l.k != Kind.NULLV) { rtn l }
        rtn ev(rn, env)!!
    }

    // ==== PART4 ====

    // ------------------------------------------------------------------ 语句
    //
    // 每个 BLOCK 自成一个作用域（和 rsf 的大括号语义一致）；函数体不额外开一层
    // （参数与函数体顶层共用作用域，这一点和 Checker 的口径对齐）。

    public fun blk(b : Node, env : Env) -> !int {
        var pc = 0
        var cnt = b.childCount
        while (pc < cnt) {
            var s = b.children[pc]
            if (s.kind == NodeKind.LABEL) {
                pc = pc + 1
            } else {
                // goto 由**离它最近的、含该标签的块**接住；本块没有就原样往上传
                var jump = -1
                var sig = ""
                try {
                    st(s, env)!!
                } catch (e : string) {
                    if (signalKind(e) == "G") {
                        var idx = labelIndex(b, signalPayload(e))
                        if (idx >= 0) { jump = idx } else { sig = e }
                    } else {
                        sig = e
                    }
                }
                if (sig.length() > 0) { fail sig }
                if (jump >= 0) { pc = jump } else { pc = pc + 1 }
            }
        }
        rtn 0
    }

    fun labelIndex(b : Node, nm : string) -> int {
        var i = 0
        while (i < b.childCount) {
            var s = b.children[i]
            if (s.kind == NodeKind.LABEL && attr(s, "name") == nm) { rtn i }
            i = i + 1
        }
        rtn -1
    }

    public fun st(n : Node, env : Env) -> !int {
        switch (n.kind) {
            NodeKind.BLOCK : rtn blk(n, new Env(env))!!
            NodeKind.VAR_DECL : rtn stVarDecl(n, env)!!
            NodeKind.ASSIGN : rtn stAssign(n, env)!!
            NodeKind.MEMBER_ASSIGN : rtn stMemberAssign(n, env)!!
            NodeKind.INDEX_ASSIGN : rtn stIndexAssign(n, env)!!
            NodeKind.RETURN : rtn stReturn(n, env)!!
            NodeKind.EXPR_STMT : rtn stExpr(n, env)!!
            NodeKind.LABEL : rtn 0
            NodeKind.THIS_CALL : rtn stThisCall(n, env)!!
            // 阶段 25 K5c：`super(实参)` 走到这里是**空操作** —— 父类那一串构造器早由
            // `runCtor` 在本构造体开跑**之前**铺完了（K3 把 ISuperDelegate 变成 pc++ 是同一条理由）
            NodeKind.SUPER_CALL : rtn 0
            NodeKind.SWITCH : rtn stSwitch(n, env)!!
            NodeKind.GOTO : rtn stGoto(n)!!
            NodeKind.IF : rtn stIf(n, env)!!
            NodeKind.WHILE : rtn stWhile(n, env)!!
            NodeKind.FOR : rtn stFor(n, env)!!
            NodeKind.BREAK : rtn stBreak()!!
            NodeKind.CONTINUE : rtn stContinue()!!
            NodeKind.FAIL : rtn stFail(n, env)!!
            NodeKind.TRY : rtn stTry(n, env)!!
            else : fail unsupported("语句 " + kindName(n.kind))
        }
        rtn 0
    }

    public fun stVarDecl(n : Node, env : Env) -> !int {
        var v = ev(kid(n, 0), env)!!
        env.define(attr(n, "name"), coerceTo(attr(n, "type"), v))
        rtn 0
    }

    // 裸名字赋值：局部/参数优先，其次才是当前类的字段（与 Checker 的解析顺序一致）
    public fun stAssign(n : Node, env : Env) -> !int {
        var nm = attr(n, "name")
        var v = ev(kid(n, 0), env)!!
        if (env.assign(nm, v)) { rtn 0 }
        var c = env.curClass()
        if (c != null) {
            // 阶段 25 K5c：字段沿**类父链**找（继承来的字段能直接赋值），
            // 归属类决定写对象数组里的哪一段（父类字段在前）
            var fo = fieldOwnerInChain(c!!.name, nm)
            if (fo != null) {
                var o = env.thisObj()
                if (o == null) { fail "17c 解释器：字段 '" + nm + "' 出现在没有 this 的地方" }
                var li = fo!!.fieldIndex(nm)
                o!!.fs[baseOf(fo!!) + li] = coerceTo(fo!!.ftypes[li], v)
                rtn 0
            }
        }
        fail "17c 解释器：赋值给未声明的名字 '" + nm + "'"
        rtn 0
    }

    fun evalReceiverObj(recvNode : Node, env : Env) -> !Obj {
        if (recvNode.kind == NodeKind.THIS) {
            var self = env.thisObj()
            if (self == null) { fail "17c 解释器：这里没有 this" }
            rtn self!!
        }
        var r = ev(recvNode, env)!!
        if (r.k == Kind.OBJV) { rtn r.ov!! }
        fail unsupported("成员赋值的目标不是对象（" + ("" + r.k) + "）")
        rtn new Obj("")
    }

    // `p.x = 1`：接收者先求值，再求右值（和 Kotlin 版一致）
    public fun stMemberAssign(n : Node, env : Env) -> !int {
        var m = kid(n, 0)
        var nm = attr(m, "name")
        var o = evalReceiverObj(kid(m, 0), env)!!
        if (findCls(o.cls) == null) { fail "17c 解释器：类 '" + o.cls + "' 不在本程序里" }
        // 阶段 25 K5c：字段沿类父链找，`coerceTo` 用**声明它的那个类**的类型
        var fo = fieldOwnerInChain(o.cls, nm)
        if (fo == null) { fail "类 '" + o.cls + "' 里没有字段 '" + nm + "'" }
        var li = fo!!.fieldIndex(nm)
        var v = ev(kid(n, 1), env)!!
        o.fs[baseOf(fo!!) + li] = coerceTo(fo!!.ftypes[li], v)
        rtn 0
    }

    // `a[i] = v`：求值顺序 = 接收者 → 下标 → **越界检查** → 右值。
    // 右值放在检查之后，越界时它里面的副作用一次都不会发生（两端输出才不会分叉）。
    public fun stIndexAssign(n : Node, env : Env) -> !int {
        var ix = kid(n, 0)
        var a = ev(kid(ix, 0), env)!!
        var iv = ev(kid(ix, 1), env)!!
        if (a.k != Kind.ARRV) { fail unsupported("下标赋值用在非数组上") }
        var arr = a.av!!
        var idx = intOf(iv)
        checkIndex(arr.es.length, idx)!!
        var v = ev(kid(n, 1), env)!!
        arr.es[idx] = coerceTo(arr.elemType, v)
        rtn 0
    }

    public fun stReturn(n : Node, env : Env) -> !int {
        var v = vNull()
        if (attrBool(n, "hasValue") && n.childCount > 0) {
            v = ev(n.children[0], env)!!
        }
        retVal = v
        fail makeSignal("R", "")
        rtn 0
    }

    public fun stExpr(n : Node, env : Env) -> !int {
        ev(kid(n, 0), env)!!
        rtn 0
    }

    public fun stGoto(n : Node) -> !int {
        fail makeSignal("G", attr(n, "label"))
        rtn 0
    }

    public fun stBreak() -> !int {
        fail makeSignal("B", "")
        rtn 0
    }

    public fun stContinue() -> !int {
        fail makeSignal("C", "")
        rtn 0
    }

    public fun stFail(n : Node, env : Env) -> !int {
        var v = ev(kid(n, 0), env)!!
        fail render(v)!!
        rtn 0
    }

    public fun stIf(n : Node, env : Env) -> !int {
        if (truth(ev(kid(n, 0), env)!!)!!) { rtn blk(kid(n, 1), new Env(env))!! }
        if (n.childCount > 2) { rtn blk(kid(n, 2), new Env(env))!! }
        rtn 0
    }

    public fun stWhile(n : Node, env : Env) -> !int {
        var cond = kid(n, 0)
        var bodyNode = kid(n, 1)
        while (true) {
            if (!truth(ev(cond, env)!!)!!) { rtn 0 }
            var brk = false
            var sig = ""
            try {
                blk(bodyNode, new Env(env))!!
            } catch (e : string) {
                var sk = signalKind(e)
                if (sk == "B") { brk = true }
                else if (sk == "C") { }
                else { sig = e }
            }
            if (sig.length() > 0) { fail sig }
            if (brk) { rtn 0 }
        }
        rtn 0
    }

    // `for`：孩子按「条件? 更新? 体」排列（有没有靠 hasCond / hasStep 说）。
    // `continue` 在 for 里要**把更新跑一遍**再进下一轮（while 里直接进下一轮），
    // 这是两种循环在降级后唯一的行为差别。
    public fun stFor(n : Node, env : Env) -> !int {
        var hasCond = attrBool(n, "hasCond")
        var hasStep = attrBool(n, "hasStep")
        var idx = 0
        var condNode = kid(n, 0)
        if (hasCond) {
            condNode = kid(n, idx)
            idx = idx + 1
        }
        var stepNode = kid(n, 0)
        if (hasStep) {
            stepNode = kid(n, idx)
            idx = idx + 1
        }
        var bodyNode = kid(n, idx)
        while (true) {
            if (hasCond) {
                if (!truth(ev(condNode, env)!!)!!) { rtn 0 }
            }
            var brk = false
            var sig = ""
            try {
                blk(bodyNode, new Env(env))!!
            } catch (e : string) {
                var sk = signalKind(e)
                if (sk == "B") { brk = true }
                else if (sk == "C") { }
                else { sig = e }
            }
            if (sig.length() > 0) { fail sig }
            if (brk) { rtn 0 }
            if (hasStep) { st(stepNode, env)!! }
        }
        rtn 0
    }

    // `switch`：被分派的值只求一次，按声明顺序跟枚举常量比**引用相等**
    // （枚举值是单例，见 Enm.valueOf），一个都没命中就走 else；没写 else 且穷尽时
    // 唯一到得了这里的只有 null——消息与 Kotlin 版一字不差。
    public fun stSwitch(n : Node, env : Env) -> !int {
        var subject = ev(kid(n, 0), env)!!
        var cases = kid(n, 1)
        var i = 0
        while (i < cases.childCount) {
            var cnode = cases.children[i]
            var en = findEnum(attr(cnode, "enum"))
            if (en != null) {
                var want = en!!.valueOf(attr(cnode, "value"))
                if (want != null) {
                    if (subject == want!!) { rtn blk(kid(cnode, 0), new Env(env))!! }
                }
            }
            i = i + 1
        }
        if (attrBool(n, "hasElse")) { rtn blk(kid(n, 2), new Env(env))!! }
        var enumName = ""
        if (cases.childCount > 0) { enumName = attr(cases.children[0], "enum") }
        fail switchNoMatchFailure(enumName)
        rtn 0
    }

    // `try` / `catch`：接住的**只有真错误**，控制流信号一律原样往上传
    // （否则 `try { rtn 5 } catch ...` 会把 return 吃掉）
    public fun stTry(n : Node, env : Env) -> !int {
        var sig = ""
        var bad = false
        var msg = ""
        try {
            blk(kid(n, 0), new Env(env))!!
        } catch (e : string) {
            if (isSignal(e)) {
                sig = e
            } else {
                bad = true
                msg = e
            }
        }
        if (sig.length() > 0) { fail sig }
        if (bad) {
            var catchEnv = new Env(env)
            catchEnv.define(attr(n, "catch"), vStr(msg))
            rtn blk(kid(n, 1), catchEnv)!!
        }
        rtn 0
    }

    public fun stThisCall(n : Node, env : Env) -> !int {
        var c = env.curClass()
        var o = env.thisObj()
        if (c == null || o == null) { fail "17c 解释器：this(...) 不在构造器里" }
        var args = evalArgs(kid(n, 0), env)!!
        var target = pickCtor(c!!, args)
        if (target == null) { fail "17c 解释器：this(...) 找不到匹配的构造器" }
        rtn runCtor(c!!, target!!, o!!, args)!!
    }

    // ------------------------------------------------------------------ 入口

    public fun runMain() -> !int {
        var m = findFunc("main")
        if (m == null) { fail "找不到入口函数：需要 fun main() -> void { ... }" }
        if (m!!.pcount != 0) {
            fail "入口函数 main 不能有参数：JVM 只认 main(String[])，rsf 里也没有地方给它传参"
        }
        callFn(m!!, null, null, new Val[0])!!
        rtn 0
    }
}

// ================================================================ 对外接口

// 跑一份源码：rsf 版 lex → rsf 版 parse → 遍历执行。
// 解析失败时 `fail`（和 Kotlin 版 `rsf run` 遇错抛 RsfError 是同一条路）。
//
// 返回 `!int`（恒 0）而不是 `!void`：rsf 的 `!void` 写不出 `!!`，调用点会很难看。
public fun runSource(source : string) -> !int {
    var ast = parseSource(source)
    if (ast.kind == NodeKind.ERROR) {
        fail "解析失败：" + attr(ast, "message")
    }
    var it = new Interp(ast)
    it.load()
    // 阶段 25 K5c：装载后的静态检查（JDK 父类 / 抽象成员漏实现）—— 响亮报错，不静默降级
    it.validate()!!
    it.runMain()!!
    rtn 0
}

// 已经有树时直接跑（测试与入口都用得上：一次解析、多次跑）
public fun runProgram(ast : Node) -> !int {
    if (ast.kind == NodeKind.ERROR) {
        fail "解析失败：" + attr(ast, "message")
    }
    var it = new Interp(ast)
    it.load()
    it.validate()!!
    it.runMain()!!
    rtn 0
}
