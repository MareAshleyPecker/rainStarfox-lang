#NoWarning!!(all)
// rainStarfox 阶段 36c：自举驱动的 `run` 子命令（对齐 Kotlin `rsf run`：成功时只打程序自己的 stdout）
//
// 跑：rsf build rsfSrc/bootstrap/RsfcRun.rsf -o build/verify36/self
//     java -Drsf.rsfc.file=<源.rsf> -cp "build/verify36/self;<jar>" RsfcRun

import "Interp.rsf"
import "Sources.rsf"
import "Warn.rsf"

import java.lang.System

fn pickRunFile() -> String {
    var given : ?String = System.getProperty("rsf.rsfc.file")
    if (given == null) {
        System.err.println("usage: java -Drsf.rsfc.file=<源.rsf> -cp <out>;<jar> RsfcRun")
        System.exit(2)
        rtn ""
    }
    rtn given!!
}

fn baseNameOfPath(path : String) -> String {
    var i = path.length() - 1
    while (i >= 0) {
        var c = path.charAt(i)
        if (c == '/' || c == '\\') { rtn path.substring(i + 1, path.length()) }
        i = i - 1
    }
    rtn path
}

fn main() -> void {
    var path = pickRunFile()
    // `loadProgram` 失败：`?: null` 折成 null，再把消息从 lastErrorMessage() 取回来
    var maybeAst = loadProgram(path) ?: null
    if (maybeAst == null) {
        var message = lastErrorMessage()
        if (message.startsWith("读不到文件：")) {
            System.err.println(message)
        } else {
            System.err.println("运行期错误: " + message)
        }
        System.exit(1)
        rtn
    }
    var ast = maybeAst!!
    var ws = new WarnSink()
    ws.printWarnings(ast, path)
    runProgram(ast) ?: reportRuntimeFailure()
    rtn
}

// 运行期失败统一出口（与 Kotlin 版 Main.kt 的「运行期错误: …」逐字一致）
fn reportRuntimeFailure() -> void {
    var e = lastErrorMessage()
    if (isSignal(e) && signalKind(e) == "X") {
        System.err.println("运行期错误: " + signalPayload(e))
    } else if (isSignal(e)) {
        System.err.println("运行期错误: 内部信号 " + signalKind(e) + " 没有被接住")
    } else {
        System.err.println("运行期错误: " + e)
    }
    System.exit(1)
}
