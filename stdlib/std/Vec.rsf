// 阶段 40：核心标准库 · 动态数组 Vec<T>
//
// 口径：只用两端（Kotlin 编译器 / 自举链）都认的语法，不依赖 JDK 集合。
// 容量按 2 倍增长；`T[]` 在 JVM 上擦成 `Object[]`，所以元素只能是引用类型或自动装箱的基本类型。
pub class Vec&<T> {
    var items : T[] = new T[4]
    var n : Int = 0

    pub fn size() -> Int { rtn n }

    pub fn isEmpty() -> Bool { rtn n == 0 }

    pub fn get(i : Int) -> T { rtn items[i] }

    pub fn set(i : Int, x : T) -> void { items[i] = x }

    pub fn push(x : T) -> void {
        if (n == items.length) { grow() }
        items[n] = x
        n = n + 1
    }

    // 弹出最后一个；空表时返回 null 由调用方自己判
    pub fn pop() -> ?T {
        if (n == 0) { rtn null }
        n = n - 1
        var v : ?T = items[n]
        rtn v
    }

    pub fn last() -> ?T {
        if (n == 0) { rtn null }
        rtn items[n - 1]
    }

    pub fn clear() -> void { n = 0 }

    pub fn indexOf(x : T) -> Int {
        var i = 0
        while (i < n) {
            if (items[i] == x) { rtn i }
            i = i + 1
        }
        rtn -1
    }

    pub fn contains(x : T) -> Bool { rtn indexOf(x) >= 0 }

    // 把 [from, n) 段左移一格删掉下标 i
    pub fn removeAt(i : Int) -> void {
        if (i < 0 || i >= n) { rtn }
        var k = i
        while (k + 1 < n) {
            items[k] = items[k + 1]
            k = k + 1
        }
        n = n - 1
    }

    pub fn grow() -> void {
        var bigger : T[] = new T[items.length * 2]
        var i = 0
        while (i < n) {
            bigger[i] = items[i]
            i = i + 1
        }
        items = bigger
    }

    // 只读快照：**数组由调用方给**。
    //
    // 不能自己 `new T[n]`：`T[]` 在 JVM 上擦成 `Object[]`，返回给 `String[]` 之类的
    // 变量会在赋值处抛 ClassCastException（`[Ljava.lang.Object; cannot be cast to [Ljava.lang.String;`）。
    // 让调用方传数组，运行时类型就由调用点决定，这正是 Java `toArray(T[])` 的做法。
    //
    //     var arr : String[] = v.copyInto(new String[v.size()])
    pub fn copyInto(into : T[]) -> T[] {
        var i = 0
        while (i < n) {
            into[i] = items[i]
            i = i + 1
        }
        rtn into
    }
}
