// rsf 标准库：io（输入输出）
//
// 现在底下是内置函数（readText / writeText / readBytes / writeBytes / println），
// 这一层给它们起好用的名字，并把"打不开/写不进"这类失败统一成 `!` 形式——
// 以后换成自己的运行时时，只要保持这些签名，用户代码不用改。

/// 读整个文本文件（UTF-8）。失败时 `!String`（调用方要处理）。
fn readAllText(path : String) -> !String {
    rtn readText(path)
}

/// 写整个文本文件（覆盖）。失败时 `!void`。
fn writeAllText(path : String, text : String) -> !void {
    rtn writeText(path, text)
}

/// 读整个二进制文件。失败时 `!Byte[]`。
fn readAllBytes(path : String) -> !Byte[] {
    rtn readBytes(path)
}

/// 写整个二进制文件（覆盖）。失败时 `!void`。
fn writeAllBytes(path : String, data : Byte[]) -> !void {
    rtn writeBytes(path, data)
}

/// 打印整数并换行。
fn printlnInt(value : Int) -> void {
    println(intToString(value))
}
