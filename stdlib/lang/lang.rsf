// rsf 标准库：lang（语言级小工具）
//
// 全部用内置函数与现有语法写，不依赖任何外部东西；这些是最常被复制粘贴的几段。

/// 空串或全是空白。
fn isBlank(text : String) -> Bool {
    var i = 0
    while (i < text.length()) {
        if (!isWhitespace(text.charAt(i))) {
            rtn false
        }
        i = i + 1
    }
    rtn true
}

/// 把 [text] 重复 [count] 次（count <= 0 时给空串）。
fn repeat(text : String, count : Int) -> String {
    var out = ""
    var i = 0
    while (i < count) {
        out = out + text
        i = i + 1
    }
    rtn out
}

/// 用分隔符把若干段拼起来（空数组给空串）。
fn join(parts : String[], sep : String) -> String {
    var out = ""
    var i = 0
    while (i < parts.length) {
        if (i > 0) {
            out = out + sep
        }
        out = out + parts[i]
        i = i + 1
    }
    rtn out
}

/// 解析整数，失败给 [fallback]（等价于 parseInt(s) ?: fallback）。
fn parseIntOr(text : String, fallback : Int) -> Int {
    rtn parseInt(text) ?: fallback
}

/// 左边补齐到 [width] 个字符（用空格）。
fn padLeft(text : String, width : Int) -> String {
    if (text.length() >= width) {
        rtn text
    }
    rtn repeat(" ", width - text.length()) + text
}
