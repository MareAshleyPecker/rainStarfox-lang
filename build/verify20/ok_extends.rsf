pub interface Base {
    fn id() -> int
}

pub interface Named : Base {
    fn name() -> string
}

class Dog : Named {
    pub fn id() -> int {
        rtn 7
    }
    pub fn name() -> string {
        rtn "rex"
    }
}

fn main() -> void {
    var d : Named = new Dog()
    println(intToString(d.id()) + "/" + d.name())
    rtn
}
