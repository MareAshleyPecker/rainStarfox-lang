pub interface Greeter {
    fn greet() -> string
}

class Dog : Greeter {
    pub fn greet() -> string {
        rtn "woof"
    }
}

fn hello(g : Greeter) -> string {
    rtn g.greet()
}

fn must() -> !Greeter {
    rtn new Dog()
}

fn main() -> void {
    println(hello(new Dog()))
    var g : Greeter = must() ?: new Dog()
    println(g.greet())
    rtn
}
