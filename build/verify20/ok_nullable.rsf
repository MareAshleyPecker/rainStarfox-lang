public interface Greeter {
    fn greet() -> string
}

class Dog : Greeter {
    public fn greet() -> string {
        rtn "woof"
    }
}

fn pick(flag : bool) -> ?Greeter {
    if (flag) {
        rtn new Dog()
    }
    rtn null
}

fn main() -> void {
    var g : ?Greeter = pick(true)
    println((g ?: new Dog()).greet())
    var h : ?Greeter = pick(false)
    println((h ?: new Dog()).greet())
    rtn
}
