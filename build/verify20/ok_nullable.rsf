public interface Greeter {
    fun greet() -> string
}

class Dog : Greeter {
    public fun greet() -> string {
        rtn "woof"
    }
}

fun pick(flag : bool) -> ?Greeter {
    if (flag) {
        rtn new Dog()
    }
    rtn null
}

fun main() -> void {
    var g : ?Greeter = pick(true)
    println((g ?: new Dog()).greet())
    var h : ?Greeter = pick(false)
    println((h ?: new Dog()).greet())
    rtn
}
