pub interface Greeter {
    fn greet(name : string) -> string
    fn shout(name : string) -> string {
        rtn greet(name) + "!"
    }
}

class Dog(name : string) : Greeter {
    override pub fn greet(n : string) -> string {
        rtn "woof " + n
    }
}

fn main() -> void {
    var g : Greeter = new Dog("rex")
    println(g.greet("bob"))
    println(g.shout("bob"))
    rtn
}
