fn writeQuiet(path : String) -> !void {
    try writeText(path, "hi")      // !void 直接传播
}

fn readQuiet(path : String) -> !String {
    try readText(path)             // 语句形式：丢弃值
    rtn readText(path)!!
}

fn main() -> void {
    try {
        try writeQuiet("out.txt")
        println(readQuiet("out.txt")!!)
    } catch err {
        println("IO 失败: " + err)
    }
    // catch 不要绑定
    try {
        parseInt("abc")!!
    } catch {
        println("解析失败（不关心原因）")
    }
    // catch e 不写类型
    try {
        parseInt("x")!!
    } catch err {
        println("捕获: " + err)
    }
}
