class Calc {
    var base : int = 0

    constructor(b : int) {
        base = b
    }

    public fn same&<T>(x : T) -> T {
        rtn x
    }

    public static fn pick&<T>(x : T, y : T) -> T {
        rtn x
    }
}

fn main() {
    var c : Calc = new Calc(3)
    println("" + c.same(11))
    println(c.same("m"))
    println("" + Calc.pick(1, 2))
}
