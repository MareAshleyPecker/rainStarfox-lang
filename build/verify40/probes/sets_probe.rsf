import "../../../rsfSrc/core/Sets.rsf"

fn main() -> void {
    var s : Set&<string> = new Set&<string>()
    println("" + s.add("a") + " " + s.add("b") + " " + s.add("a") + " " + s.size())
    println("" + s.contains("b") + " " + s.contains("z") + " " + s.remove("a") + " " + s.remove("a"))
    println("" + s.size() + " " + s.get(0) + " " + s.isEmpty())

    var t : Set&<string> = new Set&<string>()
    t.add("b")
    t.add("c")
    t.add("d")
    var u : Set&<string> = s.unionWith(t)
    var i : Set&<string> = s.intersectWith(t)
    var d : Set&<string> = s.difference(t)
    println("" + u.size() + " " + i.size() + " " + d.size())
    var k = 0
    var line = ""
    while (k < u.size()) {
        line = line + u.get(k)
        k = k + 1
    }
    println(line)
    println("" + s.size() + " " + t.size())

    var nums : Set&<int> = new Set&<int>()
    nums.add(3)
    nums.add(1)
    nums.add(3)
    nums.add(2)
    var sum = 0
    var j = 0
    while (j < nums.size()) {
        sum = sum + nums.get(j)
        j = j + 1
    }
    println("" + nums.size() + " " + sum)
    nums.clear()
    println("" + nums.size() + " " + nums.isEmpty())
}
