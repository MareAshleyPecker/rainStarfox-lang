import "../../../rsfSrc/core/Sorts.rsf"

fn main() -> void {
    var xs = new string[5]
    xs[0] = "pear"
    xs[1] = "apple"
    xs[2] = "fig"
    xs[3] = "banana"
    xs[4] = "apple"
    var sorted = Sorts.strings(xs)
    println(sorted[0] + " " + sorted[1] + " " + sorted[2] + " " + sorted[3] + " " + sorted[4])
    println("" + Sorts.binarySearchStrings(sorted, "fig") + " " + Sorts.binarySearchStrings(sorted, "zzz"))
    println("" + Sorts.compareStrings("abc", "abd") + " " + Sorts.compareStrings("abc", "abc") + " " + Sorts.compareStrings("ab", "abc"))
    var ls = new long[4]
    ls[0] = 9000000000L
    ls[1] = -3L
    ls[2] = 42L
    ls[3] = 0L
    var l = Sorts.longs(ls)
    println("" + l[0] + " " + l[1] + " " + l[2] + " " + l[3])
    println("" + Sorts.binarySearchLongs(l, 9000000000L) + " " + Sorts.binarySearchLongs(l, 7L))
}
