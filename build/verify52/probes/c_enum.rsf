// 阶段 52d：C 后端探针 8 —— 枚举、switch 分派、枚举数组
enum Color { Red, Green, Blue }

fn name(c : Color) -> string {
    switch (c) {
        Color.Red : rtn "red"
        Color.Green : rtn "green"
        else : rtn "other"
    }
}

fn main() -> void {
    var c : Color = Color.Green
    println(name(c))
    println(c == Color.Green)
    var arr : Color[] = new Color[2]
    arr[0] = Color.Blue
    arr[1] = Color.Red
    for (x in arr) { println(name(x)) }
    rtn
}
