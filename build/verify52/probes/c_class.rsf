// 阶段 52c：C 后端探针 6 —— 类、字段、方法、主构造
class Point(x0 : Int, y0 : Int) {
    var x : Int = x0
    var y : Int = y0

    fn sum() -> Int { rtn x + y }

    fn scale(k : Int) -> void {
        x = x * k
        y = y * k
    }

    fn sumTimes(k : Int) -> Int { rtn this.sum() * k }
}

class Counter {
    var n : Int = 0

    fn bump() -> void { n = n + 1 }

    fn get() -> Int { rtn n }
}

fn distance1(p : Point) -> Int {
    rtn p.x + p.y
}

fn main() -> void {
    var p : Point = new Point(3, 4)
    println(p.sum())
    p.scale(2)
    println(p.x)
    println(p.sumTimes(3))
    println(distance1(p))
    var c : Counter = new Counter()
    c.bump()
    c.bump()
    println(c.get())
    rtn
}
