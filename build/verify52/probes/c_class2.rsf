// 阶段 52c：C 后端探针 7 —— 静态方法、次构造、类字段数组
class Box {
    var v : Int = 0

    constructor() { v = 7 }

    constructor(n : Int) { v = n }

    fn get() -> Int { rtn v }

    stc fn twice(x : Int) -> Int { rtn x * 2 }
}

class Bag {
    var xs : Int[] = new Int[3]

    fn put(i : Int, x : Int) -> void { xs[i] = x }

    fn total() -> Int {
        var s : Int = 0
        for (x in xs) { s = s + x }
        rtn s
    }
}

fn main() -> void {
    var a : Box = new Box()
    var b : Box = new Box(5)
    println(a.get())
    println(b.get())
    println(Box.twice(21))
    var bag : Bag = new Bag()
    bag.put(0, 10)
    bag.put(1, 20)
    bag.put(2, 30)
    println(bag.total())
    rtn
}
