class Animal(name : String) {
    var name : String = name

    pub fn speak() -> String {
        rtn "..."
    }

    pub fn describe() -> String {
        rtn name + " says " + this.speak()
    }
}

class Dog(name : String) : Animal(name) {
    pub override fn speak() -> String {
        rtn "woof"
    }
}

class Puppy(name : String) : Dog(name) {
    pub override fn speak() -> String {
        rtn "yip"
    }
}

class Base(x : Int) {
    var x : Int = x

    pub fn value() -> Int {
        rtn x
    }

    pub fn label() -> String {
        rtn "base"
    }
}

class Derived(x : Int, y : Int) : Base(x) {
    var y : Int = y

    pub override fn value() -> Int {
        rtn super.value() + y
    }

    pub override fn label() -> String {
        rtn "derived"
    }

    pub fn sum() -> Int {
        rtn x + y
    }
}

fn twice(n : Int) -> Int {
    rtn n * 2
}

fn main() {
    var a : Animal = new Animal("cat")
    var d : Animal = new Dog("rex")
    var p : Animal = new Puppy("bit")
    println(a.describe())
    println(d.describe())
    println(p.describe())

    var b : Base = new Derived(3, 4)
    println(b.value())
    println(b.label())

    var dd : Derived = new Derived(10, 20)
    println(dd.sum())
    println(twice(dd.value()))
}
