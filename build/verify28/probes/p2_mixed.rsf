// p2：反引号名与普通名混用；前跳、后跳、跳过死代码各一次。
// 期望 stdout：i=0 / i=1 / end
fn main() -> void {
    var i = 0
    goto `跳过`
    println("不该打印 1")
    `跳过`:
    if (i < 2) {
        println("i=" + i)
        i = i + 1
        goto 回跳
    }
    println("end")
    goto 结束
    println("不该打印 2")
    结束:
    rtn
    回跳:
    goto `跳过`
}
