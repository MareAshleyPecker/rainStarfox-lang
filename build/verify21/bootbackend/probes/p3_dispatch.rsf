public interface Sound {
    fn say() -> string
}
class Cat : Sound {
    fn say() -> string {
        rtn "meow"
    }
}
class Cow : Sound {
    fn say() -> string {
        rtn "moo"
    }
}
fn main() -> void {
    var s : Sound = new Cat()
    println(s.say())
    s = new Cow()
    println(s.say())
    rtn
}
