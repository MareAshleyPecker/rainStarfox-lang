public interface A {
    fn v() -> string {
        rtn "A"
    }
}
public interface B : A {
    fn w() -> string {
        rtn v() + "B"
    }
}
class C : B {
    override fn v() -> string {
        rtn "C"
    }
}
fn main() -> void {
    var c : C = new C()
    println(c.v())
    println(c.w())
    var b : B = new C()
    println(b.w())
    var a : A = new C()
    println(a.v())
    rtn
}
