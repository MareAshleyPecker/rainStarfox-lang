fn twice(x : int) -> int {
    rtn x * 2
}

fn main() -> void {
    var s : string = "abc"
    println(s)
    println("len = " + s.length())
    println("upper = " + s.toUpperCase())
    println("char = " + s.charAt(1))
    println("sub = " + s.substring(1, 3))
    println("idx = " + s.indexOf("b"))
    println("has = " + s.contains("bc"))
    println("pre = " + s.startsWith("ab"))
    println("suf = " + s.endsWith("bc"))
    println("empty = " + s.isEmpty())
    println("num = " + intToString(42))
    println("parsed = " + (parseInt("123") ?: 0))
    var cs : string[] = new string[3]
    cs[0] = "one"
    cs[1] = "two"
    println("cs0 = " + cs[0] + " cs1 = " + cs[1] + " cs2 = " + cs[2])
    var xs : int[] = new int[4]
    var i = 0
    while (i < 4) {
        xs[i] = i * i
        i = i + 1
    }
    println("len = " + xs.length)
    println("xs2 = " + xs[2])
    var g : int[][] = new int[2][3]
    g[1][2] = 9
    println("g = " + g[1][2] + " rows = " + g.length + " cols = " + g[0].length)
    println("twice = " + twice(xs[3]))
    println("bytes = " + toByte(65) + " char = " + toChar(66))
    println("digit = " + isDigit('7') + " upper = " + toUpper('a'))
    rtn
}
