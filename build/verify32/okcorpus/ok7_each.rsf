// 阶段 44：数组 for-each
//
// 解糖成下标循环（见 Parser.desugarEachLoop）：数组表达式只求值一次，
// 循环变量是 imutvar；`continue` / `break` 指的仍然是这个循环。
pub class Row {
    var cells : int[] = new int[2]

    constructor(a : int, b : int) {
        cells[0] = a
        cells[1] = b
    }

    pub fn sum() -> int {
        var t = 0
        for (c in cells) {
            t = t + c
        }
        rtn t
    }
}

fn total(xs : int[]) -> int {
    var t = 0
    for (x in xs) {
        if (x < 0) { continue }
        if (x > 100) { break }
        t = t + x
    }
    rtn t
}

fn rows() -> Row[] {
    var out : Row[] = new Row[2]
    out[0] = new Row(1, 2)
    out[1] = new Row(3, 4)
    rtn out
}

fn main() -> void {
    var xs : int[] = new int[5]
    xs[0] = 1
    xs[1] = -2
    xs[2] = 3
    xs[3] = 500
    xs[4] = 7
    println(total(xs))

    var r = new Row(4, 5)
    println(r.sum())

    // 表达式直接是方法调用：只求值一次，所以 rows() 只跑一遍
    for (row in rows()) {
        println(row.sum())
    }

    // 空数组：循环体一次都不进
    var empty : int[] = new int[0]
    var seen = 0
    for (x in empty) {
        seen = seen + 1
    }
    println(seen)

    // 嵌套：内层变量遮蔽外层，编号不能撞
    var grid : int[] = new int[3]
    grid[0] = 2
    grid[1] = 3
    grid[2] = 4
    var acc = 0
    for (a in grid) {
        for (b in grid) {
            acc = acc + a * b
        }
    }
    println(acc)
}
