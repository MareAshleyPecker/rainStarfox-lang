module "stdlib/lang" to lang { Lang, Exception }

fn main() -> void {
    try {
        fail Exception.io("a.txt", "打不开")
    } catch (e : String) {
        println(Exception.kindOf(e))
        println(Exception.messageOf(e))
        println(Exception.isKind(e, "io"))
    }
    try {
        Exception.check(1 < 2, "不会触发")
    } catch (e0 : String) {
        println("不该到这里")
    }
    try {
        Exception.checkKind(false, "range", "越界了")
    } catch (e2 : String) {
        println(e2)
    }
}
